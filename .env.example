# Copy this file to .env for local development (already gitignored).
# In production, set these in Netlify: Site settings → Environment variables.
# Get all three from your Supabase project: Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The "anon" / "publishable" key. Used only server-side here (for sign-in),
# never sent to the browser, but it is the low-privilege key by design.
SUPABASE_ANON_KEY=

# The "service_role" key. SECRET — grants full database access, bypassing
# every RLS policy. Server-side only. Never commit this. Never log it.
# Never reference it from any file that could run in the browser.
SUPABASE_SERVICE_ROLE_KEY=


# --- Enquiry email notifications (Zoho Mail SMTP) --------------------------
# When set, every enquiry submitted on the website is emailed to
# ENQUIRY_NOTIFY_TO. Sending goes through Zoho's own SMTP server using the
# buxena.com mailbox that already exists — no extra DNS records, no
# third-party email provider. Leave ZOHO_SMTP_PASSWORD blank to disable email
# entirely; submissions are still recorded in Supabase and appear in
# BUXENA Admin → Website Enquiries.

# The Zoho MAILBOX that authenticates and sends. Must be the real mailbox
# login (vaxentii@buxena.com) — NOT the info@ alias. info@buxena.com is an
# alias/default-from of this mailbox, so mail still lands in the same inbox.
ZOHO_SMTP_USER=vaxentii@buxena.com

# Zoho APP PASSWORD — not the normal mailbox login password. Requires
# Multi-Factor Authentication to be ENABLED on the Zoho account first
# (app passwords silently fail with "535 Authentication Failed" without it).
# Generate at accounts.zoho.com → Security → App Passwords.
# SECRET. Never commit this. Never log it.
ZOHO_SMTP_PASSWORD=

# Where enquiry notifications are delivered. Defaults to info@buxena.com.
ENQUIRY_NOTIFY_TO=info@buxena.com
# Where proposal-acceptance alerts are delivered. Defaults to ENQUIRY_NOTIFY_TO.
PROPOSAL_NOTIFY_TO=info@buxena.com

# BUXENA's Zoho account is hosted in the CANADIAN data centre (billing in C$),
# so the default smtp.zoho.com does NOT work — it answers 535 for .ca accounts.
# Verified working 2026-08: smtp.zohocloud.ca (port 465, SSL).
ZOHO_SMTP_HOST=smtp.zohocloud.ca

# Optional. 465 (implicit SSL, default) or 587 (STARTTLS).
# ZOHO_SMTP_PORT=465


# --- Telegram notifications (optional, runs alongside email) ---------------
# When BOTH are set, every new website enquiry and every lead created in the
# admin also posts to a Telegram group, so all founders see it instantly on
# their phones. Leave either blank to disable Telegram entirely — email and
# the Supabase record are unaffected.

# From @BotFather in Telegram: /newbot, then copy the token it gives you.
# SECRET — anyone with this can post as the bot. Never commit this.
TELEGRAM_BOT_TOKEN=

# The group to post into. GROUP ids are NEGATIVE (e.g. -1001234567890);
# a positive number is a private one-to-one chat, not the group.
# To find it: add the bot to the group, send any message there, then open
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and read result[].chat.id
TELEGRAM_CHAT_ID=


# --- Marketing measurement (optional; disabled until values are supplied) --
# Existing site events already push to window.dataLayer. Supplying a valid GTM
# container ID activates Google Tag Manager so those events can be routed to
# GA4 / Google Ads using the GTM workspace. Leave blank until the real BUXENA
# container has been created and approved. Public by design: browser-visible ID.
PUBLIC_GTM_ID=

# Optional Google Search Console HTML-tag verification token. Paste ONLY the
# value from content="...", not the entire <meta> tag. Public by design.
PUBLIC_GOOGLE_SITE_VERIFICATION=
