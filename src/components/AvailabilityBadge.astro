---
/**
 * Product availability badge.
 *
 * `preorder` remains accepted as a LEGACY internal content value so existing
 * frontmatter does not need a risky catalogue-wide rewrite. Publicly it is
 * rendered as "Check Availability" unless real inventory data supports the
 * stronger In Stock / In Transit states. We never infer a preorder program,
 * inventory promise or ETA from missing data.
 */
interface Props {
  status?: 'in-stock' | 'in-transit' | 'preorder';
  etaNote?: string; // only pass when a real, current ETA exists
}
const { status = 'preorder', etaNote } = Astro.props;

const LABELS: Record<string, string> = {
  'in-stock': 'In Stock',
  'in-transit': 'In Transit',
  preorder: 'Check Availability',
};
---

<div class="avail">
  {status === 'preorder' ? (
    <a class="avail__badge avail__badge--preorder" href="#enquire">{LABELS[status]}</a>
  ) : (
    <span class={`avail__badge avail__badge--${status}`}>{LABELS[status]}</span>
  )}
  {etaNote && <span class="avail__eta">{etaNote}</span>}
</div>

<style>
  .avail { display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; }

  .avail__badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    border: 1px solid transparent;
    text-decoration: none;
  }
  a.avail__badge:focus-visible { outline: 2px solid var(--bronze); outline-offset: 2px; }

  .avail__badge--in-stock {
    color: var(--ink);
    background: var(--linen-deep);
    border-color: var(--line);
  }
  .avail__badge--in-transit {
    color: var(--bronze-ink);
    background: rgba(156, 122, 74, 0.12);
    border-color: var(--bronze-soft);
  }
  .avail__badge--preorder {
    color: var(--muted);
    background: transparent;
    border-color: var(--line);
  }

  .avail__eta {
    font-size: var(--t-small);
    color: var(--muted);
  }
</style>
