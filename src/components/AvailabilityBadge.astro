---
interface Props {
  /** Exact internal model name shared by content and the admin products table. */
  model: string;
}
const { model } = Astro.props;
---

<div class="avail" data-product-availability data-model={model} aria-live="polite">
  <div class="avail__row">
    <span class="avail__badge avail__badge--checking" data-availability-label>Checking stock…</span>
    <button class="avail__preorder" type="button" data-preorder-label hidden>Pre-order available</button>
  </div>
  <p class="avail__note" data-availability-note>Live availability is based on current BUXENA inventory.</p>
</div>

<script is:inline>
  document.querySelectorAll('[data-product-availability]').forEach(function (root) {
    var model = root.getAttribute('data-model') || '';
    var label = root.querySelector('[data-availability-label]');
    var note = root.querySelector('[data-availability-note]');
    var preorder = root.querySelector('[data-preorder-label]');
    if (!model || !label || !note || !preorder) return;

    preorder.addEventListener('click', function () {
      var form = document.getElementById('enquire');
      if (!form) return;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(function () {
        var firstField = form.querySelector('input:not([type="hidden"]):not([tabindex="-1"]), textarea, select');
        if (firstField) firstField.focus({ preventScroll: true });
      }, 450);
    });

    fetch('/api/product-availability?model=' + encodeURIComponent(model), { cache: 'no-store' })
      .then(function (response) {
        if (!response.ok) throw new Error('availability unavailable');
        return response.json();
      })
      .then(function (result) {
        var available = Math.max(0, Number(result.available) || 0);
        var inStock = result.status === 'in-stock' && available > 0;
        label.className = 'avail__badge ' + (inStock ? 'avail__badge--in-stock' : 'avail__badge--out-of-stock');
        label.textContent = inStock
          ? 'In stock · ' + available + ' ' + (available === 1 ? 'available' : 'available')
          : 'Out of stock';
        preorder.hidden = inStock;
        note.textContent = inStock
          ? 'Current sellable inventory. Final configuration and delivery are confirmed with your quote.'
          : 'Pre-order is available. We confirm the current lead time with your quote.';
      })
      .catch(function () {
        label.className = 'avail__badge avail__badge--out-of-stock';
        label.textContent = 'Out of stock';
        preorder.hidden = false;
        note.textContent = 'Pre-order is available. We confirm the current lead time with your quote.';
      });
  });
</script>

<style>
  .avail { display: grid; gap: 0.5rem; justify-items: start; }
  .avail__row { display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; }

  .avail__badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    border: 1px solid transparent;
    text-decoration: none;
  }
  .avail__badge--in-stock {
    color: var(--ink);
    background: var(--linen-deep);
    border-color: var(--line);
  }
  .avail__badge--out-of-stock,
  .avail__badge--checking {
    color: var(--muted);
    background: transparent;
    border-color: var(--line);
  }

  .avail__preorder {
    display: inline-block;
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    color: var(--ink);
    background: var(--linen-deep);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .avail__preorder:hover { border-color: var(--bronze); background: var(--linen); }
  .avail__preorder:focus-visible { outline: 2px solid var(--bronze); outline-offset: 2px; }

  .avail__note {
    margin: 0;
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--muted);
    max-width: 42em;
  }
</style>
