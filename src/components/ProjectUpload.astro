---
/**
 * ProjectUpload — reusable photo/plan attachment control for lead forms.
 *
 * PRIVACY / SAFETY (founders' rules):
 * - Files NEVER leave the visitor's browser in this MVP. No production
 *   storage integration is configured or approved (the existing Supabase
 *   "documents" bucket is PUBLIC and must not hold customer project
 *   photos). Until a private bucket + upload endpoint is explicitly
 *   approved, only file METADATA (names, types, sizes) travels with the
 *   enquiry, via the hidden input this component maintains.
 * - Customer uploads are private project data — never marketing imagery,
 *   never gallery content.
 *
 * Accepts JPG / PNG / WEBP / PDF. The consuming form reads the hidden
 * input `name="uploadMeta"` (a human-readable summary string) and appends
 * it to the enquiry message so staff know exactly what to request.
 */
interface Props {
  /** Unique per page — keeps label/input ids valid if used twice. */
  id?: string;
  label?: string;
}
const { id = 'project-upload', label = 'Photos or plans' } = Astro.props;
---

<div class="pupload" data-pupload>
  <span class="pupload__label">{label}</span>
  <label class="pupload__drop" for={id}>
    <input
      id={id}
      type="file"
      accept="image/jpeg,image/png,image/webp,application/pdf"
      multiple
      capture="environment"
      data-pupload-input
    />
    <span class="pupload__cta">Add photos or plans</span>
    <span class="pupload__hint">JPG, PNG, WEBP or PDF — kept private, never public</span>
  </label>
  <ul class="pupload__list" data-pupload-list></ul>
  <input type="hidden" name="uploadMeta" data-pupload-meta />
</div>

<style>
  .pupload { display: grid; gap: 0.55rem; }

  .pupload__label {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .pupload__drop {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    border: 1.5px dashed var(--bronze-soft);
    padding: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
    cursor: pointer;
    text-align: center;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .pupload__drop:hover { border-color: var(--bronze); background: var(--linen-deep); }
  .pupload__drop:focus-within { outline: 2px solid var(--bronze); outline-offset: 3px; }
  .pupload__drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }

  .pupload__cta {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bronze-ink);
  }
  .pupload__hint { font-size: 0.8125rem; color: var(--muted); }

  .pupload__list { display: grid; gap: 0.3rem; }
  .pupload__list li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--line);
  }
</style>

<script>
  import { track } from '../lib/track';

  document.querySelectorAll<HTMLElement>('[data-pupload]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-pupload-input]')!;
    const list = root.querySelector<HTMLElement>('[data-pupload-list]')!;
    const meta = root.querySelector<HTMLInputElement>('[data-pupload-meta]')!;
    let started = false;

    input.addEventListener('change', () => {
      const files = Array.from(input.files ?? []);
      list.innerHTML = '';

      if (!started && files.length > 0) {
        started = true;
        track('project_upload_started', { fileCount: files.length });
      }

      const fmtSize = (bytes: number) =>
        bytes >= 1024 * 1024 ? `${(bytes / (1024 * 1024)).toFixed(1)} MB` : `${Math.ceil(bytes / 1024)} KB`;

      files.forEach((f) => {
        const li = document.createElement('li');
        const name = document.createElement('span');
        name.textContent = f.name;
        const size = document.createElement('span');
        size.textContent = fmtSize(f.size);
        li.append(name, size);
        list.appendChild(li);
      });

      // Metadata only — the enquiry tells staff what to request by email.
      meta.value = files.length
        ? `Customer prepared ${files.length} file(s): ${files.map((f) => `${f.name} (${fmtSize(f.size)})`).join(', ')} — PRIVATE project data, request by email reply; files were not transmitted.`
        : '';

      if (files.length > 0) {
        track('project_upload_completed', { fileCount: files.length });
      }
    });
  });
</script>
