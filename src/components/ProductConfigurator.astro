---
import {
  buildConfigGroups,
  configStages,
  hasProductOptions,
  PRICING_PENDING_MESSAGE,
} from '../lib/product-config';
import type { ConfigurableModel } from '../lib/product-config';

interface Props {
  model: ConfigurableModel;
  displayName: string;
}
const { model, displayName } = Astro.props;

const groups = buildConfigGroups(model);
const stages = configStages(groups);
const productBacked = hasProductOptions(model);
---

<section class="band band--deep" id="configure">
  <div class="shell">
    <div class="sec-head">
      <span class="eyebrow">Build My Sauna</span>
      <h2 class="h2 measure--tight">Configure it before we price it</h2>
      <p class="lead measure">
        {productBacked
          ? 'Choose only from options verified for this model. We carry the complete configuration into your quote so you do not have to rebuild it with a salesperson.'
          : 'This model is specified with you directly. Your project details travel with your quote request.'}
      </p>
    </div>

    <div class="cfg__flow" aria-label="Configuration steps">
      {stages.map((stage, index) => (
        <a class="cfg__flow-step" href={`#cfg-stage-${stage.key}`}>
          <span>{index + 1}</span>
          <strong>{stage.label}</strong>
        </a>
      ))}
      <a class="cfg__flow-step" href="#cfg-stage-delivery">
        <span>{stages.length + 1}</span>
        <strong>Delivery</strong>
      </a>
      <a class="cfg__flow-step" href="#enquire">
        <span>{stages.length + 2}</span>
        <strong>Quote</strong>
      </a>
    </div>

    <div class="cfg" data-configurator data-model={model.title}>
      <div class="cfg__groups">
        {stages.map((stage, stageIndex) => (
          <section class="cfg__stage" id={`cfg-stage-${stage.key}`} aria-labelledby={`cfg-stage-title-${stage.key}`}>
            <div class="cfg__stage-head">
              <span class="cfg__stage-number">{stageIndex + 1}</span>
              <div>
                <h3 class="cfg__stage-title" id={`cfg-stage-title-${stage.key}`}>{stage.label}</h3>
                <p class="cfg__stage-help">{stage.help}</p>
              </div>
            </div>

            <div class="cfg__stage-groups">
              {stage.groups.map((group) => (
                <fieldset class="cfg__group" data-cfg-group={group.key}>
                  <legend class="cfg__legend">{group.label}</legend>
                  {group.help && <p class="cfg__help">{group.help}</p>}
                  <div class="cfg__options" role="radiogroup" aria-label={group.label}>
                    {group.options.map((option) => (
                      <label class="cfg__option">
                        <input
                          type="radio"
                          name={`cfg-${group.key}`}
                          value={option.value}
                          data-cfg-input={group.key}
                          data-cfg-label={option.label}
                          data-cfg-sku={option.sku ?? ''}
                          data-track="product_option_selected"
                          data-track-model={model.title}
                          data-track-group={group.key}
                        />
                        <span class="cfg__option-body">
                          <span class="cfg__option-label">{option.label}</span>
                          {option.hint && <span class="cfg__option-hint">{option.hint}</span>}
                        </span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>
          </section>
        ))}

        <section class="cfg__stage" id="cfg-stage-delivery" aria-labelledby="cfg-stage-title-delivery">
          <div class="cfg__stage-head">
            <span class="cfg__stage-number">{stages.length + 1}</span>
            <div>
              <h3 class="cfg__stage-title" id="cfg-stage-title-delivery">Delivery</h3>
              <p class="cfg__stage-help">Tell us where the sauna is going so freight and available installation can be confirmed accurately.</p>
            </div>
          </div>
          <fieldset class="cfg__group">
            <legend class="cfg__legend">Delivery ZIP</legend>
            <p class="cfg__help">
              We do not invent freight from a generic national average. Your quote is prepared around the actual destination.
            </p>
            <label class="cfg__zip-label" for="cfg-zip">ZIP code</label>
            <input
              class="cfg__zip"
              id="cfg-zip"
              type="text"
              inputmode="numeric"
              autocomplete="postal-code"
              pattern="\d{5}"
              maxlength="5"
              title="Enter a valid 5-digit U.S. ZIP code."
              data-zip-input
              data-cfg-zip
              data-track="product_zip_entered"
              data-track-model={model.title}
            />
          </fieldset>
        </section>
      </div>

      <aside class="cfg__summary" aria-label="Your configuration">
        <div class="cfg__summary-inner">
          <p class="cfg__summary-eyebrow">Your configuration</p>
          <p class="cfg__summary-model">{displayName}</p>

          <dl class="cfg__summary-list" data-cfg-summary aria-live="polite">
            <p class="cfg__summary-empty" data-cfg-empty>
              Choose the options you know. You can still request a quote with decisions left open.
            </p>
          </dl>

          <p class="cfg__summary-price">{PRICING_PENDING_MESSAGE}</p>

          <a
            class="btn btn--bronze cfg__cta"
            href="#enquire"
            data-cfg-cta
            data-track="product_quote_cta"
            data-track-model={model.title}
            data-track-cta="configurator_exact_quote"
          >Get My Configured Quote</a>

          <p class="cfg__summary-note">
            No payment is taken here. BUXENA confirms the configuration, compatibility,
            delivery and final price in writing before anything is ordered.
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .cfg__flow {
    display: flex;
    gap: 0.55rem;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    padding-bottom: 0.35rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .cfg__flow-step {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: max-content;
    padding: 0.65rem 0.85rem;
    color: var(--ink);
    background: var(--linen);
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .cfg__flow-step span,
  .cfg__stage-number {
    display: inline-grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--bronze);
    color: var(--linen);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .cfg__flow-step strong { font-size: 0.78rem; letter-spacing: 0.04em; }

  .cfg {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .cfg { grid-template-columns: minmax(0, 1.6fr) minmax(18rem, 0.9fr); align-items: start; }
  }

  .cfg__groups { display: grid; gap: clamp(1.25rem, 1rem + 1vw, 2rem); min-width: 0; }
  .cfg__stage {
    scroll-margin-top: 1.25rem;
    padding: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    background: color-mix(in srgb, var(--linen) 55%, transparent);
    border: 1px solid var(--line);
  }
  .cfg__stage-head { display: flex; align-items: flex-start; gap: 0.85rem; margin-bottom: 1.25rem; }
  .cfg__stage-title { margin: 0; font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); }
  .cfg__stage-help { margin: 0.35rem 0 0; max-width: 46rem; font-size: 0.8125rem; line-height: 1.55; color: var(--muted); }
  .cfg__stage-groups { display: grid; gap: 1.4rem; }

  .cfg__group { border: none; margin: 0; padding: 0; }
  .cfg__legend {
    padding: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .cfg__help { margin: 0.45rem 0 0; font-size: 0.8125rem; line-height: 1.6; color: var(--muted); }

  .cfg__options { display: grid; gap: 0.6rem; margin-top: 0.9rem; }
  @media (min-width: 560px) {
    .cfg__options { grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  }

  .cfg__option {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    min-height: 3rem;
    padding: 0.85rem 1rem;
    background: var(--linen);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .cfg__option:hover { border-color: var(--bronze-soft); }
  .cfg__option input { margin: 0.2rem 0 0; flex: 0 0 auto; accent-color: var(--bronze); }
  .cfg__option:has(input:checked) { border-color: var(--bronze); background: var(--linen-deep); }
  .cfg__option:has(input:focus-visible) { outline: 2px solid var(--bronze); outline-offset: 2px; }

  .cfg__option-body { display: grid; gap: 0.25rem; min-width: 0; }
  .cfg__option-label { font-size: 0.9375rem; color: var(--ink); }
  .cfg__option-hint { font-size: 0.8125rem; line-height: 1.5; color: var(--muted); }

  .cfg__zip-label { display: block; margin: 0.9rem 0 0.4rem; font-size: 0.8125rem; color: var(--muted); }
  .cfg__zip {
    width: 100%;
    max-width: 11rem;
    padding: 0.75rem 0.9rem;
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--linen);
    border: 1px solid var(--line);
  }
  .cfg__zip:focus { outline: none; border-color: var(--bronze); }

  .cfg__summary { min-width: 0; }
  @media (min-width: 900px) {
    .cfg__summary-inner { position: sticky; top: 1.5rem; }
  }
  .cfg__summary-inner {
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    background: var(--linen);
    border: 1px solid var(--bronze-soft);
  }
  .cfg__summary-eyebrow { margin: 0; font-size: 0.6875rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--bronze-ink); }
  .cfg__summary-model { margin: 0.35rem 0 1rem; font-family: var(--font-display, inherit); font-size: 1.35rem; line-height: 1.2; color: var(--ink); }
  .cfg__summary-list { margin: 0; display: grid; gap: 0.55rem; }
  .cfg__summary-list div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.55rem; border-bottom: 1px solid var(--line); }
  .cfg__summary-list dt { font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .cfg__summary-list dd { margin: 0; font-size: 0.875rem; text-align: right; color: var(--ink); }
  .cfg__summary-empty { margin: 0; font-size: 0.8125rem; line-height: 1.6; color: var(--muted); }
  .cfg__summary-price { margin: 1.1rem 0; font-size: 0.875rem; line-height: 1.6; color: var(--bronze-ink); }
  .cfg__cta { width: 100%; text-align: center; }
  .cfg__summary-note { margin: 0.9rem 0 0; font-size: 0.75rem; line-height: 1.6; color: var(--muted); }
</style>

<script>
  import { initZipValidation } from '../lib/zip-validate';
  import { track } from '../lib/track';

  initZipValidation();

  document.querySelectorAll<HTMLElement>('[data-configurator]').forEach((root) => {
    const summary = root.querySelector<HTMLElement>('[data-cfg-summary]')!;
    const empty = root.querySelector<HTMLElement>('[data-cfg-empty]')!;
    const zip = root.querySelector<HTMLInputElement>('[data-cfg-zip]');
    const modelTitle = root.dataset.model ?? '';

    const chosen = new Map<string, { groupLabel: string; optionLabel: string; sku?: string }>();

    function render() {
      summary.querySelectorAll('div').forEach((el) => el.remove());
      for (const [, entry] of chosen) {
        const row = document.createElement('div');
        const dt = document.createElement('dt');
        dt.textContent = entry.groupLabel;
        const dd = document.createElement('dd');
        dd.textContent = entry.optionLabel;
        row.append(dt, dd);
        summary.appendChild(row);
      }
      empty.hidden = chosen.size > 0;
    }

    root.querySelectorAll<HTMLInputElement>('[data-cfg-input]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        const key = input.dataset.cfgInput!;
        const groupEl = input.closest('[data-cfg-group]');
        const groupLabel = groupEl?.querySelector('.cfg__legend')?.textContent?.trim() ?? key;
        chosen.set(key, {
          groupLabel,
          optionLabel: input.dataset.cfgLabel ?? input.value,
          sku: input.dataset.cfgSku || undefined,
        });
        render();
        track('product_option_selected', { model: modelTitle, group: key, value: input.value });
      });
    });

    if (zip) {
      zip.addEventListener('change', () => {
        const value = zip.value.trim();
        if (value) {
          chosen.set('zip', { groupLabel: 'Delivery ZIP', optionLabel: value });
          track('product_zip_entered', { model: modelTitle });
        } else {
          chosen.delete('zip');
        }
        render();
      });
    }

    root.querySelector('[data-cfg-cta]')?.addEventListener('click', () => {
      const lines = [...chosen.entries()]
        .filter(([key]) => key !== 'zip')
        .map(([, entry]) => `${entry.groupLabel}: ${entry.optionLabel}${entry.sku ? ` [${entry.sku}]` : ''}`);

      const zipValue = chosen.get('zip')?.optionLabel ?? '';
      const form = document.querySelector<HTMLFormElement>('form[name="quote"]');
      if (!form) return;

      if (zipValue) {
        const zipField = form.querySelector<HTMLInputElement>('[name="zip"]');
        if (zipField && !zipField.value) zipField.value = zipValue;
      }

      if (lines.length) {
        const message = form.querySelector<HTMLTextAreaElement>('[name="message"]');
        if (message) {
          const start = '--- BUXENA CONFIGURATION ---';
          const end = '--- END CONFIGURATION ---';
          const block = `${start}\n${lines.join('\n')}\n${end}`;
          const previous = new RegExp(`${start}[\\s\\S]*?${end}\\n*`, 'g');
          const customerText = message.value.replace(previous, '').trim();
          message.value = customerText ? `${block}\n\n${customerText}` : block;
        }
      }

      track('product_quote_cta', { model: modelTitle, selections: chosen.size });
    });
  });
</script>
