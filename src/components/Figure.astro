---
import { webpSrcset } from '../lib/optimized-image';

/**
 * Figure — the only way images enter the site.
 *
 * If `src` is set it renders a real <img>. If not, it renders the quiet
 * premium neutral placeholder (warm tone + optional `label`) — the SAME
 * markup in dev and in production. There used to be a second, louder
 * dev-only mode here (a visible "Placeholder image" tag plus the raw
 * art-direction `note`), on the theory that a developer working locally
 * should see what's still unbuilt. That stopped being true once the only
 * remaining src-less figures became the 16 EDA models withheld for
 * documented, catalogued image-rights reasons (see docs/image-rights-
 * register.md) rather than genuinely unbuilt scaffolding — and it meant a
 * founder reviewing `astro dev` locally saw a visibly uglier, more
 * "broken-looking" card than the one actually shipping to customers. One
 * rendering, always: swapping in real photography is still a one-line
 * change — add `src`.
 */
interface Props {
  src?: string;
  alt: string;
  note?: string;
  ratio?: string;      // any CSS aspect-ratio, e.g. "4 / 5"
  tone?: 'light' | 'mid' | 'dark';
  priority?: boolean;  // hero images only — skips lazy loading
  class?: string;
  // 'cover' (default, unchanged everywhere existing) crops to fill `ratio`.
  // 'contain' never crops — the image sits at its natural proportions inside
  // a capped-height box on a cream ground. Used by the product hero, where
  // the whole sauna must stay visible rather than being cropped to a shape.
  fit?: 'cover' | 'contain';
  maxHeight?: string;   // only meaningful with fit="contain" + fixedRatio=false, e.g. "520px"
  // With fit="contain": false (default, used by the product hero) lets height
  // float naturally up to maxHeight. true keeps the `ratio` box itself fixed
  // — used in grids (ProductCard) so every card is the same height regardless
  // of each photo's own proportions, while still never cropping the image.
  fixedRatio?: boolean;
  // How wide this figure renders, for the browser's variant choice.
  // The default fits the shell/grid layouts used across the site; pass
  // "100vw" for full-bleed imagery.
  sizes?: string;
  /**
   * CSS object-position for the cover crop, e.g. "38% center". Lets a card
   * keep the sauna in frame when the subject is off-centre in the source.
   * Only affects fit="cover"; contain never crops.
   */
  focus?: string;
  /**
   * A short line rendered inside the placeholder IN PRODUCTION — unlike
   * `note`, which is development scaffolding.
   *
   * Exists because sixteen models lost their photography to the image-rights
   * audit, and sixteen identical wood-gradient blocks in one catalogue grid
   * read as "the images failed to load" rather than as a designed state. A
   * factual label — the series and form, e.g. "EDA · Barrel" — makes each card
   * distinct and deliberate. Never put a claim here: it is customer-facing.
   */
  label?: string;
}

const {
  src,
  alt,
  note,
  ratio = '4 / 3',
  tone = 'mid',
  priority = false,
  class: className = '',
  fit = 'cover',
  maxHeight = '520px',
  fixedRatio = false,
  sizes = '(max-width: 768px) 100vw, 800px',
  focus,
  label,
} = Astro.props;

// WebP variants generated by scripts/optimize-images.mjs, when present.
// null → the plain <img> below renders the original file, unchanged.
const srcset = webpSrcset(src);
const hasAlphaAsset = src?.toLowerCase().endsWith('.png') ?? false;
---

{/* `fig--empty` exists because of a genuine collapse.

    `fit="contain"` sets `aspect-ratio: auto` so a photograph can size itself.
    But the placeholder is `position: absolute`, so with no image the box has
    no in-flow child at all and its height falls to just the padding. On the
    product page — which uses contain WITHOUT fixedRatio — that rendered the
    hero of all sixteen image-less models as a ~50px sliver rather than a
    520px frame. It read as broken, and it was.

    Restoring the ratio only when there is nothing to contain gives those
    pages a properly proportioned frame, and changes nothing for any figure
    that has an image. */}
<figure
  class={`fig fig--${tone} ${fit === 'contain' ? 'fig--contain' : ''} ${fit === 'contain' && fixedRatio ? 'fig--contain-fixed' : ''} ${hasAlphaAsset ? 'fig--alpha' : ''} ${!src ? 'fig--empty' : ''} ${className}`}
  style={`--fig-ratio:${ratio}; --fig-max-h:${maxHeight}${focus ? `; --fig-pos:${focus}` : ''}`}
>
  {
    src ? (
      <picture>
        {srcset && <source type="image/webp" srcset={srcset} sizes={sizes} />}
        <img
          src={src}
          alt={alt}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </picture>
    ) : (
      <div class="fig__ph" role="img" aria-label={alt}>
        {label && (
          <div class="fig__body fig__body--label">
            {/* The site's own established motif (see .slats in global.css,
                already used on /heater-guide/ etc.) — sauna-cladding
                hairlines, not an invented illustration or a stock icon. */}
            <span class="slats" aria-hidden="true"></span>
            <span class="fig__label">{label}</span>
          </div>
        )}
      </div>
    )
  }
</figure>

<style>
  .fig {
    margin: 0;
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--fig-ratio);
    background: var(--birch);
  }

  .fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Focal point for the cover crop; centre unless a `focus` is passed. */
    object-position: var(--fig-pos, center);
  }

  /* Never crop — the full product stays visible, capped height, natural
     proportions, resting on a cream ground rather than filling a shape. */
  .fig--contain {
    aspect-ratio: auto;
    background: var(--linen);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3%, 2rem);
  }
  .fig--contain img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--fig-max-h);
    object-fit: contain;
  }
  @media (max-width: 900px) {
    .fig--contain:not(.fig--contain-fixed) img { max-height: none; width: 100%; }
  }

  /* Grid variant — the box itself keeps `ratio` (so every card in a row is
     the same height), the image still only ever contains within it. */
  .fig--contain-fixed { aspect-ratio: var(--fig-ratio); }
  .fig--contain-fixed picture {
    position: absolute;
    inset: var(--fig-fixed-inset, 0);
  }
  .fig--contain-fixed img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /* Declared AFTER .fig--contain so it wins the `aspect-ratio: auto` there —
     same technique, and same specificity, as .fig--contain-fixed above.
     Only ever applies when there is no image to size the box. */
  .fig--empty { aspect-ratio: var(--fig-ratio); }

  .fig__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4%, 2.25rem);
    text-align: center;
  }

  /* PREMIUM NEUTRAL PLACEHOLDER, 2026-08-15 — replaces the wood-brown
     gradient + white-stripe "grain" texture. That combination was built to
     read as "an intentional design choice, not a broken image" one card at a
     time; seen sixteen times in a row across a catalogue grid it read as the
     opposite — loud, repetitive, and exactly like a broken-image state. The
     brief was explicit: clean warm neutral ground, no stripes, no fake
     photography. These reuse the site's own linen/birch surface tones — the
     same ones every non-placeholder section of the site already sits on —
     so an unphotographed card recedes quietly into the page rather than
     announcing itself in wood-tone brown. */
  .fig--light .fig__ph {
    background: linear-gradient(160deg, var(--linen) 0%, var(--birch) 100%);
    color: var(--muted-dark);
  }
  .fig--mid .fig__ph {
    background: linear-gradient(160deg, var(--birch) 0%, var(--linen-deep) 100%);
    color: var(--bronze-ink);
  }
  /* Kept genuinely dark — this tone is chosen by callers sitting on a dark
     band (e.g. band--ember sections), and a light-neutral placeholder there
     would look like a rendering error, not a design. Still de-loudened: no
     wood-brown gradient, no stripe texture, just the site's own near-black. */
  .fig--dark .fig__ph {
    background: var(--ember);
    color: var(--muted-dark);
  }

  .fig__body {
    position: relative;
    max-width: 30ch;
  }

  .fig__body--label {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
  }
  /* The slats motif inherits `color` from .fig__ph via currentColor, so it
     matches the label automatically in every tone above with no extra rule. */
  .fig__body--label .slats { width: 2.25rem; height: 1.05rem; opacity: 0.55; }

  /* Production label — the series and form (e.g. "EDA · Barrel"), never a
     claim. Quiet small-caps typography, not a loud "MISSING" flag. */
  .fig__label {
    position: relative;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.85;
  }

</style>
