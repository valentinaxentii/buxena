---
import { showDev } from '../data/site';
import { webpSrcset } from '../lib/optimized-image';

/**
 * Figure — the only way images enter the site.
 *
 * If `src` is set it renders a real <img>.
 * If not, it renders a clearly-labelled PLACEHOLDER block showing the
 * art-direction note, so nobody mistakes it for finished work.
 *
 * Swapping in real photography is a one-line change: add `src`.
 */
interface Props {
  src?: string;
  alt: string;
  note?: string;
  ratio?: string;      // any CSS aspect-ratio, e.g. "4 / 5"
  tone?: 'light' | 'mid' | 'dark';
  priority?: boolean;  // hero images only — skips lazy loading
  class?: string;
  // 'cover' (default, unchanged everywhere existing) crops to fill `ratio`.
  // 'contain' never crops — the image sits at its natural proportions inside
  // a capped-height box on a cream ground. Used by the product hero, where
  // the whole sauna must stay visible rather than being cropped to a shape.
  fit?: 'cover' | 'contain';
  maxHeight?: string;   // only meaningful with fit="contain" + fixedRatio=false, e.g. "520px"
  // With fit="contain": false (default, used by the product hero) lets height
  // float naturally up to maxHeight. true keeps the `ratio` box itself fixed
  // — used in grids (ProductCard) so every card is the same height regardless
  // of each photo's own proportions, while still never cropping the image.
  fixedRatio?: boolean;
  // How wide this figure renders, for the browser's variant choice.
  // The default fits the shell/grid layouts used across the site; pass
  // "100vw" for full-bleed imagery.
  sizes?: string;
  /**
   * CSS object-position for the cover crop, e.g. "38% center". Lets a card
   * keep the sauna in frame when the subject is off-centre in the source.
   * Only affects fit="cover"; contain never crops.
   */
  focus?: string;
  /**
   * A short line rendered inside the placeholder IN PRODUCTION — unlike
   * `note`, which is development scaffolding.
   *
   * Exists because sixteen models lost their photography to the image-rights
   * audit, and sixteen identical wood-gradient blocks in one catalogue grid
   * read as "the images failed to load" rather than as a designed state. A
   * factual label — the series and form, e.g. "EDA · Barrel" — makes each card
   * distinct and deliberate. Never put a claim here: it is customer-facing.
   */
  label?: string;
}

const {
  src,
  alt,
  note,
  ratio = '4 / 3',
  tone = 'mid',
  priority = false,
  class: className = '',
  fit = 'cover',
  maxHeight = '520px',
  fixedRatio = false,
  sizes = '(max-width: 768px) 100vw, 800px',
  focus,
  label,
} = Astro.props;

// WebP variants generated by scripts/optimize-images.mjs, when present.
// null → the plain <img> below renders the original file, unchanged.
const srcset = webpSrcset(src);

/**
 * Two placeholder modes.
 *   dev  — labelled block showing the art-direction note, so you can see
 *          exactly which shot is still outstanding.
 *   prod — a quiet, unlabelled tone block. It says nothing false and never
 *          announces to a customer that the site is unfinished.
 */
const labelled = showDev;
---

<figure
  class={`fig fig--${tone} ${fit === 'contain' ? 'fig--contain' : ''} ${fit === 'contain' && fixedRatio ? 'fig--contain-fixed' : ''} ${className}`}
  style={`--fig-ratio:${ratio}; --fig-max-h:${maxHeight}${focus ? `; --fig-pos:${focus}` : ''}`}
>
  {
    src ? (
      <picture>
        {srcset && <source type="image/webp" srcset={srcset} sizes={sizes} />}
        <img
          src={src}
          alt={alt}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </picture>
    ) : (
      <div class="fig__ph" role="img" aria-label={labelled ? `Placeholder image. ${alt}` : alt}>
        <div class="fig__grain" aria-hidden="true"></div>
        {labelled ? (
          <div class="fig__body">
            <span class="fig__tag">Placeholder image</span>
            <p class="fig__note">{note ?? alt}</p>
          </div>
        ) : (
          label && <span class="fig__label">{label}</span>
        )}
      </div>
    )
  }
</figure>

<style>
  .fig {
    margin: 0;
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--fig-ratio);
    background: var(--birch);
  }

  .fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Focal point for the cover crop; centre unless a `focus` is passed. */
    object-position: var(--fig-pos, center);
  }

  /* Never crop — the full product stays visible, capped height, natural
     proportions, resting on a cream ground rather than filling a shape. */
  .fig--contain {
    aspect-ratio: auto;
    background: var(--linen);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3%, 2rem);
  }
  .fig--contain img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--fig-max-h);
    object-fit: contain;
  }
  @media (max-width: 900px) {
    .fig--contain:not(.fig--contain-fixed) img { max-height: none; width: 100%; }
  }

  /* Grid variant — the box itself keeps `ratio` (so every card in a row is
     the same height), the image still only ever contains within it. */
  .fig--contain-fixed { aspect-ratio: var(--fig-ratio); }
  .fig--contain-fixed img { max-height: 100%; }

  .fig__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4%, 2.25rem);
    text-align: center;
  }

  .fig--light .fig__ph {
    background: linear-gradient(150deg, #efe6d8 0%, var(--wood-1) 100%);
    color: #453423;
  }
  .fig--mid .fig__ph {
    background: linear-gradient(150deg, var(--wood-1) 0%, var(--wood-2) 55%, var(--wood-3) 100%);
    color: #fdf8f0;
  }
  .fig--dark .fig__ph {
    background: linear-gradient(150deg, var(--wood-3) 0%, #3a2c1e 60%, var(--ember) 100%);
    color: #f0e6d6;
  }

  /* slat motif, carried through to the placeholders */
  .fig__grain {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.16) 0 1px,
      transparent 1px 9px
    );
    opacity: 0.55;
    pointer-events: none;
  }

  .fig__body {
    position: relative;
    max-width: 30ch;
  }

  /* Production label. Quiet enough to read as a designed mark rather than as
     an apology for a missing photograph. */
  .fig__label {
    position: relative;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .fig__tag {
    display: inline-block;
    font-size: 0.625rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    padding: 0.4rem 0.85rem;
    border: 1px solid currentColor;
    opacity: 0.85;
    margin-bottom: 1rem;
  }

  .fig__note {
    font-size: 0.8125rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.92;
  }
</style>
