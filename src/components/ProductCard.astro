---
import Figure from './Figure.astro';
import { showDev } from '../data/site';
import { capacityBuckets, displayTitle } from '../data/catalog';
import { displayFromPrice } from '../data/pricing';

interface VariantLink {
  slug: string;
  label: string;
}

interface Props {
  slug: string;
  title: string;
  tagline: string;
  category: string;
  placeholder?: boolean;
  image?: { src?: string; alt: string; note?: string };
  location?: 'outdoor' | 'indoor';
  productType?: string;
  series?: string;
  capacity?: string;
  capacityMin?: number;
  capacityMax?: number;
  materials?: string[];
  dimensions?: { label: string; value: string }[];
  /** When a supplier publishes one family image for several depths, show the
   * sizes together instead of repeating the same photograph as separate cards. */
  variants?: VariantLink[];
  /** Approved display price ("From $18,900"). Absent → card shows Request Pricing only. */
  fromPrice?: string;
}
const {
  slug, title, tagline, category, placeholder = true, image,
  location, productType, series, capacity, capacityMin, capacityMax, materials, dimensions,
  variants = [], fromPrice,
} = Astro.props;
const primaryDimension = dimensions?.[0]?.value;
const specLine = [productType, primaryDimension, capacity, materials?.[0]]
  .filter(Boolean)
  .join(' · ');

const buckets = capacityBuckets(capacityMin, capacityMax);
const materialSlug = (materials ?? []).map((m) => m.toLowerCase().replace(/[^a-z0-9]+/g, '-')).join(' ');
const isVariantGroup = variants.length > 1;
---

<article
  class="pcard"
  data-category={category}
  data-location={location ?? ''}
  data-type={productType ?? ''}
  data-series={series ?? ''}
  data-material={materialSlug}
  data-capacity={buckets.join(' ')}
>
  {isVariantGroup ? (
    <div class="pcard__link pcard__link--group">
      <div class="pcard__media">
        <Figure
          src={image?.src}
          alt={image?.alt ?? title}
          note={image?.note}
          label={[series, productType].filter(Boolean).join(' · ')}
          ratio="4 / 3"
          tone="mid"
          fit="contain"
          fixedRatio={true}
        />
        {placeholder && showDev && <span class="pcard__flag">Placeholder listing</span>}
      </div>
      <div class="pcard__body">
        <h3 class="pcard__title">{displayTitle(title)}</h3>
        {specLine && <p class="pcard__specs">{specLine}</p>}
        <p class="pcard__tag">{tagline}</p>
        <div class="pcard__variants" aria-label={`${displayTitle(title)} available sizes`}>
          <span class="pcard__variants-label">Available sizes</span>
          <div class="pcard__variant-links">
            {variants.map((variant) => (
              <a href={`/saunas/${variant.slug}/`}>{variant.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  ) : (
    <a class="pcard__link" href={`/saunas/${slug}/`}>
      <div class="pcard__media">
        <Figure
          src={image?.src}
          alt={image?.alt ?? title}
          note={image?.note}
          label={[series, productType].filter(Boolean).join(' · ')}
          ratio="4 / 3"
          tone="mid"
          fit="contain"
          fixedRatio={true}
        />
        {placeholder && showDev && <span class="pcard__flag">Placeholder listing</span>}
      </div>
      <div class="pcard__body">
        <h3 class="pcard__title">{displayTitle(title)}</h3>
        {specLine && <p class="pcard__specs">{specLine}</p>}
        <p class="pcard__tag">{tagline}</p>
        {displayFromPrice(title, fromPrice) && (
          <p class="pcard__price">{displayFromPrice(title, fromPrice)}</p>
        )}
      </div>
    </a>
  )}

  {isVariantGroup ? (
    <div class="pcard__actions">
      <a
        class="pcard__quote"
        href={`/quote/?model=${encodeURIComponent(title)}`}
        data-track="pricing_request_started"
        data-track-model={title}
        data-track-category={category}
        data-track-form-type="product_card"
      >Request Pricing</a>
    </div>
  ) : (
    <div class="pcard__actions">
      <a class="pcard__more" href={`/saunas/${slug}/`}>View Model <span class="pcard__arrow" aria-hidden="true">→</span></a>
      <a
        class="pcard__quote"
        href={`/quote/?model=${encodeURIComponent(title)}`}
        data-track="pricing_request_started"
        data-track-model={title}
        data-track-category={category}
        data-track-form-type="product_card"
      >Request Pricing</a>
    </div>
  )}
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.7s var(--ease);
  }
  @media (hover: hover) {
    .pcard:hover { transform: translateY(-5px); }
  }

  .pcard__link {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    text-decoration: none;
    color: inherit;
  }
  .pcard__link--group { cursor: default; }

  .pcard__media { position: relative; overflow: hidden; }
  .pcard__media :global(.fig) { transition: transform 1.1s var(--ease); }
  .pcard__link:hover .pcard__media :global(.fig) { transform: scale(1.035); }
  .pcard__link--group:hover .pcard__media :global(.fig) { transform: none; }

  .pcard__flag {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    z-index: 2;
    background: rgba(27, 25, 23, 0.82);
    color: var(--linen);
    font-size: 0.5625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
  }

  .pcard__body { padding-top: var(--card-body-pad); flex: 1 1 auto; }

  .pcard__title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.5rem + 0.7vw, 2.1rem);
    font-weight: 500;
    line-height: 1.08;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .pcard__specs {
    font-family: 'Manrope', var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--bronze-ink);
    margin-bottom: 0.65rem;
  }

  .pcard__tag {
    font-family: 'Manrope', var(--font-sans);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .pcard__variants {
    border-top: 1px solid var(--line);
    padding-top: 0.75rem;
    margin-top: 0.25rem;
  }
  .pcard__variants-label {
    display: block;
    margin-bottom: 0.55rem;
    font-family: 'Manrope', var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bronze-ink);
  }
  .pcard__variant-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pcard__variant-links a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 0.7rem;
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: 'Manrope', var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .pcard__variant-links a:hover { border-color: var(--bronze); background: var(--linen); }

  .pcard__price {
    font-family: 'Manrope', var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    margin: -0.4rem 0 1rem;
  }

  .pcard__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .pcard__more {
    font-family: 'Manrope', var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
    transition: border-color 0.4s var(--ease);
  }
  .pcard:hover .pcard__more { border-bottom-color: var(--ink); }

  .pcard__arrow { display: inline-block; transition: transform 0.4s var(--ease); }
  .pcard:hover .pcard__arrow { transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .pcard, .pcard__media :global(.fig), .pcard__arrow { transition: none; }
    .pcard:hover,
    .pcard__link:hover .pcard__media :global(.fig),
    .pcard:hover .pcard__arrow { transform: none; }
  }

  .pcard__quote {
    font-family: 'Manrope', var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bronze-ink);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease), color 0.4s var(--ease);
  }
  .pcard__quote:hover { color: var(--ink); border-bottom-color: var(--ink); }

  @media (max-width: 640px), (hover: none) {
    .pcard__more { padding-top: 0.7rem; }
    .pcard__quote { padding-block: 0.7rem; }
    .pcard__variant-links a { min-height: 44px; }
  }
</style>
