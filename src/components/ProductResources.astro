---
import { getCollection } from 'astro:content';
import { publicAssets } from '../lib/product-assets';
import type { TechnicalAssets } from '../lib/product-assets';
import { displayTitle } from '../data/catalog';
import { readHeaterFacts } from '../lib/heater-options';
import { viruDetailsFor } from '../data/viru-catalog-details';

/**
 * Technical specification sheet + verified resources for every sauna model.
 *
 * The product page already renders this component for every model. Looking up
 * the matching content entry here lets us add the specification-sheet treatment
 * globally without duplicating markup across 30+ product pages.
 *
 * FACTUAL INTEGRITY: only values already present in the model's verified content
 * are rendered. Existing dual-unit values are preserved exactly. When the
 * supplier provides metric only, the missing imperial value is calculated here
 * with standard unit factors and labelled "Approx." so no false precision is
 * introduced.
 */
interface Props {
  assets?: TechnicalAssets;
  /** Internal model title, for analytics and content lookup. */
  model: string;
  /** Content slug used to connect an exact supplier catalogue sheet. */
  slug?: string;
}
const { assets, model, slug } = Astro.props;

const resources = publicAssets(assets);
const saunaEntries = await getCollection('saunas', ({ data }) => !data.draft);
const product = saunaEntries.find((entry) => entry.data.title === model);
const data = product?.data;
const catalogue = slug ? viruDetailsFor(slug) : undefined;

function stripOuterParens(value: string): string {
  return value.replace(/^\s*\(|\)\s*$/g, '').trim();
}

function unitSystem(value: string): 'metric' | 'imperial' | null {
  const v = value.toLowerCase();
  if (/(?:\b(?:mm|cm|kg|m3|m2|m|kw)\b|m[²³])/.test(v)) return 'metric';
  if (/\b(in|inch|inches|lb|lbs|ft|sq ft|cu ft)\b/.test(v) || /\d+\s*[′']/u.test(v)) return 'imperial';
  return null;
}

function formatConverted(value: number, digits = 1): string {
  const rounded = Number(value.toFixed(digits));
  return Number.isInteger(rounded)
    ? rounded.toLocaleString('en-US')
    : rounded.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: digits });
}

/** Calculate an imperial companion only for a clearly metric source value. */
function calculatedImperial(value: string, label: string): string {
  const match = value.match(/^(.+?)\s*(mm|cm|kg|m3|m³|m2|m²|m)(?=\s|,|$)(.*)$/i);
  if (!match) return '';

  const [, metricNumbers, rawUnit, trailing] = match;
  const unit = rawUnit.toLowerCase();
  const compactCentimetres = /bench|seat|table|door|window|thickness/i.test(label);
  const conversion = unit === 'mm'
    ? { factor: 1 / 25.4, suffix: 'in', digits: 1 }
    : unit === 'cm' && compactCentimetres
      ? { factor: 1 / 2.54, suffix: 'in', digits: 1 }
      : unit === 'cm'
        ? { factor: 1 / 30.48, suffix: 'ft', digits: 1 }
        : unit === 'kg'
          ? { factor: 2.2046226218, suffix: 'lb', digits: 0 }
          : unit === 'm3' || unit === 'm³'
            ? { factor: 35.3146667, suffix: 'cu ft', digits: 1 }
            : unit === 'm2' || unit === 'm²'
              ? { factor: 10.7639104, suffix: 'sq ft', digits: 1 }
              : { factor: 3.280839895, suffix: 'ft', digits: 1 };

  let convertedAny = false;
  const converted = metricNumbers.replace(/\d[\d,]*(?:\.\d+)?/g, (token) => {
    const parsed = Number(token.replace(/,/g, ''));
    if (!Number.isFinite(parsed)) return token;
    convertedAny = true;
    return formatConverted(parsed * conversion.factor, conversion.digits);
  });
  if (!convertedAny) return '';
  return `Approx. ${converted.trim()} ${conversion.suffix}${trailing}`.replace(/\s+,/g, ',');
}

/**
 * Split an existing dual-unit source string, e.g.
 * "51.2 × 53.1 × 89.0 in (1300 × 1350 × 2260 mm)", or the same shape with a
 * trailing qualifier after the parenthetical, e.g.
 * "595 lb (270 kg) flat-pack". If the source does not explicitly contain
 * both systems, keep it intact in a neutral Value column rather than
 * manufacturing a conversion.
 */
function splitVerifiedUnits(value: string, label: string) {
  const match = value.match(/^(.*?)\s*\(([^()]*)\)\s*(.*)$/);
  if (!match) {
    if (unitSystem(value) === 'metric') {
      const imperial = calculatedImperial(value, label);
      if (imperial) return { metric: value, imperial, value: '' };
    }
    return { metric: '', imperial: '', value };
  }

  const first = match[1].trim();
  const second = stripOuterParens(match[2]);
  const trailing = match[3].trim();
  const firstSystem = unitSystem(first);
  const secondSystem = unitSystem(second);
  const withTrailing = (s: string) => (trailing ? `${s} ${trailing}` : s);

  if (firstSystem === 'imperial' && secondSystem === 'metric') {
    return { metric: withTrailing(second), imperial: withTrailing(first), value: '' };
  }
  if (firstSystem === 'metric' && secondSystem === 'imperial') {
    return { metric: withTrailing(first), imperial: withTrailing(second), value: '' };
  }
  return { metric: '', imperial: '', value };
}

/**
 * Compatible-heating table: real ✓/✕ rows, never inferred. Reuses the same
 * conservative reader as /heater-guide/ and the hero summary, so this table
 * can never disagree with either. A fuel gets a row only when the catalogue
 * states something about it — electric/wood compatibility is never assumed,
 * and an unstated fuel gets no row at all rather than a guessed ✕.
 */
const heaterFacts = readHeaterFacts(data?.heaterOptions ?? catalogue?.heaterOptions);
const heaterCompatRows = heaterFacts.unknown
  ? []
  : [
      ...(heaterFacts.fuels.includes('electric')
        ? [{ label: 'Electric heater', compatible: true, note: heaterFacts.kwRange ?? '' }]
        : []),
      ...(heaterFacts.woodExplicitlyIncompatible
        ? [{ label: 'Wood-burning heater', compatible: false, note: 'Not compatible' }]
        : heaterFacts.fuels.includes('wood')
          ? [{ label: 'Wood-burning heater', compatible: true, note: '' }]
          : []),
    ];

/**
 * A raw prose "Heater" / "Heater compatibility" row sometimes lives in
 * `specs` too (e.g. ELLA/ILLI/ALLA's frontmatter). Once heaterCompatRows has
 * a structured ✓/✕ answer, that raw row would just restate it a second time
 * in the same table — dropped only in that case. Where heaterCompatRows is
 * empty (heaterOptions absent, e.g. the EDA barrels), the raw specs row is
 * the only heater information available and is kept.
 */
const technicalRows = data
  ? [
      ...(data.capacity ? [{ label: 'Capacity', raw: data.capacity }] : []),
      ...(data.dimensions ?? []).map((row) => ({ label: row.label, raw: row.value })),
      ...(data.specs ?? [])
        .filter((row) => heaterCompatRows.length === 0 || !/heater/i.test(row.label))
        .map((row) => ({ label: row.label, raw: row.value })),
      ...(data.materials?.length ? [{ label: 'Material', raw: data.materials.join(', ') }] : []),
      ...(data.delivery ? [{ label: 'Delivery', raw: data.delivery }] : []),
    ].map((row) => ({ ...row, ...splitVerifiedUnits(row.raw, row.label) }))
  : [];

const hasTechnicalSheet = technicalRows.length > 0 || heaterCompatRows.length > 0;

const drawingResources = resources.filter(({ slot }) =>
  ['dimensionDrawing', 'floorPlan', 'elevations', 'benchLayout'].includes(slot.key)
);
const otherResources = resources.filter(({ slot }) =>
  !['dimensionDrawing', 'floorPlan', 'elevations', 'benchLayout'].includes(slot.key)
);

/** Poster-less videos still need a labelled play target. */
function embedUrl(provider: string | undefined, url: string): string {
  if (provider === 'youtube') {
    const id = url.match(/(?:youtu\.be\/|v=|embed\/)([\w-]{6,})/)?.[1];
    return id ? `https://www.youtube-nocookie.com/embed/${id}?rel=0` : url;
  }
  if (provider === 'vimeo') {
    const id = url.match(/vimeo\.com\/(?:video\/)?(\d+)/)?.[1];
    return id ? `https://player.vimeo.com/video/${id}` : url;
  }
  return url;
}

function minutes(seconds?: number): string {
  if (!seconds || seconds <= 0) return '';
  const m = Math.round(seconds / 60);
  return m >= 1 ? `${m} min` : `${seconds}s`;
}
---

{(hasTechnicalSheet || resources.length > 0) && (
  <section class="band band--tight techsheet" id="technical-information">
    <div class="shell">
      {hasTechnicalSheet && (
        <div class="techsheet__panel">
          <div class="techsheet__head">
            <div>
              <span class="eyebrow">Technical Information</span>
              <h2 class="h2 techsheet__title">{data ? displayTitle(data.title) : model}</h2>
              {data?.capacity && <p class="techsheet__subtitle">Verified specifications for {data.capacity}</p>}
            </div>
            {data?.series && <span class="techsheet__series">{data.series}</span>}
          </div>

          <div class:list={['techsheet__layout', drawingResources.length > 0 && 'techsheet__layout--with-drawings']}>
            <div class="techsheet__tablewrap">
              <table class="techsheet__table">
                <thead>
                  <tr>
                    <th scope="col">Technical information</th>
                    <th scope="col">Metric</th>
                    <th scope="col">Imperial</th>
                  </tr>
                </thead>
                <tbody>
                  {technicalRows.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      {row.value ? (
                        <td colspan="2" class="techsheet__combined">{row.value}</td>
                      ) : (
                        <>
                          <td>{row.metric || '—'}</td>
                          <td>{row.imperial || '—'}</td>
                        </>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>

              {heaterCompatRows.length > 0 && (
                <div class="techsheet__compat">
                  <h3>Compatible heating</h3>
                  <table class="techsheet__compattable">
                    <tbody>
                      {heaterCompatRows.map((row) => (
                        <tr>
                          <th scope="row">{row.label}</th>
                          <td class:list={['techsheet__mark', row.compatible ? 'is-yes' : 'is-no']} aria-label={row.compatible ? 'Compatible' : 'Not compatible'}>
                            {row.compatible ? '✓' : '✕'}
                          </td>
                          <td class="techsheet__compatnote">{row.note}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {catalogue && (
                <div class="catalogue-details">
                  <div class="catalogue-details__head">
                    <span class="eyebrow">Included & configurable</span>
                    <h3>Complete model information</h3>
                  </div>

                  <div class="catalogue-details__top">
                    <section class="catalogue-details__included">
                      <h4>Basic set includes</h4>
                      <ul>{catalogue.basicSet.map((item) => <li>{item}</li>)}</ul>
                    </section>

                    <dl class="catalogue-details__choices">
                      <div>
                        <dt>Wood</dt>
                        <dd>{catalogue.woodOptions.join(' / ')}</dd>
                      </div>
                      <div>
                        <dt>Heater choices</dt>
                        <dd>{catalogue.heaterOptions.join(' / ')}</dd>
                      </div>
                      <div>
                        <dt>Delivery choices</dt>
                        <dd>{catalogue.deliveryOptions.join(' / ')}</dd>
                      </div>
                    </dl>
                  </div>

                  {catalogue.accessories.length > 0 && (
                    <div class="catalogue-details__accessories">
                      <h4>Additional equipment and accessories</h4>
                      <div class="catalogue-details__grid">
                        {catalogue.accessories.map((group) => (
                          <section>
                            <h5>{group.label}</h5>
                            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
                          </section>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )}
            </div>

            {drawingResources.length > 0 && (
              <aside class="techsheet__drawings" aria-label="Technical drawings">
                <span class="techsheet__drawings-label">Verified drawings</span>
                {drawingResources.map(({ slot, asset }) => (
                  <a
                    class="techsheet__drawing"
                    href={asset.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="product_resource_opened"
                    data-track-model={model}
                    data-pres-open={slot.key}
                  >
                    <span class="techsheet__drawing-icon" aria-hidden="true">⌑</span>
                    <span>
                      <strong>{asset.title ?? slot.label}</strong>
                      <small>Open drawing</small>
                    </span>
                  </a>
                ))}
              </aside>
            )}
          </div>

          <p class="techsheet__note">Only supplier-verified information is shown. Imperial values labelled “Approx.” are calculated from the supplier's metric measurements. Final heater, electrical, site and delivery requirements are confirmed with your written quote.</p>
        </div>
      )}

      {otherResources.length > 0 && (
        <div class="resources-block">
          <div class="sec-head resources-block__head">
            <span class="eyebrow">Technical Resources</span>
            <h2 class="h2 measure--tight">Plans, manuals & installation resources</h2>
          </div>

          <div class="pres" data-resources data-model={model}>
            {otherResources.map(({ slot, asset }) => (
              <div class="pres__item" data-pres-item={slot.key}>
                {slot.kind === 'video' ? (
                  <button
                    class="pres__btn pres__btn--video"
                    type="button"
                    data-pres-play={slot.key}
                    data-pres-src={embedUrl(asset.provider, asset.url!)}
                    data-pres-title={asset.title ?? slot.label}
                    aria-label={`Play ${asset.title ?? slot.label}`}
                  >
                    <span class="pres__icon" aria-hidden="true">▶</span>
                    <span class="pres__body">
                      <span class="pres__label">{slot.action}</span>
                      {minutes(asset.durationSeconds) && <span class="pres__meta">{minutes(asset.durationSeconds)}</span>}
                    </span>
                  </button>
                ) : slot.kind === 'model' ? (
                  <button
                    class="pres__btn"
                    type="button"
                    data-pres-embed={slot.key}
                    data-pres-src={asset.url}
                    data-pres-title={asset.title ?? slot.label}
                    aria-label={`Open ${asset.title ?? slot.label}`}
                  >
                    <span class="pres__icon" aria-hidden="true">◈</span>
                    <span class="pres__body"><span class="pres__label">{slot.action}</span></span>
                  </button>
                ) : (
                  <a
                    class="pres__btn"
                    href={asset.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-pres-open={slot.key}
                    data-track="product_resource_opened"
                    data-track-model={model}
                  >
                    <span class="pres__icon" aria-hidden="true">▤</span>
                    <span class="pres__body">
                      <span class="pres__label">{slot.action}</span>
                      <span class="pres__meta">Opens in a new tab</span>
                    </span>
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    {otherResources.some(({ slot }) => slot.kind === 'video' || slot.kind === 'model') && (
      <dialog class="pres-modal" data-pres-modal aria-label="Technical resource">
        <div class="pres-modal__bar">
          <p class="pres-modal__title" data-pres-modal-title></p>
          <button class="pres-modal__close" type="button" data-pres-close aria-label="Close">×</button>
        </div>
        <div class="pres-modal__frame" data-pres-modal-frame></div>
      </dialog>
    )}
  </section>
)}

<style>
  .techsheet__panel {
    padding: clamp(1.25rem, 1rem + 1.2vw, 2.25rem);
    border: 1px solid var(--line);
    background: var(--linen);
  }
  .techsheet__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .techsheet__title { margin: 0.18rem 0 0; }
  .techsheet__subtitle { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.9rem; }
  .techsheet__series {
    flex: 0 0 auto;
    color: var(--bronze-ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .techsheet__layout { margin-top: 1rem; }
  .techsheet__layout--with-drawings {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(14rem, 0.65fr);
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }
  /* The scroll container. `overflow-x` has no effect on a <table> once
     border-collapse:collapse is set (CSS 2.1 §17.6.2), so this wrapper — not
     the table itself — is what keeps a wide table's horizontal scroll
     contained to itself instead of the page. */
  .techsheet__tablewrap { min-width: 0; overflow-x: auto; }
  .techsheet__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.84rem;
  }
  .techsheet__table th,
  .techsheet__table td {
    padding: 0.6rem 0.65rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .techsheet__table thead th {
    color: var(--bronze-ink);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .techsheet__table thead th:first-child { width: 34%; }
  .techsheet__table tbody th { color: var(--ink); font-weight: 500; }
  .techsheet__table td { color: var(--muted); }
  .techsheet__combined { color: var(--ink) !important; }
  .techsheet__compat { margin-top: 1.15rem; }
  .techsheet__compat h3 {
    margin: 0 0 0.55rem;
    color: var(--bronze-ink);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .techsheet__compattable { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
  .techsheet__compattable th,
  .techsheet__compattable td { padding: 0.4rem 0.5rem 0.4rem 0; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .techsheet__compattable tr:last-child th,
  .techsheet__compattable tr:last-child td { border-bottom: none; }
  .techsheet__compattable th { color: var(--ink); font-weight: 500; }
  .techsheet__mark { width: 1.4rem; font-weight: 700; }
  .techsheet__mark.is-yes { color: var(--bronze-ink); }
  .techsheet__mark.is-no { color: var(--muted); }
  .techsheet__compatnote { color: var(--muted); }
  .catalogue-details {
    margin-top: clamp(1.4rem, 1rem + 1vw, 2.2rem);
    padding-top: clamp(1.2rem, 0.9rem + 0.8vw, 1.8rem);
    border-top: 1px solid var(--line);
  }
  .catalogue-details__head h3 {
    margin: 0.2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 1.05rem + 0.8vw, 1.8rem);
    font-weight: 400;
  }
  .catalogue-details h4,
  .catalogue-details h5 {
    margin: 0;
    color: var(--bronze-ink);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .catalogue-details__top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
    gap: clamp(1rem, 2vw, 2rem);
    margin-top: 1rem;
  }
  .catalogue-details__included,
  .catalogue-details__choices,
  .catalogue-details__grid section {
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--linen-deep);
  }
  .catalogue-details ul {
    display: grid;
    gap: 0.3rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink);
    font-size: 0.8rem;
  }
  .catalogue-details li { position: relative; padding-left: 0.85rem; }
  .catalogue-details li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--bronze-ink);
  }
  .catalogue-details__choices { margin: 0; }
  .catalogue-details__choices div + div {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .catalogue-details__choices dt {
    color: var(--bronze-ink);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .catalogue-details__choices dd {
    margin: 0.25rem 0 0;
    color: var(--ink);
    font-size: 0.82rem;
  }
  .catalogue-details__accessories { margin-top: 1rem; }
  .catalogue-details__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
    margin-top: 0.65rem;
  }
  .techsheet__drawings {
    display: grid;
    gap: 0.55rem;
    padding: 0.85rem;
    border: 1px solid var(--line);
    background: var(--linen-deep);
  }
  .techsheet__drawings-label {
    margin-bottom: 0.1rem;
    color: var(--bronze-ink);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .techsheet__drawing {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    background: var(--linen);
  }
  .techsheet__drawing:hover { border-color: var(--bronze); }
  .techsheet__drawing-icon { font-size: 1.25rem; color: var(--bronze-ink); }
  .techsheet__drawing strong { display: block; font-size: 0.78rem; }
  .techsheet__drawing small { display: block; margin-top: 0.1rem; color: var(--muted); font-size: 0.7rem; }
  .techsheet__note {
    max-width: 70rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.73rem;
    line-height: 1.45;
  }
  .resources-block { margin-top: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .resources-block__head { margin-bottom: 0; }
  .pres {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 1fr;
    margin-top: clamp(1.1rem, 0.9rem + 1vw, 1.7rem);
  }
  @media (min-width: 560px) {
    .pres { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  }
  .pres__btn {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.9rem 1.1rem;
    font-family: inherit;
    text-align: left;
    text-decoration: none;
    color: var(--ink);
    background: var(--linen);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: border-color 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .pres__btn:hover { border-color: var(--bronze); background: var(--linen-deep); }
  .pres__btn:focus-visible { outline: 2px solid var(--bronze); outline-offset: 2px; }
  .pres__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-size: 0.85rem;
    color: var(--bronze-ink);
    border: 1px solid var(--bronze-soft);
    border-radius: 50%;
  }
  .pres__body { display: grid; gap: 0.15rem; min-width: 0; }
  .pres__label { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .pres__meta { font-size: 0.78rem; color: var(--muted); }
  .pres-modal {
    width: min(64rem, 94vw);
    max-height: 90vh;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--linen);
  }
  .pres-modal::backdrop { background: rgba(27, 25, 23, 0.75); }
  .pres-modal__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .pres-modal__title { margin: 0; font-size: 0.875rem; color: var(--ink); }
  .pres-modal__close {
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ink);
    background: none;
    border: 1px solid var(--line);
    cursor: pointer;
  }
  .pres-modal__close:focus-visible { outline: 2px solid var(--bronze); outline-offset: 2px; }
  .pres-modal__frame { aspect-ratio: 16 / 9; width: 100%; background: #000; }
  .pres-modal__frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }

  @media (max-width: 760px) {
    .techsheet__layout--with-drawings { grid-template-columns: 1fr; }
    .techsheet__head { align-items: flex-start; }
    .techsheet__table { min-width: 38rem; }
    .techsheet__panel { padding: 1rem; }
    .catalogue-details__top { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { track } from '../lib/track';

  document.querySelectorAll<HTMLElement>('[data-pres-open]').forEach((link) => {
    link.addEventListener('click', () => {
      const model = link.dataset.trackModel ?? '';
      track('product_resource_opened', { model, resource: link.dataset.presOpen });
    });
  });

  document.querySelectorAll<HTMLElement>('[data-resources]').forEach((root) => {
    const found = document.querySelector<HTMLDialogElement>('[data-pres-modal]');
    if (!found) return;
    const modal = found;
    const frame = modal.querySelector<HTMLElement>('[data-pres-modal-frame]')!;
    const title = modal.querySelector<HTMLElement>('[data-pres-modal-title]')!;
    const model = root.dataset.model ?? '';

    const open = (src: string, label: string, event: string, key: string) => {
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = label;
      iframe.loading = 'lazy';
      iframe.allow = 'accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.setAttribute('allowfullscreen', '');
      frame.replaceChildren(iframe);
      title.textContent = label;
      modal.showModal();
      track(event as any, { model, resource: key });
    };

    const close = () => {
      frame.replaceChildren();
      if (modal.open) modal.close();
    };

    root.querySelectorAll<HTMLElement>('[data-pres-play]').forEach((btn) => {
      btn.addEventListener('click', () =>
        open(btn.dataset.presSrc!, btn.dataset.presTitle!, 'product_video_opened', btn.dataset.presPlay!)
      );
    });
    root.querySelectorAll<HTMLElement>('[data-pres-embed]').forEach((btn) => {
      btn.addEventListener('click', () =>
        open(btn.dataset.presSrc!, btn.dataset.presTitle!, 'product_3d_opened', btn.dataset.presEmbed!)
      );
    });

    modal.querySelector('[data-pres-close]')?.addEventListener('click', close);
    modal.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  });
</script>
