---
import Figure from './Figure.astro';

interface Props {
  name: string;
  blurb: string;
  href: string;
  note?: string;
  count?: number;
  image?: string;
}
const { name, blurb, href, note, count, image } = Astro.props;
---

<a class="ccard" href={href}>
  <div class="ccard__media">
    <Figure src={image} alt={name} note={note ?? `${name} — representative collection image`} ratio="4 / 5" tone="mid" />
    <span class="ccard__slats" aria-hidden="true"></span>
  </div>
  <div class="ccard__body">
    <h3 class="ccard__name">{name}</h3>
    <p class="ccard__blurb">{blurb}</p>
    <span class="ccard__more">
      Explore <span class="ccard__arrow" aria-hidden="true">→</span>
      {typeof count === 'number' && <span class="ccard__count">{count} models</span>}
    </span>
  </div>
</a>

<style>
  .ccard {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ccard__media { position: relative; overflow: hidden; }

  .ccard__media :global(.fig) {
    transition: transform 1.1s var(--ease);
  }
  .ccard:hover .ccard__media :global(.fig),
  .ccard:focus-visible .ccard__media :global(.fig) {
    transform: scale(1.035);
  }

  /* The slat motif as a hover reveal — the cladding retracts.
     Gated behind `hover: hover` so touch devices never sit under a permanent
     overlay on the photography. Kept light so real images stay readable. */
  .ccard__slats { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .ccard__slats {
      display: block;
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(
        to bottom,
        rgba(27, 25, 23, 0.18) 0 1px,
        transparent 1px 10px
      );
      opacity: 1;
      transition: opacity 0.9s var(--ease);
      pointer-events: none;
    }
    .ccard:hover .ccard__slats,
    .ccard:focus-visible .ccard__slats { opacity: 0; }
  }

  .ccard__body { padding-top: 1.15rem; }

  .ccard__name {
    font-size: var(--t-h3);
    margin-bottom: 0.6rem;
    transition: transform 0.6s var(--ease);
  }
  .ccard:hover .ccard__name,
  .ccard:focus-visible .ccard__name { transform: translateX(4px); }

  .ccard__arrow { transition: transform 0.4s var(--ease); display: inline-block; }
  .ccard:hover .ccard__arrow,
  .ccard:focus-visible .ccard__arrow { transform: translateX(5px); }

  @media (prefers-reduced-motion: reduce) {
    .ccard__name, .ccard__arrow, .ccard__media :global(.fig) { transition: none; }
    .ccard:hover .ccard__name, .ccard:hover .ccard__arrow { transform: none; }
    .ccard:hover .ccard__media :global(.fig) { transform: none; }
  }

  .ccard__blurb {
    font-size: var(--t-small);
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1.1rem;
  }
  .band--ember .ccard__blurb { color: var(--muted-dark); }

  .ccard__more {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bronze-ink);
    padding-bottom: 0.3rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease);
  }
  .band--ember .ccard__more { color: var(--bronze-soft); }
  .ccard:hover .ccard__more { border-bottom-color: currentColor; }

  /* A bare numeral beside the label read as a stray character — "View
     collection 6". Naming the unit makes it a count. */
  .ccard__count {
    font-family: 'Manrope', var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    opacity: 0.75;
  }
</style>
