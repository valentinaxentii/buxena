---
import { categories } from '../data/site';
import { displayTitle } from '../data/catalog';
import { getCollection } from 'astro:content';
import ProjectUpload from './ProjectUpload.astro';
import { INSTALLATION_PREFERENCES } from '../lib/product-config';

interface Props {
  preselect?: string;
  compact?: boolean;
}
const { preselect, compact = false } = Astro.props;

const saunas = (await getCollection('saunas', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const offeredCategories = categories.filter((c) =>
  saunas.some((s) => s.data.category === c.id || s.data.location === c.id)
);
---

<form
  class={`qform ${compact ? 'qform--compact' : ''}`}
  name="quote"
  method="POST"
  action="/thank-you/"
>
  <p class="qform__hp">
    <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <fieldset class="qform__step" data-quote-step="capture">
    <div class="qform__grid">
      <div class="field">
        <label for="q-name">Name <span aria-hidden="true">*</span></label>
        <input id="q-name" name="name" type="text" required autocomplete="name" />
      </div>

      <div class="field">
        <label for="q-email">Email <span aria-hidden="true">*</span></label>
        <input id="q-email" name="email" type="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="q-phone">Phone</label>
        <input id="q-phone" name="phone" type="tel" autocomplete="tel" />
      </div>

      <div class="field">
        <label for="q-zip">ZIP code <span aria-hidden="true">*</span></label>
        <input id="q-zip" name="zip" type="text" inputmode="numeric" required autocomplete="postal-code" pattern="\d{5}" maxlength="5" title="Enter a valid 5-digit U.S. ZIP code." data-zip-input />
        <span class="field__hint">Delivery depends on where the sauna is going.</span>
      </div>

      <div class="field">
        <label for="q-placement">Indoor or outdoor?</label>
        <select id="q-placement" name="placement">
          <option value="">No preference yet</option>
          <option value="outdoor">Outdoor</option>
          <option value="indoor">Indoor</option>
          <option value="unsure">Not sure</option>
        </select>
      </div>

      <div class="field">
        <label for="q-model">Model, if known</label>
        <select id="q-model" name="model">
          <option value="">Undecided — please advise</option>
          {offeredCategories.map((c) => (
            <option value={c.name} selected={preselect === c.name}>{c.name}</option>
          ))}
          {saunas.length > 0 && (
            <optgroup label="Specific models">
              {saunas.map((s) => (
                <option value={s.data.title} selected={preselect === s.data.title}>{displayTitle(s.data.title)}</option>
              ))}
            </optgroup>
          )}
        </select>
      </div>

      <div class="field">
        <label for="q-timeline">Timeline</label>
        <select id="q-timeline" name="timeline">
          <option value="">Not set</option>
          <option value="asap">As soon as possible</option>
          <option value="1-3-months">1–3 months</option>
          <option value="3-6-months">3–6 months</option>
          <option value="researching">Still researching</option>
        </select>
      </div>
    </div>

    <div class="qform__foot">
      <button class="btn btn--bronze" type="submit">Get My Pricing</button>
      <p class="qform__note">We use your details to answer this enquiry. Nothing else.</p>
    </div>
  </fieldset>

  <fieldset class="qform__step qform__detail" data-quote-step="detail" hidden>
    <p class="qform__captured" data-quote-captured><strong>Your pricing request is in.</strong> Two more minutes of detail helps us quote the right system first time — or skip and we'll ask as we go.</p>
    <div class="qform__grid">
      <div class="field">
        <label for="q-capacity">People it should seat</label>
        <select id="q-capacity" name="capacity">
          <option value="">Not sure</option>
          <option value="1-2">1–2</option>
          <option value="3-4">3–4</option>
          <option value="5-6">5–6</option>
          <option value="7+">7 or more</option>
        </select>
      </div>

      <div class="field">
        <label for="q-budget">Budget range</label>
        <select id="q-budget" name="budget">
          <option value="">Prefer not to say yet</option>
          <option value="under-10k">Under $10,000</option>
          <option value="10-20k">$10,000 – $20,000</option>
          <option value="20-35k">$20,000 – $35,000</option>
          <option value="35k-plus">$35,000+</option>
        </select>
      </div>

      <div class="field">
        <label for="q-installation">Installation</label>
        <select id="q-installation" name="installation">
          <option value="">Not decided yet</option>
          {INSTALLATION_PREFERENCES.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
        <span class="field__hint">
          Tells us what to include in your quote. Nothing is committed at this stage.
        </span>
      </div>

      <div class="field">
        <label for="q-foundation">Foundation / base</label>
        <select id="q-foundation" name="foundation">
          <option value="">Not sure yet</option>
          <option value="exists">Already in place</option>
          <option value="planned">Planned</option>
          <option value="need-guidance">Need guidance</option>
        </select>
      </div>

      <div class="field">
        <label for="q-electrical">Electrical</label>
        <select id="q-electrical" name="electrical">
          <option value="">Not sure yet</option>
          <option value="available">Power available at site</option>
          <option value="planned">Electrician planned</option>
          <option value="need-guidance">Need guidance</option>
        </select>
      </div>

      <div class="field field--full">
        <label for="q-message">The space, access and anything else</label>
        <textarea id="q-message" name="message" rows="4" placeholder="Dimensions, access route, what the surroundings look like."></textarea>
      </div>

      <div class="field field--full">
        <ProjectUpload id="quote-files" label="Photos or plans (optional)" />
      </div>
    </div>

    <div class="qform__foot">
      <button class="btn btn--bronze" type="button" data-quote-details-send>Add Project Details</button>
      <button class="btn btn--ghost qform__skip" type="button" data-quote-skip>Skip for now →</button>
    </div>
  </fieldset>
</form>

<style>
  .qform__hp { position: absolute; left: -9999px; }
  .qform__step { border: none; margin: 0; padding: 0; }
  .qform__captured { font-size: var(--t-small); color: var(--muted); border-left: 3px solid var(--bronze); background: var(--linen-deep); padding: 0.9rem 1.2rem; margin: 0 0 1.5rem; }
  .qform__captured strong { color: var(--ink); font-weight: 600; }
  .qform__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--form-row-gap) 1.75rem; }
  .field { display: grid; gap: var(--form-label-gap); }.field--full { grid-column: 1 / -1; }
  .field label { font-size: var(--t-label); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink); }.field label span { color: var(--bronze-ink); font-weight: 700; }
  .field input,.field select,.field textarea { font-family: var(--font-sans); font-size: 1.0625rem; font-weight: 400; color: var(--ink); background: transparent; border: none; border-bottom: 1.5px solid var(--line); padding: 0.7rem 0; width: 100%; border-radius: 0; transition: border-color 0.4s var(--ease); }
  .field textarea { border: 1.5px solid var(--line); padding: 0.9rem 1rem; resize: vertical; line-height: 1.6; }.field select { appearance: none; cursor: pointer; }
  .field input:hover,.field select:hover,.field textarea:hover { border-color: var(--muted); }.field input:focus,.field select:focus,.field textarea:focus { border-color: var(--bronze); }
  .field__hint { font-size: 0.875rem; color: var(--muted); opacity: 1; }
  .qform__foot { margin-top: var(--form-foot-gap); display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem 2rem; }.qform__note { font-size: var(--t-small); color: var(--muted); margin: 0; }.qform__skip { color: var(--bronze-ink); letter-spacing: 0.08em; }.qform__skip:hover { color: var(--ink); }
  @media (max-width: 640px) { .qform__grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { attachProjectFiles } from '../lib/enquiry-client';
  import { INSTALLATION_PREFERENCES } from '../lib/product-config';
  import { initZipValidation } from '../lib/zip-validate';
  import { track } from '../lib/track';
  import { submitEnquiry, showFormStatus, rememberEnquiry } from '../lib/enquiry-client';

  async function sendProjectFiles(enquiryId: string | null | undefined): Promise<void> {
    if (!enquiryId) return;
    const control = document.querySelector<HTMLElement>('[data-pupload]');
    const files = ((control as any)?.buxenaFiles ?? []) as File[];
    if (!files.length) return;
    const result = await attachProjectFiles(enquiryId, files);
    if (!result.ok) console.error('[project-files] attach failed:', result.error);
  }

  const installationLabel = (value: string): string =>
    INSTALLATION_PREFERENCES.find((o) => o.value === value)?.label ?? value;

  initZipValidation();

  const urlParams = new URLSearchParams(window.location.search);
  const urlModel = urlParams.get('model');
  const urlPackage = urlParams.get('package');
  const urlMessage = urlParams.get('message');
  const isCompare = urlParams.get('intent') === 'compare';

  if (urlModel) {
    document.querySelectorAll<HTMLSelectElement>('form[name="quote"] select[name="model"]').forEach((sel) => {
      if ([...sel.options].some((o) => o.value === urlModel)) sel.value = urlModel;
    });
  }
  if (urlMessage) {
    document.querySelectorAll<HTMLTextAreaElement>('form[name="quote"] textarea[name="message"]').forEach((field) => {
      if (!field.value) field.value = urlMessage;
    });
  }

  document.querySelectorAll('form[name="quote"]').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    const captureStep = form.querySelector<HTMLElement>('[data-quote-step="capture"]')!;
    const detailStep = form.querySelector<HTMLElement>('[data-quote-step="detail"]')!;
    const captureBtn = captureStep.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const detailsBtn = form.querySelector<HTMLButtonElement>('[data-quote-details-send]')!;
    const skipBtn = form.querySelector<HTMLButtonElement>('[data-quote-skip]')!;

    const get = (key: string) => {
      const data = new FormData(form);
      return (data.get(key) || '').toString().trim();
    };

    const getLabel = (key: string) => {
      const field = form.elements.namedItem(key);
      if (field instanceof HTMLSelectElement) {
        const option = field.selectedOptions[0];
        if (option && option.value) return (option.textContent ?? '').trim() || option.value;
        return '';
      }
      return get(key);
    };

    let capturedEmail = '';
    let capturedModel = '';
    let wasDevMode = false;
    let capturedEnquiryId: string | null = null;

    form.addEventListener('focusin', () => track('quote_started', { formType: 'quote_form' }), { once: true });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const zip = get('zip');
      const projectNote = get('message');
      const extras = [
        zip && `ZIP: ${zip}`,
        get('placement') && `Placement: ${getLabel('placement')}`,
        get('timeline') && `Timeline: ${getLabel('timeline')}`,
        urlPackage && `Package interest: ${urlPackage}`,
      ].filter(Boolean).join(' · ');

      const originalLabel = captureBtn.textContent ?? '';
      captureBtn.disabled = true;
      captureBtn.textContent = 'Sending…';
      const restore = () => {
        captureBtn.disabled = false;
        captureBtn.textContent = originalLabel || 'Get My Pricing';
      };

      // The configurator and the heater calculator both prefill the hidden
      // second-step message before the buyer reaches this form. Capture that
      // data NOW with step 1 so skipping the optional details step can never
      // produce a lead that has lost the customer's chosen configuration.
      const result = await submitEnquiry({
        name: get('name'),
        email: get('email'),
        phone: get('phone'),
        location: zip,
        zip,
        message: [
          isCompare ? 'Pricing request (has another quote to compare)' : 'Pricing request',
          extras,
          projectNote && `Configuration / project note:\n${projectNote}`,
        ].filter(Boolean).join('\n\n'),
        saunaInterest: get('model'),
        source: isCompare ? 'Quote Comparison' : 'Quote Form',
        botField: get('bot-field'),
      });

      if (!result.ok) {
        console.error('[quote] capture failed:', result.error);
        restore();
        showFormStatus(form, 'error');
        return;
      }

      track('quote_submitted', {
        formType: 'quote_form',
        model: get('model'),
        zip,
        location: get('placement'),
        timeline: get('timeline'),
        ...(urlPackage ? { package: urlPackage } : {}),
      });
      track('pricing_request_submitted', { formType: 'quote_form', model: get('model'), zip });

      const leadPayload = {
        model: get('model'),
        formType: 'quote_form',
        zip,
        timeline: get('timeline'),
      };
      if (!result.devMode) track('lead_confirmed', leadPayload);

      capturedEmail = get('email');
      capturedModel = get('model');
      capturedEnquiryId = result.enquiryId ?? null;
      wasDevMode = Boolean(result.devMode);

      // The prefilled configuration/project note is already durably captured
      // above. Clear the textarea before revealing optional step 2 so sending
      // extra details does not append the same configuration twice.
      const messageField = form.querySelector<HTMLTextAreaElement>('[name="message"]');
      if (messageField) messageField.value = '';

      restore();
      form.querySelector('.form-status')?.remove();
      captureStep.hidden = true;
      detailStep.hidden = false;
      if (wasDevMode) showFormStatus(form, 'dev-success');
      detailStep.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    const finish = () => {
      rememberEnquiry({ request: 'Pricing request', model: capturedModel, zip: get('zip'), timeline: get('timeline'), projectType: get('placement'), conversionTracked: 'true' });
      if (!wasDevMode) window.location.assign('/thank-you/');
    };

    detailsBtn.addEventListener('click', async () => {
      const details = [
        `FOLLOW-UP PROJECT DETAILS (${capturedEmail})`,
        get('capacity') && `People: ${getLabel('capacity')}`,
        get('budget') && `Budget: ${getLabel('budget')}`,
        get('installation') && `Installation: ${installationLabel(get('installation'))}`,
        get('foundation') && `Foundation: ${getLabel('foundation')}`,
        get('electrical') && `Electrical: ${getLabel('electrical')}`,
        get('message') && `Space/access: ${get('message')}`,
        get('uploadMeta'),
      ].filter(Boolean).join('\n');

      const originalLabel = detailsBtn.textContent ?? '';
      detailsBtn.disabled = true;
      detailsBtn.textContent = 'Sending…';

      const result = await submitEnquiry({
        name: get('name'),
        email: capturedEmail,
        phone: get('phone'),
        location: get('zip'),
        zip: get('zip'),
        message: details,
        saunaInterest: capturedModel,
        source: 'Quote Form — details',
        botField: get('bot-field'),
        appendToEnquiryId: capturedEnquiryId,
      });

      detailsBtn.disabled = false;
      detailsBtn.textContent = originalLabel || 'Add Project Details';

      await sendProjectFiles(result.enquiryId);
      if (!result.ok) {
        showFormStatus(form, 'error');
        return;
      }
      if (result.devMode) {
        showFormStatus(form, 'dev-success', 'Follow-up details captured too.');
        return;
      }
      finish();
    });

    skipBtn.addEventListener('click', finish);
  });
</script>
