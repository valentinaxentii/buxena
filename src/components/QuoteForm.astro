---
import { categories } from '../data/site';
import { getCollection } from 'astro:content';

interface Props {
  /** Pre-selects a model when the form is embedded on a product page. */
  preselect?: string;
  compact?: boolean;
}
const { preselect, compact = false } = Astro.props;

const saunas = (await getCollection('saunas', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<!--
  Submits through /api/enquiries (the same endpoint the Sauna Advisor uses),
  which records the enquiry to Supabase (visible in /admin/enquiries) and emails
  info@buxena.com. The script below intercepts submit, POSTs the JSON, then
  redirects to /thank-you/. `bot-field` is an invisible honeypot the server
  checks to drop spam.
-->
<form
  class={`qform ${compact ? 'qform--compact' : ''}`}
  name="quote"
  method="POST"
  action="/thank-you/"
>
  <p class="qform__hp">
    <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="qform__grid">
    <div class="field">
      <label for="q-name">Name <span aria-hidden="true">*</span></label>
      <input id="q-name" name="name" type="text" required autocomplete="name" />
    </div>

    <div class="field">
      <label for="q-email">Email <span aria-hidden="true">*</span></label>
      <input id="q-email" name="email" type="email" required autocomplete="email" />
    </div>

    <div class="field">
      <label for="q-phone">Phone</label>
      <input id="q-phone" name="phone" type="tel" autocomplete="tel" />
    </div>

    <div class="field">
      <label for="q-zip">ZIP code <span aria-hidden="true">*</span></label>
      <input id="q-zip" name="zip" type="text" inputmode="numeric" required autocomplete="postal-code" />
      <span class="field__hint">Delivery cost depends on where the sauna is going.</span>
    </div>

    <div class="field">
      <label for="q-placement">Placement</label>
      <select id="q-placement" name="placement">
        <option value="">No preference yet</option>
        <option value="outdoor">Outdoor</option>
        <option value="indoor">Indoor</option>
        <option value="unsure">Not sure</option>
      </select>
    </div>

    <div class="field">
      <label for="q-model">Model or collection of interest</label>
      <select id="q-model" name="model">
        <option value="">Undecided — please advise</option>
        {categories.map((c) => (
          <option value={c.name} selected={preselect === c.name}>{c.name}</option>
        ))}
        {saunas.length > 0 && (
          <optgroup label="Specific models">
            {saunas.map((s) => (
              <option value={s.data.title} selected={preselect === s.data.title}>{s.data.title}</option>
            ))}
          </optgroup>
        )}
      </select>
    </div>

    <div class="field">
      <label for="q-people">People it should seat</label>
      <select id="q-people" name="capacity">
        <option value="">Not sure</option>
        <option value="1-2">1–2</option>
        <option value="3-4">3–4</option>
        <option value="5-6">5–6</option>
        <option value="7+">7 or more</option>
      </select>
    </div>

    <div class="field">
      <label for="q-timeline">Timeline</label>
      <select id="q-timeline" name="timeline">
        <option value="">Not set</option>
        <option value="asap">As soon as possible</option>
        <option value="1-3-months">1–3 months</option>
        <option value="3-6-months">3–6 months</option>
        <option value="researching">Still researching</option>
      </select>
    </div>

    <div class="field field--full">
      <label for="q-message">Tell us about the space</label>
      <textarea id="q-message" name="message" rows="5" placeholder="Dimensions, access, what the surroundings look like, anything you already know you want."></textarea>
    </div>
  </div>

  <div class="qform__foot">
    <button class="btn btn--bronze" type="submit">Send request</button>
    <p class="qform__note">
      We use your details to answer this enquiry. Nothing else.
    </p>
  </div>
</form>

<style>
  .qform__hp { position: absolute; left: -9999px; }

  .qform__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 1.75rem;
  }

  .field { display: grid; gap: 0.55rem; }
  .field--full { grid-column: 1 / -1; }

  .field label {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .field label span { color: var(--bronze-ink); font-weight: 700; }

  .field input,
  .field select,
  .field textarea {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 400;
    color: var(--ink);
    background: transparent;
    border: none;
    border-bottom: 1.5px solid var(--line);
    padding: 0.7rem 0;
    width: 100%;
    border-radius: 0;
    transition: border-color 0.4s var(--ease);
  }
  .field textarea {
    border: 1.5px solid var(--line);
    padding: 0.9rem 1rem;
    resize: vertical;
    line-height: 1.6;
  }
  .field select { appearance: none; cursor: pointer; }

  .field input:hover,
  .field select:hover,
  .field textarea:hover { border-color: var(--muted); }
  .field input:focus,
  .field select:focus,
  .field textarea:focus { border-color: var(--bronze); }

  .field__hint { font-size: 0.875rem; color: var(--muted); opacity: 1; }

  .qform__foot {
    margin-top: 1.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  .qform__note { font-size: var(--t-small); color: var(--muted); margin: 0; }

  @media (max-width: 640px) {
    .qform__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  /**
   * The single submission path: intercept submit, POST the enquiry as JSON to
   * /api/enquiries (records to Supabase + emails info@buxena.com), then send the
   * visitor to /thank-you/. The await matters — we only redirect once the server
   * has accepted the enquiry, so a failed request keeps the visitor on the form
   * with their data intact rather than silently losing it.
   */
  document.querySelectorAll('form[name="quote"]').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      // Let the browser enforce required fields / email format first.
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const get = (key: string) => (data.get(key) || '').toString().trim();

      const zip = get('zip');
      const extras = [
        zip && `ZIP: ${zip}`,
        get('placement') && `Placement: ${get('placement')}`,
        get('capacity') && `People: ${get('capacity')}`,
        get('timeline') && `Timeline: ${get('timeline')}`,
      ]
        .filter(Boolean)
        .join(' · ');
      const message = [get('message'), extras].filter(Boolean).join('\n\n');

      const originalLabel = submitBtn?.textContent ?? '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }

      try {
        const res = await fetch('/api/enquiries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: get('name'),
            email: get('email'),
            phone: get('phone'),
            location: zip,
            message,
            saunaInterest: get('model'),
            source: 'Quote Form',
            botField: get('bot-field'),
          }),
        });

        if (!res.ok) throw new Error(`Request failed (${res.status})`);
        window.location.assign('/thank-you/');
      } catch (err) {
        console.error('[quote] submission failed:', err);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel || 'Send request';
        }
        alert(
          'Sorry — something went wrong sending your request. Please try again, or email info@buxena.com directly.'
        );
      }
    });
  });
</script>
