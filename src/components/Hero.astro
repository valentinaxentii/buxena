---
import fs from 'node:fs';
import Figure from './Figure.astro';

// Video takes priority over the still photograph. Drop files in
// public/media/hero.mp4 and/or public/images/hero.jpg — no further
// code changes needed.
const hasVideo = fs.existsSync(new URL('../../public/media/hero.mp4', import.meta.url));
const hasImage = fs.existsSync(new URL('../../public/images/hero.jpg', import.meta.url));
---

<section class="hero">
  <div class="hero__media" aria-hidden="false">
    {hasVideo ? (
      <video
        class="hero__video"
        src="/media/hero.mp4"
        poster={hasImage ? '/images/hero.jpg' : undefined}
        autoplay
        muted
        loop
        playsinline
      />
    ) : (
      <Figure
        src={hasImage ? '/images/hero.jpg' : undefined}
        alt="A modern sauna at dusk, warm light spilling from a panoramic window"
        note="HERO — cinematic wide shot: contemporary cube sauna at blue hour, warm interior light through full-height glazing, natural landscape beyond. Shot horizontally, generous headroom for the wordmark."
        ratio="16 / 9"
        tone="dark"
        priority={true}
      />
    )}
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__content">
    <div class="shell">
      <h1 class="hero__headline">Your Sauna.<br class="hero__break" /> Your Space.<br class="hero__break" /> Your Ritual.</h1>
      <p class="hero__lede">
        European sauna design, selected for the American home.
      </p>
      <div class="hero__actions">
        <a class="btn btn--bronze" href="/saunas/">Explore Saunas</a>
        <a class="btn btn--outline" href="/quote/">Request a Quote</a>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#intro" aria-label="Scroll to introduction">
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(34rem, 92svh, 56rem);
    display: grid;
    align-items: end;
    background: var(--ember);
    color: var(--linen);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; }
  .hero__media :global(.fig) { width: 100%; height: 100%; aspect-ratio: auto; }
  .hero__video { display: block; width: 100%; height: 100%; object-fit: cover; }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(20, 18, 16, 0.88) 0%,
      rgba(20, 18, 16, 0.55) 42%,
      rgba(20, 18, 16, 0.35) 100%
    );
  }

  .hero__content {
    position: relative;
    width: 100%;
    padding-block: clamp(6rem, 4rem + 9vw, 9rem) clamp(4rem, 2.5rem + 5vw, 7rem);
  }

  .hero__content .shell {
    max-width: none;
    margin-inline: 0;
    padding-left: clamp(1.25rem, 7.5vw, 6rem);
    padding-right: var(--gutter);
  }

  .hero__headline {
    max-width: 16ch;
    font-size: clamp(1.8rem, 1.2rem + 2.72vw, 3.6rem);
    line-height: 1.02;
    color: var(--linen);
    animation: rise 1.4s var(--ease) 0.15s both;
  }

  /* force one phrase per line once there is room; on narrow screens the
     headline just wraps naturally, same as before */
  .hero__break { display: none; }
  @media (min-width: 701px) {
    .hero__break { display: block; content: ''; }
  }

  .hero__lede {
    max-width: 28em;
    margin: clamp(1.1rem, 0.8rem + 1vw, 1.7rem) 0 0;
    color: rgba(246, 242, 234, 0.9);
    font-size: clamp(0.98rem, 0.9rem + 0.425vw, 1.17rem);
    line-height: 1.45;
    font-weight: 400;
    animation: rise 1.4s var(--ease) 0.35s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.7rem, 1.2rem + 1.5vw, 2.5rem);
    animation: rise 1.4s var(--ease) 0.55s both;
  }
  .hero__actions .btn { padding: 0.87rem 1.73rem; font-size: 0.78rem; }
  .hero__actions .btn--outline { color: var(--linen); }

  .hero__scroll {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 4.5rem;
    width: 3rem;
    display: grid;
    place-items: end center;
  }
  .hero__scroll-line {
    width: 1px;
    height: 3.25rem;
    background: linear-gradient(to bottom, transparent, var(--bronze-soft));
    animation: drop 2.6s var(--ease) infinite;
    transform-origin: bottom;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes drop {
    0%, 100% { transform: scaleY(0.35); opacity: 0.35; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__headline, .hero__lede, .hero__actions, .hero__scroll-line {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 700px) {
    .hero__scroll { display: none; }
    .hero__actions .btn { flex: 1 1 auto; justify-content: center; }

    /* Desktop's min-height (92svh) makes the hero nearly full-screen. The
       video/image fills that full box via object-fit:cover regardless of
       height, so a taller box just shows proportionally more of the video's
       dark upper-sky framing before the lit sauna cabin appears — reading as
       empty black space above the "real" image. Shortening the box on mobile
       only crops tighter toward the video's already-existing lower framing;
       nothing about the video/image itself, the logo, or the header changes. */
    .hero { min-height: clamp(28rem, 70svh, 42rem); }
  }
</style>
