---
/**
 * Reusable multi-facet filter bar for sauna catalog pages.
 * Each facet is single-select (click a chip, or "All" to clear that facet).
 * Filtering itself happens client-side against data-* attributes rendered
 * on ProductCard — see the script below.
 */
interface FacetOption {
  value: string;
  label: string;
}
interface Facet {
  key: 'location' | 'type' | 'series' | 'capacity' | 'material';
  label: string;
  options: FacetOption[];
}
interface Props {
  facets: Facet[];
}
const { facets } = Astro.props;
---

<div class="pfilters" data-filters>
  <button class="pfilters__trigger" type="button" data-filter-open>
    Filter
    <span class="pfilters__count" data-filter-count hidden></span>
  </button>

  {/* Below 900px this panel becomes a full-screen overlay, so it carries
      dialog semantics. On desktop it is inline content and the role is
      harmless — the script only applies focus trapping while it overlays. */}
  <div class="pfilters__panel" data-filter-panel role="dialog" aria-modal="true" aria-label="Filter saunas" tabindex="-1">
    <div class="pfilters__head">
      <span class="pfilters__title">Filter saunas</span>
      <button class="pfilters__close" type="button" data-filter-close aria-label="Close filters">
        <span aria-hidden="true">Close</span>
      </button>
    </div>

    <div class="pfilters__groups">
      {facets.map((facet) => (
        <div class="pfilters__group" data-facet-group={facet.key}>
          <span class="pfilters__label">{facet.label}</span>
          <div class="pfilters__chips">
            <button class="chip is-on" type="button" data-facet={facet.key} data-value="" aria-pressed="true">
              All
            </button>
            {facet.options.map((opt) => (
              <button class="chip" type="button" data-facet={facet.key} data-value={opt.value} aria-pressed="false">
                {opt.label}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <button class="pfilters__apply btn btn--bronze" type="button" data-filter-apply>Show results</button>
  </div>

  <div class="pfilters__scrim" data-filter-scrim hidden></div>
</div>

<style>
  /* Tightened 2026-08-14 — shared across all 5 catalogue pages that use this
     component, so this is a genuine cross-page consistency improvement, not
     a one-off override. */
  .pfilters { position: relative; margin-bottom: clamp(0.9rem, 0.5rem + 1vw, 1.5rem); }

  .pfilters__trigger {
    display: none;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 1px solid var(--line);
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .pfilters__count {
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding: 0 0.35rem;
    background: var(--ember);
    color: var(--linen);
    font-size: 0.75rem;
    font-family: var(--font-display);
  }

  .pfilters__groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pfilters__group { display: grid; gap: 0.5rem; }

  .pfilters__label {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pfilters__chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    background: none;
    border: 1px solid var(--line);
    padding: 0.6rem 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color 0.35s var(--ease), color 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .chip:hover { border-color: var(--ink); }
  .chip.is-on { background: var(--ember); color: var(--linen); border-color: var(--ember); }

  .pfilters__apply { display: none; width: 100%; justify-content: center; margin-top: 1.5rem; }

  .pfilters__head, .pfilters__close { display: none; }
  .pfilters__scrim[hidden] { display: none; }

  @media (max-width: 900px) {
    .pfilters__trigger { display: inline-flex; }

    .pfilters__panel {
      position: fixed;
      inset: 0 0 0 auto;
      z-index: 200;
      width: min(24rem, 88vw);
      background: var(--linen);
      padding: 1.5rem var(--gutter) 2rem;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.4s var(--ease);
    }
    .pfilters.is-open .pfilters__panel { transform: translateX(0); }

    .pfilters__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--line);
    }
    .pfilters__title { font-family: var(--font-display); font-size: 1.4rem; }
    .pfilters__close {
      display: inline-flex;
      align-items: center;
      /* 25px tall before — the drawer's only dismiss control, at half a thumb.
         Padding, not font-size: the label stays quiet, the hit area doesn't. */
      min-height: 2.75rem;
      padding: 0.5rem 0.75rem;
      margin: -0.5rem -0.75rem;
      background: none;
      border: none;
      cursor: pointer;
      font-size: var(--t-small);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .pfilters__apply { display: flex; }

    .pfilters__scrim {
      position: fixed;
      inset: 0;
      z-index: 190;
      background: rgba(27, 25, 23, 0.5);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  if (root) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-filter-open]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-filter-close]');
    const applyBtn = root.querySelector<HTMLButtonElement>('[data-filter-apply]');
    const scrim = root.querySelector<HTMLElement>('[data-filter-scrim]');
    const countEl = root.querySelector<HTMLElement>('[data-filter-count]');
    const chips = root.querySelectorAll<HTMLButtonElement>('.chip');

    const grid = document.querySelector<HTMLElement>('[data-product-grid]');
    const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.pcard')) : [];
    const emptyEl = document.querySelector<HTMLElement>('[data-empty]');

    const active: Record<string, string> = {};

    /**
     * The mobile panel is a full-screen overlay, so it needs the same
     * keyboard contract as any dialog: Escape closes it, focus moves inside
     * on open, and focus returns to the trigger on close. Without that a
     * keyboard or screen-reader user can open the filters and be stranded.
     */
    const panel = root.querySelector<HTMLElement>('[data-filter-panel]');
    const isOverlay = () => window.matchMedia('(max-width: 900px)').matches;

    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      if (scrim) scrim.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      trigger?.setAttribute('aria-expanded', String(open));
      if (!isOverlay()) return;
      if (open) (closeBtn ?? panel)?.focus?.();
      else trigger?.focus();
    };

    trigger?.setAttribute('aria-expanded', 'false');
    trigger?.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    applyBtn?.addEventListener('click', () => setOpen(false));
    scrim?.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) setOpen(false);
    });

    // Keep focus inside the panel while it is an overlay.
    panel?.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !root.classList.contains('is-open') || !isOverlay()) return;
      const focusable = panel.querySelectorAll<HTMLElement>(
        'button:not([disabled]), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    const applyFilters = () => {
      let shown = 0;
      cards.forEach((card) => {
        const match = Object.entries(active).every(([facet, value]) => {
          if (!value) return true;
          const tokens = (card.dataset[facet] ?? '').split(' ').filter(Boolean);
          return tokens.includes(value);
        });
        card.hidden = !match;
        if (match) shown++;
      });
      if (emptyEl) emptyEl.hidden = shown > 0;

      const activeCount = Object.values(active).filter(Boolean).length;
      if (countEl) {
        countEl.hidden = activeCount === 0;
        countEl.textContent = String(activeCount);
      }
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const facet = chip.dataset.facet!;
        const value = chip.dataset.value ?? '';
        active[facet] = value;

        root.querySelectorAll<HTMLButtonElement>(`[data-facet="${facet}"]`).forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });

        applyFilters();
      });
    });

    // "Reset Filters" (e.g. in the no-results state): every group back to
    // All, grid restored. Lives outside the component's own markup so the
    // page can place it beside its empty message.
    document.querySelectorAll<HTMLButtonElement>('[data-filter-reset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        Object.keys(active).forEach((k) => { active[k] = ''; });
        chips.forEach((c) => {
          const on = (c.dataset.value ?? '') === '';
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        applyFilters();
      });
    });
  }
</script>
