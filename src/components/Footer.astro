---
import { site, nav, publicEmail } from '../data/site';
import { getCollection } from 'astro:content';

const models = await getCollection('saunas', ({ data }) => !data.draft);
const hasOutdoor = models.some((m) => m.data.location === 'outdoor');
const hasIndoor = models.some((m) => m.data.location === 'indoor');
const hasBarrel = models.some((m) => m.data.productType === 'Barrel');
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="shell">
    <div class="ftr__top">
      <div class="ftr__brand">
        <img
          class="ftr__logo"
          src="/brand/buxena-logo.png"
          alt={`${site.name} — ${site.tagline}`}
          width="1536"
          height="1024"
        />
      </div>

      <div class="ftr__cols">
        <div>
          <h2 class="ftr__h">Saunas</h2>
          <ul>
            {hasOutdoor && <li><a href="/saunas/outdoor-saunas/">Outdoor Saunas</a></li>}
            {hasBarrel && <li><a href="/saunas/barrel-saunas/">Barrel Saunas</a></li>}
            {hasIndoor && <li><a href="/saunas/indoor-saunas/">Indoor Saunas</a></li>}
            <li><a href="/saunas/">All Saunas</a></li>
          </ul>
        </div>

        <div>
          <h2 class="ftr__h">Explore</h2>
          <ul>
            {nav.map((n) => (
              <li><a href={n.href}>{n.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="ftr__h">Enquiries</h2>
          <ul>
            {publicEmail && <li><a href={`mailto:${publicEmail}`}>{publicEmail}</a></li>}
            {site.phone && <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></li>}
            {site.city && <li><span class="ftr__plain">{site.city}</span></li>}
            <li><a href="/quote/">Request a Quote</a></li>
            <li><span class="ftr__plain">Serving the United States</span></li>
          </ul>

          <h2 class="ftr__h ftr__h--social">Follow</h2>
          <ul class="ftr__social">
            <li>
              {/* TODO: replace "#" with the real BUXENA Facebook URL */}
              <a href="#" aria-label="BUXENA on Facebook">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <circle cx="12" cy="12" r="9.3" />
                  <text x="12" y="16" text-anchor="middle" font-size="10" font-family="sans-serif" fill="currentColor" stroke="none">f</text>
                </svg>
                <span>Facebook</span>
              </a>
            </li>
            <li>
              <a href="https://www.instagram.com/buxenasaunas/" target="_blank" rel="noopener noreferrer" aria-label="BUXENA on Instagram">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                </svg>
                <span>Instagram</span>
              </a>
            </li>
            <li>
              {/* TODO: replace "#" with the real BUXENA LinkedIn URL */}
              <a href="#" aria-label="BUXENA on LinkedIn">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="3" />
                  <text x="12" y="16.5" text-anchor="middle" font-size="9" font-family="sans-serif" fill="currentColor" stroke="none">in</text>
                </svg>
                <span>LinkedIn</span>
              </a>
            </li>
            <li>
              {/* TODO: replace "#" with the real BUXENA YouTube URL */}
              <a href="#" aria-label="BUXENA on YouTube">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <rect x="2.5" y="5.5" width="19" height="13" rx="3.5" />
                  <path d="M10.3 9.3v5.4l4.7-2.7-4.7-2.7Z" fill="currentColor" stroke="none" />
                </svg>
                <span>YouTube</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="ftr__rule slats--rule" aria-hidden="true"></div>

    <div class="ftr__base">
      <p>© <a class="ftr__staff" href="/login" rel="nofollow" aria-label="Staff sign in">{year}</a> {site.name}. All rights reserved.</p>
      <ul class="ftr__legal">
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/shipping/">Shipping &amp; Delivery</a></li>
        <li><a href="/returns/">Returns</a></li>
        <li><a href="/warranty/">Warranty</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--ember);
    color: var(--muted-dark);
    padding-block: clamp(2.6rem, 1.5rem + 3.75vw, 4.5rem) 1.5rem;
    font-size: var(--t-small);
  }

  .ftr__top {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.6fr);
    gap: clamp(1.9rem, 0.75rem + 3.75vw, 4.5rem);
    margin-bottom: clamp(1.9rem, 1.1rem + 2.25vw, 3.4rem);
  }

  .ftr__logo {
    display: block;
    width: clamp(11rem, 9.5rem + 6vw, 15rem);
    height: auto;
    margin-bottom: 1.6rem;
  }


  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.1rem, 0.45rem + 1.95vw, 2.25rem);
  }

  .ftr__h {
    font-family: var(--font-sans);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bronze-soft);
    margin: 0 0 1.4rem;
  }

  /* Footer links sat 22px tall with 11px between them — legible, but a tight
     target on a phone. The padding grows each link's hit area to ~35px while
     the reduced margin keeps the column's visual rhythm close to before. */
  .ftr__cols li + li { margin-top: 0.25rem; }
  .ftr__cols a { display: inline-block; padding-block: 0.4rem; }

  .ftr a {
    text-decoration: none;
    color: var(--muted-dark);
    transition: color 0.35s var(--ease);
  }
  .ftr a:hover { color: var(--linen); }
  .ftr__plain { color: var(--muted-dark); opacity: 0.75; }

  .ftr__h--social { margin-top: 1.4rem; }

  .ftr__social { display: grid; }
  .ftr__social li + li { margin-top: 0.4rem; }
  .ftr__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted-dark);
  }
  .ftr__social svg { flex: 0 0 auto; color: inherit; }
  .ftr__social a:hover { color: var(--bronze-soft); }
  .ftr__social a span { font-size: 0.8125rem; }

  .ftr__rule { color: var(--bronze-soft); margin-bottom: 1.1rem; }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: center;
    font-size: var(--t-small);
  }
  .ftr__base p { margin: 0; }

  /* The year is the staff entrance to /admin. There is no public link to the
     login: a visible "Admin" in a consumer footer reads as unfinished and
     invites drive-by attempts, and the route is already kept out of the
     sitemap. At rest it is indistinguishable from the text around it — same
     colour, no underline — so a customer reading the footer sees a copyright
     line and nothing else.
     Hover is the exception: it warms to bronze and shows a pointer, purely so
     staff get confirmation they are on the right two words. Nobody hovers a
     copyright notice by accident, and if they do, they find a login page that
     asks for credentials. It keeps an accessible name for screen readers and
     the global :focus-visible ring still finds it on keyboard. */
  .ftr__staff {
    color: inherit;
    text-decoration: none;
    cursor: inherit;
    transition: color 0.3s var(--ease);
  }
  .ftr__staff:hover {
    color: var(--bronze-soft);
    cursor: pointer;
  }
  .ftr__legal {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 0.5625rem;
    margin: 0;
    padding: 0;
    /* Was 11px — legible on a desktop monitor, a squint on a phone. These are
       the links people reach for when they want the returns or privacy terms
       before spending five figures, so they get a readable size and a real
       hit area rather than legal-microcopy treatment. */
    font-size: 0.875rem;
    line-height: 1.2;
  }
  .ftr__legal a { display: inline-block; padding-block: 0.35rem; }
  .ftr__legal li:not(:first-child) { display: flex; align-items: center; gap: 0.5625rem; }
  .ftr__legal li:not(:first-child)::before {
    content: '|';
    opacity: 0.35;
  }

  @media (max-width: 860px) {
    .ftr__top { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .ftr__cols { grid-template-columns: 1fr; gap: 2.25rem; }
  }
</style>
