---
import { site, nav, publicEmail } from '../data/site';
import { getCollection } from 'astro:content';

const models = await getCollection('saunas', ({ data }) => !data.draft);
const hasOutdoor = models.some((m) => m.data.location === 'outdoor');
const hasIndoor = models.some((m) => m.data.location === 'indoor');
const hasBarrel = models.some((m) => m.data.productType === 'Barrel');
const hasCube = models.some((m) => m.data.productType === 'Cube');
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="shell">
    <div class="ftr__top">
      <div class="ftr__brand">
        <img
          class="ftr__logo"
          src="/brand/buxena-logo.png"
          alt={`${site.name} — ${site.tagline}`}
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="ftr__cols">
        <div>
          <h2 class="ftr__h">Saunas</h2>
          <ul>
            {hasOutdoor && <li><a href="/saunas/outdoor-saunas/">Outdoor Saunas</a></li>}
            {hasCube && <li><a href="/saunas/cube-saunas/">Cube Saunas</a></li>}
            {hasBarrel && <li><a href="/saunas/barrel-saunas/">Barrel Saunas</a></li>}
            {hasIndoor && <li><a href="/saunas/indoor-saunas/">Indoor Saunas</a></li>}
            <li><a href="/saunas/">All Saunas</a></li>
          </ul>
        </div>

        <div>
          <h2 class="ftr__h">Explore</h2>
          <ul>
            {nav.map((n) => (
              <li><a href={n.href}>{n.label}</a></li>
            ))}
            <li><a href="/how-buying-works/">How Buying Works</a></li>
            <li><a href="/heater-guide/">Heater Guide</a></li>
            <li><a href="/faq/">FAQ</a></li>
            <li><a href="/our-story/">Our Story</a></li>
            <li><a href="/wellness/">Wellness</a></li>
          </ul>
        </div>

        <div>
          <h2 class="ftr__h">Enquiries</h2>
          <ul>
            {publicEmail && <li><a href={`mailto:${publicEmail}`}>{publicEmail}</a></li>}
            {site.phone && <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></li>}
            {site.city && <li><span class="ftr__plain">{site.city}</span></li>}
            <li>
              <a
                href="/quote/"
                data-track="footer_pricing_click"
                data-track-form-type="footer"
              >Request Pricing</a>
            </li>
            <li><a href="/consultation/">Book a Consultation</a></li>
            <li><a href="/compare/">Compare Saunas</a></li>
            <li><a href="/my-project/">My BUXENA Project</a></li>
            <li><span class="ftr__plain">Serving the United States</span></li>
          </ul>

          <h2 class="ftr__h ftr__h--social">Follow</h2>
          <ul class="ftr__social">
            {/* Only confirmed, live BUXENA accounts are shown. Facebook,
                LinkedIn and YouTube had placeholder "#" links — hidden per
                the founders' instruction (2026-08-10) until real account
                URLs are confirmed. Restore an entry only with its verified
                official URL. */}
            <li>
              <a
                href="https://www.instagram.com/buxenasaunas/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="BUXENA on Instagram"
                data-track="social_click"
                data-track-network="instagram"
              >
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                </svg>
                <span>Instagram</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="ftr__rule slats--rule" aria-hidden="true"></div>

    <div class="ftr__base">
      <p>© <a class="ftr__staff" href="/login" rel="nofollow" aria-label="Staff sign in">{year}</a> {site.name}. All rights reserved.</p>
      <ul class="ftr__legal">
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/shipping/">Shipping &amp; Delivery</a></li>
        <li><a href="/returns/">Returns</a></li>
        <li><a href="/warranty/">Warranty</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--ember);
    color: var(--muted-dark);
    padding-block: var(--footer-pad) 1.19rem;
    font-size: var(--t-small);
  }

  .ftr__top {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.6fr);
    gap: var(--footer-col-gap);
    margin-bottom: var(--footer-row-gap);
  }

  .ftr__logo {
    display: block;
    width: clamp(11rem, 9.5rem + 6vw, 15rem);
    height: auto;
    margin-bottom: 1.26rem;
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.1rem, 0.45rem + 1.95vw, 2.25rem);
  }

  .ftr__h {
    font-family: var(--font-sans);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--linen);
    margin-bottom: 1rem;
  }
  .ftr__h--social { margin-top: 1.4rem; }
  .ftr ul { list-style: none; padding: 0; margin: 0; }
  .ftr li + li { margin-top: 0.45rem; }
  .ftr a { color: inherit; text-decoration: none; transition: color 0.25s var(--ease); }
  .ftr a:hover { color: var(--linen); }
  .ftr__plain { color: inherit; }

  .ftr__social a { display: inline-flex; align-items: center; gap: 0.5rem; }
  .ftr__social svg { flex: 0 0 auto; }

  .ftr__rule {
    margin-block: var(--footer-row-gap) 1.19rem;
    opacity: 0.42;
  }

  .ftr__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    font-size: 0.75rem;
  }
  .ftr__base p { margin: 0; }
  .ftr__legal { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; }
  .ftr__legal li + li { margin-top: 0; }

  .ftr__staff { text-decoration: none; color: inherit; }

  @media (max-width: 900px) {
    .ftr__top { grid-template-columns: 1fr; }
    .ftr__cols { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .ftr__cols { grid-template-columns: 1fr 1fr; }
    .ftr__cols > :last-child { grid-column: 1 / -1; }
    .ftr__base { align-items: flex-start; flex-direction: column; }
  }
</style>
