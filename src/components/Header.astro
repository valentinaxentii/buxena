---
import { nav, site } from '../data/site';

interface Props { overHero?: boolean; }
const { overHero = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class={`hdr ${overHero ? 'hdr--over' : ''}`} data-header>
  <div class="hdr__inner">
    <a class="wordmark" href="/" aria-label={`${site.name} home`}>
      {/* Solid-header logo: the approved artwork rendered through a CSS
          mask so it takes the exact CTA brown (--bronze-btn) — one primary
          brand color across logo and button, artwork untouched. */}
      <span class="wordmark__logo wordmark__logo--dark wordmark__mark" aria-hidden="true"></span>
      <img
        class="wordmark__logo wordmark__logo--light"
        src="/brand/buxena-logo-champagne-header.png"
        alt=""
        width="1219"
        height="660"
      />
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__end">
      <a class="btn hdr__cta" href="/quote/">Request Pricing</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span class="sr-only">Open menu</span>
        <span class="burger__bar" aria-hidden="true"></span>
        <span class="burger__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="mobile-nav" hidden data-drawer>
  <nav aria-label="Mobile">
    <ul>
      {nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
  <a class="btn btn--bronze drawer__cta" href="/quote/">Request Pricing</a>
</div>

<style>
  /* DARK LUXURY HEADER, 2026-08-14 — founder-approved treatment, applied
     everywhere (every page, not just over the homepage hero).

     Deliberately built from the SAME tokens the footer already uses —
     --ember for the ground, --bronze-soft for the gold accent, --linen for
     the ivory text — rather than new colors of a similar shade. That is what
     makes it read as "the same dark luxury language as the footer" instead
     of merely "also dark": it is the identical palette, top and bottom of
     every page.

     This UNIFIES what used to be three different visual states (solid light
     header on every non-hero page; transparent-over-video on the homepage
     hero; solid light again once scrolled) into ONE dark appearance with only
     a transparency difference while sitting over the hero video. See the
     .hdr--over rules below for how that consolidation plays out — several
     per-state overrides (logo swap, CTA color, .hdr--over.is-stuck's colors)
     became redundant once every state used the same palette, and were
     removed rather than left as dead weight. */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    /* Quiet entrance on first paint — settled before the hero headline
       arrives, so the eye lands top-down in order. */
    animation: hdr-in 0.8s var(--ease) both;
    background: var(--ember);
    color: var(--linen);
    /* Same construction as the old light-header hairline (a 26% tint mixed
       into the ground), recomputed for the dark ground: a whisper of warm
       gold rather than a hard line. No shadow — the line alone separates the
       bar from the page. */
    border-bottom: 1px solid color-mix(in srgb, var(--bronze-soft) 26%, var(--ember));
    transition: background-color 0.5s var(--ease), border-color 0.5s var(--ease),
      color 0.5s var(--ease);
  }

  /* transparent over the hero video, until scrolled — the one state that
     still differs, because the video itself needs to show through. Text is
     already --linen from the base .hdr rule above, so nothing needs
     restating here for legibility; only the ground and the hairline go
     transparent. */
  .hdr--over {
    position: fixed;
    inset-inline: 0;
    background: transparent;
    border-bottom-color: transparent;
  }
  /* REAL BUG, fixed 2026-08-14: this rule used to declare nothing — the
     comment argued colors would "fall through" to the dark base .hdr rule.
     They do not. `.hdr` and `.hdr--over` carry EQUAL specificity (0,1,0),
     `.hdr--over` is declared AFTER `.hdr` in this file, and CSS breaks a
     specificity tie by source order — so `.hdr--over`'s `background:
     transparent` kept winning even with `.is-stuck` also applied. Confirmed
     live: a scrolled homepage reported `background-color: rgba(0,0,0,0)` on
     the header, i.e. fully transparent, with light page content showing
     straight through behind ivory nav text — unreadable, and exactly the
     "header becomes too light over light content" the founder reported.
     Fixed by EXPLICITLY restating the dark ground here rather than trusting
     fallthrough a second time. */
  .hdr--over.is-stuck {
    background: var(--ember);
    border-bottom-color: color-mix(in srgb, var(--bronze-soft) 26%, var(--ember));
    /* Short, not instant: "smooth transition, no flashing" was explicit, but
       a slow fade lets page content visibly scroll through the header while
       it's still partway transparent, which reads as its own glitch. 180ms
       is fast enough that bleed-through is imperceptible while still being a
       real transition rather than a hard snap — applies only to the moment
       .is-stuck is ADDED; removing it (scrolling back up to the hero) still
       uses the base .hdr rule's 0.5s. */
    transition-duration: 0.18s;
  }

  .hdr__inner {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 0 var(--gutter);
    height: var(--hdr-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    transition: height 0.35s var(--ease);
  }

  /* Once scrolled, the bar quietly compacts a further ~10% on desktop.
     Mobile keeps the full height so the drawer (pinned at --hdr-h) never
     drifts out from under the bar. */
  @media (min-width: 1001px) {
    .hdr.is-stuck .hdr__inner { height: calc(var(--hdr-h) * 0.9); }
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
    /* Structural fix, not just a spacing tune: without this, an over-budget
       row (nav content that doesn't fit even in principle) squeezes the ONE
       flex sibling with no minimum content size — the logo, a replaced
       image element — all the way to 0, silently. That is exactly what
       happened at 1024px once the nav gained `white-space:nowrap` and could
       no longer absorb the shortfall by wrapping instead. flex-shrink:0
       turns that failure mode from "the logo vanishes" into "the row
       overflows", which is visible and gets caught, rather than a logo that
       is just gone with no visual signal anything is wrong. */
    flex-shrink: 0;
  }

  /* new lockup is stacked (steam / wordmark / line / tagline) rather than a
     flat wide mark, so it is sized by width — height follows the intrinsic
     1536x1024 ratio automatically. ~145-165px mobile, ~170-190px tablet,
     ~190-220px desktop. */
  .wordmark__logo {
    display: block;
    /* DARK HEADER, 2026-08-14: sized back up — a gold mark on near-black
       reads smaller than the same mark did on cream, and the founder asked
       for it to feel like "a luxury brand mark, not a small utility logo."
       ~10% larger at both ends of the clamp than the previous pass. Width-only
       sizing: height follows the intrinsic ratio, the mark never distorts. */
    /* GROWN 15% further, 2026-08-14: "logo = strongest brand element." At
       max width (9.49rem=152px) this is 82px tall against an 88px-tall
       header — fits with margin at the header's new, restored height. */
    width: clamp(7.48rem, 7.13rem + 2.07vw, 9.49rem);
    height: auto;
  }

  /* Masked brown rendering of the approved lockup (700×379 intrinsic).
     background-color IS the logo color — the same --bronze-btn as the CTA,
     so header brand color reads as one deliberate choice. The tagline in
     the lockup takes the same brown, staying in-family per the founders'
     direction. */
  .wordmark__mark {
    aspect-ratio: 700 / 379;
    background-color: var(--bronze-btn);
    -webkit-mask-image: url('/brand/buxena-logo-transparent.png');
    mask-image: url('/brand/buxena-logo-transparent.png');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
  }

  /* The header background is dark in every state now, so the light
     (champagne/gold) logo asset is what's needed everywhere — the masked
     brown version this used to fall back to on a light ground has no state
     left to serve. Left in place in the markup rather than deleted (the
     brief asked not to touch unrelated markup), just permanently hidden. */
  .wordmark__logo--dark { display: none; }
  .wordmark__logo--light { display: block; }

  /* The menu reads as a designed cluster, not links spread across the bar:
     tighter gaps, and the whole nav hugs the right side next to the CTA. */
  .hdr__nav ul {
    display: flex;
    /* DARK HEADER, 2026-08-14: tightened from clamp(1.05rem,...,1.8rem).
       Root cause of the awkward two-line labels ("Sauna Advisor", "Our
       Story", "Heater Guide"): the anchors were plain `display:inline` text
       inside shrinkable flex <li>s, and at 1440px the combined logo + nav +
       CTA content ran ~33px over .hdr__inner's available width — just enough
       for flexbox to squeeze the nav and force those two-word labels onto a
       second line. This gap was the biggest reclaimable chunk (7 gaps at the
       old max = 201.6px); tightening it plus the lighter tracking below
       comfortably closes that 33px gap with room to spare, verified by
       measuring actual rendered widths at 1440/1280/1024, not by estimate. */
    /* GROWN, 2026-08-14: "more breathing room horizontally." Bigger gap here
       is only affordable because the CTA shrank in the same pass (see
       .hdr__cta below) — re-verified empirically across the full
       1001-1440px range afterward; see the narrow-band media query at the
       bottom of this file for how the budget was rebalanced. */
    gap: clamp(1.2rem, 0.5rem + 1.4vw, 2rem);
  }

  /* Quiet-luxury nav type: weight 500 at 13px, restrained 0.12em tracking
     (wide enough to feel considered, no further), full-strength ink. The
     underline is a 1px line that grows from the left on hover instead of
     popping in — drawn as a scaling gradient, not a border. */
  .hdr__nav a {
    /* GROWN ~9%, 2026-08-14: 0.8125rem (13px) → 0.8875rem (14.2px) —
       "navigation = clear, substantial, premium." */
    font-size: 0.8875rem;
    font-weight: 500;
    /* 0.12em → 0.09em — the other half of reclaiming the ~33px this row was
       short by. `white-space:nowrap` is the actual fix for the wrapping
       itself (the anchor was plain inline text, so a squeezed <li> could
       always wrap it); the gap and tracking changes are what make nowrap
       safe to add without the row overflowing at 1440/1280/1024 instead. */
    letter-spacing: 0.105em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.5rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0% 1px;
    transition: background-size 0.25s var(--ease), opacity 0.25s var(--ease);
    opacity: 0.88;
  }
  .hdr__nav a:hover { opacity: 1; background-size: 100% 1px; }
  /* Restrained gold, not a heavy underline: still the same thin 1px line the
     hover state uses, just in --bronze-soft — the accent this design system
     already designates for dark grounds (see its definition in global.css)
     — rather than plain --bronze, which was tuned for text sitting on the
     light --linen ground this header no longer has. */
  .hdr__nav a[aria-current='page'] {
    opacity: 1;
    background-image: linear-gradient(
      color-mix(in srgb, var(--bronze-soft) 85%, transparent),
      color-mix(in srgb, var(--bronze-soft) 85%, transparent)
    );
    background-size: 100% 1px;
  }

  .hdr__end { display: flex; align-items: center; gap: 1rem; }

  /* The CTA: a slim 44px bar in muted BUXENA gold with a white label and a
     near-square 3px corner — warm, architectural, matched to the logo's
     palette rather than a black block. --bronze-btn (#8f6e42) is the
     brand's established solid-button gold-brown, contrast-checked at
     4.69:1 with white. Hover lightens one step to --bronze (#9c7a4a) in
     ~220ms — one quiet move, no bounce, no shadow.
     One rule now instead of two: this already read correctly against the
     dark hero video (proven by the --over-specific override this used to
     need), and the header background is dark everywhere now, so that
     override duplicated these exact values rather than differing from them.
     Removed instead of kept as a no-op. */
  /* SHRUNK, 2026-08-14 — the header grew (height, logo, nav text and gap all
     up) and the founder was explicit this CTA should NOT grow with it:
     "elegant secondary CTA... NOT a large dominant block." Height down,
     horizontal padding down, tracking eased off so the same word doesn't
     fight the narrower box, font nudged up toward (not to) nav's new size
     per "approximately the same... or only slightly smaller." */
  .hdr__cta {
    height: 2.35rem;
    padding: 0 1.05rem;
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    white-space: nowrap;
    background: var(--bronze-btn);
    color: #fff;
    border: 1px solid var(--bronze-btn);
    border-radius: 3px;
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease),
      border-color 0.22s var(--ease);
  }
  .hdr__cta:hover {
    background: var(--bronze);
    border-color: var(--bronze);
    color: #fff;
  }

  .burger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    /* 44×44 hit area — this is the only way to reach navigation on a phone,
       and at the old 34×27 it was smaller than a fingertip. The bars keep
       their drawn width; the rest is invisible padding. */
    width: 44px;
    height: 44px;
    padding: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    /* Pull the button back to the edge so the larger hit area does not
       visually indent the icon from the header's right margin. */
    margin-right: -0.5rem;
  }
  .burger__bar {
    display: block;
    width: 2.1rem;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease), opacity 0.3s var(--ease);
  }
  .burger__bar + .burger__bar { margin-top: 6px; }
  .burger[aria-expanded='true'] .burger__bar:first-child { transform: translateY(3.5px) rotate(45deg); }
  .burger[aria-expanded='true'] .burger__bar:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  /* --- drawer ---
     Recolored to match: it used to be light cream against a header that was
     sometimes dark-transparent, which is exactly why the script below forces
     `is-stuck` open while the drawer shows — without it the burger and
     wordmark, in light-on-dark mode, would vanish against this same light
     panel. That forcing still runs (harmless, and left alone rather than
     unpicking working behavior this change doesn't require touching), but
     the mismatch it was working around no longer exists: the drawer is dark
     now too. */
  .drawer {
    position: fixed;
    inset: var(--hdr-h) 0 auto 0;
    z-index: 99;
    background: var(--ember);
    border-bottom: 1px solid color-mix(in srgb, var(--bronze-soft) 26%, var(--ember));
    padding: 1.5rem var(--gutter) 2.5rem;
    display: grid;
    gap: 1.5rem;
  }
  .drawer[hidden] { display: none; }
  .drawer ul { display: grid; }
  .drawer a {
    display: block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-decoration: none;
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--bronze-soft) 20%, var(--ember));
    color: var(--linen);
  }
  .drawer__cta { justify-content: center; color: #fff; border-bottom: none; font-family: var(--font-sans); font-size: var(--t-label); }

  /* The narrow band just above where nav hides entirely (1000px). Measured
     real overflow here after fixing the logo-collapse bug above: 83px at
     1024px, tapering to 0 by ~1150px — nav content genuinely does not fit
     alongside a non-shrinking logo and the CTA at these widths, so this
     tightens all three independently of the wider clamps above rather than
     making those clamps fight two very different jobs (looking spacious at
     1440 AND fitting at 1024). */
  /* RECOMPUTED, 2026-08-14: the base header grew substantially (height,
     logo, nav font, nav gap all up; CTA shrunk but not enough to offset the
     rest) so this band's own values needed to shrink to match — the old
     numbers here had drifted to be LARGER than the new base CTA, which is
     backwards for a "narrow band gets tighter" rule. Widened to 1320px
     because at the previous 1200px cutoff the jump back to base values
     opened a fresh 13px overflow right at that boundary; verified
     overflow-free from 1001px to 1440px afterward. */
  @media (max-width: 1320px) and (min-width: 1001px) {
    .hdr__nav ul { gap: 0.6rem; }
    .hdr__nav a { font-size: 0.75rem; letter-spacing: 0.06em; }
    .hdr__cta { padding: 0 0.8rem; font-size: 0.6875rem; height: 2.2rem; }
  }

  @media (max-width: 1000px) {
    .hdr__nav { display: none; }
    /* flex, not block — the button centres its bars in the 44px hit area */
    .burger { display: flex; }
    .hdr__cta { display: none; }
  }

  @keyframes hdr-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr { animation: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');

  // is-stuck drives two things: the transparent→solid swap on over-hero
  // pages, and the subtle desktop height compaction on every page — so the
  // listener attaches unconditionally now, not only when .hdr--over.
  if (header) {
    const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const setOpen = (open: boolean) => {
    if (!burger || !drawer) return;
    burger.setAttribute('aria-expanded', String(open));
    drawer.hidden = !open;
    burger.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';

    // On the homepage the header sits transparent over a dark hero with light
    // text. The drawer is cream, so force the solid state while it is open or
    // the burger and wordmark disappear against it.
    if (header?.classList.contains('hdr--over')) {
      if (open) header.classList.add('is-stuck');
      else header.classList.toggle('is-stuck', window.scrollY > 40);
    }

    document.body.style.overflow = open ? 'hidden' : '';
  };

  burger?.addEventListener('click', () => {
    setOpen(burger.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      burger.focus();
    }
  });

  // close the drawer if the viewport grows past the breakpoint
  window.matchMedia('(min-width: 1001px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
