---
import { site, publicEmail } from '../../data/site';
import {
  ITEM_GROUPS,
  FULFILMENT_LABELS,
  type CustomerProposal,
} from '../../lib/quote-proposal';

interface CatalogueFacts {
  href?: string;
  image?: { src: string; alt: string };
  gallery?: { src: string; alt: string }[];
  capacity?: string;
  dimensions?: { label: string; value: string }[];
  materials?: string[];
  specs?: { label: string; value: string }[];
  video?: { title: string; href: string; embedSrc?: string; poster?: string };
}

interface Props {
  proposal: CustomerProposal;
  token: string;
  acceptable: { ok: boolean; reason?: string };
  justAccepted?: boolean;
  acceptError?: string | null;
  preview?: boolean;
  catalogue?: CatalogueFacts;
}

const { proposal, token, acceptable, justAccepted = false, acceptError = null, preview = false, catalogue = {} } = Astro.props;

const acceptErrorMessage = acceptError === 'name'
  ? 'Enter your name so we can record who accepted the proposal.'
  : acceptError === 'rate'
    ? 'Too many attempts were made. Please wait a few minutes, then try again or contact your BUXENA advisor.'
    : acceptError
      ? 'We could not record that just now. Please try again or contact your BUXENA advisor for confirmation.'
      : '';

const money = (value: number) => value.toLocaleString('en-US', {
  style: 'currency',
  currency: 'USD',
  minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
  maximumFractionDigits: 2,
});

const formatDate = (value: string | null) => {
  if (!value) return '';
  const date = new Date(`${value.slice(0, 10)}T12:00:00Z`);
  return Number.isNaN(date.valueOf())
    ? value
    : date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
};

const daysRemaining = proposal.expiryDate && !proposal.expired
  ? Math.max(0, Math.ceil((new Date(`${proposal.expiryDate.slice(0, 10)}T23:59:59Z`).valueOf() - Date.now()) / 86_400_000))
  : null;

const grouped = ITEM_GROUPS
  .map((group) => ({ ...group, items: proposal.items.filter((item) => item.kind === group.kind) }))
  .filter((group) => group.items.length > 0);
const heaterSpecificationGroups = grouped.filter((group) =>
  group.kind === 'heater' || group.kind === 'controls' || group.kind === 'accessories'
);

const dimensions = proposal.product.dimensions.length
  ? proposal.product.dimensions
  : (catalogue.dimensions ?? []);
const capacity = proposal.product.capacity ?? catalogue.capacity ?? null;
const materials = proposal.product.timberType
  ? [proposal.product.timberType]
  : (catalogue.materials ?? []);
const baseRows = [
  ...dimensions,
  ...(capacity ? [{ label: 'Capacity', value: capacity }] : []),
  ...(materials.length ? [{ label: 'Timber', value: materials.join(' / ') }] : []),
  ...(proposal.product.glassConfiguration ? [{ label: 'Door & glass', value: proposal.product.glassConfiguration }] : []),
];

const catalogueSpecs = catalogue.specs ?? [];
const modelRows = baseRows.length ? baseRows : catalogueSpecs.slice(0, 8);
const availability = proposal.availability;
const availabilityLabel = availability
  ? availability.availableUnits > 0
    ? `${availability.availableUnits} available`
    : availability.incomingUnits > 0
      ? `${availability.incomingUnits} incoming`
      : 'Availability to confirm'
  : 'Availability to confirm';

const fulfilmentSummary = proposal.delivery !== 'unset'
  ? FULFILMENT_LABELS[proposal.delivery]
  : 'Delivery plan to confirm';

const documents = [
  { label: 'Product brochure', href: proposal.product.brochureUrl },
  { label: 'Installation manual', href: proposal.product.installationManualUrl },
  { label: 'Warranty document', href: proposal.product.warrantyDocumentUrl },
].filter((document) => document.href);

const catalogueImages = [catalogue.image, ...(catalogue.gallery ?? [])]
  .filter((image): image is { src: string; alt: string } => Boolean(image?.src))
  .filter((image, index, images) => images.findIndex((candidate) => candidate.src === image.src) === index);
const primaryImage = catalogueImages[0];
const hasHeaterPackage = grouped.some((group) => group.kind === 'heater' || group.kind === 'controls');
---

<article class="proposal-document">
  {preview && (
    <div class="preview-banner" role="status">
      Preview data — this page is for design review and does not write to Supabase.
    </div>
  )}

  <section class="proposal-hero band">
    <div class="proposal-kicker-band">
      <div class="shell proposal-shell proposal-kicker">
        <a class="proposal-kicker__brand" href="/" aria-label={`${site.name} home`}>
          <img src="/brand/buxena-logo-transparent.png" alt={site.name} />
        </a>
        <span>Customer proposal · {proposal.quoteNumber}</span>
      </div>
    </div>
    <div class="shell proposal-shell">
      <div class="proposal-hero__grid">
        <div>
          <p class="eyebrow">Prepared {proposal.customerName ? `for ${proposal.customerName}` : 'for you'}</p>
          <h1 class="display">{proposal.modelName ? `${proposal.modelName} Proposal` : 'Complete Sauna Proposal'}</h1>
          <p class="proposal-intro">
            Complete project scope, equipment, delivered investment, site
            requirements and next steps — organized in one clear document.
          </p>
        </div>
        <dl class="proposal-hero__meta">
          <div><dt>Proposal</dt><dd>{proposal.quoteNumber}</dd></div>
          {proposal.quoteDate && <div><dt>Prepared</dt><dd>{formatDate(proposal.quoteDate)}</dd></div>}
          {proposal.expiryDate && (
            <div><dt>Valid until</dt><dd class={proposal.expired ? 'is-expired' : ''}>{formatDate(proposal.expiryDate)}</dd></div>
          )}
          {proposal.ownerName && <div><dt>Your advisor</dt><dd>{proposal.ownerName}</dd></div>}
        </dl>
      </div>

      {proposal.expiryDate && (
        <div class:list={['validity-strip', proposal.expired && 'validity-strip--expired']}>
          <strong>{proposal.expired ? 'This proposal has expired.' : 'Pricing and scope are held through the date above.'}</strong>
          {!proposal.expired && daysRemaining !== null && (
            <span>{daysRemaining === 0 ? 'Valid through today.' : `${daysRemaining} day${daysRemaining === 1 ? '' : 's'} remaining.`}</span>
          )}
        </div>
      )}
    </div>
  </section>

  {(justAccepted || proposal.acceptedAt) && (
    <section class="band band--tight">
      <div class="shell proposal-shell">
        <p class="notice-strip">
          <strong>Thank you — your acceptance is recorded.</strong>
          A BUXENA advisor will confirm the final specification and next step. Nothing has been charged.
        </p>
      </div>
    </section>
  )}

  <nav class="proposal-nav" aria-label="Proposal sections">
    <div class="shell proposal-shell proposal-nav__inner">
      <a href={`/proposal/${token}#overview`}>Overview</a>
      <a href={`/proposal/${token}#package`}>Package</a>
      <a href={`/proposal/${token}#investment`}>Investment</a>
      <a href={`/proposal/${token}#delivery`}>Delivery</a>
      <a href={`/proposal/${token}#site`}>Site readiness</a>
      <a href={`/proposal/${token}#warranty`}>Warranty</a>
      <a href={`/proposal/${token}#proceed`}>Proceed</a>
    </div>
  </nav>

  <section class="band band--tight" id="overview">
    <div class="shell proposal-shell">
      <header class="section-heading">
        <span>01</span>
        <div><p class="eyebrow">Selected for your project</p><h2>See your sauna configuration</h2></div>
      </header>

      <div class:list={['model-showcase', !primaryImage && 'model-showcase--text']} data-proposal-gallery>
        {primaryImage && (
          <div class="model-gallery">
            <div class="model-gallery__stage">
              <img src={primaryImage.src} alt={primaryImage.alt} data-gallery-main />
              <span class="model-gallery__label">Your selected model</span>
            </div>
            {catalogueImages.length > 1 && (
              <div class="model-gallery__thumbs" aria-label="Product views">
                {catalogueImages.map((image, index) => (
                  <button
                    type="button"
                    class="model-gallery__thumb"
                    aria-label={`Show view ${index + 1}: ${image.alt}`}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    data-gallery-thumb
                    data-src={image.src}
                    data-alt={image.alt}
                  >
                    <img src={image.src} alt="" />
                  </button>
                ))}
              </div>
            )}
          </div>
        )}

        <div class="model-showcase__details">
          <p class="eyebrow">Configured model</p>
          <h3>{proposal.modelName ?? 'Your selected sauna'}</h3>
          <p class="model-showcase__summary">
            The model, material, equipment and delivery scope below are the basis of this proposal.
          </p>
          <dl class="model-highlights">
            {capacity && <div><dt>Capacity</dt><dd>{capacity}</dd></div>}
            {dimensions.slice(0, 2).map((row) => <div><dt>{row.label}</dt><dd>{row.value}</dd></div>)}
            {materials.length > 0 && <div><dt>Material</dt><dd>{materials.join(' / ')}</dd></div>}
          </dl>
          {catalogue.href && <a class="model-link" href={catalogue.href}>Explore the model <span aria-hidden="true">→</span></a>}
        </div>
      </div>

      {modelRows.length > 0 && (
        <dl class="fact-table">
          {modelRows.map((row) => <div><dt>{row.label}</dt><dd>{row.value}</dd></div>)}
        </dl>
      )}
    </div>
  </section>

  <section class="band band--tight band--linen" id="package">
    <div class="shell proposal-shell">
      <header class="section-heading">
        <span>02</span>
        <div><p class="eyebrow">Configured for your project</p><h2>Sauna, heater & equipment</h2></div>
      </header>

      {proposal.heaterName && (
        <section class="heater-specification" aria-labelledby="heater-specification-title">
          <div class="heater-specification__title">
            <p class="eyebrow">Selected heating system</p>
            <h3 id="heater-specification-title">{proposal.heaterName}</h3>
            <p>The equipment shown here is taken directly from this proposal's configured package.</p>
          </div>
          {heaterSpecificationGroups.length > 0 && (
            <dl class="heater-specification__facts">
              {heaterSpecificationGroups.map((group) => (
                <div>
                  <dt>{group.label}</dt>
                  <dd>{group.items.map((item) => item.description).join(' · ')}</dd>
                </div>
              ))}
            </dl>
          )}
        </section>
      )}

      {grouped.length === 0 ? (
        <p class="proposal-empty">Your detailed configuration is being prepared.</p>
      ) : (
        <div class:list={['package-visual', !hasHeaterPackage && 'package-visual--compact']}>
          {hasHeaterPackage && (
            <figure class="equipment-image">
              <img src="/images/editorial/indoor-sauna-interior-view-concept.png" alt="Warm timber sauna interior with benches, stones and an electric heater" />
              <figcaption>Representative sauna atmosphere. The exact quoted equipment is listed alongside.</figcaption>
            </figure>
          )}
          <div class="package-groups">
            {grouped.map((group, groupIndex) => (
              <section class="package-group">
                <div class="package-group__heading"><span>{String(groupIndex + 1).padStart(2, '0')}</span><h3>{group.label}</h3></div>
                <dl>
                  {group.items.map((item) => (
                    <div>
                      <dt>{item.description}{item.quantity !== 1 && <span> × {item.quantity}</span>}</dt>
                      <dd>{proposal.hasPricing && item.lineTotal > 0 ? money(item.lineTotal) : 'Included / TBC'}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            ))}
          </div>
        </div>
      )}

      {materials.length > 0 && (
        <aside class="material-story">
          <div class="material-story__copy">
            <p class="eyebrow">Material specification</p>
            <h3>Natural timber, clearly specified</h3>
            <p>Your proposal currently lists <strong>{materials.join(' / ')}</strong>. The final timber and exterior finish are confirmed in writing before order.</p>
            <ol>
              <li><span>01</span><div><strong>Material recorded</strong><small>The quoted timber is shown directly in this document.</small></div></li>
              <li><span>02</span><div><strong>Finish confirmed</strong><small>Colour and exterior treatment are finalized with your advisor.</small></div></li>
              <li><span>03</span><div><strong>Matched to your site</strong><small>Outdoor exposure and maintenance expectations are reviewed before purchase.</small></div></li>
            </ol>
          </div>
          <img src="/images/craftsmanship-detail.jpg" alt="Close detail of finished sauna timber benches and wall boards" />
        </aside>
      )}

      <aside class="ritual-story">
        <img src="/images/editorial/sauna-ritual-birch-whisk.jpg" alt="Birch sauna whisk, dark wooden bucket and ladle arranged in a warm ritual still life" />
        <div class="ritual-story__copy">
          <p class="eyebrow">The experience beyond specifications</p>
          <h3>Built for the sauna ritual</h3>
          <p>Warmth, steam, water and natural aroma turn the finished sauna into a place to slow down and return to regularly.</p>
          <small>Atmosphere image shown for inspiration. Accessories are included only when they appear in the package list above.</small>
        </div>
      </aside>

      {catalogue.video && (
        <section class="proposal-video" aria-labelledby="proposal-video-title">
          <div>
            <p class="eyebrow">Verified product resource</p>
            <h3 id="proposal-video-title">{catalogue.video.title}</h3>
            <p>See how this model is assembled or installed before you make the final decision.</p>
            <a class="model-link" href={catalogue.video.href} target="_blank" rel="noopener">Open video <span aria-hidden="true">→</span></a>
          </div>
          {catalogue.video.embedSrc && (
            <iframe
              src={catalogue.video.embedSrc}
              title={catalogue.video.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          )}
        </section>
      )}
    </div>
  </section>

  {proposal.hasPricing && (
    <section class="band band--tight" id="investment">
      <div class="shell proposal-shell">
        <header class="section-heading">
          <span>03</span>
          <div><p class="eyebrow">Transparent numbers</p><h2>Your delivered investment</h2></div>
        </header>
        <div class="investment-grid">
          <dl class="price-table">
            <div><dt>Configured sauna package</dt><dd>{money(proposal.subtotal)}</dd></div>
            {proposal.deliveryCost > 0 && <div><dt>Delivery</dt><dd>{money(proposal.deliveryCost)}</dd></div>}
            {proposal.installationCost > 0 && <div><dt>Installation</dt><dd>{money(proposal.installationCost)}</dd></div>}
            {proposal.discount > 0 && <div class="price-discount"><dt>Approved discount</dt><dd>−{money(proposal.discount)}</dd></div>}
            {proposal.taxAmount > 0 && <div><dt>Sales tax ({proposal.taxRate.toFixed(2).replace(/\.00$/, '')}%)</dt><dd>{money(proposal.taxAmount)}</dd></div>}
            <div class="price-total"><dt>Proposal total</dt><dd>{money(proposal.total)}</dd></div>
          </dl>
          <aside class="investment-summary">
            <p class="eyebrow">At a glance</p>
            <strong>{money(proposal.total)}</strong>
            <span>{fulfilmentSummary}</span>
            <span>{availabilityLabel}</span>
            <small>No payment is taken when you accept this proposal.</small>
          </aside>
        </div>
      </div>
    </section>
  )}

  <section class="band band--tight band--linen" id="delivery">
    <div class="shell proposal-shell">
      <header class="section-heading">
        <span>04</span>
        <div><p class="eyebrow">Fulfilment plan</p><h2>Availability, freight & delivery</h2></div>
      </header>
      <div class="detail-columns">
        <section class="detail-card">
          <h3>Availability</h3>
          <dl class="fact-table fact-table--compact">
            {availability ? (
              <>
                <div><dt>Available inventory</dt><dd>{availability.availableUnits > 0 ? `${availability.availableUnits} unit${availability.availableUnits === 1 ? '' : 's'}` : 'None currently available'}</dd></div>
                {availability.incomingUnits > 0 && <div><dt>Incoming</dt><dd>{availability.incomingUnits} unit{availability.incomingUnits === 1 ? '' : 's'}</dd></div>}
                {availability.eta && <div><dt>Current inventory ETA</dt><dd>{formatDate(availability.eta)}</dd></div>}
              </>
            ) : <div><dt>Status</dt><dd>Confirmed before order</dd></div>}
          </dl>
        </section>
        <section class="detail-card">
          <h3>Delivery facts</h3>
          <dl class="fact-table fact-table--compact">
            {proposal.delivery !== 'unset' && <div><dt>Delivery</dt><dd>{FULFILMENT_LABELS[proposal.delivery]}</dd></div>}
            {proposal.product.shippingDimensions && <div><dt>Packed dimensions</dt><dd>{proposal.product.shippingDimensions}</dd></div>}
            {proposal.product.weightKg !== null && <div><dt>Shipping weight</dt><dd>{proposal.product.weightKg.toLocaleString('en-US')} kg</dd></div>}
            {!proposal.product.shippingDimensions && proposal.product.weightKg === null && proposal.delivery === 'unset' && <div><dt>Method</dt><dd>Confirmed for your address before order</dd></div>}
          </dl>
        </section>
      </div>
      <p class="clarity-note">Final delivery timing and access requirements are confirmed in writing for your address before the order is placed.</p>
    </div>
  </section>

  <section class="band band--tight" id="site">
    <div class="shell proposal-shell">
      <header class="section-heading">
        <span>05</span>
        <div><p class="eyebrow">Prepare with confidence</p><h2>Electrical, foundation & installation</h2></div>
      </header>
      <div class="detail-columns detail-columns--three">
        <section class="detail-card">
          <h3>Electrical</h3>
          <p>{proposal.product.electricalRequirements ?? 'The final electrical specification will be confirmed in writing before installation.'}</p>
          <small>Electrical work must be reviewed and completed by a licensed electrician to applicable local code.</small>
        </section>
        <section class="detail-card">
          <h3>Foundation</h3>
          <p>A level, stable and appropriately load-bearing base is required.</p>
          <small>Final base size, drainage, setbacks and permitting depend on the model and site.</small>
        </section>
        <section class="detail-card">
          <h3>Installation</h3>
          <p>{proposal.installation !== 'unset' ? FULFILMENT_LABELS[proposal.installation] : 'Installation responsibility will be confirmed before order.'}</p>
          <small>Assembly scope and site access are documented before scheduling.</small>
        </section>
      </div>
      <figure class="site-visual">
        <img src="/images/editorial/sauna-white-mist-floating-bench.jpg" alt="Minimal timber sauna bench emerging through soft white mist" />
        <figcaption>
          <p class="eyebrow">Space, light & calm</p>
          <h3>A calm result begins with a clear site plan</h3>
          <p>We confirm the practical requirements first, then help keep the finished environment focused on the experience you want.</p>
          <small>Concept image for atmosphere and spatial inspiration; it does not represent included construction scope.</small>
        </figcaption>
      </figure>
      {proposal.customerNotes && (
        <div class="customer-note"><p class="eyebrow">Notes for your project</p><p>{proposal.customerNotes}</p></div>
      )}
    </div>
  </section>

  <section class="band band--tight band--linen" id="warranty">
    <div class="shell proposal-shell">
      <header class="section-heading">
        <span>06</span>
        <div><p class="eyebrow">After the purchase</p><h2>Warranty, documents & support</h2></div>
      </header>
      <div class="warranty-grid">
        <div>
          <p class="warranty-lead">
            {proposal.product.warrantyMonths
              ? `This sauna is recorded with a ${proposal.product.warrantyMonths}-month warranty term.`
              : 'The applicable manufacturer and BUXENA warranty terms are confirmed before purchase.'}
          </p>
          <p>Product, heater and component warranties can have different coverage. Your final order record identifies the documents applicable to the selected package.</p>
        </div>
        {documents.length > 0 && (
          <div class="document-links">
            <p class="eyebrow">Reference documents</p>
            {documents.map((document) => <a href={document.href!} target="_blank" rel="noopener">{document.label}<span aria-hidden="true"> →</span></a>)}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="band band--tight" id="proceed">
    <div class="shell proposal-shell">
      <header class="section-heading">
        <span>07</span>
        <div><p class="eyebrow">Your decision</p><h2>Payment & next steps</h2></div>
      </header>
      <ol class="next-steps">
        <li><span>1</span><div><strong>Accept the proposal</strong><p>This records your intention to proceed. It is not a payment or final contract.</p></div></li>
        <li><span>2</span><div><strong>Confirm final details</strong><p>We verify specification, availability, delivery access and site requirements in writing.</p></div></li>
        <li><span>3</span><div><strong>Receive order and payment instructions</strong><p>Your BUXENA advisor sends the final order confirmation and payment terms.</p></div></li>
      </ol>

      {acceptable.ok && !preview && (
        <div class="accept-panel">
          <div><p class="eyebrow">Ready to move forward?</p><h3>Accept this proposal</h3><p>Nothing is charged today. We will contact you before any order is placed.</p></div>
          <form method="POST" action="/api/proposal-accept">
            <input type="hidden" name="token" value={token} />
            <label><span>Your name</span><input type="text" name="acceptedName" required maxlength="120" autocomplete="name" /></label>
            <button class="btn btn--bronze" type="submit">Accept proposal</button>
          </form>
        </div>
      )}

      {acceptErrorMessage && !justAccepted && !proposal.acceptedAt && (
        <p class="accept-error" role="alert">{acceptErrorMessage}</p>
      )}

      {preview && <p class="preview-cta">Acceptance is disabled in preview mode.</p>}
      {!acceptable.ok && acceptable.reason && !proposal.acceptedAt && !preview && <p class="unavailable-note">{acceptable.reason}</p>}

      <footer class="proposal-footer">
        <div>
          <p class="eyebrow">Questions?</p>
          {proposal.ownerName && <strong>{proposal.ownerName}</strong>}
          <p>{proposal.ownerEmail ? <a href={`mailto:${proposal.ownerEmail}`}>{proposal.ownerEmail}</a> : publicEmail && <a href={`mailto:${publicEmail}`}>{publicEmail}</a>}</p>
        </div>
        <div class="proposal-footer__actions">
          <a class="proposal-download" href={`/proposal/${token}/pdf`} download>Download proposal PDF</a>
          <a class="proposal-download proposal-download--secondary" href={`/proposal/${token}/pdf?view=1`}>Open PDF</a>
        </div>
      </footer>
    </div>
  </section>

</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-proposal-gallery]').forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>('[data-gallery-main]');
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]'));
    if (!main || thumbs.length < 2) return;
    thumbs.forEach((thumb) => thumb.addEventListener('click', () => {
      const src = thumb.dataset.src;
      if (!src) return;
      main.src = src;
      main.alt = thumb.dataset.alt ?? '';
      thumbs.forEach((button) => button.setAttribute('aria-pressed', String(button === thumb)));
    }));
  });
</script>

<style>
  .proposal-document { --proposal-max: 70rem; background: #f7f3eb; color: #24201c; font-size: 0.96rem; }
  .proposal-shell { max-width: var(--proposal-max); }
  .preview-banner { padding: 0.55rem 1rem; text-align: center; background: var(--ink); color: var(--linen); font-size: 0.75rem; letter-spacing: 0.04em; }
  .proposal-document :global(.band--tight) { padding-block: clamp(2.6rem, 4.5vw, 4.25rem); }
  .proposal-hero { padding-top: 0; padding-bottom: clamp(1.8rem, 3.5vw, 3rem); background: linear-gradient(120deg, #fbf8f2 0%, #eee6d9 100%); border-bottom: 1px solid var(--line); }
  .proposal-kicker-band { background: #100f0d; border-bottom: 1px solid #3d352b; }
  .proposal-kicker { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; min-height: clamp(7.5rem, 10vw, 9rem); color: #f3e7d4; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  .proposal-kicker__brand { display: inline-flex; align-items: center; color: inherit; text-decoration: none; }
  .proposal-kicker__brand img { display: block; width: clamp(9rem, 12vw, 12rem); height: auto; }
