---
/**
 * "The BUXENA Ritual Kit" — the included-accessories band shown on every
 * sauna product page, between the specifications and the enquiry form.
 *
 * The kit is a real fulfilment promise: every sauna preorder ships with
 * these five items (sourced from the supplier accessory list at ~€94
 * landed cost). If the kit contents change, update BOTH this component and
 * the standard line in the written quote so site and paperwork agree.
 *
 * Product photos live in /public/images/accessories/ (supplier shop
 * photography, 480px squares). alt is empty — the visible label right
 * below each photo already names the item.
 */
const items: { label: string; image: string }[] = [
  { label: 'Wooden bucket and ladle', image: '/images/accessories/kit-bucket.jpg' },
  { label: 'Thermometer and hygrometer', image: '/images/accessories/kit-thermometer.jpg' },
  { label: 'Sauna sand timer', image: '/images/accessories/kit-timer.jpg' },
  { label: 'Two wooden headrests', image: '/images/accessories/kit-headrest.jpg' },
  { label: 'Sauna fragrance oil', image: '/images/accessories/kit-fragrance.jpg' },
];
---

<section class="band ritual">
  <div class="shell">
    <div class="ritual__rule" aria-hidden="true"></div>
    <span class="eyebrow">Included with every preorder</span>
    <h2 class="ritual__title">The BUXENA Ritual Kit</h2>
    <p class="ritual__lead">
      Every sauna leaves for your address with the ritual already packed —
      our gift with your order.
    </p>

    <ul class="ritual__grid" role="list">
      {items.map((item) => (
        <li class="ritual__item">
          <img src={item.image} alt="" loading="lazy" decoding="async" width="480" height="480" />
          <span>{item.label}</span>
        </li>
      ))}
    </ul>

    <p class="ritual__note">
      Included at no charge with every sauna preorder. Itemised in your
      written quote.
    </p>
  </div>
</section>

<style>
  .ritual { padding-top: 0; }

  .ritual__rule {
    border-top: 2px solid var(--ink);
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .ritual__title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .ritual__lead {
    color: var(--muted);
    max-width: 46em;
    margin-top: 0.7rem;
  }

  .ritual__grid {
    list-style: none;
    margin: 1.9rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.75rem;
  }

  .ritual__item {
    border: 1px solid var(--line);
    padding: 0.9rem 0.9rem 1.1rem;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 0.65rem;
    font-size: var(--t-small);
    line-height: 1.45;
    background: #fff;
  }

  .ritual__item img {
    width: 100%;
    max-width: 8.5rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .ritual__note {
    margin-top: 1.1rem;
    font-size: var(--t-small);
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .ritual__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
