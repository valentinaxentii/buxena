---
/**
 * "The BUXENA Ritual Kit" — the accessories band shown on every sauna
 * product page, between the specifications and the enquiry form.
 *
 * COMMERCIAL STATUS (founders' review, 2026-08-10): the exact inclusion
 * policy is AWAITING CONFIRMATION. Until the policy is confirmed, this
 * band presents the kit as a package component confirmed in the written
 * quote — NOT as an unconditional "included free with every sauna"
 * promise. Do not restore inclusion language without founder sign-off.
 *
 * IMAGE RIGHTS: the five photos are supplier shop photography with no
 * documented license — BLOCKED / REPLACE in docs/image-rights-register.md.
 * Local preview only.
 */
import { webpSrcset } from '../lib/optimized-image';

const items: { label: string; image: string }[] = [
  { label: 'Wooden bucket and ladle', image: '/images/accessories/kit-bucket.jpg' },
  { label: 'Thermometer and hygrometer', image: '/images/accessories/kit-thermometer.jpg' },
  { label: 'Sauna sand timer', image: '/images/accessories/kit-timer.jpg' },
  { label: 'Two wooden headrests', image: '/images/accessories/kit-headrest.jpg' },
  { label: 'Sauna fragrance oil', image: '/images/accessories/kit-fragrance.jpg' },
];
---

<section class="band ritual">
  <div class="shell">
    <div class="ritual__rule" aria-hidden="true"></div>
    <span class="eyebrow">The Ritual, Ready</span>
    <h2 class="ritual__title">The BUXENA Ritual Kit</h2>
    <p class="ritual__lead">
      The essentials of the sauna ritual, specified alongside your package
      — so the first heat is a complete experience, not a shopping list.
    </p>

    <ul class="ritual__grid" role="list">
      {items.map((item) => (
        <li class="ritual__item">
          <picture>
            {webpSrcset(item.image) && (
              <source type="image/webp" srcset={webpSrcset(item.image)} sizes="(max-width: 700px) 40vw, 200px" />
            )}
            <img src={item.image} alt="" loading="lazy" decoding="async" width="480" height="480" />
          </picture>
          <span>{item.label}</span>
        </li>
      ))}
    </ul>

    <p class="ritual__note">
      Included at no charge with every sauna preorder. Itemised in your
      written quote.
    </p>
  </div>
</section>

<style>
  .ritual { padding-top: 0; }

  .ritual__rule {
    border-top: 2px solid var(--ink);
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .ritual__title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .ritual__lead {
    color: var(--muted);
    max-width: 46em;
    margin-top: 0.7rem;
  }

  .ritual__grid {
    list-style: none;
    margin: 1.9rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.75rem;
  }

  .ritual__item {
    border: 1px solid var(--line);
    padding: 0.9rem 0.9rem 1.1rem;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 0.65rem;
    font-size: var(--t-small);
    line-height: 1.45;
    background: #fff;
  }

  .ritual__item img {
    width: 100%;
    max-width: 8.5rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .ritual__note {
    margin-top: 1.1rem;
    font-size: var(--t-small);
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .ritual__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
