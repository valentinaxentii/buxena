---
export const prerender = false;

import { createSupabaseAdminClient } from '../lib/supabase-admin';
import { getSettings, FALLBACK_SETTINGS, type BuxenaSettings } from '../lib/settings';
import { docThemeCssVars } from '../lib/doc-theme';
import ExportMenu from '../components/admin/ExportMenu.astro';
import '../styles/admin-print.css';

interface Props {
  title: string;
  subtitle?: string;
  /** Optional header search — pages opt in with a GET action, e.g. "/admin/products". */
  search?: { action: string; placeholder?: string; name?: string };
  /**
   * Hierarchical back link for sub-pages (detail/new/edit views). Both must be
   * set for it to render; top-level pages pass neither and are unchanged.
   * Always an explicit parent route — never history.back(), which breaks on
   * direct opens, bookmarks, and post-save refreshes.
   */
  parentLabel?: string;
  parentHref?: string;
  /**
   * Record pages with EXISTING generated documents pass them here; the print
   * control then renders as a dropdown ("Print this page" + those documents).
   * Absent/empty → a plain Print button that calls window.print().
   */
  printDocuments?: { label: string; href: string }[];
}
const { title, subtitle, search, parentLabel, parentHref, printDocuments } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/admin' && path.startsWith(href));

// Small line icons, stroke-based, rendered at 15px. Keyed by nav item.
const ICONS: Record<string, string> = {
  dashboard: '<rect x="3" y="3" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1"/>',
  leads: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.4 2.9-5.2 5.5-5.2s4.9 1.8 5.5 5.2"/><path d="M17 8h5M19.5 5.5v5"/>',
  quotes: '<path d="M6 2.8h8l4 4V21H6z"/><path d="M14 2.8v4h4"/><path d="M9 12h6M9 16h6"/>',
  invoices: '<path d="M6 2.8h12v18.2l-2-1.4-2 1.4-2-1.4-2 1.4-2-1.4-2 1.4z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  orders: '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
  products: '<path d="M3 3h8l10 10-8 8L3 11z"/><circle cx="7.6" cy="7.6" r="1.3"/>',
  inventory: '<rect x="3" y="8" width="18" height="13" rx="1"/><path d="M3 8l2-4h14l2 4M10 12.5h4"/>',
  shipments: '<path d="M2.5 6h12v11h-12z"/><path d="M14.5 10h4l2.5 3.5V17h-7"/><circle cx="6.5" cy="17.8" r="1.8"/><circle cx="17" cy="17.8" r="1.8"/>',
  customers: '<circle cx="8.5" cy="9" r="3"/><circle cx="16.5" cy="10" r="2.4"/><path d="M3 20c.5-3.2 2.7-5 5.5-5s5 1.8 5.5 5M15.5 15.4c2.3.2 4 1.8 4.5 4.6"/>',
  suppliers: '<path d="M3 21V9l6 4V9l6 4V4h6v17z"/><path d="M3 21h18"/>',
  enquiries: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3 7 9 6 9-6"/>',
  documents: '<path d="M3 6.5V19a1.5 1.5 0 0 0 1.5 1.5h15A1.5 1.5 0 0 0 21 19V8.5A1.5 1.5 0 0 0 19.5 7H12l-2-2.5H4.5A1.5 1.5 0 0 0 3 6.5z"/>',
  analytics: '<path d="M4.5 20V10.5M10 20V4.5M15.5 20v-7M21 20H3"/>',
  reports: '<path d="M4 20h16M5.5 16.5l4.5-5.5 3 3 5.5-7.5"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7"/>',
};

// Flat, compact nav — every existing route preserved.
const navItems = [
  { href: '/admin', label: 'Dashboard', icon: 'dashboard' },
  { href: '/admin/leads', label: 'Leads', icon: 'leads' },
  { href: '/admin/quotes', label: 'Quotes', icon: 'quotes' },
  { href: '/admin/invoices', label: 'Invoices', icon: 'invoices' },
  { href: '/admin/orders', label: 'Orders', icon: 'orders' },
  { href: '/admin/products', label: 'Products', icon: 'products' },
  { href: '/admin/inventory', label: 'Inventory', icon: 'inventory' },
  { href: '/admin/shipments', label: 'Shipment Orders', icon: 'shipments' },
  { href: '/admin/customers', label: 'Customers', icon: 'customers' },
  { href: '/admin/suppliers', label: 'Suppliers', icon: 'suppliers' },
  { href: '/admin/enquiries', label: 'Website Enquiries', icon: 'enquiries' },
  { href: '/admin/documents', label: 'Documents', icon: 'documents' },
  { href: '/admin/analytics', label: 'Analytics', icon: 'analytics' },
  { href: '/admin/reports', label: 'Reports', icon: 'reports' },
  { href: '/admin/settings', label: 'Settings', icon: 'settings' },
];

let staffLabel: string | null = null;
let staffSublabel: string | null = null;
let printSettings: BuxenaSettings = FALLBACK_SETTINGS;
try {
  const staffUser = Astro.locals.staffUser;
  if (staffUser) {
    const supabase = createSupabaseAdminClient();
    const [{ data: profile }, settings] = await Promise.all([
      supabase.from('profiles').select('full_name, role').eq('id', staffUser.id).single(),
      getSettings(supabase),
    ]);
    staffLabel = profile?.full_name || staffUser.email || null;
    staffSublabel = profile?.role ? profile.role.charAt(0).toUpperCase() + profile.role.slice(1) : null;
    printSettings = settings;
  }
} catch {
  staffLabel = Astro.locals.staffUser?.email ?? null;
}

const printGeneratedAt = new Date();

const initials = (staffLabel ?? '')
  .split(/[\s@.]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase())
  .join('');
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · BUXENA Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cormorant+Garamond:wght@500;600&display=swap"
    />
    {/* shared document design tokens — same source the PDF kit imports */}
    <style is:inline set:html={docThemeCssVars()} />
  </head>
  <body>
    <div class="shell">
      <div class="scrim" data-scrim hidden></div>
      <script>
        // Off-canvas drawer for <1024px. At desktop widths the hamburger is
        // hidden and none of this runs; the sidebar renders exactly as before.
        document.addEventListener('DOMContentLoaded', () => {
          const sidebar = document.getElementById('admin-sidebar');
          const scrim = document.querySelector('[data-scrim]') as HTMLElement | null;
          const burger = document.querySelector('[data-hamburger]') as HTMLButtonElement | null;
          if (!sidebar || !scrim || !burger) return;

          const focusables = () =>
            [...sidebar.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter((el) => el.offsetParent !== null);

          const setOpen = (open: boolean) => {
            sidebar.classList.toggle('is-open', open);
            scrim.hidden = false; // keep in layout so the opacity transition runs
            requestAnimationFrame(() => scrim.classList.toggle('is-visible', open));
            burger.setAttribute('aria-expanded', String(open));
            burger.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
            document.body.style.overflow = open ? 'hidden' : '';
            if (open) focusables()[0]?.focus();
            else burger.focus();
          };

          burger.addEventListener('click', () => setOpen(!sidebar.classList.contains('is-open')));
          scrim.addEventListener('click', () => setOpen(false));

          document.addEventListener('keydown', (e) => {
            if (!sidebar.classList.contains('is-open')) return;
            if (e.key === 'Escape') {
              setOpen(false);
            } else if (e.key === 'Tab') {
              // trap focus inside the open drawer
              const els = focusables();
              if (!els.length) return;
              const first = els[0];
              const last = els[els.length - 1];
              if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
              else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
            }
          });

          // close on navigation — full page loads reset state anyway, but this
          // gives immediate feedback the moment a nav link is tapped
          sidebar.addEventListener('click', (e) => {
            if ((e.target as HTMLElement).closest('a[href]')) setOpen(false);
          });
        });

        // --- unsaved-work protection for every shared admin form:
        // dirty-state beforeunload prompt + a sessionStorage stash written at
        // submit, restored only when the reload looks like a failed save
        // (an error notice on the page, or arrival via the login bounce).
        {
          const form = document.querySelector<HTMLFormElement>('form.admin-form');
          if (form) {
            const key = 'buxform:' + location.pathname;
            const serialize = () => {
              const out: Record<string, string[]> = {};
              new FormData(form).forEach((v, k) => { (out[k] ??= []).push(String(v)); });
              // checkbox state isn't in FormData when unchecked — capture explicitly
              form.querySelectorAll<HTMLInputElement>('input[type="checkbox"][name]').forEach((cb) => {
                out['__cb__' + cb.name] = [cb.checked ? '1' : '0'];
              });
              return JSON.stringify(out);
            };
            let baseline = serialize();
            let dirty = false;
            form.addEventListener('input', () => { dirty = serialize() !== baseline; });
            window.addEventListener('beforeunload', (e) => {
              if (dirty) { e.preventDefault(); e.returnValue = ''; }
            });
            form.addEventListener('submit', () => {
              try { sessionStorage.setItem(key, JSON.stringify({ t: Date.now(), data: serialize() })); } catch {}
              dirty = false;
            });

            // restore after a failed save / session bounce
            try {
              const raw = sessionStorage.getItem(key);
              if (raw) {
                sessionStorage.removeItem(key);
                const { t, data } = JSON.parse(raw);
                const fresh = Date.now() - t < 10 * 60 * 1000;
                const hadError = !!document.querySelector('.notice--error');
                const fromLogin = document.referrer.includes('/login');
                if (fresh && (hadError || fromLogin)) {
                  const values = JSON.parse(data) as Record<string, string[]>;
                  for (const [name, vals] of Object.entries(values)) {
                    if (name.startsWith('__cb__')) {
                      const cb = form.querySelector<HTMLInputElement>(`input[type="checkbox"][name="${name.slice(6)}"]`);
                      if (cb) cb.checked = vals[0] === '1';
                      continue;
                    }
                    const els = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${CSS.escape(name)}"]`);
                    els.forEach((el, i) => {
                      if (el instanceof HTMLInputElement && (el.type === 'checkbox' || el.type === 'hidden' && el.name.endsWith('_orig[]'))) return;
                      if (vals[i] != null) el.value = vals[i];
                    });
                  }
                  form.dispatchEvent(new Event('input', { bubbles: true }));
                  baseline = hadError ? baseline : serialize(); // after login-bounce restore, treat as dirty state to re-save
                  dirty = serialize() !== baseline;
                  if (fromLogin && !hadError) {
                    const note = document.createElement('p');
                    note.textContent = 'Your session had expired before saving — your entries were restored. Review and save again.';
                    note.style.cssText = 'margin:0 0 1rem;padding:0.7rem 1rem;font-size:0.8rem;color:#c9a668;border:1px solid rgba(201,166,104,0.35);border-radius:3px;';
                    form.parentElement?.insertBefore(note, form);
                  }
                }
              }
            } catch {}
          }
        }

        // --- session keepalive: an idle-but-visible tab refreshes its session
        // via the middleware (which rotates tokens) instead of silently dying.
        // 10-minute interval — comfortably under the 1h token lifetime — and
        // never fires while the tab is hidden; a focus event catches up
        // immediately when the user returns.
        {
          const ping = () => {
            if (document.visibilityState !== 'visible') return;
            fetch('/admin/api/session-ping', { credentials: 'same-origin', redirect: 'manual' }).catch(() => {});
          };
          setInterval(ping, 10 * 60 * 1000);
          window.addEventListener('focus', ping);
        }
      </script>
      <aside class="sidebar" id="admin-sidebar">
        <!-- The wordmark leaves the back office for the public site. Nothing
             is lost by not pointing it at /admin: Dashboard is the first item
             in the nav directly below it. -->
        <a class="brand" href="/" title="View the public site" aria-label="View the public site">
          <img src="/brand/buxena-logo-champagne.png" alt="" width="1536" height="1024" />
        </a>

        <nav class="nav">
          <ul>
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={
                    (item.href === '/admin' ? path === '/admin' : isActive(item.href)) ? 'page' : undefined
                  }
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={ICONS[item.icon]}
                  />
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="account">
          {staffLabel && (
            <div class="account__who">
              <span class="account__avatar" aria-hidden="true">{initials || 'BX'}</span>
              <span class="account__meta">
                <span class="account__name">{staffLabel}</span>
                {staffSublabel && <span class="account__role">{staffSublabel}</span>}
              </span>
            </div>
          )}
          <form method="POST" action="/api/logout">
            <button type="submit" title="Sign out">Sign Out</button>
          </form>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <button class="hamburger" type="button" data-hamburger aria-expanded="false" aria-controls="admin-sidebar" aria-label="Open navigation">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h16" /></svg>
          </button>
          <div class="topbar__title">
            {parentLabel && parentHref && (
              <a class="topbar__back" href={parentHref}>← {parentLabel}</a>
            )}
            <h1>{title} <slot name="title-badge" /></h1>
            {subtitle && <p>{subtitle}</p>}
          </div>
          {search && (
            <form class="topbar__search" method="GET" action={search.action} role="search">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" />
              </svg>
              <input
                type="search"
                name={search.name ?? 'q'}
                placeholder={search.placeholder ?? 'Search…'}
                value={Astro.url.searchParams.get(search.name ?? 'q') ?? ''}
              />
            </form>
          )}
          <div class="topbar__actions">
            {printDocuments?.length ? (
              <ExportMenu
                label="Print"
                variant="ghost"
                options={[
                  { label: 'Print this page', action: 'print', icon: 'printer' },
                  { divider: true },
                  ...printDocuments.map((d) => ({ label: d.label, href: d.href, icon: 'file' as const })),
                ]}
              />
            ) : (
              <button class="print-btn" type="button" onclick="window.print()">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 8V3.5h10V8M7 16H4.5V9.5h15V16H17M7 13.5h10V20H7z" /></svg>
                Print
              </button>
            )}
            <slot name="actions" />
          </div>
        </header>
        <main class="content">
          {/* print-only header: logo image ONLY left; title block right. No company name text. */}
          <div class="print-letterhead" aria-hidden="true">
            <img src="/brand/buxena-logo-compact.png" alt="" />
            <div class="print-letterhead__title">
              <span class="print-letterhead__doc">{title} <slot name="title-badge" /></span>
              {subtitle && <span class="print-letterhead__sub">{subtitle}</span>}
              <span class="print-letterhead__sub">Generated {printGeneratedAt.toISOString().slice(0, 10)} {printGeneratedAt.toTimeString().slice(0, 5)}</span>
            </div>
          </div>
          <p class="print-form-notice" aria-hidden="true">
            This is an editing view. To print this record, open its detail page and print from there.
          </p>
          <slot />
          {/* print-only footer: address lines left (no company name), status right */}
          <div class="print-footer" aria-hidden="true">
            <div class="print-footer__left">
              {printSettings.company_address && <span>{printSettings.company_address}</span>}
              {(() => {
                const l2 = [
                  printSettings.company_email,
                  printSettings.company_phone,
                  printSettings.company_website,
                  (printSettings as any).company_ein ? `EIN ${(printSettings as any).company_ein}` : null,
                ].filter(Boolean).join(' · ');
                return l2 ? <span>{l2}</span> : null;
              })()}
            </div>
            <div class="print-footer__right">
              <span>Internal document</span>
              <span class="print-footer__page"></span>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

<style>
  * { box-sizing: border-box; }

  :root {
    --admin-bg: #11100e;
    --admin-panel: #181613;
    --admin-panel-2: #1d1a16;
    --admin-border: rgba(212, 184, 140, 0.1);
    --admin-cream: #f2ede3;
    --admin-muted: rgba(242, 237, 227, 0.55);
    --admin-gold: #c9a668;
    --admin-gold-deep: #b98a45;
    --admin-sidebar: #0c0b0a;
  }

  html, body {
    margin: 0;
    min-height: 100%;
    background: var(--admin-bg);
    color: var(--admin-cream);
    font-family: 'Jost', system-ui, sans-serif;
  }

  .shell { display: flex; min-height: 100vh; }

  /* --- sidebar: narrow, dense, black --- */
  .sidebar {
    width: 12.75rem;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    background: var(--admin-sidebar);
    border-right: 1px solid var(--admin-border);
    padding: 1rem 0.7rem 0.85rem;
  }

  /* Lockup spans the sidebar minus 16px clear each side (sidebar has 11.2px
     side padding; the extra 4.8px lives here). 20px above, 28px below before
     "Dashboard". No max-width cap — width drives, height follows the ratio. */
  .brand { display: block; padding: 4px 4.8px 28px; }
  .brand img { width: 100%; height: auto; display: block; }

  .nav { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .nav a {
    display: flex;
    align-items: center;
    gap: 11px;
    /* 8px (was 10px): trimmed so logo + 15 nav items + sign-out fit a 900px
       viewport without sidebar scroll — per spec, nav padding gives, not the logo */
    padding: 8px 0.55rem;
    border-left: 2px solid transparent;
    border-radius: 3px;
    font-size: 15px;
    letter-spacing: 0.02em;
    color: var(--admin-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.12s ease, color 0.12s ease;
  }
  .nav a svg { flex: 0 0 auto; opacity: 0.75; }
  .nav a:hover { color: var(--admin-cream); background: rgba(255, 255, 255, 0.04); }
  .nav a[aria-current='page'] {
    color: var(--admin-gold);
    background: rgba(201, 166, 104, 0.1);
    border-left-color: var(--admin-gold);
  }
  .nav a[aria-current='page'] svg { opacity: 1; }

  /* --- sidebar footer: user + role --- */
  .account {
    margin-top: 0.7rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--admin-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .account__who { display: flex; align-items: center; gap: 0.5rem; min-width: 0; padding: 0 0.15rem; }
  .account__avatar {
    flex: 0 0 auto;
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--admin-gold);
    background: rgba(201, 166, 104, 0.12);
    border: 1px solid rgba(201, 166, 104, 0.3);
    border-radius: 50%;
  }
  .account__meta { display: flex; flex-direction: column; min-width: 0; }
  .account__name {
    font-size: 0.72rem;
    color: var(--admin-cream);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .account__role {
    font-size: 0.58rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--admin-muted);
  }
  .account form { margin: 0; }
  .account button {
    width: 100%;
    padding: 0.38rem 0.6rem;
    font-family: inherit;
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--admin-muted);
    background: none;
    border: 1px solid var(--admin-border);
    border-radius: 3px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .account button:hover { color: var(--admin-cream); border-color: var(--admin-gold); }

  /* --- main column --- */
  .main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }

  /* compact dark header — part of the shell (canvas bg), not a card */
  .topbar {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.6rem 1.25rem;
    min-height: 4.25rem;
    background: var(--admin-bg);
    border-bottom: 1px solid rgba(201, 166, 104, 0.12);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  /* title top-left, primary action bottom-right — opposing corners of the band */
  .topbar__title { min-width: 0; align-self: flex-start; padding-top: 0.2rem; }
  .topbar__back {
    display: inline-block;
    margin-bottom: 6px;
    font-size: 0.6875rem; /* ~11px */
    color: rgba(242, 237, 227, 0.55);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .topbar__back:hover { color: #c9a668; text-decoration: underline; }
  .topbar__title h1 {
    margin: 0;
    font-size: 1.375rem; /* ~22px — warm off-white; gold is for accents only */
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--admin-cream);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topbar__title p {
    margin: 0.15rem 0 0;
    font-size: 0.6875rem; /* ~11px */
