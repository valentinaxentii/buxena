---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { site, publicEmail } from '../data/site';

interface Props {
  title: string;
  /** Bypasses the "Title · BUXENA" template with an exact, fully-formed <title>. */
  fullTitle?: string;
  description?: string;
  /** Social-share preview image, absolute or site-root-relative. Defaults to site.ogImage. */
  image?: string;
  /** Transparent header over a dark hero (homepage + landing pages). */
  overHero?: boolean;
  noindex?: boolean;
}

const {
  title,
  fullTitle,
  description = site.description,
  image = site.ogImage,
  overHero = false,
  noindex = false,
} = Astro.props;

const pageTitle =
  fullTitle ?? (title === 'home' ? `${site.name} — ${site.tagline}` : `${title} · ${site.name}`);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  slogan: site.tagline,
  description: site.description,
  url: Astro.site?.href,
  ...(publicEmail ? { email: publicEmail } : {}),
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: Astro.site?.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#1b1917" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@200;300;400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />

    <!-- pages can inject page-specific structured data here -->
    <slot name="head" />
    <!-- Reveal animations depend on a script adding .is-in; without any
         JavaScript, content must simply be visible — never hidden. -->
    <noscript>
      <style>
        .reveal, .reveal * { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overHero={overHero} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ChatWidget />

    <script>
      import { track, type TrackEvent, type TrackPayload } from '../lib/track';

      // Delegated conversion tracking. Any element carrying data-track="<event>"
      // fires that event on click, with every data-track-* attribute passed
      // through as payload (e.g. data-track-model="BUH-ELLA H2"). One listener
      // for the whole site — no per-page wiring, nothing to forget on a new page.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-track]');
        if (!el) return;

        const event = el.dataset.track as TrackEvent;
        const payload: TrackPayload = {};

        for (const [key, value] of Object.entries(el.dataset)) {
          if (key === 'track' || !key.startsWith('track') || value === undefined) continue;
          // data-track-model -> "model"
          const name = key.slice(5).replace(/^[A-Z]/, (c) => c.toLowerCase());
          payload[name] = value;
        }

        track(event, payload);
      });

      // tel: and mailto: links are high-intent on a phone — tracked wherever
      // they appear, without each one needing a data-track attribute.
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a[href^="tel:"], a[href^="mailto:"]');
        if (!link) return;
        track(link.href.startsWith('tel:') ? 'phone_click' : 'email_click', {
          href: link.href,
        });
      });
    </script>

    <script>
      // Scroll reveal. Respects reduced-motion by simply never arming.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
