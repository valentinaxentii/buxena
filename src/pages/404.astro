---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex={true} description="That page has moved or no longer exists. Browse the BUXENA sauna range, or tell us about your project and we will point you to the right model.">
  <section class="band nf">
    <div class="shell shell--narrow center">
      <span class="eyebrow">404</span>
      <h1 class="display">This room does not exist</h1>
      <p class="lead">The page you were looking for is not here.</p>
      <div class="nf__actions">
        <a class="btn btn--solid" href="/">Return home</a>
        <a class="btn btn--outline" href="/saunas/">Browse the saunas</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding-block: clamp(3.83rem, 2.55rem + 6.38vw, 7.65rem); }
  .nf .lead { margin: 1.5rem auto 0; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: 1.91rem; }
</style>
