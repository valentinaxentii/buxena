---
export const prerender = false;

/**
 * Secure, customer-facing BUXENA proposal.
 *
 * Only a random 160-bit share token reaches a quote. Raw database rows are
 * projected through `toCustomerProposal()` before rendering, so internal
 * costs, margin controls, supplier notes and internal notes never enter the
 * component tree. The all-zero token is a DEV-only fixture for visual QA and
 * is unreachable in production.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CustomerProposalDocument from '../../components/proposal/CustomerProposalDocument.astro';
import { createSupabaseAdminClient } from '../../lib/supabase-admin';
import { publicEmail } from '../../data/site';
import { getCollection } from 'astro:content';
import { publicAssets } from '../../lib/product-assets';
import {
  isValidShareToken,
  toCustomerProposal,
  isAcceptable,
  type CustomerProposal,
} from '../../lib/quote-proposal';

const { token = '' } = Astro.params;
const DEV_PREVIEW_TOKEN = '0'.repeat(40);
const preview = import.meta.env.DEV && token === DEV_PREVIEW_TOKEN;

let proposal: CustomerProposal | null = null;
let notFound = false;
let acceptable: { ok: boolean; reason?: string } = { ok: false };
const justAccepted = Astro.url.searchParams.get('accepted') === '1';
const acceptError = Astro.url.searchParams.get('error');

if (preview) {
  const fixtureQuote = {
    quote_number: 'BUX-PROPOSAL-1048',
    quote_date: new Date().toISOString().slice(0, 10),
    expiry_date: new Date(Date.now() + 6 * 86_400_000).toISOString().slice(0, 10),
    status: 'Sent',
    heater: 'Harvia electric heater package with controls and stones',
    subtotal: 21_790,
    delivery_cost: 850,
    installation_cost: 0,
    discount: 750,
    tax_rate: 6.35,
    total: 23_279.90,
    delivery_state: 'included',
    installation_state: 'separate',
    customer_notes: 'Delivery access, final heater sizing and the exact foundation plan will be confirmed during the pre-order project review.',
  };
  const fixtureItems = [
    { kind: 'sauna', description: 'BUX EDA 235 outdoor barrel sauna', quantity: 1, unit_price: 18_650, line_total: 18_650 },
    { kind: 'heater', description: 'Harvia electric heater', quantity: 1, unit_price: 1_790, line_total: 1_790 },
    { kind: 'controls', description: 'Digital control package', quantity: 1, unit_price: 500, line_total: 500 },
    { kind: 'accessories', description: 'Sauna stones and heater guard', quantity: 1, unit_price: 0, line_total: 0 },
    { kind: 'delivery', description: 'Residential delivery coordination', quantity: 1, unit_price: 850, line_total: 850 },
  ];
  proposal = toCustomerProposal(fixtureQuote, fixtureItems, {
    customerName: 'Valery Smith',
    modelName: 'BUX EDA 235',
    ownerName: 'Valentin Axentii',
    ownerEmail: publicEmail,
    product: {
      dimensions: { width: 80.7, depth: 92.5, height: 84.6, unit: 'in' },
      capacity: '4–6 people',
      timber_type: 'Nordic Spruce / Thermo Pine',
      glass_configuration: 'Tempered glass door; glazing confirmed with final configuration',
      electrical_requirements: 'Final voltage, breaker and conductor sizing are matched to the selected heater and confirmed before order.',
      weight_kg: 720,
      shipping_dimensions: 'Confirmed on the final packing list',
      warranty_duration_months: 24,
    },
    inventory: [{ available: 2, incoming: 1, eta: new Date(Date.now() + 21 * 86_400_000).toISOString().slice(0, 10) }],
  });
} else if (!isValidShareToken(token)) {
  notFound = true;
} else {
  try {
    const supabase = createSupabaseAdminClient();
    const { data: quote } = await supabase
      .from('quotes')
      .select('*')
      .eq('share_token', token)
      .maybeSingle();

    if (!quote) {
      notFound = true;
    } else {
      const productPromise = quote.product_id
        ? supabase
            .from('products')
            .select('model_name, dimensions, capacity, timber_type, glass_configuration, electrical_requirements, weight_kg, shipping_dimensions, brochure_url, installation_manual_url, warranty_document_url')
            .eq('id', quote.product_id)
            .maybeSingle()
        : Promise.resolve({ data: null });
      const warrantyPromise = quote.product_id
        ? supabase.from('products').select('warranty_duration_months').eq('id', quote.product_id).maybeSingle()
        : Promise.resolve({ data: null });
      const inventoryPromise = quote.product_id
        ? supabase.from('inventory').select('available, incoming, eta').eq('product_id', quote.product_id)
        : Promise.resolve({ data: [] });

      const [itemRows, customerRow, productRow, warrantyRow, inventoryRows, ownerRow] = await Promise.all([
        supabase.from('quote_items').select('*').eq('quote_id', quote.id).order('sort_order'),
        quote.customer_id
          ? supabase.from('customers').select('name').eq('id', quote.customer_id).maybeSingle()
          : Promise.resolve({ data: null }),
        productPromise,
        warrantyPromise,
        inventoryPromise,
        quote.owner_staff_id
          ? supabase.from('profiles').select('full_name').eq('id', quote.owner_staff_id).maybeSingle()
          : Promise.resolve({ data: null }),
      ]);

      const customerProduct = {
        ...((productRow.data as Record<string, unknown> | null) ?? {}),
        ...((warrantyRow.data as Record<string, unknown> | null) ?? {}),
      };

      proposal = toCustomerProposal(quote, itemRows.data ?? [], {
        customerName: (customerRow.data as any)?.name ?? null,
        modelName: (productRow.data as any)?.model_name ?? null,
        ownerName: (ownerRow.data as any)?.full_name ?? null,
        ownerEmail: publicEmail,
        product: customerProduct,
        inventory: inventoryRows.data ?? [],
      });
      acceptable = isAcceptable(quote);

      if (!quote.viewed_at) {
        await supabase
          .from('quotes')
          .update({
            viewed_at: new Date().toISOString(),
            ...(quote.status === 'Sent' ? { status: 'Viewed' } : {}),
          })
          .eq('id', quote.id)
          .then(() => {}, () => {});
      }
    }
  } catch {
    notFound = true;
  }
}

let catalogue: {
  href?: string;
  image?: { src: string; alt: string };
  gallery?: { src: string; alt: string }[];
  capacity?: string;
  dimensions?: { label: string; value: string }[];
  materials?: string[];
  specs?: { label: string; value: string }[];
  video?: { title: string; href: string; embedSrc?: string; poster?: string };
} = {};

if (proposal?.modelName) {
  const catalog = await getCollection('saunas', ({ data }) => !data.draft);
  const target = proposal.modelName.trim().toLowerCase();
  const modelEntry = catalog.find((model) => model.data.title.trim().toLowerCase() === target);
  if (modelEntry) {
    const videoAsset = publicAssets(modelEntry.data.technicalAssets).find(({ slot }) => slot.kind === 'video');
    const videoUrl = videoAsset?.asset.url?.trim() ?? '';
    const youtubeId = videoUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]{6,})/)?.[1];
    const vimeoId = videoUrl.match(/vimeo\.com\/(?:video\/)?(\d+)/)?.[1];
    const embedSrc = youtubeId
      ? `https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0`
      : vimeoId
        ? `https://player.vimeo.com/video/${vimeoId}`
        : undefined;
    catalogue = {
      href: `/saunas/${modelEntry.id}/`,
      image: modelEntry.data.heroImage?.src
        ? { src: modelEntry.data.heroImage.src, alt: modelEntry.data.heroImage.alt }
        : undefined,
      gallery: modelEntry.data.gallery
        .filter((image) => Boolean(image.src))
        .map((image) => ({ src: image.src!, alt: image.alt })),
      capacity: modelEntry.data.capacity,
      dimensions: modelEntry.data.dimensions,
      materials: modelEntry.data.materials,
      specs: modelEntry.data.specs,
      video: videoAsset && videoUrl
        ? {
            title: videoAsset.asset.title || videoAsset.slot.label,
            href: videoUrl,
            embedSrc,
            poster: videoAsset.asset.poster,
          }
        : undefined,
    };
  }
}

if (notFound) Astro.response.status = 404;
---

<BaseLayout
  title={proposal ? `Proposal ${proposal.quoteNumber}` : 'Proposal'}
  description="Your personalized BUXENA sauna proposal."
  noindex={true}
  documentMode={true}
>
  {notFound && (
    <section class="band">
      <div class="shell shell--narrow proposal-missing">
        <span class="eyebrow">Proposal</span>
        <h1 class="h2">We couldn't find that proposal</h1>
        <p class="lead">The link may have expired or been replaced. Contact your BUXENA advisor and we will send a fresh link.</p>
        {publicEmail && <p><a class="btn btn--bronze" href={`mailto:${publicEmail}`}>Contact BUXENA</a></p>}
      </div>
    </section>
  )}

  {proposal && (
    <CustomerProposalDocument
      proposal={proposal}
      token={token}
      acceptable={acceptable}
      justAccepted={justAccepted}
      acceptError={acceptError}
      preview={preview}
      catalogue={catalogue}
    />
  )}
</BaseLayout>

{proposal && !preview && (
  <script is:inline define:vars={{ token, quoteNumber: proposal.quoteNumber, modelName: proposal.modelName }}>
    try {
      var value = { token: token, quoteNumber: quoteNumber, modelName: modelName, savedAt: new Date().toISOString() };
      localStorage.setItem('buxena-last-proposal', JSON.stringify(value));
    } catch (e) { /* private browsing / storage unavailable */ }
  </script>
)}

<style>
  .proposal-missing { text-align: center; }
  .proposal-missing .lead { margin: 1.2rem auto 1.75rem; }
</style>
