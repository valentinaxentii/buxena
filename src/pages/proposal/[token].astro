---
export const prerender = false;

/**
 * The customer's personalized BUXENA proposal.
 *
 * SECURITY POSTURE
 * ----------------
 * Reached only by a 160-bit random token, never by the quote's uuid, so
 * proposals cannot be enumerated and a leaked admin id exposes nothing. The
 * page is READ-ONLY: the single write it permits is acceptance, which goes
 * through POST /api/proposal-accept and is re-validated there. No price, id or
 * status is ever taken from the URL or the DOM.
 *
 * The raw quote row never reaches this template. `toCustomerProposal()` builds
 * an allow-listed projection, so unit cost, margin and internal notes cannot
 * appear here even if someone later edits the markup carelessly — the fields
 * simply are not present on the object.
 *
 * Noindex: a personalized price for one named customer must never be indexed.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseAdminClient } from '../../lib/supabase-admin';
import { site, publicEmail } from '../../data/site';
import {
  ITEM_GROUPS,
  FULFILMENT_LABELS,
  isValidShareToken,
  toCustomerProposal,
  isAcceptable,
  type CustomerProposal,
} from '../../lib/quote-proposal';

const { token } = Astro.params;

let proposal: CustomerProposal | null = null;
let notFound = false;
let acceptable: { ok: boolean; reason?: string } = { ok: false };
let justAccepted = Astro.url.searchParams.get('accepted') === '1';

// A malformed token is refused before it can reach a query.
if (!isValidShareToken(token)) {
  notFound = true;
} else {
  try {
    const supabase = createSupabaseAdminClient();
    const { data: quote } = await supabase
      .from('quotes')
      .select('*')
      .eq('share_token', token)
      .maybeSingle();

    if (!quote) {
      notFound = true;
    } else {
      const [itemRows, customerRow, productRow, ownerRow] = await Promise.all([
        supabase.from('quote_items').select('*').eq('quote_id', quote.id).order('sort_order'),
        quote.customer_id
          ? supabase.from('customers').select('name').eq('id', quote.customer_id).maybeSingle()
          : Promise.resolve({ data: null }),
        quote.product_id
          ? supabase.from('products').select('model_name').eq('id', quote.product_id).maybeSingle()
          : Promise.resolve({ data: null }),
        quote.owner_staff_id
          ? supabase.from('profiles').select('full_name, email').eq('id', quote.owner_staff_id).maybeSingle()
          : Promise.resolve({ data: null }),
      ]);

      proposal = toCustomerProposal(quote, itemRows.data ?? [], {
        customerName: (customerRow.data as any)?.name ?? null,
        modelName: (productRow.data as any)?.model_name ?? null,
        ownerName: (ownerRow.data as any)?.full_name ?? null,
        ownerEmail: (ownerRow.data as any)?.email ?? null,
      });
      acceptable = isAcceptable(quote);

      // First view is worth knowing and is genuinely measurable — it is a page
      // load, and the UI never claims more than that. Never overwritten, so it
      // records the first time rather than the last. Failure is ignored: a
      // telemetry write must not stop a customer seeing their proposal.
      if (!quote.viewed_at) {
        await supabase
          .from('quotes')
          .update({
            viewed_at: new Date().toISOString(),
            ...(quote.status === 'Sent' ? { status: 'Viewed' } : {}),
          })
          .eq('id', quote.id)
          .then(() => {}, () => {});
      }
    }
  } catch {
    // Missing table/column (migration not yet applied) or no database. Behave
    // as though the proposal does not exist rather than leaking a stack trace.
    notFound = true;
  }
}

const money = (n: number) =>
  n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 });

const grouped = proposal
  ? ITEM_GROUPS.map((g) => ({ ...g, items: proposal!.items.filter((i) => i.kind === g.kind) })).filter(
      (g) => g.items.length > 0
    )
  : [];

if (notFound) Astro.response.status = 404;
---

<BaseLayout
  title={proposal ? `Proposal ${proposal.quoteNumber}` : 'Proposal'}
  description="Your personalized BUXENA sauna proposal."
  noindex={true}
>
  {notFound && (
    <section class="band">
      <div class="shell shell--narrow prop-missing">
        <span class="eyebrow">Proposal</span>
        <h1 class="h2">We couldn't find that proposal</h1>
        <p class="lead">
          The link may have expired or been replaced. If you were expecting a
          proposal from us, reply to our last message and we'll send a fresh
          link.
        </p>
        {publicEmail && <p><a class="btn btn--bronze" href={`mailto:${publicEmail}`}>Contact BUXENA</a></p>}
      </div>
    </section>
  )}

  {proposal && (
    <article class="prop">
      <section class="band band--tight prop-head">
        <div class="shell shell--narrow">
          <span class="eyebrow">{site.name}</span>
          <h1 class="display">Personalized Sauna Proposal</h1>

          <dl class="prop-meta">
            {proposal.customerName && (
              <div><dt>Prepared for</dt><dd>{proposal.customerName}</dd></div>
            )}
            <div><dt>Reference</dt><dd>{proposal.quoteNumber}</dd></div>
            {proposal.quoteDate && <div><dt>Date</dt><dd>{proposal.quoteDate}</dd></div>}
            {proposal.expiryDate && (
              <div>
                <dt>Valid until</dt>
                <dd class={proposal.expired ? 'is-expired' : ''}>
                  {proposal.expiryDate}{proposal.expired ? ' — expired' : ''}
                </dd>
              </div>
            )}
          </dl>
        </div>
      </section>

      {(justAccepted || proposal.acceptedAt) && (
        <section class="band band--tight">
          <div class="shell shell--narrow">
            <p class="prop-accepted">
              <strong>Thank you — your acceptance is recorded.</strong>
              A member of the BUXENA team will be in touch to confirm the next
              step. Nothing has been charged.
            </p>
          </div>
        </section>
      )}

      {proposal.modelName && (
        <section class="band band--tight">
          <div class="shell shell--narrow">
            <h2 class="prop-h">Selected sauna</h2>
            <p class="prop-model">{proposal.modelName}</p>
          </div>
        </section>
      )}

      <section class="band band--tight">
        <div class="shell shell--narrow">
          <h2 class="prop-h">Your package</h2>

          {grouped.length === 0 ? (
            <p class="prop-empty">
              The detail of your package is being prepared. We'll be in touch
              shortly with the full breakdown.
            </p>
          ) : (
            <div class="prop-table-wrap">
              <table class="prop-table">
                <tbody>
                  {grouped.map((group) => (
                    <Fragment>
                      <tr class="prop-group"><th colspan="2" scope="colgroup">{group.label}</th></tr>
                      {group.items.map((item) => (
                        <tr>
                          <td>
                            {item.description}
                            {item.quantity !== 1 && <span class="prop-qty"> × {item.quantity}</span>}
                          </td>
                          <td class="prop-amount">
                            {proposal.hasPricing && item.lineTotal > 0 ? money(item.lineTotal) : '—'}
                          </td>
                        </tr>
                      ))}
                    </Fragment>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {/* Only ever the state actually chosen for this quote. Unset renders
              nothing — we never imply delivery or installation is included. */}
          {(proposal.delivery !== 'unset' || proposal.installation !== 'unset') && (
            <dl class="prop-fulfil">
              {proposal.delivery !== 'unset' && (
                <div><dt>Delivery</dt><dd>{FULFILMENT_LABELS[proposal.delivery]}</dd></div>
              )}
              {proposal.installation !== 'unset' && (
                <div><dt>Installation</dt><dd>{FULFILMENT_LABELS[proposal.installation]}</dd></div>
              )}
            </dl>
          )}
        </div>
      </section>

      {proposal.hasPricing && (
        <section class="band band--tight">
          <div class="shell shell--narrow">
            <dl class="prop-totals">
              <div><dt>Package subtotal</dt><dd>{money(proposal.subtotal)}</dd></div>
              {/* Shown ONLY when a real discount was approved. No crossed-out
                  MSRP, no manufactured saving. */}
              {proposal.discount > 0 && (
                <div class="prop-discount"><dt>Discount applied</dt><dd>−{money(proposal.discount)}</dd></div>
              )}
              <div class="prop-total"><dt>Total</dt><dd>{money(proposal.total)}</dd></div>
            </dl>
          </div>
        </section>
      )}

      {proposal.customerNotes && (
        <section class="band band--tight">
          <div class="shell shell--narrow">
            <h2 class="prop-h">Notes for you</h2>
            <p class="prop-notes">{proposal.customerNotes}</p>
          </div>
        </section>
      )}

      {acceptable.ok && (
        <section class="band band--tight prop-accept" id="accept">
          <div class="shell shell--narrow">
            <h2 class="prop-h">Ready to proceed?</h2>
            <p class="prop-accept__note">
              Accepting tells us you would like to go ahead with this package.
              It does not take payment and is not a contract — we will confirm
              everything with you in writing before anything is ordered.
            </p>
            <form class="prop-accept__form" method="POST" action="/api/proposal-accept">
              <input type="hidden" name="token" value={token} />
              <label class="prop-accept__field">
                <span>Your name</span>
                <input type="text" name="acceptedName" required maxlength="120" autocomplete="name" />
              </label>
              <button class="btn btn--bronze" type="submit">Accept this proposal</button>
            </form>
          </div>
        </section>
      )}

      {!acceptable.ok && acceptable.reason && !proposal.acceptedAt && (
        <section class="band band--tight">
          <div class="shell shell--narrow">
            <p class="prop-unavailable">{acceptable.reason}</p>
          </div>
        </section>
      )}

      <section class="band band--tight prop-foot">
        <div class="shell shell--narrow">
          <h2 class="prop-h">What happens next</h2>
          <ol class="prop-next">
            <li>We confirm the specification, delivery and site requirements with you.</li>
            <li>You receive written confirmation of the order and payment details.</li>
            <li>Nothing is ordered until you confirm in writing.</li>
          </ol>

          <p class="prop-warranty">
            Your sauna, heater and components each carry the applicable
            manufacturer's warranty. We provide the warranty information for
            your selected products before purchase.
          </p>

          <div class="prop-contact">
            {proposal.ownerName && <p><strong>{proposal.ownerName}</strong> — {site.name}</p>}
            {proposal.ownerEmail
              ? <p><a href={`mailto:${proposal.ownerEmail}`}>{proposal.ownerEmail}</a></p>
              : publicEmail && <p><a href={`mailto:${publicEmail}`}>{publicEmail}</a></p>}
          </div>

          <p class="prop-print">
            <button class="link" type="button" data-print>Print or save as PDF</button>
          </p>
        </div>
      </section>
    </article>
  )}
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .prop-missing { text-align: center; }
  .prop-missing .lead { margin: 1.2rem auto 1.75rem; }

  .prop-head { padding-bottom: 0; }
  .prop-head .display { margin-top: 0.5rem; }

  .prop-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem 2rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .prop-meta dt {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .prop-meta dd { margin: 0.3rem 0 0; font-size: 1.0625rem; color: var(--ink); }
  .prop-meta .is-expired { color: #9a4b2f; }

  .prop-h {
    font-family: var(--font-sans);
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .prop-model { font-family: var(--font-display); font-size: var(--t-h3); margin: 0; }

  .prop-accepted {
    padding: 1rem 1.25rem;
    background: var(--linen-deep);
    border-left: 3px solid var(--bronze);
    font-size: var(--t-small);
    line-height: 1.65;
    margin: 0;
  }

  /* The table scrolls inside its own box rather than the page — long
     accessory names must never make the whole proposal scroll sideways. */
  .prop-table-wrap { overflow-x: auto; }
  .prop-table { width: 100%; border-collapse: collapse; }
  .prop-table td, .prop-table th { padding: 0.7rem 0; border-bottom: 1px solid var(--line); text-align: left; }
  .prop-group th {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bronze-ink);
    padding-top: 1.4rem;
  }
  .prop-amount { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .prop-qty { color: var(--muted); }

  .prop-fulfil { display: grid; gap: 0.5rem; margin-top: 1.5rem; }
  .prop-fulfil div { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--t-small); }
  .prop-fulfil dt { color: var(--muted); }
  .prop-fulfil dd { margin: 0; }

  .prop-totals { display: grid; gap: 0.6rem; margin: 0; }
  .prop-totals div { display: flex; justify-content: space-between; gap: 1rem; }
  .prop-totals dd { margin: 0; font-variant-numeric: tabular-nums; }
  .prop-discount { color: var(--bronze-ink); }
  .prop-total {
    padding-top: 0.8rem;
    border-top: 2px solid var(--ink);
    font-family: var(--font-display);
    font-size: var(--t-h3);
  }

  .prop-notes, .prop-warranty { font-size: var(--t-small); line-height: 1.7; color: var(--muted-dark); white-space: pre-wrap; }
  .prop-empty { font-size: var(--t-small); color: var(--muted); font-style: italic; }
  .prop-unavailable { font-size: var(--t-small); color: var(--muted); font-style: italic; margin: 0; }

  .prop-accept { background: var(--linen-deep); }
  .prop-accept__note { font-size: var(--t-small); line-height: 1.7; color: var(--muted-dark); max-width: 46em; }
  .prop-accept__form { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.9rem; margin-top: 1.25rem; }
  .prop-accept__field { display: grid; gap: 0.35rem; flex: 1 1 16rem; }
  .prop-accept__field span {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .prop-accept__field input {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    padding: 0.6rem 0;
    border: none;
    border-bottom: 1.5px solid var(--line);
    background: transparent;
    border-radius: 0;
    width: 100%;
  }
  .prop-accept__field input:focus { border-color: var(--bronze); outline: none; }

  .prop-next { margin: 0 0 1.5rem; padding-left: 1.1rem; font-size: var(--t-small); line-height: 1.8; color: var(--muted-dark); }
  .prop-contact { margin-top: 1.5rem; font-size: var(--t-small); line-height: 1.7; }
  .prop-contact p { margin: 0; }
  .prop-print { margin-top: 1.75rem; }

  @media (max-width: 560px) {
    .prop-meta { grid-template-columns: 1fr; gap: 0.9rem; }
    .prop-accept__form { flex-direction: column; align-items: stretch; }
    .prop-accept__form .btn { width: 100%; }
  }

  /* Printing IS the PDF. A browser's own print-to-PDF gives a customer a
     clean, correctly-paginated document with no engine to maintain — so the
     page is designed to print rather than shipping a second renderer. */
  @media print {
    :global(header), :global(footer), :global(.chat-fab), :global(.chat-panel),
    :global(.salesbar), .prop-print, .prop-accept { display: none !important; }
    :global(body) { background: #fff; color: #000; }
    .band { padding-block: 0.6rem !important; }
    .prop-table td, .prop-table th { border-color: #ccc; }
    .prop-total { border-top-color: #000; }
    .prop-accepted { border-left-color: #000; background: #f5f5f5; }
    /* Never split a package group across a page break mid-line. */
    .prop-table tr { break-inside: avoid; }
  }
</style>
