---
export const prerender = false;

import { createSupabaseServerClient } from '../lib/supabase-auth';
import { checkRateLimit } from '../lib/rate-limit';

// The requested destination survives the POST via a hidden field (belt) in
// addition to the query string (braces) — losing the query no longer dumps
// the user on the Dashboard. Only relative /admin paths are ever honoured;
// an external URL smuggled into `next` is rejected.
function safeNext(raw: string | null): string {
  const v = (raw ?? '').trim();
  if (!v.startsWith('/admin') || v.includes('\\') || v.startsWith('//')) return '/admin';
  // `/admin/../../somewhere` passes the prefix test but the browser resolves
  // it away from /admin before requesting it. Same-origin either way, so this
  // was never a redirect out of the site — it just meant a sign-in link could
  // land someone somewhere they did not expect. Resolve it here and re-check.
  const resolved = new URL(v, 'http://placeholder.invalid').pathname;
  return resolved.startsWith('/admin') ? resolved : '/admin';
}
const nextParam = Astro.url.searchParams.get('next');
let redirectTo = safeNext(nextParam);

let error: string | null = null;
let notConfigured = false;
// Preserved so a failed attempt never makes the user retype their email.
let submittedEmail = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = String(form.get('email') ?? '').trim();
  submittedEmail = email;
  const password = String(form.get('password') ?? '');
  // hidden field wins over the query so the destination can't be lost mid-POST
  redirectTo = safeNext(String(form.get('next') ?? '') || nextParam);

  if (!email || !password) {
    error = 'Enter both your email and password.';
  } else {
    // Gate on attempts, not just failures — a script that gets lucky
    // shouldn't get unlimited tries either. 10 per 10 minutes comfortably
    // covers a real person fumbling a password a few times.
    const { allowed, retryAfterSeconds } = checkRateLimit(`login:${Astro.clientAddress}`, 10, 10 * 60_000);
    if (!allowed) {
      error = `Too many sign-in attempts. Try again in ${Math.ceil(retryAfterSeconds / 60)} minute(s).`;
    } else {
      try {
        const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
        const { error: signInError } = await supabase.auth.signInWithPassword({ email, password });

        if (signInError) {
          // One uniform message for wrong password, unknown user and
          // unconfirmed email — no internal Supabase error text, and no
          // hint about which part was wrong.
          error = "We couldn't sign you in. Check your email and password and try again.";
        } else {
          return Astro.redirect(redirectTo);
        }
      } catch {
        notConfigured = true;
      }
    }
  }
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Staff Sign In · BUXENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap"
    />
  </head>
  <body>
    <main class="wrap">
      <div class="card">
        <img class="logo" src="/brand/buxena-logo-champagne.png" alt="BUXENA" width="1536" height="1024" />

        {notConfigured && (
          <p class="notice">
            Supabase isn't configured yet — set <code>SUPABASE_URL</code>,
            <code>SUPABASE_ANON_KEY</code> and <code>SUPABASE_SERVICE_ROLE_KEY</code> in your
            environment before signing in.
          </p>
        )}
        {error && <p class="notice notice--error">{error}</p>}

        <form method="POST" class="form" data-login-form>
          <input type="hidden" name="next" value={redirectTo} />
          <label class="field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="username" required value={submittedEmail} />
          </label>
          <label class="field">
            <span>Password</span>
            <span class="field__pw">
              <input type="password" name="password" autocomplete="current-password" required data-pw-input />
              <button type="button" class="pw-toggle" data-pw-toggle aria-label="Show password" aria-pressed="false">Show</button>
            </span>
          </label>
          <button type="submit" class="submit" data-login-submit>Sign In</button>
        </form>

        <script is:inline>
          // Loading state: disable the button and show progress the moment a
          // valid form submits, so a slow network never looks like a dead
          // button. Native validation still runs first.
          var loginForm = document.querySelector('[data-login-form]');
          var loginBtn = document.querySelector('[data-login-submit]');
          if (loginForm && loginBtn) {
            loginForm.addEventListener('submit', function () {
              loginBtn.disabled = true;
              loginBtn.textContent = 'Signing in…';
            });
          }

          // Password visibility toggle — keyboard accessible, state announced
          // via aria-pressed.
          var pwInput = document.querySelector('[data-pw-input]');
          var pwToggle = document.querySelector('[data-pw-toggle]');
          if (pwInput && pwToggle) {
            pwToggle.addEventListener('click', function () {
              var show = pwInput.type === 'password';
              pwInput.type = show ? 'text' : 'password';
              pwToggle.textContent = show ? 'Hide' : 'Show';
              pwToggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
              pwToggle.setAttribute('aria-pressed', String(show));
            });
          }
        </script>

        <a class="forgot" href="/login/forgot-password">Forgot Password?</a>
      </div>
    </main>
  </body>
</html>

<style>
  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    min-height: 100%;
    background: #14120f;
    color: #f6f2ea;
    font-family: 'Jost', system-ui, sans-serif;
  }

  .wrap {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background:
      radial-gradient(ellipse at 50% -10%, rgba(184, 146, 90, 0.12), transparent 60%),
      #14120f;
  }

  .card {
    width: 100%;
    max-width: 26rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    padding: 3rem 2.5rem;
    border: 1px solid rgba(212, 184, 140, 0.16);
    border-radius: 2px;
  }

  .logo {
    width: 12rem;
    height: auto;
  }

  .form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(246, 242, 234, 0.65);
  }

  .field input {
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.95rem;
    letter-spacing: normal;
    text-transform: none;
    color: #f6f2ea;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(212, 184, 140, 0.25);
    border-radius: 1px;
    padding: 0.85rem 1rem;
    transition: border-color 0.3s ease;
  }

  .field input:focus {
    outline: none;
    border-color: #d4b88c;
  }

  .submit {
    margin-top: 0.43rem;
    padding: 0.95rem 1.5rem;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #14120f;
    background: #d4b88c;
    border: 1px solid #d4b88c;
    border-radius: 1px;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .submit:hover { background: #e6cda3; border-color: #e6cda3; }
  .submit:disabled { opacity: 0.65; cursor: default; }
  .submit:focus-visible, .pw-toggle:focus-visible, .field input:focus-visible {
    outline: 2px solid #d4b88c;
    outline-offset: 2px;
  }

  .field__pw { position: relative; display: block; }
  .field__pw input { width: 100%; padding-right: 4rem; }
  .pw-toggle {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 0.5rem 0.6rem;
    font-family: 'Jost', system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(246, 242, 234, 0.55);
    cursor: pointer;
  }
  .pw-toggle:hover { color: #d4b88c; }

  .forgot {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: rgba(246, 242, 234, 0.55);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .forgot:hover { color: #f6f2ea; border-bottom-color: rgba(246, 242, 234, 0.4); }

  .notice {
    width: 100%;
    margin: 0;
    padding: 0.85rem 1rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: rgba(246, 242, 234, 0.75);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 184, 140, 0.2);
    border-radius: 1px;
  }
  .notice code {
    font-size: 0.75rem;
    color: #d4b88c;
  }
  .notice--error {
    color: #e6b7a0;
    border-color: rgba(230, 130, 90, 0.35);
    background: rgba(230, 130, 90, 0.06);
  }
</style>
