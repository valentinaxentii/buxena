---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Figure from '../components/Figure.astro';
import CollectionCard from '../components/CollectionCard.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteBand from '../components/QuoteBand.astro';
import BuxenaMark from '../components/BuxenaMark.astro';
import { packages } from '../data/packages';
import { getCollection } from 'astro:content';

const saunas = await getCollection('saunas', ({ data }) => !data.draft);

const locationCount = (loc: string) => saunas.filter((s) => s.data.location === loc).length;
const typeCount = (type: string) => saunas.filter((s) => s.data.productType === type).length;

// The slim trust strip directly under the hero — four claims, each backed
// by what BUXENA actually does today.
const trustItems = [
  'European Design',
  'U.S. Project Support',
  'Complete Sauna Packages',
  'Delivery Coordination',
];

/**
 * IMAGE RIGHTS — rebuilt 2026-08-13 on cleared assets only.
 *
 * Three of these four tiles previously used images with NO identifiable source
 * at all (`collections/outdoor.png`, `collections/barrel.png`,
 * `collections/indoor.jpg` — bundled in 9562ea1 with no sourcing note). They
 * sat on the homepage, which is the page every share and every future ad lands
 * on. Nobody can grant rights to an image whose owner is unknown, so they were
 * not replaceable by asking — only by swapping.
 *
 * Every tile now points at an image whose provenance is documented:
 *   Outdoor · Cube · Indoor — Capra dealer-pack renders, WEBSITE APPROVED in
 *     writing (docs/image-rights-register.md §7). Exact-model rule respected:
 *     UKU 230 is an outdoor model, UKU 160 is a cube, ELLA H2 is indoor.
 *   Barrel — a Baltresto VIRU photograph. Supplier-owned and identifiable, so
 *     it is a PAID-ADVERTISING blocker rather than a launch blocker per the
 *     founder's 2026-08-13 ruling. It is the only barrel imagery we hold with
 *     a known owner; the unsourced alternative was strictly worse.
 *
 * The Cube tile also improves: it was a NORD Cube catalogue extraction
 * (supplier-owned, no permission on record) and is now Capra dealer-pack with
 * written website permission.
 *
 * BEFORE PAID ADVERTISING the Barrel tile still needs Baltresto's written
 * permission, and the three Capra tiles need their grant extended from website
 * to ads/social. Both are asked in the outreach drafts in docs/.
 */
const chooseTiles = [
  {
    name: 'Outdoor Saunas',
    blurb: 'Architectural backyard sauna systems',
    href: '/saunas/outdoor-saunas/',
    count: locationCount('outdoor'),
    image: '/images/catalog/uku-230-glass-front.jpg',
    alt: 'UKU 230 outdoor rounded-cube sauna in Nordic spruce with a full glass front',
    focus: 'center center',
    note: 'Outdoor Saunas — UKU 230, an outdoor model we sell.',
  },
  {
    name: 'Cube Saunas',
    blurb: 'Modern form, panoramic design',
    href: '/saunas/cube-saunas/',
    count: typeCount('Cube'),
    image: '/images/catalog/uku-160-glass-front.jpg',
    alt: 'UKU 160 rounded-cube sauna in Nordic spruce with a full glass front',
    focus: 'center center',
    note: 'Cube Saunas — UKU 160, a cube model we sell.',
  },
  {
    name: 'Barrel Saunas',
    blurb: 'Traditional shape, efficient footprint',
    href: '/saunas/barrel-saunas/',
    count: typeCount('Barrel'),
    image: '/images/saunas/viru-thermowood-2-4m-hero.jpg',
    alt: 'VIRU Thermowood 2.4m barrel sauna in thermo-treated timber with a glass door',
    focus: 'center center',
    note: 'Barrel Saunas — VIRU Thermowood 2.4m, a barrel model we sell.',
  },
  {
    name: 'Indoor Saunas',
    blurb: 'Integrated wellness for the home',
    href: '/saunas/indoor-saunas/',
    count: locationCount('indoor'),
    image: '/images/catalog/ella-h2-interior.jpg',
    alt: 'Interior of the ELLA H2 indoor sauna with timber benches and warm lighting',
    focus: 'center center',
    note: 'Indoor Saunas — ELLA H2, an indoor model we sell.',
  },
];

// WHY BUXENA — scannable, four short benefit blocks. BUXENA curates and
// imports; it is never described as a manufacturer.
const reasons = [
  {
    title: 'Curated in Europe',
    body: 'Every model is selected from established European sauna makers and specified for American homes.',
  },
  {
    title: 'Configured for Your Project',
    body: 'Heater, controls and options are matched to your room, power supply and site — before you order.',
  },
  {
    title: 'Delivered in the U.S.',
    body: 'Freight, customs and inland delivery coordinated to your address.',
  },
  {
    title: 'Project Support',
    body: 'One point of contact from selection through delivery, with site, electrical and installation guidance.',
  },
];

// Featured models — real, verified content only, chosen to avoid the
// imagery groups most clearly sourced from suppliers (VIRU, NORD).
const FEATURED_SLUGS = ['ella-h2', 'illi-h2', 'uku-160', 'uku-230'];
const featured = FEATURED_SLUGS.map((slug) => saunas.find((s) => s.id === slug)).filter(
  (s): s is NonNullable<typeof s> => Boolean(s)
);

// HOW IT WORKS — buyer-focused, no operational overclaims: no permit or
// electrical-approval promises, no nationwide-installation promise.
const steps = [
  { n: '01', title: 'Show us your space', body: 'Send dimensions, photographs, plans or even a rough sketch. That is enough to start.' },
  { n: '02', title: 'We match your sauna', body: 'We identify suitable models and configure the heater, controls and options around your project.' },
  { n: '03', title: 'Confirm the project', body: 'Review site access, foundation, electrical requirements, delivery and project pricing before the order is finalized.' },
  { n: '04', title: 'Delivery & completion', body: 'We coordinate delivery and provide the information needed to move the project through installation and first use.' },
];

// Wellness ecosystem — SAUNA is the real product category; COLD and REST
// are editorial/future categories and are labelled as such. No health
// claims anywhere in this section.
const wellnessPillars = [
  { key: 'sauna', label: 'Sauna', line: 'The core heat experience.', tag: 'The BUXENA range', href: '/saunas/' },
  { key: 'cold', label: 'Cold', line: 'The contrast that completes the heat.', tag: 'Editorial — future category' },
  { key: 'rest', label: 'Rest', line: 'The space between heat and cold.', tag: 'Editorial' },
];
---

<BaseLayout title="home" overHero={true}>
  <Hero />

  <!-- Trust / value strip -->
  <section class="band--ember trust reveal" id="intro">
    <div class="shell">
      <ul class="trust__list reveal" data-reveal-stagger>
        {trustItems.map((item) => (
          <li class="trust__item">
            <span class="slats" aria-hidden="true"></span>
            <span class="trust__label">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Brand statement — compact, supports the journey without interrupting it -->
  <section class="band band--tight intro-band">
    <div class="shell intro">
      <div class="intro__left reveal" data-reveal-stagger>
        <span class="eyebrow"><BuxenaMark /></span>
        <h2 class="h2">
          A sauna is a space that asks nothing of you.<br />
          <span class="serif-italic">That is the whole idea.</span>
        </h2>
      </div>
      <div class="intro__right reveal" data-reveal-stagger>
        <p class="lead">
          Every project is reviewed by someone who understands the models,
          site requirements, heater options and delivery process. We help
          you choose the right sauna — and avoid costly mistakes before you
          order.
        </p>
        <a class="link" href="/our-story/">Our story <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Choose Your Sauna -->
  <section class="band band--deep">
    <div class="shell">
      <div class="sec-head reveal">
        <span class="eyebrow">Choose Your Sauna</span>
        <h2 class="h2 measure--tight">Choose the sauna that fits your space</h2>
      </div>

      <div class="grid cols-4 reveal" data-reveal-stagger>
        {chooseTiles.map((tile) => (
          <CollectionCard
            name={tile.name}
            blurb={tile.blurb}
            href={tile.href}
            count={tile.count}
            image={tile.image}
            alt={tile.alt}
            focus={tile.focus}
            note={tile.note}
          />
        ))}
      </div>

      <p class="more-link reveal">
        <a class="link" href="/saunas/">View every model <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- Why BUXENA -->
  <section class="band band--ember">
    <div class="shell">
      <div class="sec-head reveal">
        <span class="eyebrow">Why <BuxenaMark /></span>
        <h2 class="h2 measure--tight">Why buy through BUXENA</h2>
      </div>
      <div class="grid cols-4 why reveal" data-reveal-stagger>
        {reasons.map((r) => (
          <div class="why__item">
            <span class="slats" aria-hidden="true"></span>
            <h3 class="h3 why__title">{r.title}</h3>
            <p class="why__body">{r.body}</p>
          </div>
        ))}
      </div>
      <div class="why__ctas reveal">
        <a
          class="btn btn--bronze"
          href="/start-your-project/"
          data-track="upload_project_click"
          data-track-form-type="why_buxena"
        >Start Your Project</a>
        <a
          class="btn btn--outline"
          href="/quote/"
          data-track="request_pricing_click"
          data-track-form-type="why_buxena"
        >Request Pricing</a>
      </div>
    </div>
  </section>

  <!-- Featured Saunas -->
  {featured.length > 0 && (
    <section class="band">
      <div class="shell">
        <div class="sec-head reveal">
          <span class="eyebrow">Featured Saunas</span>
          <h2 class="h2 measure--tight">Start with the models we recommend</h2>
          <p class="lead measure">
            The models we recommend for the most common home and outdoor
            projects.
          </p>
        </div>
        <div class="grid cols-4 reveal" data-reveal-stagger>
          {featured.map((s) => (
            <ProductCard
              slug={s.id}
              title={s.data.title}
              tagline={s.data.tagline}
              category={s.data.category}
              placeholder={s.data.placeholder}
              image={s.data.heroImage}
              location={s.data.location}
              productType={s.data.productType}
              series={s.data.series}
              capacity={s.data.capacity}
              capacityMin={s.data.capacityMin}
              capacityMax={s.data.capacityMax}
              materials={s.data.materials}
              dimensions={s.data.dimensions}
            fromPrice={s.data.fromPrice}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- BUXENA Complete — package comparison -->
  <!-- (The former "Not sure which sauna fits" decision strip was removed
       2026-08-11: its three CTAs all exist elsewhere on the page — Find My
       Sauna in the hero and Advisor band, See It In My Space on the Advisor
       journey, Upload My Project in Why-BUXENA and the final CTA band —
       and the duplication lengthened the page without adding a new action.) -->
  <section class="band" data-package-section>
    <div class="shell">
      <div class="sec-head reveal">
        <span class="eyebrow">BUXENA Complete</span>
        <h2 class="h2 measure--tight">One sauna. One properly matched system.</h2>
        <p class="lead measure">
          A complete sauna requires more than the room itself. We coordinate
          the sauna, heater, controls, stones, lighting and essential
          components as one project — so you do not have to source and match
          everything separately.
        </p>
      </div>

      <div class="pkgs reveal" data-reveal-stagger>
        {packages.map((pkg) => (
          <article class={`pkgs__card ${pkg.id === 'complete' ? 'pkgs__card--hero' : ''}`}>
            {pkg.flag && <span class="pkgs__flag">{pkg.flag}</span>}
            <h3 class="h3 pkgs__name">{pkg.name}</h3>
            {pkg.fromPrice && <p class="pkgs__price">{pkg.fromPrice}</p>}
            <p class="pkgs__summary">{pkg.summary}</p>
            <ul class="pkgs__list">
              {pkg.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {pkg.note && <p class="pkgs__note">{pkg.note}</p>}
            <a
              class={pkg.id === 'complete' ? 'btn btn--bronze pkgs__cta' : 'link pkgs__cta'}
              href={`/quote/?package=${encodeURIComponent(pkg.name)}`}
              data-track="package_selected"
              data-track-package={pkg.name}
              data-track-form-type="homepage_packages"
            >
              {pkg.id === 'complete' ? 'Build My Package' : (
                <Fragment>Request pricing <span class="arrow" aria-hidden="true">→</span></Fragment>
              )}
            </a>
          </article>
        ))}
      </div>

      <div class="pkgs__foot reveal">
        <p class="pkgs__confidence">
          Not sure which heater or controls your sauna needs? We specify the
          package around the actual model and project requirements.
        </p>
        <div class="pkgs__foot-ctas">
          <a
            class="btn btn--bronze"
            href="/quote/?package=BUXENA%20Complete"
            data-track="build_package_click"
            data-track-package="BUXENA Complete"
            data-track-form-type="homepage_packages"
          >Build My Package</a>
          <a
            class="btn btn--outline"
            href="/start-your-project/"
            data-track="project_pricing_click"
            data-track-package="BUXENA Project"
            data-track-form-type="homepage_packages"
          >Request Project Pricing</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="band band--deep" data-how-section>
    <div class="shell">
      <div class="sec-head reveal">
        <span class="eyebrow">How It Works</span>
        <h2 class="h2 measure--tight">Four steps, in order</h2>
      </div>

      <ol class="steps reveal" data-reveal-stagger>
        {steps.map((s) => (
          <li class="step">
            <span class="step__n">{s.n}</span>
            <div class="step__body">
              <h3 class="h3">{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="more-link reveal">
        <a class="link" href="/how-buying-works/">See how buying works, start to finish <span class="arrow" aria-hidden="true">→</span></a>
      </p>

      <!-- (The "Ready to start?" CTA trio was removed 2026-08-11 — the same
           three actions live in the hero, Why-BUXENA and the final CTA band;
           the steps now flow straight to the Advisor. The buying-process
           link above stays: it is the one action unique to this section.) -->
    </div>
  </section>

  <!-- Sauna Advisor -->
  <section class="band band--ember advisor">
    <div class="shell advisor__grid">
      <div class="reveal reveal--left">
        <span class="eyebrow">Sauna Advisor</span>
        <h2 class="h2 measure--tight">Find the sauna that fits your space.</h2>
        <p class="lead">
          Answer a few questions about your space, budget and priorities.
          We'll shortlist up to three models worth a closer look — no
          pressure, no commitment, no email required to see your results.
        </p>
        <a class="btn btn--bronze" href="/plan-your-sauna/">Start the Sauna Advisor</a>
      </div>
    </div>
  </section>

  <!-- For Trade -->
  <section class="band band--deep trade">
    <div class="shell trade__grid">
      <div class="reveal reveal--right">
        <span class="eyebrow">For Architects, Builders &amp; Hospitality</span>
        <h2 class="h2 measure--tight">Specify BUXENA for your next project.</h2>
        <p class="lead measure">
          Product specifications, project consultation, heater and control
          selection support, and delivery coordination — for residential,
          development and hospitality projects.
        </p>
        <div class="trade__ctas">
          <a class="btn btn--bronze" href="/for-trade/#trade-form">Submit a Project</a>
          <a class="link" href="/for-trade/">For Trade <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Wellness -->
  <section class="band band--birch">
    <div class="shell wellness">
      <div class="sec-head reveal">
        <span class="eyebrow">The Ritual</span>
        <h2 class="h2 measure--tight">Heat, cold, rest — and then again</h2>
        <p class="lead measure">
          The sauna is not a machine you sit inside. It is a rhythm, and the
          pauses are as much a part of it as the heat.
          <span class="wellness__transition">Build the ritual around your sauna.</span>
        </p>
      </div>

      <div class="grid cols-3 reveal" data-reveal-stagger>
        {/* IMAGE RIGHTS, 2026-08-13 — the three photographs that were here
            (ritual-01-loyly, ritual-02-cooling, ritual-03-rest) have no
            identifiable source, so no permission can ever be obtained for
            them. This is the homepage, so three empty tone blocks were not an
            acceptable answer either.

            The band is now typographic: the same three pillars, the same
            copy, the same links, carried by the brand's own slat motif and a
            large serif numeral instead of a photograph. Nothing is claimed
            that isn't true, and the section reads as an intentional editorial
            device rather than as missing content.

            When licensed or BUXENA-owned ritual photography exists, this can
            go back to <Figure> — the pillar data and layout are unchanged. */}
        {wellnessPillars.map((pillar, i) => (
          <div class="ritual-shot ritual-shot--type">
            <div class="ritual-card">
              <span class="slats" aria-hidden="true"></span>
              <span class="ritual-card__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <p class="ritual-shot__caption">{pillar.label}</p>
            <p class="ritual-shot__line">{pillar.line}</p>
            {pillar.href ? (
              <a class="ritual-shot__tag ritual-shot__tag--link" href={pillar.href}>{pillar.tag}</a>
            ) : (
              <span class="ritual-shot__tag">{pillar.tag}</span>
            )}
          </div>
        ))}
      </div>

      <div class="wellness__foot reveal">
        <a class="btn btn--outline" href="/wellness/">Explore Wellness</a>
        <a class="link" href="/plan-your-sauna/">Find My Sauna <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <QuoteBand />

  <script>
    import { track } from '../lib/track';

    // Section-view events, fired once each when the section first enters
    // the viewport. Cheap: two observers that disconnect after firing.
    const sections: Array<[string, 'package_view' | 'how_it_works_view']> = [
      ['[data-package-section]', 'package_view'],
      ['[data-how-section]', 'how_it_works_view'],
    ];
    if ('IntersectionObserver' in window) {
      for (const [selector, event] of sections) {
        const el = document.querySelector(selector);
        if (!el) continue;
        const io = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            track(event, {});
            io.disconnect();
          }
        }, { threshold: 0.2 });
        io.observe(el);
      }
    }
  </script>
</BaseLayout>

<style>
  /* --- trust strip --- */
  .trust {
    background: var(--ember);
    color: var(--linen);
    border-top: 1px solid var(--line-dark);
    padding-block: clamp(1.1rem, 0.85rem + 0.9vw, 1.7rem);
  }
  .trust__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem 2rem;
  }
  .trust__item { display: flex; align-items: center; gap: 0.9rem; }
  .trust__item .slats { color: var(--bronze-soft); flex: 0 0 auto; height: 1.1rem; width: 2rem; }
  .trust__label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }

  /* --- intro (compact) --- */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 0.4rem + 3vw, 3.5rem);
    align-items: center;
  }
  .intro__left .h2 { line-height: 1.14; font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.6rem); }

  /* The italic second line follows the headline by a beat — it sits inside
     the h2 (one stagger child), so it carries its own delayed transition
     keyed off the parent's is-in. */
  .intro__left .serif-italic {
    display: inline-block;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.8s var(--ease) 0.5s, transform 0.8s var(--ease) 0.5s;
  }
  .intro__left.is-in .serif-italic { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .intro__left .serif-italic { opacity: 1; transform: none; transition: none; }
  }
  .intro__right .link { margin-top: 0.9rem; }

  /* --- choose your sauna --- */
  .more-link { margin-top: clamp(1.9rem, 1.1rem + 1.9vw, 3rem); }

  /* --- why --- */
  .why__item .slats { color: var(--bronze-soft); margin-bottom: 1.1rem; }
  .why__title { margin-bottom: 0.7rem; }
  .why__body { font-size: 1rem; color: var(--muted-dark); line-height: 1.65; }
  .why__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.9rem, 1.2rem + 2vw, 3rem);
  }

  /* Homepage rhythm: sections sit ~12% closer than the site default so the
     journey reads as one continuous scroll (global --band elsewhere is
     untouched; this rule is scoped to this page's sections only). */
  .band { padding-block: calc(var(--band) * 0.88); }

  /* --- packages --- */
  /* COMPRESSED ~25%, 2026-08-14 — founder-approved, deliberate exception to
     Home's standing exclusion, scoped to ONLY this section via
     [data-package-section] and the .pkgs* classes below (Astro auto-scopes
     this whole style block to index.astro anyway, so none of this can leak
     into any other page). Nothing here touches font-size — every cut is
     padding, margin or line-height, per the explicit "do not make text
     tiny" constraint. */
  [data-package-section] { padding-block: clamp(1.25rem, 0.73rem + 2.2vw, 2.6rem); }
  /* Scoped, not a --sec-head-gap change — that token is shared by every
     "eyebrow / heading / lead" block sitewide, and this cut is specific to
     this one section. */
  [data-package-section] .sec-head { margin-bottom: clamp(0.95rem, 0.55rem + 1vw, 1.5rem); }
  /* Scoped, not a .btn change — same reasoning: .btn is the shared button
     class used by every CTA on every page. Vertical padding only, so click
     width is unaffected. */
  [data-package-section] .btn { padding-top: 0.8rem; padding-bottom: 0.8rem; }

  .pkgs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.9rem, 0.5rem + 1.2vw, 1.5rem);
    align-items: stretch;
  }
  .pkgs__card {
    display: flex;
    flex-direction: column;
    background: var(--linen);
    border: 1px solid var(--line);
    /* -25%: clamp(1.4rem,1rem+1.3vw,2.1rem) → ...,1.58rem. */
    padding: clamp(0.9rem, 0.65rem + 0.8vw, 1.35rem);
  }
  /* BUXENA Complete dominates: bronze frame, deeper ground, no size tricks */
  .pkgs__card--hero {
    background: var(--linen-deep);
    border: 2px solid var(--bronze);
  }
  .pkgs__flag {
    align-self: flex-start;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
    background: var(--bronze-btn);
    /* Vertical padding only -25% (0.4rem→0.3rem); horizontal untouched —
       this is a small label, not a spacing-heavy block. */
    padding: 0.3rem 0.8rem;
    margin-bottom: 0.65rem;
  }
  .pkgs__name { margin-bottom: 0.3rem; }
  .pkgs__price { font-size: var(--t-small); color: var(--bronze-ink); font-weight: 600; margin-bottom: 0.4rem; }
  /* line-height: leading, not font-size — a 2-3 line summary, not a long
     paragraph, so 1.3 still reads comfortably. */
  .pkgs__summary { font-size: var(--t-small); color: var(--muted); line-height: 1.3; margin-bottom: 0.65rem; }
  .pkgs__list { margin-bottom: 0.65rem; }
  .pkgs__list li {
    position: relative;
    font-size: var(--t-small);
