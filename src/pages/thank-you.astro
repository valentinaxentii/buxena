---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRecap from '../components/ProjectRecap.astro';
import ContinueExploring from '../components/ContinueExploring.astro';
import { getCollection } from 'astro:content';

// Pre-rendered, hidden per model — the actual submitted model is only known
// client-side (sessionStorage), but every recap's photo, capacity, dimensions
// and material are real, server-rendered catalogue facts. See my-project.astro
// for the same pattern.
const models = await getCollection('saunas', ({ data }) => !data.draft);
---

<BaseLayout title="Your project is started" description="Your request has been received." noindex={true}>
  <section class="band ty">
    <div class="shell shell--narrow center">
      <h1 class="display">Your project is started</h1>
      <p class="lead">
        Thank you. A BUXENA specialist will review your enquiry and come
        back to you directly.
      </p>

      <div class="ty__recaps" data-ty-recaps>
        {models.map((m) => (
          <div class="ty__recap" data-recap-title={m.data.title} hidden>
            <ProjectRecap
              modelTitle={m.data.title}
              modelHref={`/saunas/${m.id}/`}
              image={m.data.heroImage}
              capacity={m.data.capacity}
              dimensions={m.data.dimensions}
              materials={m.data.materials}
              compact
            />
          </div>
        ))}
      </div>

      <dl class="ty__summary" data-ty-summary hidden></dl>

      <div class="ty__actions">
        <a class="btn btn--bronze" href="/start-your-project/">Upload Photos / Plans</a>
        <a class="btn btn--outline" href="/consultation/">Book a Consultation</a>
        <a class="btn btn--outline" href="/compare/">Compare Models</a>
        <a class="btn btn--outline" href="/saunas/">Explore Recommended Saunas</a>
      </div>

      <div class="ty__explore">
        <ContinueExploring />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ty { padding-block: clamp(3.83rem, 2.55rem + 6.38vw, 7.65rem); }
  .ty .lead { margin: 1.3rem auto 0; max-width: 34em; }
  .ty__recaps { max-width: 26rem; margin: 2rem auto 0; text-align: left; }
  .ty__recap { margin: 0; }
  .ty__summary { max-width: 26rem; margin: 1.5rem auto 0; text-align: left; border-top: 2px solid var(--ink); padding-top: 0.43rem; }
  .ty__summary :global(div) { display: flex; justify-content: space-between; gap: 1.5rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); font-size: var(--t-small); }
  .ty__summary :global(dt) { color: var(--muted); margin: 0; }
  .ty__summary :global(dd) { margin: 0; text-align: right; }
  .ty__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 1.91rem; }
  @media (max-width: 560px) { .ty__actions { flex-direction: column; align-items: stretch; }.ty__actions .btn { justify-content: center; } }
  .ty__explore { max-width: 34rem; margin: 2.55rem auto 0; text-align: left; }
</style>

<script>
  import { track } from '../lib/track';

  const el = document.querySelector<HTMLElement>('[data-ty-summary]');
  let confirmed = false;
  try {
    const raw = sessionStorage.getItem('buxena:lastEnquiry');
    if (raw) {
      const s = JSON.parse(raw) as Record<string, string>;

      // THE conversion event. Ad platforms and GA4 count a lead here, on the
      // confirmation page, rather than on submit — it is the signal that the
      // enquiry actually completed.
      //
      // The progressive quote form is the exception: it counts the lead as
      // soon as step 1 succeeds, because step 2 is optional and an abandoned
      // step 2 must still be a conversion. Its summary carries
      // conversionTracked=true so this page does not count it twice.
      if (s.conversionTracked !== 'true') {
        track('lead_confirmed', {
          model: s.model ?? '',
          formType: s.request ?? s.formType ?? 'enquiry',
          zip: s.zip ?? '',
          timeline: s.timeline ?? '',
        });
      }
      confirmed = true;

      // Shows the model as a photo + spec recap only when it matches a real
      // catalogue entry. If it doesn't match (e.g. "Undecided", a heater, or
      // any value that isn't a model title), the recap stays hidden and the
      // plain-text row below still shows it — the fact is never dropped.
      let modelMatched = false;
      if (s.model) {
        const recap = document.querySelector<HTMLElement>(
          `[data-recap-title="${CSS.escape(s.model)}"]`
        );
        if (recap) { recap.hidden = false; modelMatched = true; }
      }

      if (el) {
        const LABELS: Record<string, string> = {
          ...(modelMatched ? {} : { model: 'Model' }),
          zip: 'ZIP code',
          timeline: 'Timeline',
          projectType: 'Project type',
        };

        /**
         * The six forms that reach this page store their <select> VALUES,
         * which are slugs — "1-3-months", "asap", "need-guidance", "outdoor".
         * Those are the right thing to store (the event above reads them, and
         * they must stay stable) and the wrong thing to show: the buyer was
         * reading "1–3 months" a second ago.
         *
         * Rendering-only. The stored object is untouched, so lead_confirmed
         * still carries the stable slug. No invented meaning: ranges are
         * re-spaced and the two known shorthands spelled out, nothing else.
         */
        const prettify = (value: string): string =>
          value
            .replace(/^(\d+)-(\d+)-months$/, '$1–$2 months')
            .replace(/^under-(\d+)k$/, 'Under $$$1,000')
            .replace(/^(\d+)-(\d+)k$/, '$$$1,000 – $$$2,000')
            .replace(/^(\d+)k-plus$/, '$$$1,000+')
            .replace(/^asap$/, 'As soon as possible')
            .replace(/^researching$/, 'Still researching')
            .replace(/^(\d+)-(\d+)$/, '$1–$2')
            .replace(/-/g, ' ')
            .replace(/^./, (c) => c.toUpperCase());

        const rows = Object.entries(s)
          .filter(([k, v]) => LABELS[k] && v)
          .map(([k, v]) => {
            const div = document.createElement('div');
            const dt = document.createElement('dt');
            dt.textContent = LABELS[k];
            const dd = document.createElement('dd');
            // ZIP is digits and the model carries its own casing — neither
            // wants slug treatment.
            dd.textContent =
              k === 'model' ? v.replace(/^BUH-/i, '') : k === 'zip' ? v : prettify(v);
            div.append(dt, dd);
            return div;
          });
        if (rows.length > 0) { el.append(...rows); el.hidden = false; }
      }

      sessionStorage.removeItem('buxena:lastEnquiry');
    }
  } catch {
    /* storage unavailable — generic page is fine */
  }

  if (!confirmed) track('thank_you_direct_visit', { formType: 'none' });
</script>
