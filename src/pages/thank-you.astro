---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Your project is started" description="Your request has been received." noindex={true}>
  <section class="band ty">
    <div class="shell shell--narrow center">
      <h1 class="display">Your project is started</h1>
      <p class="lead">
        Thank you. A BUXENA specialist will review your enquiry and come
        back to you directly.
      </p>

      <!-- Filled client-side from the summary the submitting form stored;
           stays hidden when no summary exists (direct visits, cleared
           storage) so the page never shows empty rows. -->
      <dl class="ty__summary" data-ty-summary hidden></dl>

      <div class="ty__actions">
        <a class="btn btn--bronze" href="/start-your-project/">Upload Photos / Plans</a>
        <a class="btn btn--outline" href="/consultation/">Book a Consultation</a>
        <a class="btn btn--outline" href="/compare/">Compare Models</a>
        <a class="btn btn--outline" href="/saunas/">Explore Recommended Saunas</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ty { padding-block: clamp(4.5rem, 3rem + 7.5vw, 9rem); }
  .ty .lead { margin: 1.3rem auto 0; max-width: 34em; }

  .ty__summary {
    max-width: 26rem;
    margin: 2rem auto 0;
    text-align: left;
    border-top: 2px solid var(--ink);
    padding-top: 0.5rem;
  }
  .ty__summary :global(div) {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-small);
  }
  .ty__summary :global(dt) { color: var(--muted); margin: 0; }
  .ty__summary :global(dd) { margin: 0; text-align: right; }

  .ty__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2.25rem; }

  @media (max-width: 560px) {
    .ty__actions { flex-direction: column; align-items: stretch; }
    .ty__actions .btn { justify-content: center; }
  }
</style>

<script>
  import { track } from '../lib/track';

  // Render the enquiry summary stored by the submitting form (see
  // src/lib/enquiry-client.ts). Display-only, non-sensitive fields; cleared
  // after render so a later unrelated visit doesn't resurrect stale data.
  const el = document.querySelector<HTMLElement>('[data-ty-summary]');
  let confirmed = false;
  try {
    const raw = sessionStorage.getItem('buxena:lastEnquiry');
    if (raw) {
      // THE conversion event. Ad platforms and GA4 count a lead here, on the
      // confirmation page, rather than on submit — it is the signal that the
      // enquiry actually completed. Carries the model and request type so
      // conversions can be valued per product once pricing exists.
      const s = JSON.parse(raw) as Record<string, string>;
      track('lead_confirmed', {
        model: s.model ?? '',
        formType: s.request ?? s.formType ?? 'enquiry',
        zip: s.zip ?? '',
        timeline: s.timeline ?? '',
      });
      confirmed = true;
    }
    if (el && raw) {
      const summary = JSON.parse(raw) as Record<string, string>;
      const LABELS: Record<string, string> = {
        model: 'Model',
        zip: 'ZIP code',
        timeline: 'Timeline',
        projectType: 'Project type',
      };
      /**
       * The six forms that reach this page store their <select> values, which
       * are slugs — "1-3-months", "asap", "need-guidance", "outdoor". Those are
       * the right thing to store (analytics below reads them, and they must
       * stay stable) and the wrong thing to show: the buyer was reading
       * "1–3 months" a second ago and this page echoed "1-3-months" back at
       * them, on the one screen whose whole job is to feel like a confirmation.
       *
       * Rendering-only, and applied to the display copy — the stored object is
       * untouched, so `lead_confirmed` still carries the stable slug.
       * Deliberately no invented meaning: the ranges are re-spaced and the two
       * known shorthands are spelled out, nothing else.
       */
      const prettify = (value: string): string =>
        value
          .replace(/^(\d+)-(\d+)-months$/, '$1–$2 months')
          .replace(/^under-(\d+)k$/, 'Under $$$1,000')
          .replace(/^(\d+)-(\d+)k$/, '$$$1,000 – $$$2,000')
          .replace(/^(\d+)k-plus$/, '$$$1,000+')
          .replace(/^asap$/, 'As soon as possible')
          .replace(/^researching$/, 'Still researching')
          .replace(/^(\d+)-(\d+)$/, '$1–$2')
          .replace(/-/g, ' ')
          .replace(/^./, (c) => c.toUpperCase());

      const rows = Object.entries(summary)
        .filter(([k, v]) => LABELS[k] && v)
        .map(([k, v]) => {
          const div = document.createElement('div');
          const dt = document.createElement('dt');
          dt.textContent = LABELS[k];
          const dd = document.createElement('dd');
          // ZIP is digits and the model carries its own casing — neither wants
          // slug treatment.
          dd.textContent =
            k === 'model' ? v.replace(/^BUH-/i, '') : k === 'zip' ? v : prettify(v);
          div.append(dt, dd);
          return div;
        });
      if (rows.length > 0) {
        el.append(...rows);
        el.hidden = false;
      }
      sessionStorage.removeItem('buxena:lastEnquiry');
    }
  } catch {
    /* storage unavailable — generic page is fine */
  }

  // Direct visit with no stored enquiry (bookmark, refresh after clear, or a
  // shared link). Recorded separately so it can never be counted as a lead.
  if (!confirmed) track('thank_you_direct_visit', { formType: 'none' });
</script>
