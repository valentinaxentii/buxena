---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Your project is started" description="Your request has been received." noindex={true}>
  <section class="band ty">
    <div class="shell shell--narrow center">
      <h1 class="display">Your project is started</h1>
      <p class="lead">
        Thank you. A BUXENA specialist will review your enquiry and come
        back to you directly.
      </p>

      <dl class="ty__summary" data-ty-summary hidden></dl>

      <div class="ty__actions">
        <a class="btn btn--bronze" href="/start-your-project/">Upload Photos / Plans</a>
        <a class="btn btn--outline" href="/consultation/">Book a Consultation</a>
        <a class="btn btn--outline" href="/compare/">Compare Models</a>
        <a class="btn btn--outline" href="/saunas/">Explore Recommended Saunas</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ty { padding-block: clamp(4.5rem, 3rem + 7.5vw, 9rem); }
  .ty .lead { margin: 1.3rem auto 0; max-width: 34em; }
  .ty__summary { max-width: 26rem; margin: 2rem auto 0; text-align: left; border-top: 2px solid var(--ink); padding-top: 0.5rem; }
  .ty__summary :global(div) { display: flex; justify-content: space-between; gap: 1.5rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); font-size: var(--t-small); }
  .ty__summary :global(dt) { color: var(--muted); margin: 0; }
  .ty__summary :global(dd) { margin: 0; text-align: right; }
  .ty__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-top: 2.25rem; }
  @media (max-width: 560px) { .ty__actions { flex-direction: column; align-items: stretch; }.ty__actions .btn { justify-content: center; } }
</style>

<script>
  import { track } from '../lib/track';

  const el = document.querySelector<HTMLElement>('[data-ty-summary]');
  let confirmed = false;
  try {
    const raw = sessionStorage.getItem('buxena:lastEnquiry');
    if (raw) {
      const s = JSON.parse(raw) as Record<string, string>;
      // Most forms count the durable lead here. The progressive quote form
      // counts it immediately after Step 1 succeeds because Step 2 is optional;
      // its summary carries conversionTracked=true so this page won't double-count.
      if (s.conversionTracked !== 'true') {
        track('lead_confirmed', {
          model: s.model ?? '',
          formType: s.request ?? s.formType ?? 'enquiry',
          zip: s.zip ?? '',
          timeline: s.timeline ?? '',
        });
      }
      confirmed = true;

      if (el) {
        const LABELS: Record<string, string> = { model: 'Model', zip: 'ZIP code', timeline: 'Timeline', projectType: 'Project type' };
        const rows = Object.entries(s)
          .filter(([k, v]) => LABELS[k] && v)
          .map(([k, v]) => {
            const div = document.createElement('div');
            const dt = document.createElement('dt');
            dt.textContent = LABELS[k];
            const dd = document.createElement('dd');
            dd.textContent = k === 'model' ? v.replace(/^BUH-/i, '') : v;
            div.append(dt, dd);
            return div;
          });
        if (rows.length > 0) { el.append(...rows); el.hidden = false; }
      }
      sessionStorage.removeItem('buxena:lastEnquiry');
    }
  } catch {
    /* storage unavailable — generic page is fine */
  }

  if (!confirmed) track('thank_you_direct_visit', { formType: 'none' });
</script>
