---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductFilters from '../../components/ProductFilters.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import ContinueProject from '../../components/ContinueProject.astro';
import { getCollection } from 'astro:content';
import { byPhotographedThenOrder } from '../../data/catalog';

// Photographed models lead, curated order preserved within each group —
// see byPhotographedThenOrder in src/data/catalog.ts for why.
const saunas = (await getCollection('saunas', ({ data }) => !data.draft)).sort(byPhotographedThenOrder);

/** Capra publishes one family photograph for every depth in these ranges.
 * Rendering that same photograph as 4–5 separate neighbouring cards made the
 * catalogue look broken and implied unique model photography that does not
 * exist. Keep every SKU/page, but present these ranges once with direct size
 * links to every individual model. */
const FAMILY_PHOTO_SERIES = new Set(['EKE', 'SUSI', 'ITI']);
const seenFamilySeries = new Set<string>();
const catalogueCards: Array<{
  representative: (typeof saunas)[number];
  title?: string;
  tagline?: string;
  variants?: { slug: string; label: string }[];
}> = [];

for (const sauna of saunas) {
  const series = sauna.data.series ?? '';
  if (!FAMILY_PHOTO_SERIES.has(series)) {
    catalogueCards.push({ representative: sauna });
    continue;
  }
  if (seenFamilySeries.has(series)) continue;
  seenFamilySeries.add(series);

  const members = saunas
    .filter((candidate) => candidate.data.series === series)
    .sort((a, b) => {
      const an = Number(a.data.title.match(/(\d+)(?!.*\d)/)?.[1] ?? 0);
      const bn = Number(b.data.title.match(/(\d+)(?!.*\d)/)?.[1] ?? 0);
      return an - bn;
    });
  // EKE 160 has a verified exact-model image from Capra's live product page;
  // use that clean supplier image for the collection card instead of the old
  // generic dark family render. Individual size pages remain unchanged.
  const representative = series === 'EKE'
    ? (members.find((member) => member.data.title === 'BUX EKE 160') ?? members[0] ?? sauna)
    : (members[0] ?? sauna);
  const variants = members.map((member) => ({
    slug: member.id,
    label: `${member.data.title.match(/(\d+)(?!.*\d)/)?.[1] ?? member.data.title} cm`,
  }));

  catalogueCards.push({
    representative,
    title: `BUX ${series}`,
    tagline: `${members.length} available depths. Choose the size that fits your space.`,
    variants,
  });
}

/** Build each facet's option list from whatever is actually in the catalog today. */
function uniqueOptions(values: (string | undefined)[]) {
  return Array.from(new Set(values.filter((v): v is string => Boolean(v)))).sort();
}

const facets = [
  {
    key: 'location' as const,
    label: 'Location',
    options: uniqueOptions(saunas.map((s) => s.data.location)).map((v) => ({
      value: v,
      label: v === 'outdoor' ? 'Outdoor' : 'Indoor',
    })),
  },
  {
    key: 'type' as const,
    label: 'Type',
    options: uniqueOptions(saunas.map((s) => s.data.productType)).map((v) => ({ value: v, label: v })),
  },
  {
    key: 'series' as const,
    label: 'Series',
    options: uniqueOptions(saunas.map((s) => s.data.series)).map((v) => ({ value: v, label: v })),
  },
  {
    key: 'capacity' as const,
    label: 'Capacity',
    options: ['2–3', '3–4', '4–5', '5–6', '6–8'].map((v) => ({ value: v, label: `${v} people` })),
  },
  {
    key: 'material' as const,
    label: 'Material',
    options: uniqueOptions(saunas.flatMap((s) => s.data.materials ?? [])).map((v) => ({
      value: v.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
      label: v,
    })),
  },
];
---

<BaseLayout
  title="Saunas"
  description="Browse the BUXENA range — outdoor barrel saunas and indoor rooms, filterable by type, series, capacity and material."
>
  <section class="band band--tight page-head catalogue-intro">
    <div class="shell">
      <ContinueProject />
      <span class="eyebrow">The Range</span>
      <h1 class="display measure--tight">Every model, in one place</h1>
      <p class="lead measure">
        Filter by location, type, series, capacity or material. Every sellable
        size remains available; ranges that share one supplier photograph are
        grouped so the catalogue does not repeat the same image again and again.
      </p>
      <a class="plan-cta" href="/plan-your-sauna/">
        Plan Your Sauna <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="band band--tight catalogue-paths">
    <div class="shell">
      <div class="paths">
        <div class="path">
          <span class="path__eyebrow">Location</span>
          <span class="path__name">Outdoor Saunas</span>
          <span class="path__line">Barrel and cube cabins built for the garden, the deck or the tree line.</span>
          <a class="path__cta" href="/saunas/outdoor-saunas/">
            Explore Outdoor <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="path">
          <span class="path__eyebrow">Location</span>
          <span class="path__name">Indoor Saunas</span>
          <span class="path__line">Rounded pine rooms for basements, bathrooms and private suites.</span>
          <a class="path__cta" href="/saunas/indoor-saunas/">
            Explore Indoor <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--tight catalogue-filters">
    <div class="shell">
      <ProductFilters facets={facets} />

      <div class="grid cols-3" data-product-grid>
        {catalogueCards.map((card) => {
          const s = card.representative;
          return (
            <ProductCard
              slug={s.id}
              title={card.title ?? s.data.title}
              tagline={card.tagline ?? s.data.tagline}
              category={s.data.category}
              placeholder={s.data.placeholder}
              image={s.data.heroImage}
              location={s.data.location}
              productType={s.data.productType}
              series={s.data.series}
              capacity={s.data.capacity}
              capacityMin={s.data.capacityMin}
              capacityMax={s.data.capacityMax}
              materials={s.data.materials}
              dimensions={card.variants ? undefined : s.data.dimensions}
              fromPrice={s.data.fromPrice}
              variants={card.variants}
            />
          );
        })}
      </div>

      <div class="empty" data-empty hidden>
        <p class="empty__line">No saunas match these filters.</p>
        <button class="btn btn--outline" type="button" data-filter-reset>Reset Filters</button>
      </div>
    </div>
  </section>

  <QuoteBand
    heading="Not sure which one fits?"
    body="Send us the dimensions of the space and how many people you want to seat. We will tell you which models work and which do not."
  />
</BaseLayout>

<style>
  .page-head { padding-bottom: 0; }
  .page-head .lead { margin-top: 0.85rem; }
  .catalogue-intro { padding-top: clamp(0.7rem, 0.4rem + 0.7vw, 1.1rem); }
  .catalogue-paths, .catalogue-filters { padding-block: clamp(0.6rem, 0.35rem + 0.6vw, 0.95rem); }

  .paths {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.94rem, 0.45rem + 1.5vw, 1.9rem);
  }
  .path {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: clamp(1.3rem, 0.9rem + 1.7vw, 2.15rem);
    border: 1px solid var(--line);
    background: var(--linen);
  }
  .path__eyebrow {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze-ink);
  }
  .path__name { font-family: var(--font-display); font-size: var(--t-h3); font-weight: 500; }
  .path__line { font-size: var(--t-small); color: var(--muted); }

  .path__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    justify-self: start;
    min-width: 160px;
    height: 40px;
    gap: 1.25rem;
    white-space: nowrap;
    margin-top: 0.43rem;
    padding: 0 1rem;
    border: 1px solid var(--bronze);
    background: transparent;
    color: var(--bronze-ink);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .path__cta:hover { background: var(--bronze); color: var(--linen); }
  .path__cta .arrow { transition: transform 0.3s var(--ease); }
  .path__cta:hover .arrow { transform: translateX(2px); }

  .empty { padding-block: 1.91rem; display: grid; justify-items: start; gap: 1.25rem; }
  .empty__line { margin: 0; color: var(--muted); font-style: italic; }

  @media (max-width: 640px) {
    .paths { grid-template-columns: 1fr; }
  }
</style>
