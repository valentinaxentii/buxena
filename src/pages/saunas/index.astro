---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductFilters from '../../components/ProductFilters.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import { getCollection } from 'astro:content';

const saunas = (await getCollection('saunas', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

/** Build each facet's option list from whatever is actually in the catalog today. */
function uniqueOptions(values: (string | undefined)[]) {
  return Array.from(new Set(values.filter((v): v is string => Boolean(v)))).sort();
}

const facets = [
  {
    key: 'location' as const,
    label: 'Location',
    options: uniqueOptions(saunas.map((s) => s.data.location)).map((v) => ({
      value: v,
      label: v === 'outdoor' ? 'Outdoor' : 'Indoor',
    })),
  },
  {
    key: 'type' as const,
    label: 'Type',
    options: uniqueOptions(saunas.map((s) => s.data.productType)).map((v) => ({ value: v, label: v })),
  },
  {
    key: 'series' as const,
    label: 'Series',
    options: uniqueOptions(saunas.map((s) => s.data.series)).map((v) => ({ value: v, label: v })),
  },
  {
    key: 'capacity' as const,
    label: 'Capacity',
    options: ['2–3', '3–4', '4–5', '5–6', '6–8'].map((v) => ({ value: v, label: `${v} people` })),
  },
  {
    key: 'material' as const,
    label: 'Material',
    options: uniqueOptions(saunas.flatMap((s) => s.data.materials ?? [])).map((v) => ({
      value: v.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
      label: v,
    })),
  },
];
---

<BaseLayout
  title="Saunas"
  description="Browse the BUXENA range — outdoor barrel saunas and indoor rooms, filterable by type, series, capacity and material."
>
  <section class="band band--tight page-head">
    <div class="shell">
      <span class="eyebrow">The Range</span>
      <h1 class="display measure--tight">Every model, in one place</h1>
      <p class="lead measure">
        Filter by location, type, series, capacity or material. Each model has
        its own page with full dimensions and specifications.
      </p>
      <a class="plan-cta" href="/plan-your-sauna/">
        Plan Your Sauna <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell">
      <div class="paths">
        <div class="path">
          <span class="path__eyebrow">Location</span>
          <span class="path__name">Outdoor Saunas</span>
          <span class="path__line">Barrel cabins built for the garden, the deck or the tree line.</span>
          <a class="path__cta" href="/saunas/outdoor-saunas/">
            Explore Outdoor <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="path">
          <span class="path__eyebrow">Location</span>
          <span class="path__name">Indoor Saunas</span>
          <span class="path__line">Rounded pine rooms for basements, bathrooms and private suites.</span>
          <a class="path__cta" href="/saunas/indoor-saunas/">
            Explore Indoor <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell">
      <ProductFilters facets={facets} />

      <div class="grid cols-3" data-product-grid>
        {saunas.map((s) => (
          <ProductCard
            slug={s.id}
            title={s.data.title}
            tagline={s.data.tagline}
            category={s.data.category}
            placeholder={s.data.placeholder}
            image={s.data.heroImage}
            location={s.data.location}
            productType={s.data.productType}
            series={s.data.series}
            capacity={s.data.capacity}
            capacityMin={s.data.capacityMin}
            capacityMax={s.data.capacityMax}
            materials={s.data.materials}
            dimensions={s.data.dimensions}
          />
        ))}
      </div>

      <p class="empty" data-empty hidden>Nothing matches those filters yet.</p>
    </div>
  </section>

  <QuoteBand
    heading="Not sure which one fits?"
    body="Send us the dimensions of the space and how many people you want to seat. We will tell you which models work and which do not."
  />
</BaseLayout>

<style>
  .page-head { padding-bottom: 0; }
  .page-head .lead { margin-top: 1.3rem; }


  .paths {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.94rem, 0.45rem + 1.5vw, 1.9rem);
    /* No bottom margin: .paths is the last child of its own band, and the
       band's padding plus the next band's padding already set the rhythm.
       The extra 48px here read as a hole between the cards and the filters. */
  }
  .path {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--line);
    background: var(--linen);
  }
  .path__eyebrow {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze-ink);
  }
  .path__name { font-family: var(--font-display); font-size: var(--t-h3); font-weight: 500; }
  .path__line { font-size: var(--t-small); color: var(--muted); }

  .path__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    /* Sized to its own label, not to a fixed width — "Explore Outdoor" is a
       character longer than "Explore Indoor" and wrapped at the old 160px.
       justify-self keeps the button from stretching across the grid cell. */
    justify-self: start;
    min-width: 160px;
    height: 40px;
    gap: 1.25rem;
    white-space: nowrap;
    margin-top: 0.5rem;
    padding: 0 1rem;
    border: 1px solid var(--bronze);
    background: transparent;
    color: var(--bronze-ink);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .path__cta:hover { background: var(--bronze); color: var(--linen); }
  .path__cta .arrow { transition: transform 0.3s var(--ease); }
  .path__cta:hover .arrow { transform: translateX(2px); }

  .empty { color: var(--muted); font-style: italic; padding-block: 2.25rem; }

  @media (max-width: 640px) {
    .paths { grid-template-columns: 1fr; }
  }
</style>
