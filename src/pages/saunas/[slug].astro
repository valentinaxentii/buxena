---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ProductCard from '../../components/ProductCard.astro';
import AvailabilityBadge from '../../components/AvailabilityBadge.astro';
import CheckAvailability from '../../components/CheckAvailability.astro';
import StickySalesBar from '../../components/StickySalesBar.astro';
import PackageBand from '../../components/PackageBand.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import QuoteCompare from '../../components/QuoteCompare.astro';
import NaturalWoodNote from '../../components/NaturalWoodNote.astro';
import RitualKit from '../../components/RitualKit.astro';
import ProductConfigurator from '../../components/ProductConfigurator.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import { groupSpecs } from '../../lib/product-specs';
import { shouldShowConfigurator } from '../../lib/product-config';
import { categoryMap, showDev, site, publicEmail } from '../../data/site';
import { displayTitle } from '../../data/catalog';
import { publicPrice } from '../../data/pricing';
import { publicNameFor, codeFor, presentationPath } from '../../data/model-identity';
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const saunas = await getCollection('saunas', ({ data }) => !data.draft);
  return saunas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;

// Public price comes from the central register (src/data/pricing.ts) — the
// only place approved customer-facing prices live. Null (today, for every
// model) means the page shows Request Pricing and nothing else.
const approved = publicPrice(data.title, data.fromPrice);

// Downloadable model presentation — linked only when the generated PDF
// actually exists on disk (scripts/build-model-presentation.mjs), so a
// missing file can never produce a broken download link.
const presentationHref = presentationPath(entry.id);
const hasPresentation = fs.existsSync(path.join(process.cwd(), 'public', presentationHref));
const buxenaCode = codeFor(data.title);
const { Content } = await render(entry);

const cat = categoryMap[data.category];

// Sibling models in the same collection
const all = await getCollection('saunas', ({ data: d }) => !d.draft);
const related = all
  .filter((s) => s.data.category === data.category && s.id !== entry.id)
  .slice(0, 3);

const TBC = 'To be confirmed';

/**
 * Specification handling.
 *
 * In production, anything without a verified value is simply omitted — a
 * customer never sees a column of "To be confirmed". If nothing at all is
 * verified, the whole sidebar is hidden and the description runs full width.
 *
 * In development every field is shown, so you can see what is still missing.
 */
const verifiedRows = [
  { label: 'Collection', value: cat?.name ?? data.category },
  ...(data.series ? [{ label: 'Series', value: data.series }] : []),
  ...(data.capacity ? [{ label: 'Capacity', value: data.capacity }] : []),
  ...(data.dimensions ?? []),
  ...(data.specs ?? []),
  ...(data.delivery ? [{ label: 'Delivery', value: data.delivery }] : []),
];

const pendingRows = [
  ...(data.capacity ? [] : [{ label: 'Capacity', value: TBC }]),
  ...(data.dimensions ? [] : [{ label: 'Dimensions', value: TBC }]),
];

const specRows = showDev ? [...verifiedRows, ...pendingRows] : verifiedRows;

// Grouped view of the same verified rows — DIMENSIONS / CONSTRUCTION /
// DOOR & GLASS / INTERIOR / HEATING / VENTILATION / INSTALLATION. Derived
// from labels already in the data: no frontmatter rewritten, no value
// invented, and a category with no rows never renders.
const specGroups = groupSpecs(specRows.filter((r) => r.value !== TBC), []);

// Condensed key facts for the hero's right column — a subset of the full
// specification sheet (still shown in full further down the page, unchanged).
const heroSpecRows = [
  ...(data.capacity ? [{ label: 'Capacity', value: data.capacity }] : []),
  ...(data.dimensions ?? []),
  ...(data.materials?.length ? [{ label: 'Material', value: data.materials.join(', ') }] : []),
  ...(data.specs ?? []).slice(0, 2),
];

const blocks = [
  { title: 'Materials', items: data.materials },
  { title: 'Heater options', items: data.heaterOptions },
  { title: 'Features', items: data.features },
  { title: 'Available options', items: data.options },
];

const hasDownloads = (data.downloads ?? []).some((d) => d.file);

// Is there anything worth showing a customer beyond the collection name?
const hasVerifiedDetail =
  verifiedRows.length > 1 || blocks.some((b) => b.items?.length) || hasDownloads;

const showSpecs = showDev || hasVerifiedDetail;

// Structured data — verified fields only. No price/offers/rating: none of
// that is published, and none should be invented.
const productImage = data.heroImage.src ? new URL(data.heroImage.src, Astro.site).href : undefined;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: displayTitle(data.title),
  description: data.summary,
  ...(productImage ? { image: [productImage] } : {}),
  brand: { '@type': 'Brand', name: site.name },
  ...(data.materials?.length ? { material: data.materials.join(', ') } : {}),
};

const locationLabel = data.location === 'outdoor' ? 'Outdoor Saunas' : data.location === 'indoor' ? 'Indoor Saunas' : null;
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Saunas', item: new URL('/saunas/', Astro.site).href },
  ...(locationLabel
    ? [{ '@type': 'ListItem', position: 2, name: locationLabel, item: new URL(`/saunas/${data.location}-saunas/`, Astro.site).href }]
    : []),
  {
    '@type': 'ListItem',
    position: locationLabel ? 3 : 2,
    name: displayTitle(data.title),
    item: new URL(`/saunas/${entry.id}/`, Astro.site).href,
  },
];
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};
---

{/* Meta description is built per model rather than reusing `summary`, which
    several models in a series share word-for-word — duplicate descriptions
    weaken every page in that series. Facts only: name, capacity, material,
    placement and size, all from this model's own verified data. */}
<BaseLayout
  title={displayTitle(data.title)}
  description={[
    `${displayTitle(data.title)} —`,
    data.summary?.replace(/\.$/, '') ?? '',
    [
      data.capacity,
      data.materials?.[0],
      data.location ? `${data.location} sauna` : null,
      data.dimensions?.[0]?.value?.replace(/\s*\(.*\)/, ''),
    ].filter(Boolean).join(', '),
  ].filter(Boolean).join(' ').replace(/\s+/g, ' ').slice(0, 160)}
  image={data.heroImage.src}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <article>
    <!-- Hero: product image + key info, side by side -->
    <section class="band band--tight prod-hero">
      <div class="shell">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/saunas/">Saunas</a>
          <span aria-hidden="true">/</span>
          {data.location ? (
            <a href={`/saunas/${data.location}-saunas/`}>
              {data.location === 'outdoor' ? 'Outdoor Saunas' : 'Indoor Saunas'}
            </a>
          ) : (
            <a href={`/collections/${data.category}/`}>{cat?.name}</a>
          )}
        </nav>

        <div class="prod-hero__grid">
          <div class="prod-hero__media">
            <ProductGallery hero={data.heroImage} gallery={data.gallery} model={data.title} />
          </div>

          <div class="prod-hero__info">
            <h1 class="display">{displayTitle(data.title)}</h1>
            <p class="prod-hero__tag serif-italic">{data.tagline}</p>
            <AvailabilityBadge status={data.availability ?? 'preorder'} />

            {/* Pricing block — renders ONLY approved values from frontmatter.
                With none set (the current state of every model) it shows
                nothing here and the Request Pricing CTA below carries the
                weight. See content.config.ts pricing fields. */}
            {approved && (
              <dl class="prod-hero__pricing">
                {approved.fromPrice && !approved.projectPricing && (
                  <div><dt>Sauna</dt><dd>{approved.fromPrice}</dd></div>
                )}
                {approved.completeFromPrice && (
                  <div><dt>BUXENA Complete</dt><dd>{approved.completeFromPrice}</dd></div>
                )}
                {approved.projectPricing && (
                  <div><dt>BUXENA Project</dt><dd>Project Pricing</dd></div>
                )}
                {approved.note && <p class="prod-hero__pricing-note">{approved.note}</p>}
              </dl>
            )}
            <p class="lead">{data.summary}</p>

            {heroSpecRows.length > 0 && (
              <dl class="prod-hero__keyspecs">
                {heroSpecRows.map((row) => (
                  <div class="prod-hero__keyspecs-row">
                    <dt>{row.label}</dt>
                    <dd>{row.value}</dd>
                  </div>
                ))}
              </dl>
            )}

            <a
              class="btn btn--bronze"
              href="#enquire"
              data-track="pricing_request_started"
              data-track-model={data.title}
              data-track-category={data.category}
              data-track-location={data.location ?? ''}
              data-track-form-type="product_page"
            >Request Pricing</a>
            <p class="prod-hero__quote-note">We prepare pricing around your chosen configuration and delivery location.</p>

            <CheckAvailability model={data.title} />

            <div class="prod-hero__more">
              <a
                class="link"
                href="#configure"
                data-track="product_configure_click"
                data-track-model={data.title}
              >Configure This Sauna <span class="arrow" aria-hidden="true">→</span></a>
              <a
                class="link"
                href="/see-it-in-my-space/"
                data-track="space_flow_started"
                data-track-model={data.title}
                data-track-form-type="product_page"
              >See It In My Space <span class="arrow" aria-hidden="true">→</span></a>
              {publicEmail && (
                <a class="link" href={`mailto:${publicEmail}?subject=${encodeURIComponent(`Question about the ${displayTitle(data.title)}`)}`}>
                  Talk to BUXENA <span class="arrow" aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </div>

        {data.placeholder && showDev && (
          <p class="notice">
            <strong>Placeholder listing.</strong> Images, dimensions, materials and
            heater options for this model are not yet published. Nothing on this page
            should be treated as a specification.
          </p>
        )}
      </div>
    </section>

    <!-- Description + specs -->
    <section class="band">
      <div class={`shell prod-body ${showSpecs ? "" : "prod-body--solo"}`}>
        <div class="prose">
          <span class="eyebrow">Why choose this model</span>
          <Content />
        </div>

        {showSpecs && (
          <aside class="specs">
            <h2 class="specs__h">Specifications</h2>
            {specGroups.map((group) => (
              <div class="specs__group">
                <h3 class="specs__cat">{group.title}</h3>
                <dl class="specs__list">
                  {group.rows.map((row) => (
                    <div class="specs__row">
                      <dt>{row.label}</dt>
                      <dd>{row.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}

            {showDev && pendingRows.length > 0 && (
              <div class="specs__group">
                <h3 class="specs__cat">Awaiting supplier confirmation</h3>
                <dl class="specs__list">
                  {pendingRows.map((row) => (
                    <div class="specs__row">
                      <dt>{row.label}</dt>
                      <dd class="is-tbc">{row.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}

            {blocks.map((block) =>
              block.items?.length ? (
                <Fragment>
                  <h3 class="specs__sub">{block.title}</h3>
                  <ul class="specs__ul">{block.items.map((i) => <li>{i}</li>)}</ul>
                </Fragment>
              ) : showDev ? (
                <Fragment>
                  <h3 class="specs__sub">{block.title}</h3>
                  <p class="is-tbc">{TBC}</p>
                </Fragment>
              ) : null
            )}

            <h3 class="specs__sub">Downloads</h3>
            {hasPresentation && (
              <ul class="specs__ul">
                <li>
                  <a
                    class="dl"
                    href={presentationHref}
                    download
                    data-track="document_download"
                    data-track-model={data.title}
                    data-track-label="Model Presentation"
                  >Download Model Presentation (PDF)</a>
                </li>
              </ul>
            )}
            {hasDownloads ? (
              <ul class="specs__ul">
                {data.downloads!.filter((d) => d.file).map((d) => (
                  <li>
                    <a
                      class="dl"
                      href={d.file}
                      download
                      data-track="document_download"
                      data-track-model={data.title}
                      data-track-label={d.label}
                    >{d.label}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <Fragment>
                {/* Audited 2026-08-10: no real product documents exist
                    anywhere in the repo (no PDFs, manuals or drawings) —
                    nothing is linked until genuine, model-matched files
                    arrive. This fallback turns the gap into a lead path. */}
                <p class="specs__docnote">
                  {hasPresentation
                    ? 'Manufacturer manuals and technical drawings are being prepared for this model. Request specifications and we\'ll send the currently available project information.'
                    : 'Technical documents are being prepared for this model. Request specifications and we\'ll send the currently available project information.'}
                </p>
                <a
                  class="link specs__docreq"
                  href="#enquire"
                  data-track="specification_request_click"
                  data-track-model={data.title}
                >Request Specifications <span class="arrow" aria-hidden="true">→</span></a>
                <a
                  class="link specs__docreq"
                  href="/for-trade/#trade-form"
                  data-track="product_trade_click"
                  data-track-model={data.title}
                  data-track-cta="submit_project"
                >For Trade — Submit a Project <span class="arrow" aria-hidden="true">→</span></a>
              </Fragment>
            )}
          </aside>
        )}
      </div>
    </section>

    <!-- Configuration & system — real options only, confirmed at quote -->
    {/* Shown only where this model has verified choices. A configurator whose
        one question is "how will you install it?" performs configurability
        without asking anything about the product; those models get the quote
        and project CTAs instead, and installation is asked once in the quote
        form where EVERY model asks it. Turns itself on automatically when
        verified options are added to the model's frontmatter. */}
    {shouldShowConfigurator(data) && (
      <ProductConfigurator model={data} displayName={displayTitle(data.title)} />
    )}

    <section class="band">
      <div class="shell">
            <div class="config__inc">
              <div class="config__block">
                <h3 class="config__h">What's included</h3>
                <ul class="config__list">
                  <li>The sauna in your chosen configuration</li>
                  <li>Confirmed standard equipment for the model</li>
                  <li>Every inclusion itemised line-by-line in your written quote</li>
                </ul>
              </div>
              <div class="config__block">
                <h3 class="config__h">What's not included</h3>
                <ul class="config__list">
                  <li>Foundation / base preparation</li>
                  <li>Electrical connection work (a licensed electrician)</li>
                  <li>Permits, where your municipality requires them</li>
                  <li>Site preparation and access equipment</li>
                </ul>
                <p class="config__note">
                  Nothing here should surprise you on delivery day — your quote
                  states exactly where our scope ends and your site work begins.
                </p>
              </div>
            </div>
      </div>
    </section>

    <PackageBand model={data.title} />

    <QuoteCompare model={data.title} />

    <!-- Delivery & project guidance — cautious, no operational overclaims -->
    <section class="band">
      <div class="shell">
        <div class="sec-head">
          <span class="eyebrow">Delivery &amp; Your Site</span>
          <h2 class="h2 measure--tight">What the project asks of your site</h2>
        </div>
        <div class="grid cols-4 sitecards">
          <div class="sitecard">
            <h3 class="config__h">Delivery</h3>
            <p>Coordinated to your address, with route and timing agreed in advance. Your quote covers the delivery approach for your location and access.</p>
          </div>
          <div class="sitecard">
            <h3 class="config__h">Site access</h3>
            <p>Gate widths, slopes and clearances decide how the sauna arrives. We review access with you before ordering, not on delivery day.</p>
          </div>
          <div class="sitecard">
            <h3 class="config__h">Foundation</h3>
            <p>A level, load-bearing base is required. We provide guidance on what this model needs so your contractor can prepare it.</p>
          </div>
          <div class="sitecard">
            <h3 class="config__h">Electrical &amp; installation</h3>
            <p>Electrical work is completed by your licensed electrician to the model's requirements. BUXENA provides guidance, and installation coordination where available.</p>
          </div>
        </div>

        <div class="sitefoot">
          <p class="sitefoot__note">
            Delivery pricing depends on your ZIP code and project — guidance
            here is planning help, not an engineering approval. Foundation,
            electrical, access, delivery location and installation planning
            are each confirmed with you before ordering.
          </p>
          <a
            class="btn btn--bronze"
            href={`/quote/?model=${encodeURIComponent(data.title)}`}
            data-track="request_pricing_click"
            data-track-model={data.title}
            data-track-form-type="delivery_section"
          >Get Delivery + Project Pricing</a>
        </div>
      </div>
    </section>

    {/* Sets expectations about real timber before purchase. Renders only for
        models whose verified materials include wood. */}
    <section class="band band--tight">
      <div class="shell">
        <NaturalWoodNote materials={data.materials} />
      </div>
    </section>

    <RitualKit />

    <!-- Enquiry -->
    <section class="band band--birch" id="enquire">
      <div class="shell shell--narrow">
        <div class="sec-head center">
          <span class="eyebrow">Enquire</span>
          <h2 class="h2">Request pricing for the {displayTitle(data.title)}</h2>
        </div>
        <QuoteForm preselect={data.title} />
      </div>
    </section>

    <!-- For Trade -->
    <section class="band band--tight band--birch">
      <div class="shell prodtrade">
        <div>
          <span class="eyebrow">For Trade</span>
          <h2 class="h3">Specifying the {displayTitle(data.title)} for a project?</h2>
        </div>
        <div class="prodtrade__ctas">
          <a
            class="btn btn--outline"
            href="/for-trade/#trade-form"
            data-track="product_trade_click"
            data-track-model={data.title}
            data-track-cta="request_specifications"
          >Request Specifications</a>
          <a
            class="btn btn--bronze"
            href="/for-trade/#trade-form"
            data-track="product_trade_click"
            data-track-model={data.title}
            data-track-cta="submit_project"
          >Submit a Project</a>
        </div>
      </div>
    </section>

    {related.length > 0 && (
      <section class="band">
        <div class="shell">
          <div class="sec-head">
            <span class="eyebrow">Also in {cat?.name}</span>
          </div>
          <div class="grid cols-3">
            {related.map((s) => (
              <ProductCard
                slug={s.id}
                title={s.data.title}
                tagline={s.data.tagline}
                category={s.data.category}
                placeholder={s.data.placeholder}
                image={s.data.heroImage}
                location={s.data.location}
                productType={s.data.productType}
                series={s.data.series}
                capacity={s.data.capacity}
                capacityMin={s.data.capacityMin}
                capacityMax={s.data.capacityMax}
                materials={s.data.materials}
                dimensions={s.data.dimensions}
            fromPrice={s.data.fromPrice}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <QuoteBand model={data.title} heading={`Start your ${displayTitle(data.title)} project`} />

  <StickySalesBar model={data.title} />

  <script
    is:inline
    define:vars={{
      model: data.title,
      category: data.category,
      location: data.location ?? '',
      series: data.series ?? '',
    }}
  >
    // product_view fires once per page load, carrying the same model context
    // every downstream pricing/availability event on this page will carry —
    // so a lead can be attributed back to the exact model that produced it.
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'product_view',
      model,
      category,
      location,
      series,
      landing_page: window.location.pathname,
    });

    // product_gallery_view — once, when the thumbnail strip is first seen.
    var gallery = document.querySelector('.prod-hero__thumbs');
    if (gallery && 'IntersectionObserver' in window) {
      var gio = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) {
          window.dataLayer.push({ event: 'product_gallery_view', model: model });
          gio.disconnect();
        }
      }, { threshold: 0.4 });
      gio.observe(gallery);
    }

    // product_availability_click — opening the Check Availability disclosure
    // is the intent signal; the submitted request has its own event.
    var avail = document.querySelector('[data-avail-check]');
    if (avail) {
      avail.addEventListener('toggle', function () {
        if (avail.open) {
          window.dataLayer.push({ event: 'product_availability_click', model: model });
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .prod-hero { padding-bottom: 0; }

  .crumbs {
    display: flex;
    gap: 0.75rem;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: clamp(1.3rem, 0.75rem + 1.5vw, 2.25rem);
  }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--ink); }

  /* Two-column hero: image left (~53%), key info right (~47%). Image never
     dominates — it supports the product info, capped height, never cropped. */
  .prod-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.13fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 0.6rem + 3.5vw, 3.5rem);
    align-items: start;
  }

  .prod-hero__media { display: flex; flex-direction: column; gap: 0.75rem; }

  .prod-hero__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
    gap: 0.6rem;
  }
  .prod-hero__thumbs :global(.fig) { max-width: 6.5rem; }

  .prod-hero__info { padding-top: 0.25rem; }
  .prod-hero__tag {
    font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.3rem);
    color: var(--bronze-ink);
    margin: 0.6rem 0 1rem;
  }
  .prod-hero__info :global(.avail) { margin-bottom: 1.1rem; }
  .prod-hero__info .lead { margin-bottom: 1.5rem; }

  .prod-hero__pricing { margin: 0 0 1.25rem; }
  .prod-hero__pricing div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-small);
  }
  .prod-hero__pricing dt { color: var(--muted); margin: 0; }
  .prod-hero__pricing dd { margin: 0; font-weight: 600; color: var(--ink); }
  .prod-hero__pricing-note {
    margin: 0.5rem 0 0;
    font-size: var(--t-small);
    color: var(--muted);
  }
  .prod-hero__quote-note { max-width: 29rem; margin: 0.65rem 0 1.15rem; color: var(--muted); font-size: 0.8125rem; line-height: 1.45; }

  .prod-hero__keyspecs { margin: 0 0 1.75rem; }
  .prod-hero__keyspecs-row {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-small);
  }
  .prod-hero__keyspecs-row dt { color: var(--muted); margin: 0; }
  .prod-hero__keyspecs-row dd { margin: 0; text-align: right; }

  .notice {
    border: 1px solid var(--line);
    border-left: 3px solid var(--bronze);
    background: var(--linen-deep);
    padding: 1.15rem 1.5rem;
    font-size: var(--t-small);
    color: var(--muted);
