---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductFilters from '../../components/ProductFilters.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import CategoryViewTrack from '../../components/CategoryViewTrack.astro';
import { getCollection } from 'astro:content';
import { byPhotographedThenOrder } from '../../data/catalog';

const models = (
  await getCollection('saunas', ({ data }) => !data.draft && data.productType === 'Cube')
).sort(byPhotographedThenOrder);

function uniqueOptions(values: (string | undefined)[]) {
  return Array.from(new Set(values.filter((v): v is string => Boolean(v)))).sort();
}

const facets = [
  {
    key: 'series' as const,
    label: 'Series',
    options: uniqueOptions(models.map((s) => s.data.series)).map((v) => ({ value: v, label: v })),
  },
  {
    key: 'capacity' as const,
    label: 'Capacity',
    options: ['2–3', '3–4', '4–5', '5–6', '6–8'].map((v) => ({ value: v, label: `${v} people` })),
  },
  {
    key: 'material' as const,
    label: 'Material',
    options: uniqueOptions(models.flatMap((s) => s.data.materials ?? [])).map((v) => ({
      value: v.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
      label: v,
    })),
  },
];
---

<BaseLayout
  title="Outdoor Cube Saunas"
  fullTitle="Outdoor Cube Saunas | BUXENA"
  description="Outdoor cube saunas — flat-roofed architectural volumes with wide panoramic glazing, for gardens, decks and rooflines that call for a cleaner form than a barrel."
>
  <section class="band band--tight page-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/saunas/">Saunas</a>
        <span aria-hidden="true">/</span>
        <a href="/saunas/outdoor-saunas/">Outdoor Saunas</a>
        <span aria-hidden="true">/</span>
        <span>Cube</span>
      </nav>
      <h1 class="display measure--tight">Outdoor Cube Saunas</h1>
      <p class="lead measure">
        Flat roofline. Full-glass fronts. A cleaner architectural form.
      </p>
      <p class="intro measure">
        BUXENA cube saunas trade the barrel's curve for a flat-roofed,
        panoramic volume — built for gardens and rooflines that call for a
        more architectural silhouette.
      </p>
    </div>
  </section>

  <section class="band band--tight">
    <div class="shell">
      <ProductFilters facets={facets} />

      <div class="grid cols-3" data-product-grid>
        {models.map((s) => (
          <ProductCard
            slug={s.id}
            title={s.data.title}
            tagline={s.data.tagline}
            category={s.data.category}
            placeholder={s.data.placeholder}
            image={s.data.heroImage}
            location={s.data.location}
            productType={s.data.productType}
            series={s.data.series}
            capacity={s.data.capacity}
            capacityMin={s.data.capacityMin}
            capacityMax={s.data.capacityMax}
            materials={s.data.materials}
            dimensions={s.data.dimensions}
            fromPrice={s.data.fromPrice}
          />
        ))}
      </div>

      <p class="empty" data-empty hidden>Nothing matches those filters yet.</p>
    </div>
  </section>

  <QuoteBand />
  <CategoryViewTrack category="cube" />
</BaseLayout>

<style>
  .page-head { padding-bottom: 0; }
  .page-head .lead { margin-top: 1.11rem; font-style: italic; font-family: var(--font-display); font-size: var(--t-h3); color: var(--ink); }
  .intro { margin-top: 0.85rem; }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: clamp(1.11rem, 0.64rem + 1.27vw, 1.91rem);
  }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--ink); }

  .empty { color: var(--muted); font-style: italic; padding-block: 1.91rem; }
</style>
