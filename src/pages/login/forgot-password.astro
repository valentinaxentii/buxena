---
export const prerender = false;

/**
 * Automatic reset messages are deliberately disabled. This internal staff
 * portal must not let anonymous requests repeatedly email a founder account.
 */
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Forgot Password · BUXENA Staff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" />
  </head>
  <body>
    <main class="wrap">
      <div class="card">
        <img class="logo" src="/brand/buxena-logo-champagne.png" alt="BUXENA" width="1536" height="1024" />

        <h1>Password reset</h1>
        <p>Automatic reset emails are disabled to protect staff accounts from repeated requests.</p>
        <p class="muted">Contact the BUXENA administrator to reset your staff password securely.</p>

        <a class="back" href="/login">← Back to Sign In</a>
      </div>
    </main>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #14120f; color: #f6f2ea; font-family: 'Jost', system-ui, sans-serif; }
  .wrap { min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; }
  .card { width: 100%; max-width: 26rem; display: flex; flex-direction: column; align-items: center; gap: 1.25rem; padding: 3rem 2.5rem; border: 1px solid rgba(212, 184, 140, 0.16); border-radius: 2px; text-align: center; }
  .logo { width: 10rem; height: auto; }
  h1 { margin: 0; font-size: 1.15rem; font-weight: 500; }
  p { margin: 0; font-size: 0.9rem; line-height: 1.6; color: rgba(246, 242, 234, 0.75); }
  p.muted { font-size: 0.8rem; color: rgba(246, 242, 234, 0.5); }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8rem; color: #d4b88c; }
  strong { color: #f6f2ea; font-weight: 500; }
  form { width: 100%; display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
  label { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(246, 242, 234, 0.55); }
  input { width: 100%; padding: 0.85rem 1rem; font-family: inherit; font-size: 1rem; color: #f6f2ea; background: rgba(246, 242, 234, 0.05); border: 1px solid rgba(212, 184, 140, 0.22); border-radius: 2px; }
  input:focus { outline: none; border-color: #d4b88c; }
  button { margin-top: 0.64rem; padding: 0.9rem 1rem; font-family: inherit; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #14120f; background: #d4b88c; border: none; border-radius: 2px; cursor: pointer; }
  button:hover { background: #e6cda3; }
  .error { font-size: 0.8rem; color: #e5a3a3; }
  .back { font-size: 0.8rem; color: #d4b88c; text-decoration: none; }
  .back:hover { color: #e6cda3; }
</style>
