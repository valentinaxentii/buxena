---
export const prerender = false;

import { createSupabaseServerClient } from '../../lib/supabase-auth';
import { checkRateLimit } from '../../lib/rate-limit';

/**
 * Step 1 of the password reset: ask Supabase to email a recovery link.
 *
 * The link lands on /login/reset-password, which exchanges the one-time code
 * for a session and lets the holder set a new password. `redirectTo` must be
 * listed under Authentication → URL Configuration → Redirect URLs in the
 * Supabase dashboard, or Supabase refuses to send the visitor there.
 */

let sent = false;
let error: string | null = null;
let notConfigured = false;
let submittedEmail = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  submittedEmail = String(form.get('email') ?? '').trim();

  // This is a public POST that makes Supabase send email, so it is an abuse
  // path in the same class as /login and /api/enquiries — and it was the only
  // one of the three with no application-level limit, relying entirely on
  // Supabase's own quota. Exhausting that quota does not just block password
  // resets: staff invitations go out through the same auth email pathway, so
  // a flood here can lock the founders out of adding people. A real person
  // needs one or two of these; 5 per 15 minutes is generous for that and
  // still cuts off a script.
  const { allowed, retryAfterSeconds } = checkRateLimit(
    `forgot-password:${Astro.clientAddress}`,
    5,
    15 * 60_000
  );

  if (!allowed) {
    error = `Too many reset requests. Try again in ${Math.ceil(retryAfterSeconds / 60)} minute(s).`;
  } else if (!submittedEmail) {
    error = 'Enter the email address for your account.';
  } else {
    try {
      const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
      const redirectTo = new URL('/login/reset-password', Astro.url.origin).toString();
      const { error: resetError } = await supabase.auth.resetPasswordForEmail(submittedEmail, {
        redirectTo,
      });

      // Deliberately not surfaced per-address: telling a stranger which
      // emails have staff accounts is free reconnaissance. Rate limiting is
      // the one case worth naming, because otherwise the page looks broken.
      if (resetError && /rate|limit|seconds/i.test(resetError.message)) {
        error = 'Too many attempts. Wait a minute and try again.';
      } else {
        sent = true;
      }
    } catch {
      notConfigured = true;
    }
  }
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Forgot Password · BUXENA Staff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap"
    />
  </head>
  <body>
    <main class="wrap">
      <div class="card">
        <img
          class="logo"
          src="/brand/buxena-logo-champagne.png"
          alt="BUXENA"
          width="1536"
          height="1024"
        />

        {notConfigured ? (
          <>
            <h1>Not configured</h1>
            <p>
              Supabase credentials are missing, so no email can be sent. Set
              <code>SUPABASE_URL</code> and <code>SUPABASE_ANON_KEY</code> in the environment.
            </p>
          </>
        ) : sent ? (
          <>
            <h1>Check your email</h1>
            <p>
              If an account exists for <strong>{submittedEmail}</strong>, a link to set a new
              password is on its way. It expires in one hour.
            </p>
            <p class="muted">Nothing after a few minutes? Check the spam folder.</p>
          </>
        ) : (
          <>
            <h1>Forgot your password?</h1>
            <p>Enter your staff email address and we'll send you a link to set a new one.</p>

            <form method="POST" novalidate>
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="username"
                required
                autofocus
                value={submittedEmail}
              />
              {error && <p class="error">{error}</p>}
              <button type="submit">Send reset link</button>
            </form>
          </>
        )}

        <a class="back" href="/login">← Back to Sign In</a>
      </div>
    </main>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #14120f; color: #f6f2ea; font-family: 'Jost', system-ui, sans-serif; }
  .wrap { min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; }
  .card {
    width: 100%; max-width: 26rem; display: flex; flex-direction: column; align-items: center;
    gap: 1.25rem; padding: 3rem 2.5rem; border: 1px solid rgba(212, 184, 140, 0.16); border-radius: 2px;
    text-align: center;
  }
  .logo { width: 10rem; height: auto; }
  h1 { margin: 0; font-size: 1.15rem; font-weight: 500; }
  p { margin: 0; font-size: 0.9rem; line-height: 1.6; color: rgba(246, 242, 234, 0.75); }
  p.muted { font-size: 0.8rem; color: rgba(246, 242, 234, 0.5); }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8rem; color: #d4b88c; }
  strong { color: #f6f2ea; font-weight: 500; }

  form { width: 100%; display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
  label {
    font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(246, 242, 234, 0.55);
  }
  input {
    width: 100%; padding: 0.85rem 1rem; font-family: inherit; font-size: 1rem;
    color: #f6f2ea; background: rgba(246, 242, 234, 0.05);
    border: 1px solid rgba(212, 184, 140, 0.22); border-radius: 2px;
  }
  input:focus { outline: none; border-color: #d4b88c; }
  button {
    margin-top: 0.75rem; padding: 0.9rem 1rem; font-family: inherit; font-size: 0.8rem;
    font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: #14120f; background: #d4b88c; border: none; border-radius: 2px; cursor: pointer;
  }
  button:hover { background: #e6cda3; }
  .error { font-size: 0.8rem; color: #e5a3a3; }
  .back { font-size: 0.8rem; color: #d4b88c; text-decoration: none; }
  .back:hover { color: #e6cda3; }
</style>
