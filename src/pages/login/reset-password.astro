---
export const prerender = false;

import { createSupabaseServerClient } from '../../lib/supabase-auth';

/**
 * Step 2 of the password reset: the destination of the emailed recovery link.
 *
 * @supabase/ssr uses the PKCE flow, so the link arrives as ?code=<one-time>.
 * Exchanging that code establishes a real session — which is what authorises
 * the updateUser call below, and is why the code is single-use and expires.
 *
 * Two visits, one page:
 *   GET  with ?code  — exchange it, then show the new-password form
 *   POST             — set the password using the session from that exchange
 */

const MIN_LENGTH = 10;

let stage: 'form' | 'invalid' | 'done' | 'notConfigured' = 'form';
let error: string | null = null;

const code = Astro.url.searchParams.get('code');

try {
  const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const password = String(form.get('password') ?? '');
    const confirm = String(form.get('confirm') ?? '');

    // The session cookie set during the GET exchange is what proves this
    // visitor opened the emailed link; without it there is nothing to update.
    const { data: userData } = await supabase.auth.getUser();

    if (!userData.user) {
      stage = 'invalid';
    } else if (password.length < MIN_LENGTH) {
      error = `Use at least ${MIN_LENGTH} characters.`;
    } else if (password !== confirm) {
      error = 'The two passwords do not match.';
    } else {
      const { error: updateError } = await supabase.auth.updateUser({ password });
      if (updateError) {
        // Never surface raw Supabase error text. The one case a user can
        // act on differently is reusing their current password; everything
        // else gets a generic retry message.
        error = /different from the old password|same password/i.test(updateError.message)
          ? 'Your new password must be different from your current one.'
          : "We couldn't update your password. Try again, or request a new reset link.";
      } else {
        stage = 'done';
      }
    }
  } else if (code) {
    const { error: exchangeError } = await supabase.auth.exchangeCodeForSession(code);
    if (exchangeError) stage = 'invalid';
  } else {
    // Landing here without a code is only valid if a recovery session already
    // exists — e.g. the form was reloaded after the exchange.
    const { data: userData } = await supabase.auth.getUser();
    if (!userData.user) stage = 'invalid';
  }
} catch {
  stage = 'notConfigured';
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Set a New Password · BUXENA Staff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap"
    />
  </head>
  <body>
    <main class="wrap">
      <div class="card">
        <img
          class="logo"
          src="/brand/buxena-logo-champagne.png"
          alt="BUXENA"
          width="1536"
          height="1024"
        />

        {stage === 'notConfigured' && (
          <>
            <h1>Not configured</h1>
            <p>Supabase credentials are missing, so passwords cannot be changed.</p>
          </>
        )}

        {stage === 'invalid' && (
          <>
            <h1>This link has expired</h1>
            <p>
              Reset links can only be used once, and expire after an hour. Request a new one and
              open it from the most recent email.
            </p>
            <a class="cta" href="/login/forgot-password">Request a new link</a>
          </>
        )}

        {stage === 'done' && (
          <>
            <h1>Password updated</h1>
            <p>You're signed in with your new password.</p>
            <a class="cta" href="/admin">Go to the Dashboard</a>
          </>
        )}

        {stage === 'form' && (
          <>
            <h1>Set a new password</h1>
            <p>Choose something at least {MIN_LENGTH} characters long.</p>

            <form method="POST" novalidate>
              <label for="password">New password</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength={MIN_LENGTH}
                required
                autofocus
              />

              <label for="confirm">Confirm password</label>
              <input
                id="confirm"
                name="confirm"
                type="password"
                autocomplete="new-password"
                minlength={MIN_LENGTH}
                required
              />

              {error && <p class="error">{error}</p>}
              <button type="submit">Update password</button>
            </form>
          </>
        )}

        <a class="back" href="/login">← Back to Sign In</a>
      </div>
    </main>
  </body>
</html>

<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; min-height: 100%; background: #14120f; color: #f6f2ea; font-family: 'Jost', system-ui, sans-serif; }
  .wrap { min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; }
  .card {
    width: 100%; max-width: 26rem; display: flex; flex-direction: column; align-items: center;
    gap: 1.25rem; padding: 3rem 2.5rem; border: 1px solid rgba(212, 184, 140, 0.16); border-radius: 2px;
    text-align: center;
  }
  .logo { width: 10rem; height: auto; }
  h1 { margin: 0; font-size: 1.15rem; font-weight: 500; }
  p { margin: 0; font-size: 0.9rem; line-height: 1.6; color: rgba(246, 242, 234, 0.75); }

  form { width: 100%; display: flex; flex-direction: column; gap: 0.5rem; text-align: left; }
  label {
    font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(246, 242, 234, 0.55);
  }
  label + input { margin-bottom: 0.35rem; }
  input {
    width: 100%; padding: 0.85rem 1rem; font-family: inherit; font-size: 1rem;
    color: #f6f2ea; background: rgba(246, 242, 234, 0.05);
    border: 1px solid rgba(212, 184, 140, 0.22); border-radius: 2px;
  }
  input:focus { outline: none; border-color: #d4b88c; }
  button {
    margin-top: 0.75rem; padding: 0.9rem 1rem; font-family: inherit; font-size: 0.8rem;
    font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    color: #14120f; background: #d4b88c; border: none; border-radius: 2px; cursor: pointer;
  }
  button:hover { background: #e6cda3; }
  .error { font-size: 0.8rem; color: #e5a3a3; }
  .cta {
    padding: 0.8rem 1.4rem; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: #14120f; background: #d4b88c; text-decoration: none;
    border-radius: 2px;
  }
  .cta:hover { background: #e6cda3; }
  .back { font-size: 0.8rem; color: #d4b88c; text-decoration: none; }
  .back:hover { color: #e6cda3; }
</style>
