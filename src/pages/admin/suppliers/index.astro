---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import ArchiveToggle from '../../../components/admin/ArchiveToggle.astro';
import { archiveSupported, withArchiveFilter } from '../../../lib/archive';
import { isAdminStaff } from '../../../lib/staff-access';

const search = Astro.url.searchParams.get('q') ?? '';
let suppliers: any[] = [];
let dbReady = true;
// Archived records are hidden from the active list; ?archived=1 shows only them.
const showArchived = Astro.url.searchParams.get('archived') === '1';
let archiveOk = false;
const canManageSupplierPricing = await isAdminStaff(Astro);

try {
  const supabase = createSupabaseAdminClient();
  let query = supabase.from('suppliers').select('id, name, contact_name, email, phone, country').order('name');
  if (search) query = query.ilike('name', `%${search}%`);
  // Archived rows drop out of the active list. A no-op until the migration
  // is applied, so this cannot break the page in the meantime.
  archiveOk = await archiveSupported(supabase);
  query = withArchiveFilter(query, archiveOk, showArchived);
  const { data } = await query.limit(300);
  suppliers = data ?? [];
} catch {
  dbReady = false;
}
---

<AdminLayout title="Suppliers" parentLabel="Dashboard" parentHref="/admin">
  {!dbReady && (
    <div class="admin-placeholder" style="margin-bottom: 1.5rem;">
      <h2>Not connected to Supabase yet</h2>
      <p>See <code>README-ADMIN.md</code> to connect a project and run the schema.</p>
    </div>
  )}

  <ArchiveToggle supported={archiveOk} showingArchived={showArchived} />
  <div class="admin-toolbar">
    <form class="admin-toolbar__filters" method="GET">
      <input class="admin-input admin-input--search" type="search" name="q" placeholder="Search supplier name…" value={search} />
      <button class="admin-btn admin-btn--ghost" type="submit">Filter</button>
    </form>
  </div>
  <div slot="actions" style="display:flex; gap:0.6rem; align-items:center; flex-wrap:wrap;">
    {canManageSupplierPricing && <a class="admin-btn admin-btn--ghost" href="/admin/supplier-pricing">Supplier Pricing</a>}
    <a class="admin-btn" href="/admin/suppliers/new">+ New Supplier</a>
  </div>

  <div class="admin-panel">
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>Name</th><th>Contact</th><th>Email</th><th>Phone</th><th>Country</th></tr></thead>
        <tbody>
          {suppliers.map((s) => (
            <tr>
              <td><a href={`/admin/suppliers/${s.id}`}>{s.name}</a></td>
              <td>{s.contact_name || '—'}</td>
              <td>{s.email || '—'}</td>
              <td>{s.phone || '—'}</td>
              <td>{s.country || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {dbReady && suppliers.length === 0 && <p class="admin-empty">No suppliers yet.</p>}
  </div>
</AdminLayout>
