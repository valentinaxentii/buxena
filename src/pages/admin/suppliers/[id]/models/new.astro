---
export const prerender = false;

import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import ModelSelect from '../../../../../components/admin/ModelSelect.astro';
import '../../../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../../../lib/supabase-admin';

const { id } = Astro.params;
let supplier: any = null;
let products: any[] = [];
let error: string | null = null;

try {
  const supabase = createSupabaseAdminClient();
  const [supplierRes, productRows] = await Promise.all([
    supabase.from('suppliers').select('id, name, currency').eq('id', id).single(),
    supabase.from('products').select('id, model_name, cost').eq('is_active', true).order('model_name'),
  ]);
  supplier = supplierRes.data;
  products = productRows.data ?? [];

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const payload = {
      supplier_id: id,
      product_id: String(form.get('product_id') ?? '') || null,
      supplier_model_code: String(form.get('supplier_model_code') ?? '') || null,
      image_url: String(form.get('image_url') ?? '') || null,
      moq: form.get('moq') ? Number(form.get('moq')) : null,
      unit_cost: form.get('unit_cost') ? Number(form.get('unit_cost')) : null,
      currency: String(form.get('currency') ?? '') || null,
      lead_time_days: form.get('lead_time_days') ? Number(form.get('lead_time_days')) : null,
      production_time_days: form.get('production_time_days') ? Number(form.get('production_time_days')) : null,
      packed_dimensions: String(form.get('packed_dimensions') ?? '') || null,
      weight_kg: form.get('weight_kg') ? Number(form.get('weight_kg')) : null,
      units_per_40hc: form.get('units_per_40hc') ? Number(form.get('units_per_40hc')) : null,
      notes: String(form.get('notes') ?? '') || null,
      is_active: form.get('is_active') === 'on',
      last_price_update: String(form.get('last_price_update') ?? '') || null,
    };

    if (!payload.product_id) {
      error = 'Sauna model is required.';
    } else {
      const { error: insertError } = await supabase.from('supplier_products').insert(payload);
      if (insertError) {
        error = insertError.code === '23505'
          ? 'This model is already linked to this supplier — edit its existing entry instead.'
          : insertError.message;
      } else {
        return Astro.redirect(`/admin/suppliers/${id}`);
      }
    }
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}
---

<AdminLayout title={`Add Model — ${supplier?.name ?? 'Supplier'}`}>
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  <form class="admin-form" method="POST">
    <label class="admin-field admin-form__full"><span>Model *</span>
      <ModelSelect id="sp-product-select" name="product_id" products={products} />
    </label>
    <label class="admin-field"><span>Supplier Model Code</span><input type="text" name="supplier_model_code" placeholder="e.g. EDA 250" /></label>
    <label class="admin-field"><span>Model Picture (URL)</span><input type="url" name="image_url" placeholder="https://…" /></label>
    <label class="admin-field"><span>MOQ / Quantity</span><input type="number" name="moq" /></label>
    <label class="admin-field"><span>Unit Cost</span><input type="number" step="0.01" name="unit_cost" id="sp-unit-cost" /></label>
    <label class="admin-field"><span>Currency</span><input type="text" name="currency" maxlength="3" value={supplier?.currency ?? ''} /></label>
    <label class="admin-field"><span>Lead Time (days)</span><input type="number" name="lead_time_days" /></label>
    <label class="admin-field"><span>Production Time (days)</span><input type="number" name="production_time_days" /></label>
    <label class="admin-field"><span>Packed Dimensions</span><input type="text" name="packed_dimensions" /></label>
    <label class="admin-field"><span>Weight (kg)</span><input type="number" step="0.1" name="weight_kg" /></label>
    <label class="admin-field"><span>Units per 40HC</span><input type="number" name="units_per_40hc" /></label>
    <label class="admin-field"><span>Last Price Update</span><input type="date" name="last_price_update" /></label>
    <label class="admin-field"><span>Status</span>
      <select name="is_active"><option value="on">Active</option><option value="">Discontinued</option></select>
    </label>
    <label class="admin-field admin-form__full"><span>Notes</span><textarea name="notes"></textarea></label>

    <div class="admin-form__actions">
      <button class="admin-btn" type="submit">Add Model</button>
      <a class="admin-btn admin-btn--ghost" href={`/admin/suppliers/${id}`}>Cancel</a>
    </div>
  </form>
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
</style>

<script>
  const productHidden = document.getElementById('sp-product-select') as HTMLInputElement | null;
  const productWrap = productHidden?.closest('[data-model-select]');
  const unitCostInput = document.getElementById('sp-unit-cost') as HTMLInputElement | null;

  productWrap?.addEventListener('modelselect:change', ((e: CustomEvent) => {
    const product = e.detail?.product;
    if (!product || !unitCostInput) return;
    if (!unitCostInput.value && product.cost) unitCostInput.value = String(product.cost);
  }) as EventListener);
</script>
