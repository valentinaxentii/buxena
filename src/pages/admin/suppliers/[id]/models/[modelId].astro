---
export const prerender = false;

import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import '../../../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../../../lib/supabase-admin';

const { id, modelId } = Astro.params;
let supplier: any = null;
let record: any = null;
let error: string | null = null;
let notFound = false;

try {
  const supabase = createSupabaseAdminClient();

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const intent = String(form.get('_intent') ?? 'update');

    if (intent === 'delete') {
      await supabase.from('supplier_products').delete().eq('id', modelId);
      return Astro.redirect(`/admin/suppliers/${id}`);
    }

    const payload = {
      supplier_model_code: String(form.get('supplier_model_code') ?? '') || null,
      image_url: String(form.get('image_url') ?? '') || null,
      moq: form.get('moq') ? Number(form.get('moq')) : null,
      unit_cost: form.get('unit_cost') ? Number(form.get('unit_cost')) : null,
      currency: String(form.get('currency') ?? '') || null,
      lead_time_days: form.get('lead_time_days') ? Number(form.get('lead_time_days')) : null,
      production_time_days: form.get('production_time_days') ? Number(form.get('production_time_days')) : null,
      packed_dimensions: String(form.get('packed_dimensions') ?? '') || null,
      weight_kg: form.get('weight_kg') ? Number(form.get('weight_kg')) : null,
      units_per_40hc: form.get('units_per_40hc') ? Number(form.get('units_per_40hc')) : null,
      notes: String(form.get('notes') ?? '') || null,
      is_active: form.get('is_active') === 'on',
      last_price_update: String(form.get('last_price_update') ?? '') || null,
    };
    const { error: updateError } = await supabase.from('supplier_products').update(payload).eq('id', modelId);
    if (updateError) error = updateError.message;
  }

  const [supplierRes, recordRes] = await Promise.all([
    supabase.from('suppliers').select('id, name').eq('id', id).single(),
    supabase
      .from('supplier_products')
      .select('*, products(model_name, category, dimensions, capacity, timber_type, glass_configuration, heater_options)')
      .eq('id', modelId)
      .single(),
  ]);
  supplier = supplierRes.data;
  if (recordRes.error || !recordRes.data) notFound = true;
  else record = recordRes.data;
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}

function dimsText(dims: any): string {
  if (!dims) return '—';
  const parts = [dims.width, dims.depth, dims.height].filter(Boolean);
  return parts.length ? `${parts.join(' × ')} ${dims.unit ?? ''}`.trim() : '—';
}
---

<AdminLayout title={record?.products?.model_name ?? 'Supplier Model'} subtitle={supplier ? `Supplied by ${supplier.name}` : undefined} parentLabel={supplier?.name ?? 'Supplier'} parentHref={`/admin/suppliers/${id}`}>
  {notFound && <p class="admin-empty">Supplier model record not found.</p>}
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  {record && (
    <>
      <div class="admin-panel" style="padding:1.2rem 1.4rem; margin-bottom:1.75rem;">
        <h2 class="admin-section-title">{record.products?.model_name} — Product Specification</h2>
        <p style="font-size:0.82rem; color:var(--admin-muted); margin:0;">
          Category {record.products?.category || '—'} · Dimensions {dimsText(record.products?.dimensions)} ·
          Capacity {record.products?.capacity || '—'} · Material {record.products?.timber_type || '—'} ·
          Glass {record.products?.glass_configuration || '—'} · Heater options {(record.products?.heater_options ?? []).join(', ') || '—'}
        </p>
        <p style="font-size:0.75rem; color:var(--admin-muted); margin:0.5rem 0 0;">
          These come from the Product record itself (same regardless of supplier) — edit them on the
          <a href={`/admin/products`} style="color:var(--admin-gold);">Products</a> page, not here.
        </p>
      </div>

      <form class="admin-form" method="POST">
        <label class="admin-field"><span>Supplier Model Code</span><input type="text" name="supplier_model_code" value={record.supplier_model_code ?? ''} /></label>
        <label class="admin-field"><span>Model Picture (URL)</span><input type="url" name="image_url" value={record.image_url ?? ''} /></label>
        <label class="admin-field"><span>MOQ / Quantity</span><input type="number" name="moq" value={record.moq ?? ''} /></label>
        <label class="admin-field"><span>Unit Cost</span><input type="number" step="0.01" name="unit_cost" value={record.unit_cost ?? ''} /></label>
        <label class="admin-field"><span>Currency</span><input type="text" name="currency" maxlength="3" value={record.currency ?? ''} /></label>
        <label class="admin-field"><span>Lead Time (days)</span><input type="number" name="lead_time_days" value={record.lead_time_days ?? ''} /></label>
        <label class="admin-field"><span>Production Time (days)</span><input type="number" name="production_time_days" value={record.production_time_days ?? ''} /></label>
        <label class="admin-field"><span>Packed Dimensions</span><input type="text" name="packed_dimensions" value={record.packed_dimensions ?? ''} /></label>
        <label class="admin-field"><span>Weight (kg)</span><input type="number" step="0.1" name="weight_kg" value={record.weight_kg ?? ''} /></label>
        <label class="admin-field"><span>Units per 40HC</span><input type="number" name="units_per_40hc" value={record.units_per_40hc ?? ''} /></label>
        <label class="admin-field"><span>Last Price Update</span><input type="date" name="last_price_update" value={record.last_price_update ?? ''} /></label>
        <label class="admin-field"><span>Status</span>
          <select name="is_active">
            <option value="on" selected={record.is_active}>Active</option>
            <option value="" selected={!record.is_active}>Discontinued</option>
          </select>
        </label>
        <label class="admin-field admin-form__full"><span>Notes</span><textarea name="notes">{record.notes ?? ''}</textarea></label>

        <div class="admin-form__actions">
          <button class="admin-btn" type="submit">Save Changes</button>
          <a class="admin-btn admin-btn--ghost" href={`/admin/suppliers/${id}`}>Back to Supplier</a>
        </div>
      </form>

      <form method="POST" style="margin-top:1.5rem;" onsubmit="return confirm('Remove this model from this supplier? This cannot be undone.');">
        <input type="hidden" name="_intent" value="delete" />
        <button class="admin-btn admin-btn--ghost" type="submit" style="color:#e6b7a0; border-color:rgba(230,130,90,0.35);">Remove Model From Supplier</button>
      </form>
    </>
  )}
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
</style>
