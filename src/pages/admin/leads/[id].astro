---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ModelSelect from '../../../components/admin/ModelSelect.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import { isAdminStaff, refuseDelete } from '../../../lib/staff-access';
import { getSettings, FALLBACK_SETTINGS } from '../../../lib/settings';

// Permanent deletion is admin-only; enforced server-side in the handler below.
const canDelete = await isAdminStaff(Astro);

const { id } = Astro.params;
const STATUSES = ['New Lead', 'Contacted', 'Qualified', 'Quote Sent', 'Negotiating', 'Won', 'Lost'];

let lead: any = null;
let products: any[] = [];
let staff: any[] = [];
let error: string | null = null;
let notFound = false;
let SOURCES: string[] = FALLBACK_SETTINGS.lead_sources;

try {
  const supabase = createSupabaseAdminClient();
  SOURCES = (await getSettings(supabase)).lead_sources;

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const intent = String(form.get('_intent') ?? 'update');

    if (intent === 'delete') {
      if (!canDelete) return refuseDelete(Astro);
      await supabase.from('leads').delete().eq('id', id);
      return Astro.redirect('/admin/leads');
    }

    const payload = {
      name: String(form.get('name') ?? ''),
      email: String(form.get('email') ?? '') || null,
      phone: String(form.get('phone') ?? '') || null,
      state: String(form.get('state') ?? '') || null,
      source: String(form.get('source') ?? 'Manual'),
      product_id: String(form.get('product_id') ?? '') || null,
      location_type: String(form.get('location_type') ?? '') || null,
      budget: form.get('budget') ? Number(form.get('budget')) : null,
      heater_preference: String(form.get('heater_preference') ?? '') || null,
      timeline: String(form.get('timeline') ?? '') || null,
      notes: String(form.get('notes') ?? '') || null,
      follow_up_date: String(form.get('follow_up_date') ?? '') || null,
      assigned_staff: String(form.get('assigned_staff') ?? '') || null,
      status: String(form.get('status') ?? 'New Lead'),
    };
    const { error: updateError } = await supabase.from('leads').update(payload).eq('id', id);
    if (updateError) error = updateError.message;
  }

  const [leadRow, productRows, staffRows] = await Promise.all([
    supabase.from('leads').select('*').eq('id', id).single(),
    supabase.from('products').select('id, model_name, heater_options').eq('is_active', true).order('model_name'),
    supabase.from('profiles').select('id, full_name'),
  ]);

  if (leadRow.error || !leadRow.data) {
    notFound = true;
  } else {
    lead = leadRow.data;
  }
  products = productRows.data ?? [];
  staff = staffRows.data ?? [];

  if (lead?.product_id && !products.some((p) => p.id === lead.product_id)) {
    const { data: selectedProduct } = await supabase
      .from('products')
      .select('id, model_name, heater_options')
      .eq('id', lead.product_id)
      .single();
    if (selectedProduct) products = [selectedProduct, ...products];
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}
---

<AdminLayout title={lead ? lead.name : 'Lead'} parentLabel="Leads" parentHref="/admin/leads">
  {notFound && <p class="admin-empty">Lead not found.</p>}
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  {lead && (
    <>
    <form class="admin-form" method="POST">
      <label class="admin-field"><span>Name *</span><input type="text" name="name" value={lead.name} required /></label>
      <label class="admin-field"><span>Email</span><input type="email" name="email" value={lead.email ?? ''} /></label>
      <label class="admin-field"><span>Phone</span><input type="tel" name="phone" value={lead.phone ?? ''} /></label>
      <label class="admin-field"><span>State</span><input type="text" name="state" value={lead.state ?? ''} /></label>

      <label class="admin-field">
        <span>Source</span>
        <select name="source">{SOURCES.map((s) => <option value={s} selected={s === lead.source}>{s}</option>)}</select>
      </label>
      <label class="admin-field">
        <span>Sauna Model of Interest</span>
        <ModelSelect id="lead-product-select" name="product_id" products={products} value={lead.product_id} />
      </label>

      <label class="admin-field">
        <span>Indoor / Outdoor</span>
        <select name="location_type">
          <option value="" selected={!lead.location_type}>— unspecified —</option>
          <option value="indoor" selected={lead.location_type === 'indoor'}>Indoor</option>
          <option value="outdoor" selected={lead.location_type === 'outdoor'}>Outdoor</option>
        </select>
      </label>
      <label class="admin-field"><span>Budget (USD)</span><input type="number" step="0.01" name="budget" value={lead.budget ?? ''} /></label>

      <label class="admin-field"><span>Heater Preference</span><input type="text" name="heater_preference" id="lead-heater-preference" value={lead.heater_preference ?? ''} /></label>
      <label class="admin-field"><span>Timeline</span><input type="text" name="timeline" value={lead.timeline ?? ''} /></label>

      <label class="admin-field"><span>Follow-Up Date</span><input type="date" name="follow_up_date" value={lead.follow_up_date ?? ''} /></label>
      <label class="admin-field">
        <span>Assigned Staff</span>
        <select name="assigned_staff">
          <option value="">— unassigned —</option>
          {staff.map((s) => <option value={s.id} selected={s.id === lead.assigned_staff}>{s.full_name || s.id}</option>)}
        </select>
      </label>

      <label class="admin-field">
        <span>Status</span>
        <select name="status">{STATUSES.map((s) => <option value={s} selected={s === lead.status}>{s}</option>)}</select>
      </label>

      <label class="admin-field admin-form__full"><span>Notes</span><textarea name="notes">{lead.notes ?? ''}</textarea></label>

      <div class="admin-form__actions">
        <button class="admin-btn" type="submit">Save Changes</button>
        <a class="admin-btn admin-btn--ghost" href="/admin/leads">Back to Leads</a>
      </div>
    </form>

    {canDelete && (
      <form method="POST" style="margin-top:1.5rem;" onsubmit="return confirm('Delete this lead? This cannot be undone.');">
        <input type="hidden" name="_intent" value="delete" />
        <button class="admin-btn admin-btn--ghost" type="submit" style="color:#e6b7a0; border-color:rgba(230,130,90,0.35);">Delete Lead</button>
      </form>
    )}
    </>
  )}
</AdminLayout>

<style>
  .notice--error {
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
    color: #e6b7a0;
    background: rgba(230, 130, 90, 0.06);
    border: 1px solid rgba(230, 130, 90, 0.35);
    border-radius: 2px;
  }
</style>

<script>
  const productHidden = document.getElementById('lead-product-select') as HTMLInputElement | null;
  const productWrap = productHidden?.closest('[data-model-select]');
  const heaterInput = document.getElementById('lead-heater-preference') as HTMLInputElement | null;

  productWrap?.addEventListener('modelselect:change', ((e: CustomEvent) => {
    const product = e.detail?.product;
    if (!product || !heaterInput) return;
    if (heaterInput.value && !heaterInput.dataset.autofilled) return;
    const heaterOptions = Array.isArray(product.heater_options) ? product.heater_options : [];
    if (heaterOptions.length) {
      heaterInput.value = heaterOptions[0];
      heaterInput.dataset.autofilled = 'true';
      heaterInput.addEventListener('input', () => { delete heaterInput.dataset.autofilled; }, { once: true });
    }
  }) as EventListener);
</script>
