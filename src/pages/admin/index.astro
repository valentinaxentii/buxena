---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import '../../styles/admin.css';
import { createSupabaseAdminClient } from '../../lib/supabase-admin';

const PIPELINE_STAGES = ['New Lead', 'Contacted', 'Qualified', 'Quote Sent', 'Negotiating', 'Won', 'Lost'];
const OPEN_QUOTE_STATUSES = ['Draft', 'Sent', 'Viewed', 'Negotiating'];
const LOW_STOCK_THRESHOLD = 2;
const ETA_SOON_DAYS = 14;
const EXPIRY_SOON_DAYS = 7;

let dbReady = true;

let pipeline: { stage: string; count: number; value: number }[] = [];
let totalLeadsCount = 0;
let activeLeadsCount = 0;
let followUpCount = 0;

let openQuotesCount = 0;
let openQuoteValue = 0;

let ordersInProgressCount = 0;
let ordersInProgressValue = 0;

let unitsInStock = 0;
let incomingInventory = 0;
let newEnquiriesCount = 0;

let outstandingBalance = 0;
let overdueBalance = 0;
let nextShipment: { eta: string; container_number: string | null; total_units: number } | null = null;

let needsAttention: { label: string; detail: string; href: string; overdue?: boolean }[] = [];
let recentActivity: { label: string; detail: string; href: string; when: string; kind: string }[] = [];
let topProducts: { name: string; count: number }[] = [];

function daysFromNow(n: number): string {
  const d = new Date();
  d.setDate(d.getDate() + n);
  return d.toISOString().slice(0, 10);
}
function timeAgo(iso: string): string {
  const ms = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 60) return `${Math.max(mins, 0)}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}
function money(n: number | null | undefined): string {
  return `$${(Number(n) || 0).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
}
// Presentation only: split "Type — Entity" labels into the two-line stack.
function splitLabel(label: string): { primary: string; secondary: string } {
  const idx = label.indexOf(' — ');
  if (idx === -1) return { primary: label, secondary: '' };
  return { primary: label.slice(idx + 3), secondary: label.slice(0, idx) };
}

try {
  const supabase = createSupabaseAdminClient();
  const today = new Date().toISOString().slice(0, 10);

  const [
    leadRows,
    followUpRows,
    openQuoteRows,
    expiringQuoteRows,
    orderRows,
    inventoryRows,
    lowStockRows,
    etaSoonRows,
    newEnquiryRows,
    recentLeads,
    recentQuotes,
    recentOrders,
    recentCustomers,
    recentEnquiries,
    orderProductRows,
    outstandingInvoiceRows,
    nextShipmentRows,
    newEnquiryCountRows,
    followUpCountRows,
  ] = await Promise.all([
    supabase.from('leads').select('status, budget'),
    supabase
      .from('leads')
      .select('id, name, follow_up_date')
      .lte('follow_up_date', today)
      .not('status', 'in', '("Won","Lost")')
      .order('follow_up_date', { ascending: true })
      .limit(4),
    supabase.from('quotes').select('total').in('status', OPEN_QUOTE_STATUSES),
    supabase
      .from('quotes')
      .select('id, quote_number, expiry_date, customers(name)')
      .in('status', OPEN_QUOTE_STATUSES)
      .gte('expiry_date', today)
      .lte('expiry_date', daysFromNow(EXPIRY_SOON_DAYS))
      .order('expiry_date', { ascending: true })
      .limit(4),
    supabase.from('orders').select('selling_price, status').not('status', 'in', '("Delivered","Installed")'),
    supabase.from('inventory').select('in_stock, incoming'),
    supabase
      .from('inventory')
      .select('id, available, products(model_name)')
      .lte('available', LOW_STOCK_THRESHOLD)
      .order('available', { ascending: true })
      .limit(4),
    supabase
      .from('inventory')
      .select('id, eta, products(model_name)')
      .gte('eta', today)
      .lte('eta', daysFromNow(ETA_SOON_DAYS))
      .order('eta', { ascending: true })
      .limit(4),
    supabase.from('enquiries').select('id, name, source, created_at').eq('status', 'New').order('created_at', { ascending: false }).limit(4),
    supabase.from('enquiries').select('id', { count: 'exact', head: true }).eq('status', 'New'),
    supabase
      .from('leads')
      .select('id', { count: 'exact', head: true })
      .lte('follow_up_date', today)
      .not('status', 'in', '("Won","Lost")'),
    supabase.from('leads').select('id, name, created_at').order('created_at', { ascending: false }).limit(6),
    supabase.from('quotes').select('id, quote_number, created_at').order('created_at', { ascending: false }).limit(6),
    supabase.from('orders').select('id, order_number, created_at').order('created_at', { ascending: false }).limit(6),
    supabase.from('customers').select('id, name, created_at').order('created_at', { ascending: false }).limit(6),
    supabase.from('enquiries').select('id, name, source, created_at').order('created_at', { ascending: false }).limit(6),
    supabase.from('orders').select('product_id, products(model_name)').not('product_id', 'is', null),
    // NEW (read-only): outstanding invoice balances — drafts and voids excluded
    supabase.from('invoices').select('balance_due, due_date, status').in('status', ['issued', 'partially_paid', 'overdue']),
    // NEW (read-only): earliest inbound container not yet received/cancelled
    supabase.from('shipments').select('eta, container_number, total_units, status').not('status', 'in', '("Received","Cancelled")').not('eta', 'is', null).order('eta', { ascending: true }).limit(1),
  ]);

  const leads = leadRows.data ?? [];
  totalLeadsCount = leads.length;
  activeLeadsCount = leads.filter((l) => l.status !== 'Won' && l.status !== 'Lost').length;
  pipeline = PIPELINE_STAGES.map((stage) => {
    const stageLeads = leads.filter((l) => l.status === stage);
    return {
      stage,
      count: stageLeads.length,
      value: stageLeads.reduce((sum, l) => sum + Number(l.budget ?? 0), 0),
    };
  });
  // exact counts (the *Rows fetches above are capped at 4 for the Attention list) —
  // read-only, no calculation this dashboard didn't already make elsewhere
  followUpCount = followUpCountRows.count ?? followUpRows.data?.length ?? 0;
  newEnquiriesCount = newEnquiryCountRows.count ?? newEnquiryRows.data?.length ?? 0;

  openQuotesCount = (openQuoteRows.data ?? []).length;
  openQuoteValue = (openQuoteRows.data ?? []).reduce((sum, q) => sum + Number(q.total ?? 0), 0);

  const inProgressOrders = orderRows.data ?? [];
  ordersInProgressCount = inProgressOrders.length;
  ordersInProgressValue = inProgressOrders.reduce((sum, o) => sum + Number(o.selling_price ?? 0), 0);

  unitsInStock = (inventoryRows.data ?? []).reduce((sum, r) => sum + (r.in_stock ?? 0), 0);
  incomingInventory = (inventoryRows.data ?? []).reduce((sum, r) => sum + (r.incoming ?? 0), 0);

  const outstanding = outstandingInvoiceRows.data ?? [];
  outstandingBalance = outstanding.reduce((s: number, r: any) => s + Number(r.balance_due ?? 0), 0);
  overdueBalance = outstanding
    .filter((r: any) => r.due_date && r.due_date < today)
    .reduce((s: number, r: any) => s + Number(r.balance_due ?? 0), 0);
  nextShipment = nextShipmentRows.data?.[0] ?? null;

  needsAttention = [
    ...(followUpRows.data ?? []).map((l: any) => ({
      label: `Follow-up — ${l.name}`,
      detail: l.follow_up_date ? `Due ${l.follow_up_date}` : '',
      href: `/admin/leads/${l.id}`,
      overdue: true,
    })),
    ...(expiringQuoteRows.data ?? []).map((q: any) => ({
      label: `Quote expiring — ${q.quote_number || 'Quote'}`,
      detail: `Expires ${q.expiry_date}`,
      href: `/admin/quotes/${q.id}`,
    })),
    ...(lowStockRows.data ?? []).map((i: any) => ({
      label: `Low stock — ${i.products?.model_name ?? 'Unknown model'}`,
      detail: `${i.available ?? 0} available`,
      href: `/admin/inventory/${i.id}`,
    })),
    ...(etaSoonRows.data ?? []).map((i: any) => ({
      label: `Arriving — ${i.products?.model_name ?? 'Unknown model'}`,
      detail: `ETA ${i.eta}`,
      href: `/admin/inventory/${i.id}`,
    })),
    ...(newEnquiryRows.data ?? []).map((e: any) => ({
      label: `Unhandled enquiry — ${e.name || e.source}`,
      detail: timeAgo(e.created_at),
      href: `/admin/enquiries`,
    })),
  ];

  recentActivity = [
    ...(recentLeads.data ?? []).map((l: any) => ({ label: 'New lead', detail: l.name, href: `/admin/leads/${l.id}`, when: l.created_at, kind: 'lead' })),
    ...(recentQuotes.data ?? []).map((q: any) => ({ label: 'Quote created', detail: q.quote_number || 'Quote', href: `/admin/quotes/${q.id}`, when: q.created_at, kind: 'quote' })),
    ...(recentOrders.data ?? []).map((o: any) => ({ label: 'Order created', detail: o.order_number || 'Order', href: `/admin/orders/${o.id}`, when: o.created_at, kind: 'order' })),
    ...(recentCustomers.data ?? []).map((c: any) => ({ label: 'New customer', detail: c.name, href: `/admin/customers/${c.id}`, when: c.created_at, kind: 'customer' })),
    ...(recentEnquiries.data ?? []).map((e: any) => ({ label: 'Website enquiry', detail: e.name || e.source, href: `/admin/enquiries`, when: e.created_at, kind: 'enquiry' })),
  ]
    .filter((r) => r.when)
    .sort((a, b) => new Date(b.when).getTime() - new Date(a.when).getTime())
    .slice(0, 5);

  const productCounts = new Map<string, number>();
  for (const row of orderProductRows.data ?? []) {
    const name = (row as any).products?.model_name;
    if (!name) continue;
    productCounts.set(name, (productCounts.get(name) ?? 0) + 1);
  }
  topProducts = [...productCounts.entries()]
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count);
} catch {
  dbReady = false;
}

const maxPipelineCount = Math.max(1, ...pipeline.map((p) => p.count));

// KPI corner icons — same line-icon set the sidebar uses, matched to each metric.
const KPI_ICONS: Record<string, string> = {
  quotes: '<path d="M6 2.8h8l4 4V21H6z"/><path d="M14 2.8v4h4"/><path d="M9 12h6M9 16h6"/>',
  orders: '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
  invoices: '<path d="M6 2.8h12v18.2l-2-1.4-2 1.4-2-1.4-2 1.4-2-1.4-2 1.4z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  shipments: '<path d="M2.5 6h12v11h-12z"/><path d="M14.5 10h4l2.5 3.5V17h-7"/><circle cx="6.5" cy="17.8" r="1.8"/><circle cx="17" cy="17.8" r="1.8"/>',
  enquiries: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3 7 9 6 9-6"/>',
};

function formatEta(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(y, m - 1, d).toLocaleDateString('en-US', { day: 'numeric', month: 'short' });
}

// Small line icons for the activity chips, keyed by entry kind.
const ACT_ICONS: Record<string, string> = {
  lead: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c.6-3.4 2.9-5.2 5.5-5.2s4.9 1.8 5.5 5.2M17 8h5M19.5 5.5v5"/>',
  quote: '<path d="M6 2.8h8l4 4V21H6z"/><path d="M14 2.8v4h4M9 12h6M9 16h6"/>',
  order: '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
  customer: '<circle cx="12" cy="8.5" r="3.4"/><path d="M5 20.5c.7-3.8 3.4-5.8 7-5.8s6.3 2 7 5.8"/>',
  enquiry: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3 7 9 6 9-6"/>',
};

// Donut: top 4 products + an "Others" remainder from the same existing data.
// Graduated gold→bronze ramp; Others uses the darkest step.
const DONUT_RAMP = ['#c9a668', '#a8874f', '#86683a', '#5f4a29'];
const OTHERS_COLOR = '#3a2f1c';
const donutTotal = topProducts.reduce((sum, p) => sum + p.count, 0);
const top4 = topProducts.slice(0, 4);
const othersCount = topProducts.slice(4).reduce((sum, p) => sum + p.count, 0);
const donutSlices = [
  ...top4.map((p, i) => ({ ...p, color: DONUT_RAMP[i] })),
  ...(othersCount > 0 ? [{ name: 'Others', count: othersCount, color: OTHERS_COLOR }] : []),
];
let donutAcc = 0;
const donutStops = donutSlices
  .map((s) => {
    const from = donutTotal > 0 ? (donutAcc / donutTotal) * 100 : 0;
    donutAcc += s.count;
    const to = donutTotal > 0 ? (donutAcc / donutTotal) * 100 : 0;
    return `${s.color} ${from}% ${to}%`;
  })
  .join(', ');
const pct = (n: number) => (donutTotal > 0 ? Math.round((n / donutTotal) * 100) : 0);
---

<AdminLayout title="Dashboard" subtitle="Business overview">
  <a slot="actions" class="admin-btn" href="/admin/quotes/new">+ New Quote</a>

  {!dbReady && (
    <div class="admin-placeholder" style="margin-bottom: 1rem;">
      <h2>Not connected to Supabase yet</h2>
      <p>
        Set <code>SUPABASE_URL</code>, <code>SUPABASE_ANON_KEY</code> and
        <code>SUPABASE_SERVICE_ROLE_KEY</code>, then run <code>supabase/schema.sql</code> in your
        project's SQL editor. See <code>README-ADMIN.md</code> for exact steps.
      </p>
    </div>
  )}

  <!-- BAND 2: KPI row — the four things checked daily -->
  <div class="dx-kpis">
    <a class="dx-kpi" href="/admin/quotes">
      <span class="dx-kpi__head">
        <span class="dx-kpi__label">Open Quote Value</span>
        <svg class="dx-kpi__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={KPI_ICONS.quotes} />
      </span>
      <span class="dx-kpi__value">{money(openQuoteValue)}</span>
      <span class="dx-kpi__support">
        <span class="dx-kpi__caption">{openQuotesCount} open quote{openQuotesCount === 1 ? '' : 's'}</span>
      </span>
    </a>
    <a class="dx-kpi" href="/admin/orders">
      <span class="dx-kpi__head">
        <span class="dx-kpi__label">Orders in Progress</span>
        <svg class="dx-kpi__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={KPI_ICONS.orders} />
      </span>
      <span class="dx-kpi__value">{money(ordersInProgressValue)}</span>
      <span class="dx-kpi__support">
        <span class="dx-kpi__caption">{ordersInProgressCount} order{ordersInProgressCount === 1 ? '' : 's'}</span>
      </span>
    </a>
    <a class="dx-kpi" href="/admin/invoices">
      <span class="dx-kpi__head">
        <span class="dx-kpi__label">Outstanding Balance</span>
        <svg class="dx-kpi__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={KPI_ICONS.invoices} />
      </span>
      <span class="dx-kpi__value">{money(outstandingBalance)}</span>
      <span class="dx-kpi__support">
        <span class={`dx-kpi__caption ${overdueBalance > 0 ? 'dx-kpi__caption--overdue' : ''}`}>{money(overdueBalance)} overdue</span>
      </span>
    </a>
    <a class="dx-kpi" href="/admin/enquiries?status=New">
      <span class="dx-kpi__head">
        <span class="dx-kpi__label">New Enquiries</span>
        <svg class="dx-kpi__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={KPI_ICONS.enquiries} />
      </span>
      <span class="dx-kpi__value">{newEnquiriesCount}</span>
      <span class="dx-kpi__support">
        <span class={`dx-kpi__caption ${newEnquiriesCount > 0 ? 'dx-kpi__caption--attn' : ''}`}>{newEnquiriesCount > 0 ? 'Needs attention' : 'All clear'}</span>
      </span>
    </a>
    <a class="dx-kpi" href="/admin/shipments">
      <span class="dx-kpi__head">
        <span class="dx-kpi__label">Next Container</span>
        <svg class="dx-kpi__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={KPI_ICONS.shipments} />
      </span>
      <span class="dx-kpi__value">{nextShipment ? formatEta(nextShipment.eta) : '—'}</span>
      <span class="dx-kpi__support">
        <span class="dx-kpi__caption">{nextShipment ? [nextShipment.container_number, `${nextShipment.total_units} units`].filter(Boolean).join(' · ') : 'none inbound'}</span>
      </span>
    </a>
  </div>

  <!-- secondary stat strip: quick current-state facts, one line -->
  <p class="dx-substrip">
    <a href="/admin/inventory">In Stock <strong>{unitsInStock}</strong></a>
    <span class="dx-substrip__dot" aria-hidden="true">•</span>
    <a href="/admin/inventory">Incoming <strong>{incomingInventory}</strong></a>
    <span class="dx-substrip__dot" aria-hidden="true">•</span>
    <a href="/admin/enquiries">New Enquiries <strong>{newEnquiriesCount}</strong></a>
    <span class="dx-substrip__dot" aria-hidden="true">•</span>
    <a href="/admin/leads">Follow-Ups Due <strong>{followUpCount}</strong></a>
  </p>

  <!-- BAND 3: Sales Pipeline — one continuous bar -->
  <section class="dx-panel">
    <header class="dx-panel__head">
      <h2>Sales Pipeline</h2>
      <a class="dx-panel__more" href="/admin/leads">View all leads →</a>
    </header>
    <div class="dx-pipebar">
      {pipeline.map((p) => (
        <a class="dx-pipebar__cell" href={`/admin/leads?status=${encodeURIComponent(p.stage)}`}>
          <span class="dx-pipebar__toprow">
            <span class="dx-pipebar__stage">{p.stage}</span>
            <span class="dx-pipebar__badge">{p.count}</span>
          </span>
          <span class={`dx-pipebar__value ${p.value > 0 ? '' : 'dx-pipebar__value--zero'}`}>{money(p.value)}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- BAND 4: three panels -->
  <div class="dx-grid">
    <section class="dx-panel">
      <header class="dx-panel__head">
        <h2>Recent Activity</h2>
        <a class="dx-panel__more" href="/admin/analytics">View all →</a>
      </header>
      <ul class="dx-rows">
        {recentActivity.map((item) => (
          <li>
            <a class="dx-row" href={item.href}>
              <span class="dx-row__chip" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ACT_ICONS[item.kind] ?? ACT_ICONS.lead} />
              </span>
              <span class="dx-row__text">
                <span class="dx-row__primary">{item.detail}</span>
                <span class="dx-row__secondary">{item.label}</span>
              </span>
              <span class="dx-row__meta">{timeAgo(item.when)}</span>
            </a>
          </li>
        ))}
        {Array.from({ length: Math.max(0, 5 - recentActivity.length) }).map(() => (
          <li class="dx-row dx-row--ghost dx-row--activity" aria-hidden="true" />
        ))}
      </ul>
    </section>

    <section class="dx-panel">
      <header class="dx-panel__head">
        <h2>Attention Needed</h2>
        <a class="dx-panel__more" href="/admin/leads">View all →</a>
      </header>
      <ul class="dx-rows">
        {needsAttention.slice(0, 6).map((item) => {
          const parts = splitLabel(item.label);
          return (
            <li>
              <a class="dx-row" href={item.href}>
                <span class="dx-row__dot" aria-hidden="true" />
                <span class="dx-row__text">
                  <span class="dx-row__primary">{parts.primary}</span>
                  {parts.secondary && <span class="dx-row__secondary">{parts.secondary}</span>}
                </span>
                <span class={`dx-row__meta ${item.overdue ? 'dx-row__meta--overdue' : 'dx-row__meta--gold'}`}>{item.detail}</span>
              </a>
            </li>
          );
        })}
        {Array.from({ length: Math.max(0, 5 - needsAttention.length) }).map(() => (
          <li class="dx-row dx-row--ghost dx-row--task" aria-hidden="true" />
        ))}
      </ul>
    </section>

    <section class="dx-panel">
      <header class="dx-panel__head">
        <h2>Top Products</h2>
        <a class="dx-panel__more" href="/admin/products">View all →</a>
      </header>
      <div class="dx-donut-wrap">
        <div
          class="dx-donut"
          style={donutTotal > 0 ? `background: conic-gradient(${donutStops});` : 'background: rgba(201, 166, 104, 0.10);'}
          role="img"
          aria-label={`${donutTotal} orders by product`}
        >
          <span class="dx-donut__hole">
            <span class="dx-donut__num">{donutTotal}</span>
            <span class="dx-donut__cap">orders</span>
          </span>
        </div>
        <div class="dx-legend-col">
          <ul class="dx-legend">
            {donutSlices.map((s) => (
              <li>
                <span class="dx-legend__dot" style={`background:${s.color}`} />
                <span class="dx-legend__name">{s.name}</span>
                <span class="dx-legend__count">{s.count} · {pct(s.count)}%</span>
              </li>
            ))}
            {donutSlices.length === 0 &&
              Array.from({ length: 4 }).map(() => (
                <li class="dx-legend__ghost" aria-hidden="true">
                  <span class="dx-legend__dot" />
                  <span class="dx-legend__name">—</span>
                  <span class="dx-legend__count">0</span>
                </li>
              ))}
          </ul>
          {donutSlices.length === 0 && <p class="dx-caption">No product orders yet.</p>}
        </div>
      </div>
      <a class="dx-products-btn" href="/admin/products">View all products →</a>
    </section>
  </div>
</AdminLayout>

<script>
  // Keep the dashboard live: reload every 5 minutes while the tab is visible;
  // if it fires while hidden, reload the moment the tab is next focused.
  const REFRESH_MS = 5 * 60 * 1000;
  let refreshDue = false;
  setInterval(() => {
    if (document.visibilityState === 'visible') location.reload();
    else refreshDue = true;
  }, REFRESH_MS);
  document.addEventListener('visibilitychange', () => {
    if (refreshDue && document.visibilityState === 'visible') location.reload();
  });
</script>

<style>
