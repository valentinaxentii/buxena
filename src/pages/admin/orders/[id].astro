---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import ModelSelect from '../../../components/admin/ModelSelect.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import { releaseInventoryUnit } from '../../../lib/inventory-reservation';

const { id } = Astro.params;
const STATUSES = [
  'Deposit Received', 'Ordered', 'In Production', 'Shipped', 'At Port',
  'Warehouse', 'Delivery Scheduled', 'Delivered', 'Installed',
];
const INSTALLATION_STATUSES = ['Not Started', 'Scheduled', 'In Progress', 'Completed'];

let order: any = null;
let customers: any[] = [];
let products: any[] = [];
let suppliers: any[] = [];
let error: string | null = null;
let notFound = false;

try {
  const supabase = createSupabaseAdminClient();

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const intent = String(form.get('_intent') ?? 'update');

    if (intent === 'delete') {
      const { data: existing } = await supabase.from('orders').select('product_id').eq('id', id).single();
      await supabase.from('orders').delete().eq('id', id);
      if (existing?.product_id) await releaseInventoryUnit(supabase, existing.product_id);
      return Astro.redirect('/admin/orders');
    }

    const accessories = String(form.get('accessories') ?? '')
      .split(',').map((s) => s.trim()).filter(Boolean);

    const payload = {
      customer_id: String(form.get('customer_id') ?? '') || null,
      product_id: String(form.get('product_id') ?? '') || null,
      supplier_id: String(form.get('supplier_id') ?? '') || null,
      heater: String(form.get('heater') ?? '') || null,
      accessories: accessories.length ? accessories : null,
      selling_price: Number(form.get('selling_price') ?? 0) || 0,
      deposit: Number(form.get('deposit') ?? 0) || 0,
      balance: Number(form.get('balance') ?? 0) || 0,
      purchase_order: String(form.get('purchase_order') ?? '') || null,
      container_number: String(form.get('container_number') ?? '') || null,
      production_completion_date: String(form.get('production_completion_date') ?? '') || null,
      etd: String(form.get('etd') ?? '') || null,
      eta: String(form.get('eta') ?? '') || null,
      port: String(form.get('port') ?? '') || null,
      warehouse: String(form.get('warehouse') ?? '') || null,
      delivery_address: String(form.get('delivery_address') ?? '') || null,
      delivery_date: String(form.get('delivery_date') ?? '') || null,
      installation_status: String(form.get('installation_status') ?? '') || null,
      installation_date: String(form.get('installation_date') ?? '') || null,
      status: String(form.get('status') ?? 'Deposit Received'),
      notes: String(form.get('notes') ?? '') || null,
      product_cost: Number(form.get('product_cost') ?? 0) || 0,
      ocean_freight: Number(form.get('ocean_freight') ?? 0) || 0,
      customs_duty: Number(form.get('customs_duty') ?? 0) || 0,
      port_handling: Number(form.get('port_handling') ?? 0) || 0,
      inland_delivery: Number(form.get('inland_delivery') ?? 0) || 0,
      warehouse_cost: Number(form.get('warehouse_cost') ?? 0) || 0,
      installation_cost: Number(form.get('installation_cost') ?? 0) || 0,
      other_cost: Number(form.get('other_cost') ?? 0) || 0,
    };
    const { error: updateError } = await supabase.from('orders').update(payload).eq('id', id);
    if (updateError) error = updateError.message;
  }

  const [orderRow, customerRows, productRows, supplierRows] = await Promise.all([
    supabase.from('orders_with_margin').select('*').eq('id', id).single(),
    supabase.from('customers').select('id, name').order('name'),
    supabase.from('products').select('id, model_name, supplier_id, cost').eq('is_active', true).order('model_name'),
    supabase.from('suppliers').select('id, name').order('name'),
  ]);

  if (orderRow.error || !orderRow.data) notFound = true;
  else order = orderRow.data;
  customers = customerRows.data ?? [];
  products = productRows.data ?? [];
  suppliers = supplierRows.data ?? [];

  if (order?.product_id && !products.some((p) => p.id === order.product_id)) {
    const { data: selectedProduct } = await supabase
      .from('products')
      .select('id, model_name, supplier_id, cost')
      .eq('id', order.product_id)
      .single();
    if (selectedProduct) products = [selectedProduct, ...products];
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}

function money(n: number | null | undefined): string {
  return n == null ? '—' : `$${Number(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}
---

<AdminLayout title={order ? (order.order_number || 'Order') : 'Order'} parentLabel="Orders" parentHref="/admin/orders">
  {notFound && <p class="admin-empty">Order not found.</p>}
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  {order && (
    <>
      <p style="margin-top:-0.5rem;"><StatusBadge status={order.status} /></p>

      <form class="admin-form" method="POST">
        {/* identifies the record — read-only, no name attribute, never submitted */}
        <label class="admin-field admin-form__full"><span>Order Number</span>
          <input type="text" value={order.order_number ?? ''} placeholder="—" readonly disabled />
        </label>
        <label class="admin-field"><span>Customer *</span>
          <select name="customer_id" required>
            <option value="">— select —</option>
            {customers.map((c) => <option value={c.id} selected={c.id === order.customer_id}>{c.name}</option>)}
          </select>
        </label>
        <label class="admin-field"><span>Sauna Model</span>
          <ModelSelect id="order-product-select" name="product_id" products={products} value={order.product_id} />
        </label>
        <label class="admin-field"><span>Supplier</span>
          <select name="supplier_id" id="order-supplier">
            <option value="">— none —</option>
            {suppliers.map((s) => <option value={s.id} selected={s.id === order.supplier_id}>{s.name}</option>)}
          </select>
        </label>
        <label class="admin-field"><span>Heater</span><input type="text" name="heater" value={order.heater ?? ''} /></label>
        <label class="admin-field admin-form__full"><span>Accessories (comma-separated)</span><input type="text" name="accessories" value={Array.isArray(order.accessories) ? order.accessories.join(', ') : ''} /></label>

        <label class="admin-field"><span>Selling Price</span><input type="number" step="0.01" name="selling_price" id="order-selling-price" value={order.selling_price ?? 0} /></label>
        <label class="admin-field"><span>Deposit Received</span><input type="number" step="0.01" name="deposit" id="order-deposit" value={order.deposit ?? 0} /></label>
        <label class="admin-field"><span>Balance Due</span><input type="number" step="0.01" name="balance" id="order-balance" value={order.balance ?? 0} /></label>

        <label class="admin-field"><span>Status</span>
          <select name="status">{STATUSES.map((s) => <option value={s} selected={s === order.status}>{s}</option>)}</select>
        </label>
        <label class="admin-field"><span>Purchase Order</span><input type="text" name="purchase_order" value={order.purchase_order ?? ''} /></label>
        <label class="admin-field"><span>Container / Shipment</span><input type="text" name="container_number" value={order.container_number ?? ''} /></label>
        <label class="admin-field"><span>Production Completion Date</span><input type="date" name="production_completion_date" value={order.production_completion_date ?? ''} /></label>
        <label class="admin-field"><span>ETD</span><input type="date" name="etd" value={order.etd ?? ''} /></label>
        <label class="admin-field"><span>ETA</span><input type="date" name="eta" value={order.eta ?? ''} /></label>
        <label class="admin-field"><span>Port</span><input type="text" name="port" value={order.port ?? ''} /></label>
        <label class="admin-field"><span>Warehouse</span><input type="text" name="warehouse" value={order.warehouse ?? ''} /></label>
        <label class="admin-field admin-form__full"><span>Delivery Address</span><input type="text" name="delivery_address" value={order.delivery_address ?? ''} /></label>
        <label class="admin-field"><span>Delivery Date</span><input type="date" name="delivery_date" value={order.delivery_date ?? ''} /></label>
        <label class="admin-field"><span>Installation Status</span>
          <select name="installation_status">
            <option value="" selected={!order.installation_status}>— unspecified —</option>
            {INSTALLATION_STATUSES.map((s) => <option value={s} selected={s === order.installation_status}>{s}</option>)}
          </select>
        </label>
        <label class="admin-field"><span>Installation Date</span><input type="date" name="installation_date" value={order.installation_date ?? ''} /></label>

        <label class="admin-field admin-form__full"><span>Notes</span><textarea name="notes">{order.notes ?? ''}</textarea></label>

        <div class="admin-form__full">
          <h2 class="admin-section-title" style="margin-top:1rem;">Landed Cost Breakdown</h2>
        </div>
        <label class="admin-field"><span>Product Cost</span><input type="number" step="0.01" name="product_cost" class="cost-input" value={order.product_cost ?? 0} /></label>
        <label class="admin-field"><span>Ocean Freight</span><input type="number" step="0.01" name="ocean_freight" class="cost-input" value={order.ocean_freight ?? 0} /></label>
        <label class="admin-field"><span>Customs / Duty</span><input type="number" step="0.01" name="customs_duty" class="cost-input" value={order.customs_duty ?? 0} /></label>
        <label class="admin-field"><span>Port Handling</span><input type="number" step="0.01" name="port_handling" class="cost-input" value={order.port_handling ?? 0} /></label>
        <label class="admin-field"><span>Inland Delivery</span><input type="number" step="0.01" name="inland_delivery" class="cost-input" value={order.inland_delivery ?? 0} /></label>
        <label class="admin-field"><span>Warehouse Cost</span><input type="number" step="0.01" name="warehouse_cost" class="cost-input" value={order.warehouse_cost ?? 0} /></label>
        <label class="admin-field"><span>Installation Cost</span><input type="number" step="0.01" name="installation_cost" class="cost-input" value={order.installation_cost ?? 0} /></label>
        <label class="admin-field"><span>Other Cost</span><input type="number" step="0.01" name="other_cost" class="cost-input" value={order.other_cost ?? 0} /></label>

        <div class="admin-form__full">
          <p>
            Landed Cost: <strong>{money(order.landed_cost)}</strong> &nbsp;
            Gross Profit: <strong>{money(order.gross_profit)}</strong> &nbsp;
            Gross Margin: <strong>{order.gross_margin_pct != null ? `${order.gross_margin_pct}%` : '—'}</strong>
          </p>
        </div>

        <div class="admin-form__actions">
          <button class="admin-btn" type="submit">Save Changes</button>
          <a class="admin-btn admin-btn--ghost" href="/admin/orders">Back to Orders</a>
        </div>
      </form>

      <form method="POST" style="margin-top:1.5rem;" onsubmit="return confirm('Delete this order? This cannot be undone.');">
        <input type="hidden" name="_intent" value="delete" />
        <button class="admin-btn admin-btn--ghost" type="submit" style="color:#e6b7a0; border-color:rgba(230,130,90,0.35);">Delete Order</button>
      </form>
    </>
  )}
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
</style>

<script>
  const productHidden = document.getElementById('order-product-select') as HTMLInputElement | null;
  const productWrap = productHidden?.closest('[data-model-select]');
  const supplierSelect = document.getElementById('order-supplier') as HTMLSelectElement | null;

  productWrap?.addEventListener('modelselect:change', ((e: CustomEvent) => {
    const product = e.detail?.product;
    if (!product || !supplierSelect) return;
    if (supplierSelect.value && !supplierSelect.dataset.autofilled) return;
    if (product.supplier_id && supplierSelect.querySelector(`option[value="${product.supplier_id}"]`)) {
      supplierSelect.value = product.supplier_id;
      supplierSelect.dataset.autofilled = 'true';
      supplierSelect.addEventListener('change', () => { delete supplierSelect.dataset.autofilled; }, { once: true });
    }
  }) as EventListener);

  const sellingPriceInput = document.getElementById('order-selling-price') as HTMLInputElement | null;
  const depositInput = document.getElementById('order-deposit') as HTMLInputElement | null;
  const balanceInput = document.getElementById('order-balance') as HTMLInputElement | null;

  function recalcBalance() {
    const selling = parseFloat(sellingPriceInput?.value || '0') || 0;
    const deposit = parseFloat(depositInput?.value || '0') || 0;
    if (balanceInput) balanceInput.value = Math.max(0, selling - deposit).toFixed(2);
  }
  sellingPriceInput?.addEventListener('input', recalcBalance);
  depositInput?.addEventListener('input', recalcBalance);
</script>
