---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import ArchiveToggle from '../../../components/admin/ArchiveToggle.astro';
import { archiveSupported, withArchiveFilter } from '../../../lib/archive';

const CATEGORIES = [
  'Supplier Price List', 'Brochure', 'Installation Manual', 'Installation Document',
  'Product Specification', 'Electrical Specification', 'Warranty Document',
  'Customs Document', 'Shipping Document', 'Container Document', 'Purchase Order',
  'Customer Quote', 'Invoice',
  'Receiving Report', 'Quality Inspection', 'Delivery Document', 'Delivery Photo',
  'Installation Photo', 'Warranty Certificate', 'Service Document', 'Service Photo',
];

const search = Astro.url.searchParams.get('q') ?? '';
const categoryFilter = Astro.url.searchParams.get('category') ?? '';

let rows: any[] = [];
let dbReady = true;
// Archived records are hidden from the active list; ?archived=1 shows only them.
const showArchived = Astro.url.searchParams.get('archived') === '1';
let archiveOk = false;

try {
  const supabase = createSupabaseAdminClient();

  let query = supabase
    .from('documents')
    .select(
      'id, category, file_name, file_url, notes, created_at, customers(name), suppliers(name), products(model_name), quotes(quote_number), orders(order_number), inventory_units(unit_code)'
    )
    .order('created_at', { ascending: false });

  if (categoryFilter) query = query.eq('category', categoryFilter);
  if (search) query = query.ilike('file_name', `%${search}%`);

  // Archived rows drop out of the active list. A no-op until the migration
  // is applied, so this cannot break the page in the meantime.
  archiveOk = await archiveSupported(supabase);
  query = withArchiveFilter(query, archiveOk, showArchived);
  const { data } = await query.limit(300);
  rows = data ?? [];
} catch {
  dbReady = false;
}

function relatedTo(row: any): string {
  if (row.inventory_units?.unit_code) return `Unit: ${row.inventory_units.unit_code}`;
  if (row.customers?.name) return `Customer: ${row.customers.name}`;
  if (row.suppliers?.name) return `Supplier: ${row.suppliers.name}`;
  if (row.products?.model_name) return `Product: ${row.products.model_name}`;
  if (row.quotes?.quote_number) return `Quote: ${row.quotes.quote_number}`;
  if (row.orders?.order_number) return `Order: ${row.orders.order_number}`;
  return '—';
}
---

<AdminLayout title="Documents" parentLabel="Dashboard" parentHref="/admin">
  {!dbReady && (
    <div class="admin-placeholder" style="margin-bottom: 1.5rem;">
      <h2>Not connected to Supabase yet</h2>
      <p>See <code>README-ADMIN.md</code> to connect a project and run the schema.</p>
    </div>
  )}

  <ArchiveToggle supported={archiveOk} showingArchived={showArchived} />
  <div class="admin-toolbar">
    <form class="admin-toolbar__filters" method="GET">
      <input class="admin-input admin-input--search" type="search" name="q" placeholder="Search file name…" value={search} />
      <select class="admin-select" name="category">
        <option value="">All categories</option>
        {CATEGORIES.map((c) => <option value={c} selected={c === categoryFilter}>{c}</option>)}
      </select>
      <button class="admin-btn admin-btn--ghost" type="submit">Filter</button>
    </form>
  </div>
  <a slot="actions" class="admin-btn" href="/admin/documents/new">+ Add Document</a>

  <div class="admin-panel">
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>File</th><th>Category</th><th>Related To</th><th>Notes</th><th>Date</th></tr></thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td><a href={`/admin/documents/${row.id}`}>{row.file_name || 'Untitled document'}</a></td>
              <td>{row.category}</td>
              <td>{relatedTo(row)}</td>
              <td>{row.notes ? (row.notes.length > 60 ? `${row.notes.slice(0, 60)}…` : row.notes) : '—'}</td>
              <td>{row.created_at ? new Date(row.created_at).toLocaleDateString() : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {dbReady && rows.length === 0 && <p class="admin-empty">No documents yet.</p>}
  </div>
</AdminLayout>
