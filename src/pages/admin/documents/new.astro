---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';

const CATEGORIES = [
  'Supplier Price List', 'Brochure', 'Installation Manual', 'Installation Document',
  'Product Specification', 'Electrical Specification', 'Warranty Document',
  'Customs Document', 'Shipping Document', 'Container Document', 'Purchase Order',
  'Customer Quote', 'Invoice',
];

let customers: any[] = [];
let suppliers: any[] = [];
let products: any[] = [];
let quotes: any[] = [];
let orders: any[] = [];
let error: string | null = null;

try {
  const supabase = createSupabaseAdminClient();
  const [customerRows, supplierRows, productRows, quoteRows, orderRows] = await Promise.all([
    supabase.from('customers').select('id, name').order('name'),
    supabase.from('suppliers').select('id, name').order('name'),
    supabase.from('products').select('id, model_name').order('model_name'),
    supabase.from('quotes').select('id, quote_number').order('quote_date', { ascending: false }).limit(200),
    supabase.from('orders').select('id, order_number').order('created_at', { ascending: false }).limit(200),
  ]);
  customers = customerRows.data ?? [];
  suppliers = supplierRows.data ?? [];
  products = productRows.data ?? [];
  quotes = quoteRows.data ?? [];
  orders = orderRows.data ?? [];

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const payload = {
      category: String(form.get('category') ?? ''),
      file_url: String(form.get('file_url') ?? ''),
      file_name: String(form.get('file_name') ?? '') || null,
      customer_id: String(form.get('customer_id') ?? '') || null,
      supplier_id: String(form.get('supplier_id') ?? '') || null,
      product_id: String(form.get('product_id') ?? '') || null,
      quote_id: String(form.get('quote_id') ?? '') || null,
      order_id: String(form.get('order_id') ?? '') || null,
      notes: String(form.get('notes') ?? '') || null,
    };
    if (!payload.category || !payload.file_url) {
      error = 'Category and File URL are required.';
    } else {
      const { data: inserted, error: insertError } = await supabase.from('documents').insert(payload).select('id').single();
      if (insertError) error = insertError.message;
      else return Astro.redirect(`/admin/documents/${inserted.id}`);
    }
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}
---

<AdminLayout title="Add Document">
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  <form class="admin-form" method="POST">
    <label class="admin-field"><span>Category *</span>
      <select name="category" required>
        <option value="">— select —</option>
        {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
      </select>
    </label>
    <label class="admin-field"><span>File Name</span><input type="text" name="file_name" placeholder="e.g. ELLA H2 Installation Manual.pdf" /></label>
    <label class="admin-field admin-form__full"><span>File URL *</span><input type="url" name="file_url" required placeholder="https://…" /></label>

    <label class="admin-field"><span>Related Customer</span>
      <select name="customer_id"><option value="">— none —</option>{customers.map((c) => <option value={c.id}>{c.name}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Supplier</span>
      <select name="supplier_id"><option value="">— none —</option>{suppliers.map((s) => <option value={s.id}>{s.name}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Product</span>
      <select name="product_id"><option value="">— none —</option>{products.map((p) => <option value={p.id}>{p.model_name}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Quote</span>
      <select name="quote_id"><option value="">— none —</option>{quotes.map((q) => <option value={q.id}>{q.quote_number || q.id.slice(0, 8)}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Order</span>
      <select name="order_id"><option value="">— none —</option>{orders.map((o) => <option value={o.id}>{o.order_number || o.id.slice(0, 8)}</option>)}</select>
    </label>

    <label class="admin-field admin-form__full"><span>Notes</span><textarea name="notes"></textarea></label>

    <div class="admin-form__actions">
      <button class="admin-btn" type="submit">Add Document</button>
      <a class="admin-btn admin-btn--ghost" href="/admin/documents">Cancel</a>
    </div>
  </form>
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
</style>
