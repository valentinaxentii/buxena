---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import { normalizeDocumentUrl } from '../../../lib/document-url';
import { uploadDocumentFile, MAX_UPLOAD_BYTES } from '../../../lib/document-storage';

const CATEGORIES = [
  'Supplier Price List', 'Brochure', 'Installation Manual', 'Installation Document',
  'Product Specification', 'Electrical Specification', 'Warranty Document',
  'Customs Document', 'Shipping Document', 'Container Document', 'Purchase Order',
  'Customer Quote', 'Invoice',
  'Receiving Report', 'Quality Inspection', 'Delivery Document', 'Delivery Photo',
  'Installation Photo', 'Warranty Certificate', 'Service Document', 'Service Photo',
];

const prefillUnitId = Astro.url.searchParams.get('unit_id') ?? '';
const prefillCategory = Astro.url.searchParams.get('category') ?? '';
const returnTo = Astro.url.searchParams.get('return_to') ?? '';

let customers: any[] = [];
let suppliers: any[] = [];
let products: any[] = [];
let quotes: any[] = [];
let orders: any[] = [];
let units: { id: string; unit_code: string }[] = [];
let error: string | null = null;

try {
  const supabase = createSupabaseAdminClient();
  const [customerRows, supplierRows, productRows, quoteRows, orderRows, unitRows] = await Promise.all([
    supabase.from('customers').select('id, name').order('name'),
    supabase.from('suppliers').select('id, name').order('name'),
    supabase.from('products').select('id, model_name').order('model_name'),
    supabase.from('quotes').select('id, quote_number').order('quote_date', { ascending: false }).limit(200),
    supabase.from('orders').select('id, order_number').order('created_at', { ascending: false }).limit(200),
    supabase.from('inventory_units').select('id, unit_code').order('unit_code').limit(500),
  ]);
  customers = customerRows.data ?? [];
  suppliers = supplierRows.data ?? [];
  products = productRows.data ?? [];
  quotes = quoteRows.data ?? [];
  orders = orderRows.data ?? [];
  units = unitRows.data ?? [];

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const uploadedFile = form.get('upload');
    const payload = {
      category: String(form.get('category') ?? ''),
      file_url: String(form.get('file_url') ?? ''),
      file_name: String(form.get('file_name') ?? '') || null,
      customer_id: String(form.get('customer_id') ?? '') || null,
      supplier_id: String(form.get('supplier_id') ?? '') || null,
      product_id: String(form.get('product_id') ?? '') || null,
      quote_id: String(form.get('quote_id') ?? '') || null,
      order_id: String(form.get('order_id') ?? '') || null,
      unit_id: String(form.get('unit_id') ?? '') || null,
      notes: String(form.get('notes') ?? '') || null,
    };
    const formReturnTo = String(form.get('return_to') ?? '');

    // An uploaded file wins over a typed link — the form offers either, not
    // both, and a file present here means the visitor used the upload control.
    if (uploadedFile instanceof File && uploadedFile.size > 0) {
      const result = await uploadDocumentFile(supabase, uploadedFile);
      if ('error' in result) {
        error = result.error;
      } else {
        payload.file_url = result.url;
        if (!payload.file_name) payload.file_name = uploadedFile.name;
      }
    } else {
      const normalized = normalizeDocumentUrl(payload.file_url);
      if (normalized.error) error = normalized.error;
      else payload.file_url = normalized.url!;
    }

    if (!error && !payload.category) {
      error = 'Category is required.';
    } else if (!error && !payload.file_url) {
      error = 'Upload a file or enter a File URL.';
    }

    if (!error) {
      const { data: inserted, error: insertError } = await supabase.from('documents').insert(payload).select('id').single();
      if (insertError) error = insertError.message;
      else return Astro.redirect(formReturnTo || `/admin/documents/${inserted.id}`);
    }
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}
---

<AdminLayout title="Add Document" parentLabel="Documents" parentHref="/admin/documents">
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  <form class="admin-form" method="POST" enctype="multipart/form-data">
    <label class="admin-field"><span>Category *</span>
      <select name="category" required>
        <option value="">— select —</option>
        {CATEGORIES.map((c) => <option value={c} selected={c === prefillCategory}>{c}</option>)}
      </select>
    </label>
    <label class="admin-field"><span>File Name</span><input type="text" name="file_name" placeholder="e.g. ELLA H2 Installation Manual.pdf" /></label>

    <div class="admin-form__full">
      <p class="upload-warning">
        <strong>Anything uploaded here is readable by anyone with the link.</strong>
        The storage bucket is public so that customers can open manuals from the QR label on
        their sauna without signing in. The web address is long and unguessable, but it is not
        protected — if it is forwarded, pasted into a chat, or lands in browser history, it
        works for whoever has it.
        <br /><br />
        Safe to upload: manuals, brochures, spec sheets, warranty documents, product photos.
        <br />
        <strong>Do not upload:</strong> supplier price lists or anything showing dealer cost,
        customer contracts, signed invoices, ID documents, or anything you would not publish
        on the website.
      </p>
    </div>

    <label class="admin-field admin-form__full">
      <span>Upload a File</span>
      <input type="file" name="upload" />
      <span style="text-transform:none; letter-spacing:normal; font-size:0.78rem;">
        Max {Math.floor(MAX_UPLOAD_BYTES / (1024 * 1024))} MB. Leave empty to use a link below instead.
      </span>
    </label>
    <label class="admin-field admin-form__full"><span>...or File URL / Web Link</span><input type="text" name="file_url" placeholder="buxena.com/specs/aura.pdf — https:// is added automatically" /></label>

    <label class="admin-field"><span>Related Customer</span>
      <select name="customer_id"><option value="">— none —</option>{customers.map((c) => <option value={c.id}>{c.name}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Supplier</span>
      <select name="supplier_id"><option value="">— none —</option>{suppliers.map((s) => <option value={s.id}>{s.name}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Product</span>
      <select name="product_id"><option value="">— none —</option>{products.map((p) => <option value={p.id}>{p.model_name}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Quote</span>
      <select name="quote_id"><option value="">— none —</option>{quotes.map((q) => <option value={q.id}>{q.quote_number || q.id.slice(0, 8)}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Order</span>
      <select name="order_id"><option value="">— none —</option>{orders.map((o) => <option value={o.id}>{o.order_number || o.id.slice(0, 8)}</option>)}</select>
    </label>
    <label class="admin-field"><span>Related Inventory Unit</span>
      <select name="unit_id">
        <option value="">— none —</option>
        {units.map((u) => <option value={u.id} selected={u.id === prefillUnitId}>{u.unit_code}</option>)}
      </select>
    </label>

    <label class="admin-field admin-form__full"><span>Notes</span><textarea name="notes"></textarea></label>

    <input type="hidden" name="return_to" value={returnTo} />
    <div class="admin-form__actions">
      <button class="admin-btn" type="submit">Add Document</button>
      <a class="admin-btn admin-btn--ghost" href={returnTo || '/admin/documents'}>Cancel</a>
    </div>
  </form>
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }

  /* Reads as caution, not as an error — nothing has gone wrong, but this is
     the one decision on this form that cannot be undone after the fact. */
  .upload-warning {
    margin: 0 0 0.5rem;
    padding: 0.85rem 1rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: #e8cfa4;
    background: rgba(201, 166, 104, 0.07);
    border: 1px solid rgba(201, 166, 104, 0.32);
    border-radius: 2px;
  }
  .upload-warning strong { color: #f2dfb8; }
</style>
