---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';

const { id } = Astro.params;
const CATEGORIES = [
  'Supplier Price List', 'Brochure', 'Installation Manual', 'Installation Document',
  'Product Specification', 'Electrical Specification', 'Warranty Document',
  'Customs Document', 'Shipping Document', 'Container Document', 'Purchase Order',
  'Customer Quote', 'Invoice',
];

let doc: any = null;
let customers: any[] = [];
let suppliers: any[] = [];
let products: any[] = [];
let quotes: any[] = [];
let orders: any[] = [];
let error: string | null = null;
let notFound = false;

try {
  const supabase = createSupabaseAdminClient();

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const intent = String(form.get('_intent') ?? 'update');

    if (intent === 'delete') {
      await supabase.from('documents').delete().eq('id', id);
      return Astro.redirect('/admin/documents');
    }

    const payload = {
      category: String(form.get('category') ?? ''),
      file_url: String(form.get('file_url') ?? ''),
      file_name: String(form.get('file_name') ?? '') || null,
      customer_id: String(form.get('customer_id') ?? '') || null,
      supplier_id: String(form.get('supplier_id') ?? '') || null,
      product_id: String(form.get('product_id') ?? '') || null,
      quote_id: String(form.get('quote_id') ?? '') || null,
      order_id: String(form.get('order_id') ?? '') || null,
      notes: String(form.get('notes') ?? '') || null,
    };
    const { error: updateError } = await supabase.from('documents').update(payload).eq('id', id);
    if (updateError) error = updateError.message;
  }

  const [docRow, customerRows, supplierRows, productRows, quoteRows, orderRows] = await Promise.all([
    supabase.from('documents').select('*').eq('id', id).single(),
    supabase.from('customers').select('id, name').order('name'),
    supabase.from('suppliers').select('id, name').order('name'),
    supabase.from('products').select('id, model_name').order('model_name'),
    supabase.from('quotes').select('id, quote_number').order('quote_date', { ascending: false }).limit(200),
    supabase.from('orders').select('id, order_number').order('created_at', { ascending: false }).limit(200),
  ]);

  if (docRow.error || !docRow.data) notFound = true;
  else doc = docRow.data;
  customers = customerRows.data ?? [];
  suppliers = supplierRows.data ?? [];
  products = productRows.data ?? [];
  quotes = quoteRows.data ?? [];
  orders = orderRows.data ?? [];
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}
---

<AdminLayout title={doc?.file_name || 'Document'}>
  {notFound && <p class="admin-empty">Document not found.</p>}
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  {doc && (
    <>
      <form class="admin-form" method="POST">
        <label class="admin-field"><span>Category *</span>
          <select name="category" required>
            {CATEGORIES.map((c) => <option value={c} selected={c === doc.category}>{c}</option>)}
          </select>
        </label>
        <label class="admin-field"><span>File Name</span><input type="text" name="file_name" value={doc.file_name ?? ''} /></label>
        <label class="admin-field admin-form__full">
          <span>File URL *</span>
          <input type="url" name="file_url" required value={doc.file_url} />
          <a href={doc.file_url} target="_blank" rel="noopener" style="font-size:0.8rem; color:var(--admin-gold);">Open file ↗</a>
        </label>

        <label class="admin-field"><span>Related Customer</span>
          <select name="customer_id"><option value="">— none —</option>{customers.map((c) => <option value={c.id} selected={c.id === doc.customer_id}>{c.name}</option>)}</select>
        </label>
        <label class="admin-field"><span>Related Supplier</span>
          <select name="supplier_id"><option value="">— none —</option>{suppliers.map((s) => <option value={s.id} selected={s.id === doc.supplier_id}>{s.name}</option>)}</select>
        </label>
        <label class="admin-field"><span>Related Product</span>
          <select name="product_id"><option value="">— none —</option>{products.map((p) => <option value={p.id} selected={p.id === doc.product_id}>{p.model_name}</option>)}</select>
        </label>
        <label class="admin-field"><span>Related Quote</span>
          <select name="quote_id"><option value="">— none —</option>{quotes.map((q) => <option value={q.id} selected={q.id === doc.quote_id}>{q.quote_number || q.id.slice(0, 8)}</option>)}</select>
        </label>
        <label class="admin-field"><span>Related Order</span>
          <select name="order_id"><option value="">— none —</option>{orders.map((o) => <option value={o.id} selected={o.id === doc.order_id}>{o.order_number || o.id.slice(0, 8)}</option>)}</select>
        </label>

        <label class="admin-field admin-form__full"><span>Notes</span><textarea name="notes">{doc.notes ?? ''}</textarea></label>

        <div class="admin-form__actions">
          <button class="admin-btn" type="submit">Save Changes</button>
          <a class="admin-btn admin-btn--ghost" href="/admin/documents">Back to Documents</a>
        </div>
      </form>

      <form method="POST" style="margin-top:1.5rem;" onsubmit="return confirm('Delete this document record? This cannot be undone.');">
        <input type="hidden" name="_intent" value="delete" />
        <button class="admin-btn admin-btn--ghost" type="submit" style="color:#e6b7a0; border-color:rgba(230,130,90,0.35);">Delete Record</button>
      </form>
    </>
  )}
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
</style>
