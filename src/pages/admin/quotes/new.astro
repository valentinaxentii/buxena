---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ModelSelect from '../../../components/admin/ModelSelect.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import { getSettings, FALLBACK_SETTINGS } from '../../../lib/settings';
import { approvedQuoteFloor, belowApprovedFloor, quoteNetBeforeTax } from '../../../lib/quote-margin-guard';

const STATUSES = ['Draft', 'Ready', 'Sent', 'Viewed', 'Negotiating', 'Accepted', 'Declined', 'Expired', 'Converted'];
const ITEM_KINDS = [
  ['sauna', 'Sauna'], ['heater', 'Heater'], ['controls', 'Controls'],
  ['accessories', 'Accessories'], ['delivery', 'Delivery'],
  ['installation', 'Installation'], ['service', 'Service'], ['other', 'Other'],
];
let customers: any[] = [];
let products: any[] = [];
let staff: any[] = [];
let error: string | null = null;
let settings = FALLBACK_SETTINGS;

try {
  const supabase = createSupabaseAdminClient();
  settings = await getSettings(supabase);
  const [customerRows, productRows, staffRows] = await Promise.all([
    supabase.from('customers').select('id, name, email').order('name'),
    supabase.from('products').select('id, model_name, selling_price, heater_options').eq('is_active', true).order('model_name'),
    supabase.from('profiles').select('id, full_name').order('full_name'),
  ]);
  customers = customerRows.data ?? [];
  products = productRows.data ?? [];
  staff = staffRows.data ?? [];

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const descriptions = form.getAll('item_description[]').map(String);
    const kinds = form.getAll('item_kind[]').map(String);
    const quantities = form.getAll('item_quantity[]').map(Number);
    const unitPrices = form.getAll('item_unit_price[]').map(Number);

    const items = descriptions
      .map((description, i) => ({
        description,
        kind: ITEM_KINDS.some(([value]) => value === kinds[i]) ? kinds[i] : 'other',
        quantity: quantities[i] || 0,
        unit_price: unitPrices[i] || 0,
        line_total: (quantities[i] || 0) * (unitPrices[i] || 0),
        sort_order: i,
      }))
      .filter((item) => item.description.trim());

    const subtotal = items.reduce((sum, item) => sum + item.line_total, 0);
    const deliveryCost = Number(form.get('delivery_cost') ?? 0) || 0;
    const installationCost = Number(form.get('installation_cost') ?? 0) || 0;
    const discount = Number(form.get('discount') ?? 0) || 0;
    const taxRate = Number(form.get('tax_rate') ?? 0) || 0;
    const taxableBase = subtotal + deliveryCost + installationCost - discount;
    const total = taxableBase + taxableBase * (taxRate / 100);
    const productId = String(form.get('product_id') ?? '') || null;
    const floor = await approvedQuoteFloor(supabase, productId);

    if (discount < 0) {
      error = 'Discount cannot be negative.';
    } else if (floor.enforced && belowApprovedFloor(taxableBase, floor.floor)) {
      error = 'This discount would place the quote below its approved minimum selling price. Review the private Product Pricing record before issuing it.';
    } else {

    const quoteDate = String(form.get('quote_date') ?? '') || new Date().toISOString().slice(0, 10);
    const defaultExpiry = new Date(quoteDate);
    defaultExpiry.setDate(defaultExpiry.getDate() + settings.default_quote_validity_days);

    const quotePayload = {
      quote_number: `${settings.quote_number_prefix}${Date.now().toString(36).toUpperCase()}`,
      customer_id: String(form.get('customer_id') ?? '') || null,
      product_id: productId,
      owner_staff_id: String(form.get('owner_staff_id') ?? '') || null,
      heater: String(form.get('heater') ?? '') || null,
      delivery_cost: deliveryCost,
      installation_cost: installationCost,
      discount,
      tax_rate: taxRate,
      subtotal,
      total,
      quote_date: quoteDate,
      expiry_date: String(form.get('expiry_date') ?? '') || defaultExpiry.toISOString().slice(0, 10),
      status: String(form.get('status') ?? 'Draft'),
      delivery_state: String(form.get('delivery_state') ?? '') || null,
      installation_state: String(form.get('installation_state') ?? '') || null,
      customer_notes: String(form.get('customer_notes') ?? '').trim() || null,
      internal_notes: String(form.get('internal_notes') ?? '').trim() || null,
    };

    const { data: quote, error: insertError } = await supabase
      .from('quotes').insert(quotePayload).select('id').single();

    if (insertError) {
      error = insertError.message;
    } else {
      if (items.length) {
        await supabase.from('quote_items').insert(items.map((item) => ({ ...item, quote_id: quote.id })));
      }
      return Astro.redirect(`/admin/quotes/${quote.id}`);
    }
    }
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}
---

<AdminLayout title="New Quote" parentLabel="Quotes" parentHref="/admin/quotes">
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  <form class="admin-form" method="POST" id="quote-form" data-quote-validity-days={settings.default_quote_validity_days}>
    <label class="admin-field"><span>Customer</span>
      <select name="customer_id"><option value="">— none —</option>{customers.map((c) => <option value={c.id}>{c.name}</option>)}</select>
    </label>
    <label class="admin-field"><span>Sauna Model</span>
      {products.length === 0
        ? <p class="admin-empty" style="padding:0.7rem 0.85rem; text-align:left;">No sauna models available — <a href="/admin/products/new" target="_blank" rel="noopener" style="color:var(--admin-gold);">add one</a>.</p>
        : <ModelSelect id="product-select" name="product_id" products={products} />}
    </label>
    <label class="admin-field"><span>Customer advisor</span>
      <select name="owner_staff_id">
        <option value="">— BUXENA team —</option>
        {staff.map((person) => <option value={person.id} selected={person.id === Astro.locals.staffUser?.id}>{person.full_name || person.id}</option>)}
      </select>
      <small>The advisor's name appears on the proposal and in the email.</small>
    </label>
    <label class="admin-field"><span>Heater</span><input type="text" name="heater" /></label>
    <label class="admin-field"><span>Status</span>
      <select name="status">{STATUSES.map((s) => <option value={s}>{s}</option>)}</select>
    </label>
    <label class="admin-field"><span>Quote Date</span><input type="date" name="quote_date" value={new Date().toISOString().slice(0, 10)} id="quote-date" /></label>
    <label class="admin-field"><span>Expiry Date</span><input type="date" name="expiry_date" id="quote-expiry-date" /></label>
    <label class="admin-field"><span>Delivery</span>
      <select name="delivery_state">
        <option value="">— not stated —</option><option value="included">Included</option><option value="separate">Quoted separately</option><option value="customer">Customer arranged</option><option value="tbc">To be confirmed</option>
      </select>
    </label>
    <label class="admin-field"><span>Installation</span>
      <select name="installation_state">
        <option value="">— not stated —</option><option value="included">Included</option><option value="separate">Quoted separately</option><option value="customer">Customer arranged</option><option value="tbc">To be confirmed</option>
      </select>
    </label>
    <label class="admin-field admin-form__full"><span>Customer-facing notes</span><textarea name="customer_notes" rows="4" placeholder="Only verified details the customer should see"></textarea></label>
    <label class="admin-field admin-form__full"><span>Internal notes</span><textarea name="internal_notes" rows="3" placeholder="Never shown on the proposal"></textarea></label>

    <div class="admin-form__full">
      <h2 class="admin-section-title">Line Items</h2>
      <table class="admin-table" id="items-table">
        <thead><tr><th>Section</th><th>Description</th><th>Qty</th><th>Unit Price</th><th>Line Total</th><th></th></tr></thead>
        <tbody id="items-body">
          <tr class="item-row">
            <td><select name="item_kind[]">{ITEM_KINDS.map(([value, label]) => <option value={value} selected={value === 'sauna'}>{label}</option>)}</select></td>
            <td><input type="text" name="item_description[]" placeholder="Sauna base price" /></td>
            <td><input type="number" step="0.01" name="item_quantity[]" value="1" class="qty" /></td>
            <td><input type="number" step="0.01" name="item_unit_price[]" class="price" /></td>
            <td class="line-total">$0.00</td>
            <td><button type="button" class="admin-btn admin-btn--ghost remove-row">×</button></td>
          </tr>
        </tbody>
      </table>
      <button type="button" class="admin-btn admin-btn--ghost" id="add-row" style="margin-top:0.75rem;">+ Add Line</button>
    </div>

    <label class="admin-field"><span>Delivery Cost</span><input type="number" step="0.01" name="delivery_cost" value="0" class="calc-input" /></label>
    <label class="admin-field"><span>Installation Cost</span><input type="number" step="0.01" name="installation_cost" value="0" class="calc-input" /></label>
    <label class="admin-field"><span>Discount</span><input type="number" min="0" step="0.01" name="discount" value="0" class="calc-input" /><small>Checked against an approved private price floor when one is set.</small></label>
    <label class="admin-field"><span>Tax Rate (%)</span><input type="number" step="0.01" name="tax_rate" value={settings.default_tax_rate} class="calc-input" /></label>

    <div class="admin-form__full" id="totals">
      <p>Subtotal: <strong id="subtotal-out">$0.00</strong></p>
      <p>Total: <strong id="total-out">$0.00</strong></p>
    </div>

    <div class="admin-form__actions">
      <button class="admin-btn" type="submit">Create Quote</button>
      <a class="admin-btn admin-btn--ghost" href="/admin/quotes">Cancel</a>
      <span class="admin-btn admin-btn--ghost" style="opacity:0.5; cursor:not-allowed;" title="Save the quote first">Generate PDF Quote</span>
    </div>
  </form>
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
  #items-table input { width: 100%; }
  #totals p { margin: 0.3rem 0; font-size: 0.9rem; color: var(--admin-muted); }
</style>

<script>
  const body = document.getElementById('items-body') as HTMLTableSectionElement;
  const addRowBtn = document.getElementById('add-row');
  const productHidden = document.getElementById('product-select') as HTMLInputElement | null;
  const productWrap = productHidden?.closest('[data-model-select]');
  const heaterInput = document.querySelector('input[name="heater"]') as HTMLInputElement | null;

  const quoteDateInput = document.getElementById('quote-date') as HTMLInputElement | null;
  const expiryDateInput = document.getElementById('quote-expiry-date') as HTMLInputElement | null;
  const quoteForm = document.getElementById('quote-form') as HTMLFormElement | null;
  const defaultValidityDays = Number(quoteForm?.dataset.quoteValidityDays || '30');
  function applyDefaultExpiry() {
    if (!quoteDateInput?.value || !expiryDateInput || expiryDateInput.value) return;
    const d = new Date(quoteDateInput.value);
    d.setDate(d.getDate() + defaultValidityDays);
    expiryDateInput.value = d.toISOString().slice(0, 10);
  }
  applyDefaultExpiry();
  quoteDateInput?.addEventListener('change', applyDefaultExpiry);

  function markAutofilled(el: HTMLInputElement) {
    el.dataset.autofilled = 'true';
    el.addEventListener('input', () => { delete el.dataset.autofilled; }, { once: true });
  }

  function rowTemplate() {
    const tr = document.createElement('tr');
    tr.className = 'item-row';
    tr.innerHTML = `
      <td><select name="item_kind[]">
        <option value="sauna">Sauna</option><option value="heater">Heater</option><option value="controls">Controls</option>
        <option value="accessories">Accessories</option><option value="delivery">Delivery</option><option value="installation">Installation</option>
        <option value="service">Service</option><option value="other" selected>Other</option>
      </select></td>
      <td><input type="text" name="item_description[]" /></td>
      <td><input type="number" step="0.01" name="item_quantity[]" value="1" class="qty" /></td>
      <td><input type="number" step="0.01" name="item_unit_price[]" class="price" /></td>
      <td class="line-total">$0.00</td>
      <td><button type="button" class="admin-btn admin-btn--ghost remove-row">×</button></td>
    `;
    return tr;
  }

  function recalc() {
    let subtotal = 0;
    body.querySelectorAll('.item-row').forEach((row) => {
      const qty = parseFloat((row.querySelector('.qty') as HTMLInputElement)?.value || '0');
      const price = parseFloat((row.querySelector('.price') as HTMLInputElement)?.value || '0');
      const lineTotal = qty * price;
      (row.querySelector('.line-total') as HTMLElement).textContent = `$${lineTotal.toFixed(2)}`;
      subtotal += lineTotal;
    });

    const delivery = parseFloat((document.querySelector('[name="delivery_cost"]') as HTMLInputElement)?.value || '0');
    const installation = parseFloat((document.querySelector('[name="installation_cost"]') as HTMLInputElement)?.value || '0');
    const discount = parseFloat((document.querySelector('[name="discount"]') as HTMLInputElement)?.value || '0');
    const taxRate = parseFloat((document.querySelector('[name="tax_rate"]') as HTMLInputElement)?.value || '0');
    const taxableBase = subtotal + delivery + installation - discount;
    const total = taxableBase + taxableBase * (taxRate / 100);

    document.getElementById('subtotal-out')!.textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('total-out')!.textContent = `$${total.toFixed(2)}`;
  }

  addRowBtn?.addEventListener('click', () => {
    const row = rowTemplate();
    body.appendChild(row);
    recalc();
  });

  body.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('remove-row')) {
      target.closest('.item-row')?.remove();
      recalc();
    }
  });

  document.getElementById('quote-form')?.addEventListener('input', recalc);

  productWrap?.addEventListener('modelselect:change', ((e: CustomEvent) => {
    const product = e.detail?.product;
    if (!product) return;

    if (heaterInput && (!heaterInput.value || heaterInput.dataset.autofilled)) {
      const heaterOptions = Array.isArray(product.heater_options) ? product.heater_options : [];
      if (heaterOptions.length) {
        heaterInput.value = heaterOptions[0];
        markAutofilled(heaterInput);
      }
    }

    const firstPriceInput = body.querySelector('.price') as HTMLInputElement | null;
    const firstDescInput = body.querySelector('input[name="item_description[]"]') as HTMLInputElement | null;
    if (firstPriceInput && (!firstPriceInput.value || firstPriceInput.dataset.autofilled) && product.selling_price) {
      firstPriceInput.value = String(product.selling_price);
      markAutofilled(firstPriceInput);
    }
    if (firstDescInput && (!firstDescInput.value || firstDescInput.dataset.autofilled)) {
      firstDescInput.value = `${product.model_name} — base unit`;
      markAutofilled(firstDescInput);
    }
    recalc();
  }) as EventListener);

  recalc();
</script>
