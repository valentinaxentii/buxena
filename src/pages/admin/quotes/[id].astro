---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import ModelSelect from '../../../components/admin/ModelSelect.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import { isAdminStaff, refuseDelete } from '../../../lib/staff-access';

// Permanent deletion is admin-only; enforced server-side in the handler below.
const canDelete = await isAdminStaff(Astro);

const { id } = Astro.params;
const STATUSES = ['Draft', 'Sent', 'Viewed', 'Negotiating', 'Accepted', 'Declined', 'Expired'];

let quote: any = null;
let items: any[] = [];
let customers: any[] = [];
let products: any[] = [];
let existingOrderId: string | null = null;
let error: string | null = null;
let notFound = false;

async function recomputeTotal(supabase: any, quoteId: string, deliveryCost: number, installationCost: number, discount: number, taxRate: number) {
  const { data: currentItems } = await supabase.from('quote_items').select('line_total').eq('quote_id', quoteId);
  const subtotal = (currentItems ?? []).reduce((sum: number, i: any) => sum + Number(i.line_total ?? 0), 0);
  const taxableBase = subtotal + deliveryCost + installationCost - discount;
  const total = taxableBase + taxableBase * (taxRate / 100);
  return { subtotal, total };
}

try {
  const supabase = createSupabaseAdminClient();

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const intent = String(form.get('_intent') ?? 'update');

    if (intent === 'delete') {
      if (!canDelete) return refuseDelete(Astro);
      await supabase.from('quotes').delete().eq('id', id);
      return Astro.redirect('/admin/quotes');
    }

    if (intent === 'delete_item') {
      await supabase.from('quote_items').delete().eq('id', String(form.get('item_id')));
    }

    if (intent === 'add_item') {
      const description = String(form.get('new_description') ?? '').trim();
      const quantity = Number(form.get('new_quantity') ?? 1) || 1;
      const unitPrice = Number(form.get('new_unit_price') ?? 0) || 0;
      if (description) {
        await supabase.from('quote_items').insert({
          quote_id: id, description, quantity, unit_price: unitPrice, line_total: quantity * unitPrice,
        });
      }
    }

    const deliveryCost = Number(form.get('delivery_cost') ?? 0) || 0;
    const installationCost = Number(form.get('installation_cost') ?? 0) || 0;
    const discount = Number(form.get('discount') ?? 0) || 0;
    const taxRate = Number(form.get('tax_rate') ?? 0) || 0;
    const { subtotal, total } = await recomputeTotal(supabase, id!, deliveryCost, installationCost, discount, taxRate);

    const payload = {
      customer_id: String(form.get('customer_id') ?? '') || null,
      product_id: String(form.get('product_id') ?? '') || null,
      heater: String(form.get('heater') ?? '') || null,
      status: String(form.get('status') ?? 'Draft'),
      quote_date: String(form.get('quote_date') ?? '') || null,
      expiry_date: String(form.get('expiry_date') ?? '') || null,
      delivery_cost: deliveryCost,
      installation_cost: installationCost,
      discount,
      tax_rate: taxRate,
      subtotal,
      total,
    };
    const { error: updateError } = await supabase.from('quotes').update(payload).eq('id', id);
    if (updateError) error = updateError.message;
  }

  const [quoteRow, itemRows, customerRows, productRows] = await Promise.all([
    supabase.from('quotes').select('*').eq('id', id).single(),
    supabase.from('quote_items').select('*').eq('quote_id', id).order('sort_order'),
    supabase.from('customers').select('id, name').order('name'),
    supabase.from('products').select('id, model_name, selling_price, heater_options').eq('is_active', true).order('model_name'),
  ]);

  if (quoteRow.error || !quoteRow.data) notFound = true;
  else quote = quoteRow.data;
  items = itemRows.data ?? [];
  customers = customerRows.data ?? [];
  products = productRows.data ?? [];

  if (quote) {
    const { data: existingOrder } = await supabase.from('orders').select('id').eq('quote_id', id).limit(1).maybeSingle();
    existingOrderId = existingOrder?.id ?? null;
  }

  // An already-selected model might have since been made inactive — keep it
  // resolvable in the selector so the field doesn't render blank.
  if (quote?.product_id && !products.some((p) => p.id === quote.product_id)) {
    const { data: selectedProduct } = await supabase
      .from('products')
      .select('id, model_name, selling_price, heater_options')
      .eq('id', quote.product_id)
      .single();
    if (selectedProduct) products = [selectedProduct, ...products];
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}

const pdfMissingFields: string[] = [];
if (quote) {
  if (!quote.customer_id) pdfMissingFields.push('Customer');
  if (!quote.product_id) pdfMissingFields.push('Sauna Model');
  if (items.length === 0) pdfMissingFields.push('at least one line item');
}
const canGeneratePdf = quote !== null && pdfMissingFields.length === 0;
const pdfError = Astro.url.searchParams.get('pdf_error');
---

<AdminLayout
  title={quote ? (quote.quote_number || 'Quote') : 'Quote'}
  parentLabel="Quotes"
  parentHref="/admin/quotes"
  printDocuments={quote ? [{ label: 'Quote PDF', href: `/admin/quotes/${id}/pdf` }] : undefined}
>
  {notFound && <p class="admin-empty">Quote not found.</p>}
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}
  {pdfError && <p class="notice notice--error" style="margin-bottom:1.25rem;">{pdfError}</p>}

  {quote && (
    <>
      <p style="margin-top:-0.5rem;"><StatusBadge status={quote.status} /></p>

      <form class="admin-form" method="POST">
        <label class="admin-field"><span>Customer</span>
          <select name="customer_id"><option value="">— none —</option>{customers.map((c) => <option value={c.id} selected={c.id === quote.customer_id}>{c.name}</option>)}</select>
        </label>
        <label class="admin-field"><span>Sauna Model</span>
          <ModelSelect id="product-select" name="product_id" products={products} value={quote.product_id} />
        </label>
        <label class="admin-field"><span>Heater</span><input type="text" name="heater" id="quote-heater" value={quote.heater ?? ''} /></label>
        <label class="admin-field"><span>Status</span>
          <select name="status">{STATUSES.map((s) => <option value={s} selected={s === quote.status}>{s}</option>)}</select>
        </label>
        <label class="admin-field"><span>Quote Date</span><input type="date" name="quote_date" value={quote.quote_date ?? ''} /></label>
        <label class="admin-field"><span>Expiry Date</span><input type="date" name="expiry_date" value={quote.expiry_date ?? ''} /></label>
        <label class="admin-field"><span>Delivery Cost</span><input type="number" step="0.01" name="delivery_cost" value={quote.delivery_cost ?? 0} /></label>
        <label class="admin-field"><span>Installation Cost</span><input type="number" step="0.01" name="installation_cost" value={quote.installation_cost ?? 0} /></label>
        <label class="admin-field"><span>Discount</span><input type="number" step="0.01" name="discount" value={quote.discount ?? 0} /></label>
        <label class="admin-field"><span>Tax Rate (%)</span><input type="number" step="0.01" name="tax_rate" value={quote.tax_rate ?? 0} /></label>

        <div class="admin-form__full">
          <p>Subtotal: <strong>${quote.subtotal ?? 0}</strong> &nbsp; Total: <strong>${quote.total ?? 0}</strong></p>
        </div>

        <div class="admin-form__actions">
          <button class="admin-btn" type="submit">Save Changes</button>
          <a class="admin-btn admin-btn--ghost" href="/admin/quotes">Back to Quotes</a>
          {canGeneratePdf
            ? <a class="admin-btn admin-btn--ghost" href={`/admin/quotes/${id}/pdf`} target="_blank" rel="noopener">Generate PDF Quote</a>
            : <span class="admin-btn admin-btn--ghost" style="opacity:0.5; cursor:not-allowed;" title={`Missing: ${pdfMissingFields.join(', ')}`}>Generate PDF Quote</span>}
          {quote.status === 'Accepted' && (
            existingOrderId
              ? <a class="admin-btn admin-btn--ghost" href={`/admin/orders/${existingOrderId}`}>View Order</a>
              : <a class="admin-btn admin-btn--ghost" href={`/admin/orders/new?from_quote=${id}`}>Convert to Order</a>
          )}
        </div>
        {!canGeneratePdf && (
          <p class="admin-empty" style="margin-top:0.6rem;">
            Add {pdfMissingFields.join(', ')} to enable PDF generation.
          </p>
        )}
      </form>

      <h2 class="admin-section-title" style="margin-top:2.5rem;">Line Items</h2>
      <div class="admin-panel">
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead><tr><th>Description</th><th>Qty</th><th>Unit Price</th><th>Line Total</th><th></th></tr></thead>
            <tbody>
              {items.map((item) => (
                <tr>
                  <td>{item.description}</td>
                  <td>{item.quantity}</td>
                  <td>${item.unit_price}</td>
                  <td>${item.line_total}</td>
                  <td>
                    <form method="POST" style="margin:0;">
                      <input type="hidden" name="_intent" value="delete_item" />
                      <input type="hidden" name="item_id" value={item.id} />
                      <button class="admin-btn admin-btn--ghost" type="submit">Remove</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {items.length === 0 && <p class="admin-empty">No line items yet.</p>}
      </div>

      <form method="POST" class="admin-form" style="margin-top:1.25rem;">
        <input type="hidden" name="_intent" value="add_item" />
        <label class="admin-field"><span>Description</span><input type="text" name="new_description" /></label>
        <label class="admin-field"><span>Qty</span><input type="number" step="0.01" name="new_quantity" value="1" /></label>
        <label class="admin-field"><span>Unit Price</span><input type="number" step="0.01" name="new_unit_price" /></label>
        <div class="admin-form__actions"><button class="admin-btn admin-btn--ghost" type="submit">+ Add Item</button></div>
      </form>

      {canDelete && (
        <form method="POST" style="margin-top:1.5rem;" onsubmit="return confirm('Delete this quote? This cannot be undone.');">
        <input type="hidden" name="_intent" value="delete" />
        <button class="admin-btn admin-btn--ghost" type="submit" style="color:#e6b7a0; border-color:rgba(230,130,90,0.35);">Delete Quote</button>
        </form>
      )}
    </>
  )}
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
</style>

<script>
  const productHidden = document.getElementById('product-select') as HTMLInputElement | null;
  const productWrap = productHidden?.closest('[data-model-select]');
  const heaterInput = document.getElementById('quote-heater') as HTMLInputElement | null;

  productWrap?.addEventListener('modelselect:change', ((e: CustomEvent) => {
    const product = e.detail?.product;
    if (!product || !heaterInput) return;
    if (heaterInput.value && !heaterInput.dataset.autofilled) return;
    const heaterOptions = Array.isArray(product.heater_options) ? product.heater_options : [];
    if (heaterOptions.length) {
      heaterInput.value = heaterOptions[0];
      heaterInput.dataset.autofilled = 'true';
      heaterInput.addEventListener('input', () => { delete heaterInput.dataset.autofilled; }, { once: true });
    }
  }) as EventListener);
</script>
