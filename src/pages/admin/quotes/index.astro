---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import ArchiveToggle from '../../../components/admin/ArchiveToggle.astro';
import { archiveSupported, withArchiveFilter } from '../../../lib/archive';

const statusFilter = Astro.url.searchParams.get('status') ?? '';
const STATUSES = ['Draft', 'Sent', 'Viewed', 'Negotiating', 'Accepted', 'Declined', 'Expired'];

let quotes: any[] = [];
let dbReady = true;
// Archived records are hidden from the active list; ?archived=1 shows only them.
const showArchived = Astro.url.searchParams.get('archived') === '1';
let archiveOk = false;

let hasViewedAt = true;

try {
  const supabase = createSupabaseAdminClient();
  const baseCols = 'id, quote_number, status, total, quote_date, expiry_date, customers(name)';

  const run = async (cols: string) => {
    let query = supabase.from('quotes').select(cols).order('created_at', { ascending: false });
    if (statusFilter) query = query.eq('status', statusFilter);
    archiveOk = await archiveSupported(supabase);
    query = withArchiveFilter(query, archiveOk, showArchived);
    return query.limit(200);
  };

  // viewed_at ships in the same migration as share_token
  // (supabase/migrations/2026-08-13-personalized-quotes.sql), which the
  // customer proposal page already treats as possibly-not-yet-applied. Ask
  // for it; fall back to the base columns if the column doesn't exist yet,
  // so a pending migration degrades one column instead of the whole list.
  let { data, error } = await run(`${baseCols}, viewed_at`);
  if (error) {
    hasViewedAt = false;
    ({ data } = await run(baseCols));
  }
  quotes = data ?? [];
} catch {
  dbReady = false;
}
---

<AdminLayout title="Quotes" parentLabel="Dashboard" parentHref="/admin">
  {!dbReady && (
    <div class="admin-placeholder" style="margin-bottom: 1.5rem;">
      <h2>Not connected to Supabase yet</h2>
      <p>See <code>README-ADMIN.md</code> to connect a project and run the schema.</p>
    </div>
  )}

  <ArchiveToggle supported={archiveOk} showingArchived={showArchived} />
  <div class="admin-toolbar">
    <form class="admin-toolbar__filters" method="GET">
      <select class="admin-select" name="status">
        <option value="">All statuses</option>
        {STATUSES.map((s) => <option value={s} selected={s === statusFilter}>{s}</option>)}
      </select>
      <button class="admin-btn admin-btn--ghost" type="submit">Filter</button>
    </form>
  </div>
  <a slot="actions" class="admin-btn" href="/admin/quotes/new">+ New Quote</a>

  <div class="admin-panel">
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>Quote #</th><th>Customer</th><th>Total</th><th>Quote Date</th><th>Expires</th>{hasViewedAt && <th>Last Viewed</th>}<th>Status</th></tr></thead>
        <tbody>
          {quotes.map((q) => (
            <tr>
              <td><a href={`/admin/quotes/${q.id}`}>{q.quote_number || q.id}</a></td>
              <td>{q.customers?.name || '—'}</td>
              <td>${q.total ?? 0}</td>
              <td>{q.quote_date || '—'}</td>
              <td>{q.expiry_date || '—'}</td>
              {hasViewedAt && <td>{q.viewed_at ? new Date(q.viewed_at).toLocaleDateString() : 'Not yet'}</td>}
              <td><StatusBadge status={q.status} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {dbReady && quotes.length === 0 && <p class="admin-empty">No quotes yet.</p>}
  </div>
</AdminLayout>
