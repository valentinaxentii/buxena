---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';

const search = (Astro.url.searchParams.get('q') ?? '').trim();
const view = Astro.url.searchParams.get('view') === 'pricing' ? 'pricing' : 'list';

let products: any[] = [];
let dbReady = true;
let pricingError: string | null = null;
let pricingNotice: string | null = null;
// on a failed save, the user's submitted values re-render instead of the DB's
let submittedPricing: Map<string, { cost: string; selling: string }> | null = null;

const r2 = (n: number) => Math.round(n * 100) / 100;

try {
  const supabase = createSupabaseAdminClient();

  // ---- Pricing save: writes ONLY products.cost and products.selling_price,
  // and only for rows whose values actually changed ----
  if (Astro.request.method === 'POST' && view === 'pricing') {
    const form = await Astro.request.formData();
    const ids = form.getAll('row_id[]').map(String);
    const costs = form.getAll('row_cost[]').map(String);
    const sellings = form.getAll('row_selling[]').map(String);
    const origCosts = form.getAll('row_cost_orig[]').map(String);
    const origSellings = form.getAll('row_selling_orig[]').map(String);

    submittedPricing = new Map(ids.map((id, i) => [id, { cost: costs[i] ?? '', selling: sellings[i] ?? '' }]));

    // empty = NULL (unknown), never zero; negatives and non-numbers rejected
    const parse = (raw: string): number | null | 'invalid' => {
      const v = raw.trim();
      if (v === '') return null;
      const n = Number(v);
      if (!Number.isFinite(n) || n < 0) return 'invalid';
      return r2(n);
    };

    let invalid = 0;
    let written = 0;
    const updates: { id: string; cost: number | null; selling_price: number | null }[] = [];
    ids.forEach((id, i) => {
      const cost = parse(costs[i] ?? '');
      const selling = parse(sellings[i] ?? '');
      if (cost === 'invalid' || selling === 'invalid') { invalid++; return; }
      const changed = (costs[i] ?? '').trim() !== (origCosts[i] ?? '').trim()
        || (sellings[i] ?? '').trim() !== (origSellings[i] ?? '').trim();
      if (changed) updates.push({ id, cost, selling_price: selling });
    });

    if (invalid > 0) {
      pricingError = `${invalid} row${invalid === 1 ? ' has' : 's have'} an invalid value — numbers must be non-negative. Nothing was saved.`;
    } else {
      for (const u of updates) {
        const { error } = await supabase.from('products').update({ cost: u.cost, selling_price: u.selling_price }).eq('id', u.id);
        if (error) { pricingError = `Save failed: ${error.message}. Your edits are still on screen.`; break; }
        written++;
      }
      if (!pricingError) {
        return Astro.redirect(`/admin/products?view=pricing&saved=${written}`);
      }
    }
  }

  let query = supabase
    .from('products')
    .select('id, model_name, category, cost, selling_price, is_active, suppliers(name)')
    .order('model_name');
  if (search && view === 'list') query = query.ilike('model_name', `%${search}%`);
  const { data } = await query.limit(300);
  const raw = data ?? [];

  const ids = raw.map((p: any) => p.id);
  const { data: invData } = ids.length
    ? await supabase.from('inventory').select('product_id, available, incoming').in('product_id', ids)
    : { data: [] as any[] };

  const invByProduct = new Map<string, { available: number; incoming: number }>();
  for (const row of invData ?? []) {
    const agg = invByProduct.get(row.product_id) ?? { available: 0, incoming: 0 };
    agg.available += row.available ?? 0;
    agg.incoming += row.incoming ?? 0;
    invByProduct.set(row.product_id, agg);
  }

  products = raw.map((p: any) => {
    const inv = invByProduct.get(p.id) ?? { available: 0, incoming: 0 };
    const availability = inv.available > 0 ? 'In Stock' : inv.incoming > 0 ? 'In Transit' : 'Preorder';
    return { ...p, in_stock_available: inv.available, incoming: inv.incoming, availability };
  });
} catch {
  dbReady = false;
}

const savedCount = Astro.url.searchParams.get('saved');
if (savedCount != null && !pricingNotice) pricingNotice = `${savedCount} row${savedCount === '1' ? '' : 's'} saved.`;

const totalModels = products.length;
const inStockCount = products.filter((p) => p.availability === 'In Stock').length;
const incomingCount = products.filter((p) => p.availability === 'In Transit').length;
const preorderCount = products.filter((p) => p.availability === 'Preorder').length;

function availabilityTone(a: string): string {
  if (a === 'In Stock') return 'green';
  if (a === 'In Transit') return 'amber';
  return 'neutral';
}
function money(n: number | null | undefined): string {
  return n == null ? '—' : `$${Number(n).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`;
}

// pricing view rows: submitted values win after a failed save
const pricingRows = products.map((p) => {
  const sub = submittedPricing?.get(p.id);
  return {
    id: p.id,
    model_name: p.model_name,
    cost: sub ? sub.cost : (p.cost == null ? '' : String(p.cost)),
    selling: sub ? sub.selling : (p.selling_price == null ? '' : String(p.selling_price)),
    origCost: p.cost == null ? '' : String(p.cost),
    origSelling: p.selling_price == null ? '' : String(p.selling_price),
  };
});
---

<AdminLayout title="Products" subtitle="The BUXENA catalog — every sauna model BUXENA sells." parentLabel="Dashboard" parentHref="/admin">
  <a slot="actions" class="admin-btn" href="/admin/products/new">+ New Product</a>

  {!dbReady && (
    <div class="admin-placeholder" style="margin-bottom: 1.5rem;">
      <h2>Not connected to Supabase yet</h2>
      <p>See <code>README-ADMIN.md</code> to connect a project and run the schema.</p>
    </div>
  )}

  <div class="pr-switch">
    <a class={view === 'list' ? 'is-active' : ''} href="/admin/products">Product List</a>
    <a class={view === 'pricing' ? 'is-active' : ''} href="/admin/products?view=pricing">Pricing</a>
  </div>

  {view === 'list' && (
    <>
      <div class="rpt-kpis">
        <div class="rpt-kpi rpt-kpi--hero"><span class="rpt-kpi__value">{totalModels}</span><span class="rpt-kpi__label">Total Models</span></div>
        <div class="rpt-kpi"><span class="rpt-kpi__value">{inStockCount}</span><span class="rpt-kpi__label">In Stock</span></div>
        <div class="rpt-kpi"><span class="rpt-kpi__value">{incomingCount}</span><span class="rpt-kpi__label">Incoming</span></div>
        <div class="rpt-kpi"><span class="rpt-kpi__value">{preorderCount}</span><span class="rpt-kpi__label">Preorder</span></div>
      </div>

      <form class="admin-filterbar" method="GET">
        <input class="admin-input admin-input--search" type="search" name="q" placeholder="Search model name…" value={search} />
        <button class="admin-btn admin-btn--ghost" type="submit">Filter</button>
        {search && <a class="admin-btn admin-btn--ghost" href="/admin/products">Clear</a>}
      </form>

      <div class="admin-panel">
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Model</th><th>Category</th><th>Supplier</th><th>Selling Price</th><th>In Stock</th><th>Incoming</th><th>Availability</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
              {products.map((p) => (
                <tr>
                  <td><a href={`/admin/products/${p.id}`}>{p.model_name}</a></td>
                  <td>{p.category || '—'}</td>
                  <td>{p.suppliers?.name || '—'}</td>
                  <td>{money(p.selling_price)}</td>
                  <td>{p.in_stock_available}</td>
                  <td>{p.incoming}</td>
                  <td><span class={`admin-pill admin-pill--${availabilityTone(p.availability)}`}>{p.availability}</span></td>
                  <td>
                    <span class={`admin-pill ${p.is_active ? 'admin-pill--green' : 'admin-pill--neutral'}`}>{p.is_active ? 'Active' : 'Inactive'}</span>
                    {(p.cost == null || p.selling_price == null) && (
                      <span class="admin-pill admin-pill--neutral" title="Created inline — cost or selling price still missing" style="margin-left:0.3rem;">Incomplete</span>
                    )}
                  </td>
                  <td><a href={`/admin/products/${p.id}`} style="font-size:0.72rem; font-weight:600; letter-spacing:0.04em; text-transform:uppercase; color:var(--admin-gold); text-decoration:none;">View →</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {dbReady && products.length === 0 && (
          <p class="admin-empty">{search ? 'No products found.' : 'No products yet.'}</p>
        )}
      </div>
    </>
  )}

  {view === 'pricing' && (
    <>
      {pricingError && <p class="notice notice--error" style="margin-bottom:1rem;">{pricingError}</p>}
      {pricingNotice && <p class="notice notice--ok" style="margin-bottom:1rem;">{pricingNotice}</p>}

      <form method="POST" action="/admin/products?view=pricing" id="pricing-form">
        <div class="pr-bulk">
          <label class="pr-bulk__field">
            <span>Bulk markup %</span>
            <input class="admin-input" type="number" step="0.1" min="0" id="bulk-markup" placeholder="e.g. 40" />
          </label>
          <button class="admin-btn admin-btn--ghost" type="button" id="apply-markup">Apply to all</button>
          <span class="pr-bulk__note" id="bulk-note"></span>
          <button class="admin-btn" type="submit" style="margin-left:auto;">Save changes</button>
        </div>

        <div class="admin-panel">
          <div class="admin-table-wrap">
            <table class="admin-table pr-table" id="pricing-table">
              <thead>
                <tr><th>Model</th><th class="num">Cost</th><th class="num">Selling</th><th class="num">Margin</th><th class="num">%</th></tr>
              </thead>
              <tbody>
                {pricingRows.map((r) => (
                  <tr class="pr-row" data-id={r.id}>
                    <td class="pr-model">{r.model_name}</td>
                    <td class="num">
                      <input type="hidden" name="row_id[]" value={r.id} />
                      <input type="hidden" name="row_cost_orig[]" value={r.origCost} />
                      <input type="hidden" name="row_selling_orig[]" value={r.origSelling} />
                      <input class="admin-input pr-cost" type="number" step="0.01" min="0" name="row_cost[]" value={r.cost} data-orig={r.origCost} />
                    </td>
                    <td class="num"><input class="admin-input pr-selling" type="number" step="0.01" min="0" name="row_selling[]" value={r.selling} data-orig={r.origSelling} /></td>
                    <td class="num pr-margin">—</td>
                    <td class="num pr-pct">—</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr class="pr-totals">
                  <td id="pr-count">{pricingRows.length} products</td>
                  <td></td>
                  <td></td>
                  <td class="num" id="pr-total-margin">—</td>
                  <td class="num" id="pr-blended">—</td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
        <p class="pr-excluded" id="pr-excluded" hidden></p>
        <p class="pr-caption">
          Margin here is planning only — cost is the product's list cost, not the landed cost from a shipment. Actual margin per order is in the Margin report.
        </p>
      </form>
    </>
  )}
</AdminLayout>

<style>
  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
  .notice--ok { padding: 0.85rem 1rem; font-size: 0.85rem; color: #a9cfa4; background: rgba(143, 191, 138, 0.06); border: 1px solid rgba(143, 191, 138, 0.35); border-radius: 2px; }

  .pr-switch {
    display: inline-flex;
    gap: 2px;
    margin-bottom: 1.1rem;
    padding: 3px;
    background: #181613;
    border: 1px solid rgba(201, 166, 104, 0.14);
    border-radius: 5px;
  }
  .pr-switch a {
    padding: 0.4rem 0.9rem;
    border-radius: 3px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--admin-muted);
    text-decoration: none;
  }
  .pr-switch a.is-active { background: rgba(201, 166, 104, 0.14); color: var(--admin-gold); }
  .pr-switch a:hover:not(.is-active) { color: var(--admin-cream); }

  .pr-bulk {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .pr-bulk__field { display: flex; flex-direction: column; gap: 0.3rem; }
  .pr-bulk__field span { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--admin-muted); }
  .pr-bulk__field input { width: 7rem; }
  .pr-bulk__note { font-size: 0.75rem; color: var(--admin-gold); }

  .pr-table td, .pr-table th { border-bottom: 1px solid rgba(201, 166, 104, 0.12); }
  .pr-table .num { text-align: right; }
  .pr-table td { padding-top: 0.35rem; padding-bottom: 0.35rem; } /* ~38px rows */
  .pr-table input[type='number'] { width: 7.5rem; text-align: right; }
  .pr-model { white-space: normal; }
  .pr-margin { color: var(--admin-gold); font-variant-numeric: tabular-nums; }
  .pr-pct { font-variant-numeric: tabular-nums; }
  .pr-pct--green { color: #97c459; }
  .pr-pct--amber { color: #ef9f27; }
  .pr-pct--red { color: #d98a66; }
  .pr-dash { color: var(--admin-muted); }
  .pr-row.is-dirty td:first-child { box-shadow: inset 3px 0 0 var(--admin-gold); }
  .pr-totals td { font-weight: 600; border-top: 1px solid rgba(201, 166, 104, 0.3); }
  .pr-excluded { margin: 0.5rem 0 0; font-size: 0.72rem; color: var(--admin-muted); }
  .pr-caption { margin: 0.9rem 0 0; font-size: 0.75rem; color: var(--admin-muted); }
</style>

<script>
  const table = document.getElementById('pricing-table');
  if (table) {
    const form = document.getElementById('pricing-form') as HTMLFormElement;
    const fmt = (n: number) => `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const rows = [...table.querySelectorAll<HTMLTableRowElement>('.pr-row')];
    let dirty = false;

    function rowValues(row: HTMLTableRowElement) {
      const costRaw = (row.querySelector('.pr-cost') as HTMLInputElement).value.trim();
      const sellRaw = (row.querySelector('.pr-selling') as HTMLInputElement).value.trim();
      const cost = costRaw === '' ? null : Number(costRaw);
      const sell = sellRaw === '' ? null : Number(sellRaw);
      return { cost, sell };
    }

    function recalc() {
      let totalMargin = 0;
      let totalSelling = 0;
      let excluded = 0;
      dirty = false;

      for (const row of rows) {
        const costEl = row.querySelector('.pr-cost') as HTMLInputElement;
        const sellEl = row.querySelector('.pr-selling') as HTMLInputElement;
        const marginEl = row.querySelector('.pr-margin') as HTMLElement;
        const pctEl = row.querySelector('.pr-pct') as HTMLElement;
        const { cost, sell } = rowValues(row);

        const rowDirty = costEl.value.trim() !== (costEl.dataset.orig ?? '') || sellEl.value.trim() !== (sellEl.dataset.orig ?? '');
        row.classList.toggle('is-dirty', rowDirty);
        if (rowDirty) dirty = true;

        // unknown (null) OR zero cost/selling: em-dash — never 0, never 100%
        if (cost == null || sell == null || cost === 0 || sell === 0 || !Number.isFinite(cost) || !Number.isFinite(sell)) {
          marginEl.textContent = '—';
          marginEl.classList.add('pr-dash');
          pctEl.textContent = '—';
          pctEl.className = 'num pr-pct pr-dash';
          excluded++;
          continue;
        }
        const margin = sell - cost;
        const pct = ((sell - cost) / sell) * 100;
        marginEl.textContent = fmt(margin);
        marginEl.classList.remove('pr-dash');
        pctEl.textContent = `${pct.toFixed(1)}%`;
        pctEl.className = 'num pr-pct ' + (pct >= 30 ? 'pr-pct--green' : pct >= 15 ? 'pr-pct--amber' : 'pr-pct--red');
        totalMargin += margin;
        totalSelling += sell;
      }

      document.getElementById('pr-total-margin')!.textContent = totalSelling > 0 ? fmt(totalMargin) : '—';
      // blended = total margin / total selling — NOT an average of the % column
      document.getElementById('pr-blended')!.textContent = totalSelling > 0 ? `${((totalMargin / totalSelling) * 100).toFixed(1)}%` : '—';
      const exNote = document.getElementById('pr-excluded')!;
      if (excluded > 0) {
        exNote.hidden = false;
        exNote.textContent = `${excluded} row${excluded === 1 ? '' : 's'} excluded from totals (missing or zero cost/selling price).`;
      } else exNote.hidden = true;
    }

    form.addEventListener('input', recalc);
    recalc();

    // bulk markup: on-screen only; NULL-cost rows skipped, never zeroed
    document.getElementById('apply-markup')?.addEventListener('click', () => {
      const pctRaw = (document.getElementById('bulk-markup') as HTMLInputElement).value.trim();
      const pct = Number(pctRaw);
      const note = document.getElementById('bulk-note')!;
      if (pctRaw === '' || !Number.isFinite(pct) || pct < 0) { note.textContent = 'Enter a non-negative markup percentage first.'; return; }
      if (!confirm(`Apply ${pct}% markup to every row with a cost?\n\nThis overwrites the on-screen selling prices (nothing is saved until you click Save changes).`)) return;
      let applied = 0, skipped = 0;
      for (const row of rows) {
        const { cost } = rowValues(row);
        const sellEl = row.querySelector('.pr-selling') as HTMLInputElement;
        if (cost == null || !Number.isFinite(cost)) { skipped++; continue; }
        sellEl.value = (Math.round(cost * (1 + pct / 100) * 100) / 100).toFixed(2);
        applied++;
      }
      note.textContent = `Applied to ${applied} row${applied === 1 ? '' : 's'}${skipped ? ` — ${skipped} skipped (no cost)` : ''}. Review, then Save changes.`;
      recalc();
    });

    // unsaved-changes guard
    window.addEventListener('beforeunload', (e) => {
      if (dirty) { e.preventDefault(); e.returnValue = ''; }
    });
    form.addEventListener('submit', () => { dirty = false; });
  }
</script>
