---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';

const search = Astro.url.searchParams.get('q') ?? '';
let products: any[] = [];
let dbReady = true;

try {
  const supabase = createSupabaseAdminClient();
  let query = supabase
    .from('products')
    .select('id, model_name, category, selling_price, stock_quantity, is_active')
    .order('model_name');
  if (search) query = query.ilike('model_name', `%${search}%`);
  const { data } = await query.limit(300);
  products = data ?? [];
} catch {
  dbReady = false;
}
---

<AdminLayout title="Products">
  {!dbReady && (
    <div class="admin-placeholder" style="margin-bottom: 1.5rem;">
      <h2>Not connected to Supabase yet</h2>
      <p>See <code>README-ADMIN.md</code> to connect a project and run the schema.</p>
    </div>
  )}

  <div class="admin-toolbar">
    <form class="admin-toolbar__filters" method="GET">
      <input class="admin-input admin-input--search" type="search" name="q" placeholder="Search model name…" value={search} />
      <button class="admin-btn admin-btn--ghost" type="submit">Filter</button>
    </form>
    <a class="admin-btn" href="/admin/products/new">+ New Product</a>
  </div>

  <div class="admin-panel">
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>Model</th><th>Category</th><th>Selling Price</th><th>Stock</th><th>Status</th></tr></thead>
        <tbody>
          {products.map((p) => (
            <tr>
              <td><a href={`/admin/products/${p.id}`}>{p.model_name}</a></td>
              <td>{p.category || '—'}</td>
              <td>{p.selling_price != null ? `$${p.selling_price}` : '—'}</td>
              <td>{p.stock_quantity ?? 0}</td>
              <td><span class={`admin-badge ${p.is_active ? 'admin-badge--green' : 'admin-badge--neutral'}`}>{p.is_active ? 'Active' : 'Inactive'}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {dbReady && products.length === 0 && <p class="admin-empty">No products yet.</p>}
  </div>
</AdminLayout>
