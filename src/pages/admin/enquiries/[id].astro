---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import { signDocumentUrls } from '../../../lib/document-access';
import { isAdminStaff } from '../../../lib/staff-access';
import RecordActions from '../../../components/admin/RecordActions.astro';
import { handleRecordAction, recordActionState } from '../../../lib/record-actions';
import { markEnquiryContacted, changeEnquiryStatus, convertEnquiryToLead, createQuoteFromEnquiry } from '../../../lib/enquiry-conversion';
import { buildEnquiryReply, buildMailtoHref } from '../../../lib/enquiry-reply-templates';
import { buildFollowUpEmail, type FollowUpTrigger } from '../../../lib/follow-up-email-templates';
import { parseEnquiryDetails } from '../../../lib/enquiry-details';
import { effectiveSource } from '../../../lib/enquiry-source';
import { site } from '../../../data/site';

// Permanent deletion is admin-only; enforced server-side in the handler below.
const canDelete = await isAdminStaff(Astro);

const { id } = Astro.params;
const STATUSES = ['New', 'Contacted', 'Qualified', 'Quoted', 'Won', 'Lost'];

let enquiry: any = null;
let lead: any = null;
let quote: any = null;
let timeline: any[] = [];
let notFound = false;
let error: string | null = null;
// Files the customer attached to this enquiry. Read with the service-role
// client behind the admin middleware, then each one is given a short-lived
// signed URL — the private object path never reaches the browser.
let projectFiles: { name: string; url: string | null; created: string | null }[] = [];
let actions = { supported: false, archived: false };
let notice: string | null = null;
/** Other enquiries sharing this email — returning buyer, or a duplicate. */
let alsoFromContact: any[] = [];

try {
  const supabase = createSupabaseAdminClient();
  const staffId = Astro.locals.staffUser?.id ?? null;

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const intent = String(form.get('_intent') ?? '');

    if (intent === 'mark_contacted') {
      await markEnquiryContacted(supabase, id!, staffId);
    } else if (intent === 'change_status') {
      const status = String(form.get('status') ?? '');
      if (STATUSES.includes(status)) await changeEnquiryStatus(supabase, id!, status, staffId);
    } else if (intent === 'convert_to_lead') {
      const result = await convertEnquiryToLead(supabase, id!, staffId);
      if (!result.ok && result.reason === 'ALREADY_CONVERTED') notice = 'This enquiry was already converted to a Lead.';
      else if (!result.ok) error = 'Could not convert to Lead: ' + result.reason;
    } else if (intent === 'create_quote') {
      const result = await createQuoteFromEnquiry(supabase, id!, staffId);
      if (!result.ok && result.reason === 'ALREADY_CONVERTED') notice = 'A Quote already exists for this enquiry.';
      else if (!result.ok) error = 'Could not create Quote: ' + result.reason;
    } else {
      // Archive / restore / permanent delete. A converted enquiry keeps an
      // extra rule of its own on top of the shared checks: it is the source
      // record behind a Lead or Quote and must survive them, so it can be
      // archived out of the way but never permanently deleted.
      const linked = await (async () => {
        if (String(form.get('_intent') ?? '') !== 'delete') return false;
        const { data: current } = await supabase.from('enquiries').select('lead_id, quote_id').eq('id', id).single();
        return Boolean(current?.lead_id || current?.quote_id);
      })();

      if (linked) {
        error = 'This enquiry is linked to a Lead or Quote and cannot be deleted — it must remain as the source record. Archive it, or set its status to Lost, to close it instead.';
      } else {
        const outcome = await handleRecordAction(Astro, form, {
          supabase,
          table: 'enquiries',
          id: id!,
          canDelete,
          listPath: '/admin/enquiries',
        });
        if (outcome.kind === 'response') return outcome.response;
        if (outcome.kind === 'error') error = outcome.message;
        if (outcome.kind === 'notice') notice = outcome.message;
      }
    }
  }

  const { data: enquiryRow, error: enquiryError } = await supabase.from('enquiries').select('*').eq('id', id).single();
  if (enquiryError || !enquiryRow) {
    notFound = true;
  } else {
    enquiry = enquiryRow;
    const [leadRow, quoteRow, activityRows] = await Promise.all([
      enquiry.lead_id ? supabase.from('leads').select('id, name, status').eq('id', enquiry.lead_id).maybeSingle() : Promise.resolve({ data: null }),
      enquiry.quote_id ? supabase.from('quotes').select('id, quote_number, status, total, share_token, viewed_at').eq('id', enquiry.quote_id).maybeSingle() : Promise.resolve({ data: null }),
      supabase.from('activities').select('id, description, created_at').eq('entity_type', 'enquiry').eq('entity_id', id).order('created_at', { ascending: false }),
    ]);
    lead = leadRow.data;
    quote = quoteRow.data;
    timeline = activityRows.data ?? [];
  }

  // OTHER ENQUIRIES FROM THE SAME PERSON.
  //
  // Two things a salesperson could not previously see. First, whether this is
  // a returning buyer — somebody who checked availability last week and has
  // now asked for pricing is the warmest lead in the system, and answering
  // them as a stranger wastes that. Second, whether this record is a duplicate
  // of one a colleague already replied to, which is how a customer ends up
  // with two different people quoting them.
  //
  // Matched on email because that is the field every form requires. One
  // indexed query on a table already open; no new table, no new column.
  if (enquiry?.email) {
    const { data: siblingRows } = await supabase
      .from('enquiries')
      .select('id, source, status, sauna_interest, created_at')
      .eq('email', enquiry.email)
      .neq('id', id)
      .order('created_at', { ascending: false })
      .limit(10);
    alsoFromContact = siblingRows ?? [];
  }

  // Customer project files, newest first.
  if (enquiry) {
    const { data: fileRows } = await supabase
      .from('documents')
      .select('file_url, file_name, created_at')
      .eq('enquiry_id', id)
      .order('created_at', { ascending: false });
    const rows = fileRows ?? [];
    const signed = await signDocumentUrls(supabase, rows.map((r: any) => r.file_url));
    projectFiles = rows.map((r: any) => ({
      name: r.file_name || 'Attachment',
      url: signed.get(String(r.file_url ?? '').trim()) ?? null,
      created: r.created_at ?? null,
    }));
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Supabase is not configured yet.';
}
// Archive state for the actions block. Resolved after the record loads and
// kept out of the main try so a failure here can never mask the record itself.
try {
  actions = await recordActionState(createSupabaseAdminClient(), enquiry);
} catch {
  /* leave defaults: unsupported + not archived, so no controls render */
}

// Suggested first response — a draft for the founder to review and edit.
// Built server-side from the enquiry's own fields; nothing sends by itself.
// The form this enquiry really came from. Differs from enquiry.source only
// while the source CHECK constraint is un-migrated, when the API records the
// true form in the message instead — see lib/enquiry-source.ts. Used for the
// reply template so a trade project never gets the general-enquiry draft.
const formSource = enquiry ? effectiveSource(enquiry) : '';

const reply = enquiry
  ? buildEnquiryReply({
      name: enquiry.name,
      phone: enquiry.phone,
      location: enquiry.location,
      saunaInterest: enquiry.sauna_interest,
      source: formSource,
    })
  : null;
const replyMailto = enquiry?.email && reply ? buildMailtoHref(enquiry.email, reply) : null;

/**
 * Follow-up draft — a SEPARATE template from the "Suggested Reply" above.
 * That one is the founder's first response; this is what a later, "you
 * started something and didn't finish" nudge could say. Trigger and CTA are
 * both derived from real, already-loaded fields — never invented:
 *   quote.share_token exists → the customer's real proposal link, trigger
 *     'proposal_not_opened' (true whether or not it's actually been opened —
 *     the copy reads fine either way: "your proposal is ready and waiting").
 *   otherwise → the generic pricing page, trigger 'pricing_request_no_action'.
 */
const followUpTrigger: FollowUpTrigger = quote?.share_token ? 'proposal_not_opened' : 'pricing_request_no_action';
const siteUrl = String(Astro.site ?? 'https://buxena.com').replace(/\/$/, '');
const followUp = enquiry
  ? buildFollowUpEmail({
      trigger: followUpTrigger,
      customerFirstName: (enquiry.name ?? '').trim().split(/\s+/)[0] || null,
      recap: { modelTitle: enquiry.sauna_interest, location: enquiry.location },
      primaryCtaHref: quote?.share_token ? `${siteUrl}/proposal/${quote.share_token}/` : `${siteUrl}/quote/`,
      primaryCtaLabel: quote?.share_token ? 'Review your proposal' : 'Request pricing',
      siteName: site.name,
      siteUrl,
    })
  : null;
const followUpMailto = enquiry?.email && followUp ? buildMailtoHref(enquiry.email, followUp) : null;

// The customer's own answers, lifted out of the message blob so the reply can
// be written from them without reading a paragraph first. Read-only.
const details = parseEnquiryDetails(enquiry?.message);
---

<AdminLayout title="Enquiry" subtitle={enquiry ? `Received ${new Date(enquiry.created_at).toLocaleString()}` : undefined} parentLabel="Website Enquiries" parentHref="/admin/enquiries">
  {enquiry && <Fragment slot="title-badge"><StatusBadge status={enquiry.status} /></Fragment>}

  {notFound && <p class="admin-empty">Enquiry not found.</p>}
  {error && <p class="notice notice--error" style="margin-bottom:1.25rem;">{error}</p>}

  {enquiry && (
    <RecordActions
      label="Enquiry"
      archived={actions.archived}
      supported={actions.supported}
      canDelete={canDelete}
      archivedAt={enquiry?.archived_at}
    />
  )}
  {notice && <p class="notice notice--ok" style="margin-bottom:1.25rem;">{notice}</p>}

  {enquiry && (
    <div class="enq-detail">
      <div class="enq-actions">
        {enquiry.status === 'New' && (
          <form method="POST" style="margin:0;">
            <input type="hidden" name="_intent" value="mark_contacted" />
            <button class="admin-btn admin-btn--ghost" type="submit">Mark Contacted</button>
          </form>
        )}
        {enquiry.lead_id ? (
          <a class="admin-btn admin-btn--ghost" href={`/admin/leads/${enquiry.lead_id}`}>View Lead</a>
        ) : (
          <form method="POST" style="margin:0;">
            <input type="hidden" name="_intent" value="convert_to_lead" />
            <button class="admin-btn" type="submit">Convert to Lead</button>
          </form>
        )}
        {enquiry.quote_id ? (
          <a class="admin-btn admin-btn--ghost" href={`/admin/quotes/${enquiry.quote_id}`}>View Quote</a>
        ) : (
          <form method="POST" style="margin:0;">
            <input type="hidden" name="_intent" value="create_quote" />
            <button class="admin-btn" type="submit">Create Quote</button>
          </form>
        )}
        {enquiry.email && <a class="admin-btn admin-btn--ghost" href={replyMailto ?? `mailto:${enquiry.email}`}>Email Customer</a>}
        {enquiry.phone && <a class="admin-btn admin-btn--ghost" href={`tel:${enquiry.phone}`}>Call Customer</a>}

        <form method="POST" class="enq-status-form">
          <input type="hidden" name="_intent" value="change_status" />
          <select class="admin-select" name="status">
            {STATUSES.map((s) => <option value={s} selected={s === enquiry.status}>{s}</option>)}
          </select>
          <button class="admin-btn admin-btn--ghost" type="submit">Update Status</button>
        </form>

      </div>

      <div class="enq-grid">
        <div class="enq-main">
          <section class="admin-panel enq-sec">
            <h2 class="enq-sec__h">Customer</h2>
            <dl class="enq-kv">
              <div><dt>Name</dt><dd>{enquiry.name || '—'}</dd></div>
              <div><dt>Email</dt><dd>{enquiry.email || '—'}</dd></div>
              <div><dt>Phone</dt><dd>{enquiry.phone || '—'}</dd></div>
              <div><dt>ZIP / Postal Code</dt><dd>{enquiry.location || '—'}</dd></div>
            </dl>

            {projectFiles.length > 0 && (
              <div class="enq-files">
                <h3 class="enq-files__h">Customer project files ({projectFiles.length})</h3>
                <p class="enq-files__note">
                  Uploaded by the customer with this enquiry. Links are private and
                  expire after an hour — reopen this page for a fresh one.
                </p>
                <ul class="enq-files__list">
                  {projectFiles.map((file) => (
                    <li>
                      <span class="enq-files__name">{file.name}</span>
                      {file.url ? (
                        <a
                          class="admin-btn admin-btn--ghost"
                          href={file.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-track="project_file_opened"
                        >View / Download</a>
                      ) : (
                        <span class="enq-files__missing">File missing from storage</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}

          </section>

          <section class="admin-panel enq-sec">
            <h2 class="enq-sec__h">Request</h2>
            <dl class="enq-kv">
              <div><dt>Requested Sauna / Model</dt><dd>{enquiry.sauna_interest || '—'}</dd></div>
              <div><dt>Requested Service</dt><dd>{formSource || '—'}</dd></div>
            </dl>

            {details.fields.length > 0 && (
              <Fragment>
                <p class="enq-label">Project Answers</p>
                <dl class="enq-kv enq-kv--answers">
                  {details.fields.map((f) => (
                    <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
                  ))}
                </dl>
              </Fragment>
            )}

            <p class="enq-label">Customer Message</p>
            {details.prose.length > 0 ? (
              details.prose.map((p) => <p class="enq-message">{p}</p>)
            ) : (
              <p class="enq-message">{details.fields.length ? '— (answers above)' : enquiry.message || '—'}</p>
            )}

            {/* The unedited capture stays available. The panels above are a
                reading aid; this is the record, and it must remain checkable. */}
            {enquiry.message && (
              <details class="enq-raw">
                <summary>Show raw submission</summary>
                <p class="enq-message">{enquiry.message}</p>
              </details>
            )}
          </section>

          {reply && (
            <section class="admin-panel enq-sec">
              <h2 class="enq-sec__h">Suggested Reply <span class="enq-reply__tpl">{reply.templateName}</span></h2>
              <p class="enq-label" style="margin-top:0;">Subject</p>
              <p class="enq-reply__subject">{reply.subject}</p>
              <p class="enq-label">Draft — review and personalize before sending</p>
              <textarea class="enq-reply__body" data-reply-body readonly rows={reply.body.split('\n').length + 1}>{reply.body}</textarea>
              <div class="enq-reply__actions">
                <button class="admin-btn admin-btn--ghost" type="button" data-copy-reply>Copy Reply</button>
                {replyMailto && <a class="admin-btn" href={replyMailto}>Open in Email App</a>}
              </div>
              <p class="enq-reply__note">Opens as a draft in your own mail app — nothing is ever sent automatically.</p>
            </section>
          )}

          {(lead || quote) && (
            <section class="admin-panel enq-sec">
              <h2 class="enq-sec__h">Linked Records</h2>
              <dl class="enq-kv">
                {lead && <div><dt>Lead</dt><dd><a href={`/admin/leads/${lead.id}`}>{lead.name}</a> — {lead.status}</dd></div>}
                {quote && (
                  <div>
                    <dt>Quote</dt>
                    <dd>
                      <a href={`/admin/quotes/${quote.id}`}>{quote.quote_number}</a> — {quote.status}
                      {/* Real, already-captured data — quotes.viewed_at is set the
                          first time the customer opens their proposal link. Not a
                          new tracking event, just surfaced here for follow-up. */}
                      {quote.viewed_at
                        ? <span class="enq-sub"> · viewed {new Date(quote.viewed_at).toLocaleDateString()}</span>
                        : <span class="enq-sub"> · not yet viewed</span>}
                    </dd>
                  </div>
                )}
              </dl>
            </section>
          )}

          {followUp && (
            <section class="admin-panel enq-sec">
              <h2 class="enq-sec__h">Follow-up Email <span class="enq-reply__tpl">Prepared — not sent</span></h2>
              <p class="enq-label" style="margin-top:0;">Subject</p>
              <p class="enq-reply__subject">{followUp.subject}</p>
              <p class="enq-label">Draft — review and personalize before sending</p>
              <textarea class="enq-reply__body" data-followup-body readonly rows={followUp.body.split('\n').length + 1}>{followUp.body}</textarea>
              <div class="enq-reply__actions">
                <button class="admin-btn admin-btn--ghost" type="button" data-copy-followup>Copy Follow-up</button>
                {followUpMailto && <a class="admin-btn" href={followUpMailto}>Open in Email App</a>}
              </div>
              <p class="enq-reply__note">
                Prepared from this record's own data — nothing is sent automatically, no automated trigger exists yet.
              </p>
            </section>
          )}
        </div>

        <div class="enq-side">
          <section class="admin-panel enq-sec">
            <h2 class="enq-sec__h">Enquiry Information</h2>
            <dl class="enq-kv enq-kv--1col">
              <div><dt>Received</dt><dd>{new Date(enquiry.created_at).toLocaleString()}</dd></div>
              <div><dt>Source</dt><dd>{formSource || enquiry.source}</dd></div>
              {formSource && formSource !== enquiry.source && (
                <div>
                  <dt>Stored as</dt>
                  <dd class="enq-stored-as">
                    {enquiry.source} — the database will not yet accept
                    "{formSource}". Apply the 2026-08-13 enquiry-source
                    migration and new enquiries will store it directly.
                  </dd>
                </div>
              )}
              <div><dt>Status</dt><dd><StatusBadge status={enquiry.status} /></dd></div>
              {enquiry.contacted_at && <div><dt>Contacted</dt><dd>{new Date(enquiry.contacted_at).toLocaleString()}</dd></div>}
            </dl>
          </section>

          {alsoFromContact.length > 0 && (
            <section class="admin-panel enq-sec">
              <h2 class="enq-sec__h">Also From This Contact ({alsoFromContact.length})</h2>
              <p class="enq-files__note" style="margin-bottom:0.7rem;">
                Same email address. A returning enquirer is a strong buying
                signal — check what was already answered before replying.
              </p>
              <ul class="enq-also">
                {alsoFromContact.map((s) => (
                  <li>
                    <a href={`/admin/enquiries/${s.id}`}>
                      <span class="enq-also__src">{s.sauna_interest || s.source}</span>
                      <span class="enq-also__meta">
                        {new Date(s.created_at).toLocaleDateString()} · {s.status}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section class="admin-panel enq-sec">
            <h2 class="enq-sec__h">Activity Timeline</h2>
            <ul class="enq-timeline">
              {timeline.map((t) => (
                <li><span class="enq-timeline__desc">{t.description}</span><span class="enq-timeline__when">{new Date(t.created_at).toLocaleString()}</span></li>
              ))}
              <li class="enq-timeline__origin"><span class="enq-timeline__desc">Enquiry received</span><span class="enq-timeline__when">{new Date(enquiry.created_at).toLocaleString()}</span></li>
            </ul>
          </section>
        </div>
      </div>
    </div>
  )}
</AdminLayout>

<style>
  .enq-files { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(212, 184, 140, 0.14); }
  .enq-files__h { margin: 0 0 0.35rem; font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--admin-gold); }
  .enq-files__note { margin: 0 0 0.9rem; font-size: 0.78rem; line-height: 1.6; color: var(--admin-muted); }
  .enq-files__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .enq-files__list li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.7rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(212,184,140,0.12); border-radius: 3px; }
  .enq-files__name { font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .enq-files__missing { font-size: 0.78rem; color: #e6b7a0; }

  .notice--error { padding: 0.85rem 1rem; font-size: 0.85rem; color: #e6b7a0; background: rgba(230, 130, 90, 0.06); border: 1px solid rgba(230, 130, 90, 0.35); border-radius: 2px; }
  .notice--ok { padding: 0.85rem 1rem; font-size: 0.85rem; color: #a9cfa4; background: rgba(143, 191, 138, 0.06); border: 1px solid rgba(143, 191, 138, 0.35); border-radius: 2px; }

  .enq-detail { display: flex; flex-direction: column; gap: 0.9rem; }
  .enq-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .enq-status-form { display: flex; gap: 0.4rem; align-items: center; margin: 0; margin-left: auto; }

  .enq-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 0.9rem; align-items: start; }
  .enq-main, .enq-side { display: flex; flex-direction: column; gap: 0.9rem; }

  .enq-sec { padding: 0.9rem 1.1rem; border-radius: 6px; }
  .enq-sec__h {
    margin: 0 0 0.65rem;
    font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--admin-cream);
  }

  .enq-kv { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem 1.25rem; margin: 0; }
  .enq-kv--1col { grid-template-columns: 1fr; }
  .enq-kv dt { font-size: 0.62rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--admin-muted); }
  .enq-kv dd { margin: 0.15rem 0 0; font-size: 0.85rem; color: var(--admin-cream); }

  .enq-label { margin: 0.9rem 0 0.3rem; font-size: 0.62rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--admin-muted); }
  .enq-message { margin: 0 0 0.5rem; font-size: 0.85rem; line-height: 1.55; color: var(--admin-cream); white-space: pre-wrap; }
  .enq-message:last-child { margin-bottom: 0; }

  /* The customer's answers, as a scannable grid rather than a paragraph. */
  .enq-kv--answers {
    padding: 0.7rem 0.8rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--admin-border);
    border-radius: 4px;
  }

  .enq-raw { margin-top: 0.9rem; }
  .enq-raw summary {
    cursor: pointer;
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--admin-muted);
  }
  .enq-raw summary:hover { color: var(--admin-gold); }
  .enq-raw .enq-message { margin-top: 0.5rem; }

  .enq-also { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .enq-also a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.7rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--admin-border);
    border-radius: 3px;
    text-decoration: none;
  }
  .enq-also a:hover { border-color: var(--admin-gold); }
  .enq-also__src { font-size: 0.82rem; color: var(--admin-cream); }
  .enq-also__meta { font-size: 0.68rem; color: var(--admin-muted); }

  .enq-stored-as { font-size: 0.72rem; line-height: 1.5; color: var(--admin-muted); }

  .enq-timeline { list-style: none; margin: 0; padding: 0; }
  .enq-timeline li {
    display: flex; flex-direction: column; gap: 0.1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--admin-border);
    font-size: 0.8rem;
  }
  .enq-timeline li:last-child { border-bottom: none; }
