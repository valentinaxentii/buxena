<script>
  // Copy a drafted reply to the clipboard. Read-only convenience — the
  // founder pastes, edits and sends from their own mail app. Nothing here
  // ever sends anything.
  function wireCopyButton(buttonSelector: string, bodySelector: string) {
    const btn = document.querySelector<HTMLButtonElement>(buttonSelector);
    const body = document.querySelector<HTMLTextAreaElement>(bodySelector);
    if (!btn || !body) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(body.value);
      } catch {
        body.select();
        document.execCommand('copy');
      }
      const original = btn.textContent;
      btn.textContent = 'Copied';
      setTimeout(() => { btn.textContent = original; }, 1600);
    });
  }
  wireCopyButton('[data-copy-reply]', '[data-reply-body]');
  wireCopyButton('[data-copy-followup]', '[data-followup-body]');
</script>
