---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import '../../../styles/admin.css';
import { createSupabaseAdminClient } from '../../../lib/supabase-admin';
import ArchiveToggle from '../../../components/admin/ArchiveToggle.astro';
import { archiveSupported, withArchiveFilter } from '../../../lib/archive';
import { effectiveSource } from '../../../lib/enquiry-source';
import {
  classifyList,
  CONFIGURATION_BODY,
  CONFIGURATION_HEADLINE,
  LOAD_FAILED_BODY,
  LOAD_FAILED_HEADLINE,
  RETRY_LABEL,
} from '../../../lib/admin-enquiry-state';

const search = Astro.url.searchParams.get('q') ?? '';
const statusFilter = Astro.url.searchParams.get('status') ?? '';
/** Where "Try again" goes: this same view, filters intact. */
const retryHref = Astro.url.pathname + Astro.url.search;

const STATUSES = ['New', 'Contacted', 'Qualified', 'Quoted', 'Won', 'Lost'];

/**
 * How long an enquiry has been sitting unanswered.
 *
 * The list used to show only a raw locale timestamp, which makes the reader do
 * date arithmetic on every row to find the one that has been waiting longest —
 * on the screen whose entire job is deciding who to call next. "waiting 3d"
 * needs no arithmetic.
 *
 * Shown only while the status is still New: once somebody has replied, age
 * stops being the thing that matters and the status carries the story.
 *
 * The 24-hour threshold is a display emphasis, not a service-level promise.
 * BUXENA publishes no response time anywhere and this must not become one.
 */
const WAITING_URGENT_HOURS = 24;
function waitingFor(createdAt: string): { text: string; urgent: boolean } | null {
  const ms = Date.now() - new Date(createdAt).getTime();
  if (!Number.isFinite(ms) || ms < 0) return null;
  const mins = Math.floor(ms / 60000);
  const hours = Math.floor(mins / 60);
  const days = Math.floor(hours / 24);
  const text = mins < 60 ? `${mins}m` : hours < 24 ? `${hours}h` : `${days}d`;
  return { text: `waiting ${text}`, urgent: hours >= WAITING_URGENT_HOURS };
}

/**
 * A recommended next step, derived purely from `status` (and, for New, how
 * long it's been waiting — reusing waitingFor() rather than a new signal).
 * No behaviour is tracked to produce this: it is a read of a field that
 * already exists, restated as an action instead of a status word.
 */
function nextAction(e: { status: string; created_at: string }): string {
  switch (e.status) {
    case 'New': {
      const w = waitingFor(e.created_at);
      return w?.urgent ? 'Follow up — waiting over 24h' : 'Send first reply';
    }
    case 'Contacted': return 'Awaiting customer reply';
    case 'Qualified': return 'Prepare a quote';
    case 'Quoted': return 'Check if proposal was viewed';
    case 'Won': return 'No action — won';
    case 'Lost': return 'No action — lost';
    default: return '—';
  }
}

let enquiries: any[] = [];
/**
 * What the list query actually did. The old code kept a single boolean and
 * discarded the query's error, so a failed read rendered as "No enquiries yet"
 * — a claim about the business made on the strength of a request that never
 * returned. See lib/admin-enquiry-state.ts.
 */
let listKind: 'ok' | 'configuration' | 'unavailable' = 'ok';
// Archived records are hidden from the active list; ?archived=1 shows only them.
const showArchived = Astro.url.searchParams.get('archived') === '1';
let archiveOk = false;

try {
  const supabase = createSupabaseAdminClient();
  let query = supabase
    .from('enquiries')
    .select('id, name, email, phone, location, message, sauna_interest, source, status, created_at')
    .order('created_at', { ascending: false });

  if (search) query = query.or(`name.ilike.%${search}%,email.ilike.%${search}%,phone.ilike.%${search}%,location.ilike.%${search}%`);
  if (statusFilter) query = query.eq('status', statusFilter);

  // Archived rows drop out of the active list. A no-op until the migration
  // is applied, so this cannot break the page in the meantime.
  archiveOk = await archiveSupported(supabase);
  query = withArchiveFilter(query, archiveOk, showArchived);
  const list = classifyList(await query.limit(200));
  listKind = list.kind;
  enquiries = list.rows;
} catch {
  // createSupabaseAdminClient() throws only when the project is unconfigured,
  // which is a configuration problem rather than a temporary one.
  listKind = 'configuration';
}
---

<AdminLayout title="Website Enquiries" parentLabel="Dashboard" parentHref="/admin">
  {listKind === 'configuration' && (
    <div class="admin-placeholder" style="margin-bottom: 1.5rem;">
      <h2>{CONFIGURATION_HEADLINE}</h2>
      <p>{CONFIGURATION_BODY}</p>
    </div>
  )}

  {/* A failed read is NOT an empty inbox. Reporting "No enquiries yet" here
      would tell the founder the funnel is quiet while the CRM is unreachable. */}
  {listKind === 'unavailable' && (
    <div class="admin-placeholder" style="margin-bottom: 1.5rem; border-color: rgba(230,130,90,0.35);">
      <h2>{LOAD_FAILED_HEADLINE}</h2>
      <p>{LOAD_FAILED_BODY}</p>
      <a class="admin-btn" href={retryHref}>{RETRY_LABEL}</a>
    </div>
  )}

  <p style="color:var(--admin-muted); font-size:0.85rem; margin-top:-0.5rem; margin-bottom:1.25rem;">
    All website enquiries in one place — quote requests, product enquiries, contact forms and Sauna Advisor conversations.
  </p>

  <ArchiveToggle supported={archiveOk} showingArchived={showArchived} />
  <div class="admin-toolbar">
    <form class="admin-toolbar__filters" method="GET">
      <input class="admin-input admin-input--search" type="search" name="q" placeholder="Search name, email, phone, ZIP…" value={search} />
      <select class="admin-select" name="status">
        <option value="">All statuses</option>
        {STATUSES.map((s) => <option value={s} selected={s === statusFilter}>{s}</option>)}
      </select>
      <button class="admin-btn admin-btn--ghost" type="submit">Filter</button>
    </form>
  </div>

  <div class="admin-panel">
    {listKind === 'ok' && (
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>When</th><th>Contact</th><th>Request / Model</th><th>Source</th><th>Status</th><th>Next Action</th><th></th></tr>
        </thead>
        <tbody>
          {enquiries.map((e) => (
            <tr class="enq-row" data-href={`/admin/enquiries/${e.id}`}>
              <td>
                {new Date(e.created_at).toLocaleString()}
                {e.status === 'New' && waitingFor(e.created_at) && (
                  <span class={`enq-wait ${waitingFor(e.created_at)!.urgent ? 'enq-wait--urgent' : ''}`}>
                    {waitingFor(e.created_at)!.text}
                  </span>
                )}
              </td>
              <td>
                <a href={`/admin/enquiries/${e.id}`}>{e.name || e.email || e.phone || '—'}</a>
                {e.name && (e.email || e.phone) && <span class="enq-sub">{e.email || e.phone}</span>}
              </td>
              <td class="enq-req">{e.sauna_interest || e.message || '—'}</td>
              {/* The real form, which lives in the message while the source
                  CHECK constraint is un-migrated — see lib/enquiry-source.ts.
                  Without this the list showed nine of the twelve forms as a
                  flat "Website", which is the whole problem restated. */}
              <td>{effectiveSource(e) || e.source}</td>
              <td><StatusBadge status={e.status} /></td>
              <td class="enq-next">{nextAction(e)}</td>
              <td><a class="admin-btn admin-btn--ghost admin-btn--sm" href={`/admin/enquiries/${e.id}`}>View</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    )}
    {/* Only a query that actually SUCCEEDED may say the list is empty, and an
        empty filtered list is not the same statement as an empty database. */}
    {listKind === 'ok' && enquiries.length === 0 && (
      <p class="admin-empty">
        {search || statusFilter
          ? 'No enquiries match this filter. Clear the search or the status filter to see the whole list.'
          : "No enquiries yet — they'll appear here as visitors submit Request a Quote, use the Sauna Advisor, or reach out through the contact form."}
      </p>
    )}
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('tr.enq-row').forEach((row) => {
    row.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      const href = row.getAttribute('data-href');
      if (href) window.location.href = href;
    });
  });
</script>

<style>
  .enq-row { cursor: pointer; }
  .enq-sub { display: block; font-size: 0.72rem; color: var(--admin-muted); }
  .enq-wait { display: block; font-size: 0.72rem; color: var(--admin-gold); }
  .enq-wait--urgent { color: #d98a66; }
  .enq-req { max-width: 20rem; white-space: normal; }
  .enq-next { font-size: 0.78rem; color: var(--admin-muted); white-space: normal; max-width: 12rem; }
  .admin-btn--sm { padding: 0.3rem 0.7rem; font-size: 0.75rem; }
</style>
